
# ============================================================================
# WONDERLAND PLATFORM MAKEFILE
# GNU Make 3.81 compatible | macOS Apple Silicon
#
# Engineering rules:
#   - WL_ROOT > WL_HOME > WONDERLAND_ROOT > Makefile directory
#   - Debian Bookworm ARM64 is the canonical Spark build
#   - Pin the container image by verified repository digest
#   - Keep temporary rootfs data inside the container
#   - Publish artifacts only after successful validation
#   - Never overwrite an existing data disk
#   - Verify process identity before signaling vfkit
#   - Preserve TaylorZone and Control Plane targets
#   - Never claim an unimplemented daemon or SSH connection succeeded
# ============================================================================

.DEFAULT_GOAL := all
SHELL := /bin/sh

# ----------------------------------------------------------------------------
# Workspace root
# ----------------------------------------------------------------------------

WL_ROOT ?=
WL_HOME ?=
WONDERLAND_ROOT ?=

MAKEFILE_DIR := $(shell cd "$(dir $(lastword $(MAKEFILE_LIST)))" 2>/dev/null && pwd -P)

ifneq ($(strip $(WL_ROOT)),)
ROOT_DIR := $(shell cd "$(WL_ROOT)" 2>/dev/null && pwd -P)
else
ifneq ($(strip $(WL_HOME)),)
ROOT_DIR := $(shell cd "$(WL_HOME)" 2>/dev/null && pwd -P)
else
ifneq ($(strip $(WONDERLAND_ROOT)),)
ROOT_DIR := $(shell cd "$(WONDERLAND_ROOT)" 2>/dev/null && pwd -P)
else
ROOT_DIR := $(MAKEFILE_DIR)
endif
endif
endif

# ----------------------------------------------------------------------------
# Spark configuration
# ----------------------------------------------------------------------------

BUILD_CANDIDATE ?= vm-candidate-20261024-01

BUILD_PARENT := $(ROOT_DIR)/images/spark-debian/build
BUILD_DIR := $(BUILD_PARENT)/$(BUILD_CANDIDATE)
LOG_DIR := $(ROOT_DIR)/logs/spark-debian

ROOTFS_PATH := $(BUILD_DIR)/debian-bookworm-vm-rootfs.ext4
KERNEL_PATH := $(BUILD_DIR)/vmlinuz
INITRD_PATH := $(BUILD_DIR)/initrd.img
DATA_DISK := $(BUILD_DIR)/data.ext4

BUILD_STAMP := $(BUILD_DIR)/build-manifest.txt
CHECKSUM_FILE := $(BUILD_DIR)/checksums.sha256

CONTAINER_NAMESPACE ?= orbit
NERDCTL ?= nerdctl
VFKit ?= vfkit

# Verified orbit image repository digest, not a mutable tag.
BASE_IMAGE := debian@sha256:99c0b25c46d0214d5a2091092e7908907dcaecd6a962cde0ac700acee222b6f3

ROOTFS_SIZE ?= 4G
DATA_DISK_SIZE ?= 1G
CPUS ?= 2
MEMORY_MB ?= 2048

# Require at least 8 GiB free on the host before starting a build.
MIN_HOST_FREE_KB ?= 8388608

PID_FILE := $(LOG_DIR)/vfkit.pid
SERIAL_LOG := $(LOG_DIR)/vm-serial.log
VFKit_LOG := $(LOG_DIR)/vfkit.log

# ----------------------------------------------------------------------------
# Python configuration
# ----------------------------------------------------------------------------

PYTHON ?= $(ROOT_DIR)/.venv/bin/python
PYTEST ?= $(PYTHON) -m pytest
CONTROL_AUDIT_LOG ?= $(ROOT_DIR)/crystal_audit.log

# ----------------------------------------------------------------------------
# Targets
# ----------------------------------------------------------------------------

.PHONY: all help
.PHONY: vm-validate vm-artifacts vm-build vm-check-artifacts vm-data-disk
.PHONY: start-spark-debian stop-spark-debian status-spark-debian
.PHONY: launch-ssh clean
.PHONY: setup-venv benchmark
.PHONY: taylorzone-deploy
.PHONY: control-test control-daemon-start control-daemon-stop control-audit-tail

all: help

help:
	@echo "Wonderland Make targets:"
	@echo "  vm-validate          Validate host and build prerequisites"
	@echo "  vm-artifacts         Build or verify Spark artifacts"
	@echo "  vm-build             Build a new candidate (refuses overwrite)"
	@echo "  vm-check-artifacts   Verify published artifacts"
	@echo "  vm-data-disk        Explicitly create the persistent data disk"
	@echo "  start-spark-debian   Start the verified Spark VM"
	@echo "  status-spark-debian  Inspect Spark process identity"
	@echo "  stop-spark-debian    Stop only the verified Spark process"
	@echo "  launch-ssh           Report SSH readiness limitations"
	@echo "  clean                Remove a candidate with explicit confirmation"
	@echo "  setup-venv           Install Python development dependencies"
	@echo "  control-test         Run Control Plane tests with coverage gate"
	@echo "  control-audit-tail   Display recent Crystal audit records"
	@echo "  control-daemon-start Report daemon implementation status"
	@echo "  control-daemon-stop  Report daemon lifecycle status"
	@echo "  taylorzone-deploy    Run the explicit TaylorZone deployment"
	@echo "  benchmark            Report benchmark implementation status"

# ============================================================================
# HOST VALIDATION
# ============================================================================

vm-validate:
	@set -eu; \
	test -n "$(ROOT_DIR)" || { echo "FAIL: Workspace root unresolved"; exit 1; }; \
	test -d "$(ROOT_DIR)" || { echo "FAIL: Invalid workspace root"; exit 1; }; \
	case "$(BUILD_CANDIDATE)" in \
		""|.|..|.*|*[!A-Za-z0-9._-]*) echo "FAIL: Invalid BUILD_CANDIDATE"; exit 1 ;; \
	esac; \
	command -v "$(NERDCTL)" >/dev/null 2>&1 || { echo "FAIL: nerdctl unavailable"; exit 1; }; \
	command -v "$(VFKit)" >/dev/null 2>&1 || { echo "FAIL: vfkit unavailable"; exit 1; }; \
	command -v zsh >/dev/null 2>&1 || { echo "FAIL: zsh unavailable"; exit 1; }; \
	command -v shasum >/dev/null 2>&1 || { echo "FAIL: shasum unavailable"; exit 1; }; \
	command -v python3 >/dev/null 2>&1 || { echo "FAIL: python3 unavailable"; exit 1; }; \
	AVAILABLE_KB=$$(df -Pk "$(ROOT_DIR)" | awk 'NR == 2 {print $$4}'); \
	test -n "$$AVAILABLE_KB" || { echo "FAIL: Cannot determine free space"; exit 1; }; \
	if [ "$$AVAILABLE_KB" -lt "$(MIN_HOST_FREE_KB)" ]; then \
		echo "FAIL: Host free space below threshold"; \
		echo "Available KiB: $$AVAILABLE_KB"; \
		echo "Required KiB:  $(MIN_HOST_FREE_KB)"; \
		exit 1; \
	fi; \
	echo "PASS: Workspace root $(ROOT_DIR)"; \
	echo "PASS: Candidate name $(BUILD_CANDIDATE)"; \
	echo "PASS: Host dependencies"; \
	echo "PASS: Host free-space threshold"

# ============================================================================
# ARTIFACT ORCHESTRATION
# ============================================================================

vm-artifacts: vm-validate
	@$(MAKE) --no-print-directory vm-check-artifacts

# ============================================================================
# SPARK BUILD
#
# Temporary rootfs is /tmp/rootfs inside the container.
# Only completed output files are written to the host staging directory.
# ============================================================================

vm-build: vm-validate
	@set -eu; \
	mkdir -p "$(BUILD_PARENT)" "$(LOG_DIR)"; \
	LOCK="$(BUILD_PARENT)/.$(BUILD_CANDIDATE).build.lock"; \
	if ! mkdir "$$LOCK" 2>/dev/null; then \
		echo "FAIL: Build lock exists: $$LOCK"; \
		echo "Inspect the lock owner before removing a stale lock."; \
		exit 1; \
	fi; \
	STAGE=; \
	cleanup_build() { \
		if [ -n "$$STAGE" ]; then rm -rf "$$STAGE"; fi; \
		rmdir "$$LOCK" 2>/dev/null || true; \
	}; \
	trap cleanup_build EXIT; \
	trap 'exit 1' HUP INT TERM; \
	if [ -L "$(BUILD_DIR)" ]; then \
		echo "FAIL: Candidate directory is a symlink"; exit 1; \
	fi; \
	if [ -d "$(BUILD_DIR)" ]; then \
		EXISTING=$$(find "$(BUILD_DIR)" -mindepth 1 -maxdepth 1 -print -quit); \
		if [ -n "$$EXISTING" ]; then \
			echo "FAIL: Candidate directory is not empty"; \
			echo "Refusing to overwrite existing candidate"; \
			exit 1; \
		fi; \
	fi; \
	STAGE=$$(mktemp -d "$(BUILD_PARENT)/.$(BUILD_CANDIDATE).stage.XXXXXX"); \
	echo "Building Debian Bookworm ARM64 Spark"; \
	echo "Image: $(BASE_IMAGE)"; \
	echo "Namespace: $(CONTAINER_NAMESPACE)"; \
	$(NERDCTL) --namespace "$(CONTAINER_NAMESPACE)" run --rm --privileged \
		--memory 1536m --cpus 2 \
		-v "$$STAGE:/build" \
		-e ROOTFS_SIZE="$(ROOTFS_SIZE)" \
		"$(BASE_IMAGE)" bash -euc '\
			set -Eeuo pipefail; \
			export DEBIAN_FRONTEND=noninteractive; \
			R=/tmp/rootfs; \
			mkdir -p "$$R"; \
			apt-get update -qq; \
			apt-get install -y -qq --no-install-recommends \
				debootstrap e2fsprogs gzip; \
			debootstrap --arch=arm64 bookworm \
				"$$R" http://deb.debian.org/debian; \
			printf "%s\n" \
				"deb http://deb.debian.org/debian bookworm main contrib non-free non-free-firmware" \
				> "$$R/etc/apt/sources.list"; \
			mkdir -p "$$R/proc" "$$R/sys" "$$R/dev/pts"; \
			cleanup_mounts() { \
				umount "$$R/dev/pts" 2>/dev/null || true; \
				umount "$$R/dev" 2>/dev/null || true; \
				umount "$$R/sys" 2>/dev/null || true; \
				umount "$$R/proc" 2>/dev/null || true; \
			}; \
			trap cleanup_mounts EXIT; \
			mount -t proc proc "$$R/proc"; \
			mount -t sysfs sys "$$R/sys"; \
			mount --bind /dev "$$R/dev"; \
			mount --bind /dev/pts "$$R/dev/pts"; \
			chroot "$$R" apt-get update -qq; \
			chroot "$$R" apt-get install -y -qq --no-install-recommends \
				linux-image-arm64 initramfs-tools \
				systemd systemd-sysv systemd-resolved \
				openssh-server e2fsprogs jq curl wget git; \
			mkdir -p "$$R/etc/initramfs-tools"; \
			touch "$$R/etc/initramfs-tools/modules"; \
			for module in virtio_blk virtio_mmio virtio_pci ext4; do \
				grep -qx "$$module" "$$R/etc/initramfs-tools/modules" || \
					echo "$$module" >> "$$R/etc/initramfs-tools/modules"; \
			done; \
			chroot "$$R" systemctl enable systemd-networkd.service; \
			chroot "$$R" systemctl enable systemd-resolved.service; \
			mkdir -p "$$R/etc/systemd/network"; \
			printf "%s\n" \
				"[Match]" "Name=en*" "" "[Network]" "DHCP=yes" \
				> "$$R/etc/systemd/network/10-virtio.network"; \
			mkdir -p "$$R/var/lib/tailscale"; \
			touch "$$R/etc/fstab"; \
			if ! grep -q " /var/lib/tailscale " "$$R/etc/fstab"; then \
				echo "LABEL=SPARKDATA /var/lib/tailscale ext4 defaults,nofail 0 2" \
					>> "$$R/etc/fstab"; \
			fi; \
			mkdir -p "$$R/etc/ssh/sshd_config.d"; \
			printf "%s\n" \
				"PermitRootLogin prohibit-password" \
				"PasswordAuthentication no" \
				"PubkeyAuthentication yes" \
				> "$$R/etc/ssh/sshd_config.d/99-wonderland.conf"; \
			chroot "$$R" update-initramfs -u -k all; \
			KERNEL_SOURCE=$$(find "$$R/boot" -maxdepth 1 -type f -name "vmlinuz-*" | sort -V | tail -1); \
			INITRD_SOURCE=$$(find "$$R/boot" -maxdepth 1 -type f -name "initrd.img-*" | sort -V | tail -1); \
			test -s "$$KERNEL_SOURCE"; \
			test -s "$$INITRD_SOURCE"; \
			MAGIC=$$(od -An -tx1 -N2 "$$KERNEL_SOURCE" | tr -d " \n"); \
			if [ "$$MAGIC" = "1f8b" ]; then \
				gzip -dc "$$KERNEL_SOURCE" > /build/vmlinuz; \
			else \
				cp "$$KERNEL_SOURCE" /build/vmlinuz; \
			fi; \
			ARM64_MAGIC=$$(od -An -tx1 -j56 -N4 /build/vmlinuz | tr -d " \n"); \
			if [ "$$ARM64_MAGIC" != "41524d64" ]; then \
				echo "FAIL: Uncompressed ARM64 Image magic not found"; \
				exit 1; \
			fi; \
			cp "$$INITRD_SOURCE" /build/initrd.img; \
			cleanup_mounts; \
			trap - EXIT; \
			truncate -s "$$ROOTFS_SIZE" /build/debian-bookworm-vm-rootfs.ext4; \
			mkfs.ext4 -F -L SPARKROOT -d "$$R" \
				/build/debian-bookworm-vm-rootfs.ext4; \
			cd /build; \
			sha256sum debian-bookworm-vm-rootfs.ext4 vmlinuz initrd.img > checksums.sha256; \
			{ \
				echo "schema=wonderland.spark.build.v1"; \
				echo "created_at_utc=$$(date -u +%Y-%m-%dT%H:%M:%SZ)"; \
				echo "base_image=$(BASE_IMAGE)"; \
				echo "kernel_version=$$(basename "$$KERNEL_SOURCE" | sed 's/^vmlinuz-//')"; \
				echo "architecture=arm64"; \
				echo "distribution=debian-bookworm"; \
				echo "rootfs_label=SPARKROOT"; \
				echo "data_label=SPARKDATA"; \
				echo "rootfs_size=$$ROOTFS_SIZE"; \
				echo "kernel_format=uncompressed-arm64-Image"; \
				echo "container_namespace=$(CONTAINER_NAMESPACE)"; \
			} > build-manifest.txt; \
			test -s debian-bookworm-vm-rootfs.ext4; \
			test -s vmlinuz; \
			test -s initrd.img; \
			echo "PASS: Rootfs, kernel, initrd and manifest generated"; \
		'; \
	if [ -d "$(BUILD_DIR)" ]; then \
		rmdir "$(BUILD_DIR)" || { echo "FAIL: Candidate directory is not empty"; exit 1; }; \
	fi; \
	if [ -e "$(BUILD_DIR)" ] || [ -L "$(BUILD_DIR)" ]; then \
		echo "FAIL: Candidate destination appeared during build"; exit 1; \
	fi; \
	mv "$$STAGE" "$(BUILD_DIR)"; \
	STAGE=; \
	cleanup_build; \
	trap - EXIT HUP INT TERM; \
	echo "PASS: Candidate published at $(BUILD_DIR)"

# ============================================================================
# ARTIFACT VERIFICATION
# ============================================================================

vm-check-artifacts:
	@set -eu; \
	for f in "$(ROOTFS_PATH)" "$(KERNEL_PATH)" "$(INITRD_PATH)" \
	         "$(BUILD_STAMP)" "$(CHECKSUM_FILE)"; do \
		test -s "$$f" || { echo "FAIL: Missing artifact $$f"; exit 1; }; \
		echo "PASS: $$f"; \
	done; \
	cd "$(BUILD_DIR)"; \
	shasum -a 256 -c checksums.sha256; \
	MAGIC=$$(od -An -tx1 -j56 -N4 vmlinuz | tr -d ' \n'); \
	test "$$MAGIC" = "41524d64" || { echo "FAIL: Kernel magic mismatch"; exit 1; }; \
	echo "PASS: Artifact verification"

# ============================================================================
# PERSISTENT DATA DISK
#
# Explicit provisioning only. A hard link publishes the completed image
# atomically and fails if the destination already exists.
# ============================================================================

vm-data-disk: vm-check-artifacts
	@set -eu; \
	test -d "$(BUILD_DIR)" || { echo "FAIL: Candidate directory missing"; exit 1; }; \
	test ! -L "$(BUILD_DIR)" || { echo "FAIL: Candidate directory is a symlink"; exit 1; }; \
	if [ -e "$(DATA_DISK)" ] || [ -L "$(DATA_DISK)" ]; then \
		echo "FAIL: Data disk already exists; refusing overwrite"; exit 1; \
	fi; \
	TMPDIR=$$(mktemp -d "$(BUILD_DIR)/.data-stage.XXXXXX"); \
	cleanup_data() { rm -rf "$$TMPDIR"; }; \
	trap cleanup_data EXIT; \
	trap 'exit 1' HUP INT TERM; \
	$(NERDCTL) --namespace "$(CONTAINER_NAMESPACE)" run --rm \
		-v "$$TMPDIR:/build" \
		"$(BASE_IMAGE)" bash -euc '\
			export DEBIAN_FRONTEND=noninteractive; \
			apt-get update -qq; \
			apt-get install -y -qq --no-install-recommends e2fsprogs; \
			truncate -s "$(DATA_DISK_SIZE)" /build/data.ext4; \
			mkfs.ext4 -F -L SPARKDATA /build/data.ext4; \
		'; \
	test -s "$$TMPDIR/data.ext4"; \
	ln "$$TMPDIR/data.ext4" "$(DATA_DISK)" || { \
		echo "FAIL: Atomic no-clobber data-disk publication failed"; exit 1; \
	}; \
	cleanup_data; \
	trap - EXIT HUP INT TERM; \
	echo "PASS: Persistent data disk created"

# VM PROCESS LIFECYCLE
# ============================================================================

start-spark-debian: vm-artifacts
	@set -eu; \
	mkdir -p "$(LOG_DIR)"; \
	test -s "$(DATA_DISK)" || { echo "FAIL: Data disk missing; run make vm-data-disk explicitly"; exit 1; }; \
	test ! -L "$(DATA_DISK)" || { echo "FAIL: Data disk is a symlink"; exit 1; }; \
	matching_pids() { \
		ps -axo pid=,comm=,args= | awk -v p="$(ROOTFS_PATH)" \
			'$$2 ~ /(^|\/)vfkit$$/ && index($$0,p) > 0 {print $$1}'; \
	}; \
	if [ -L "$(PID_FILE)" ]; then echo "FAIL: PID file is a symlink"; exit 1; fi; \
	if [ -f "$(PID_FILE)" ]; then \
		PID=$$(cat "$(PID_FILE)"); \
		case "$$PID" in ""|*[!0-9]*) echo "FAIL: Invalid vfkit PID file"; exit 1 ;; esac; \
		kill -0 "$$PID" 2>/dev/null || { echo "FAIL: Stale PID file; inspect manually"; exit 1; }; \
		CMD=$$(ps -p "$$PID" -o comm=,args= 2>/dev/null || true); \
		case "$$CMD" in *vfkit*"$(ROOTFS_PATH)"*) echo "FAIL: Spark already running, PID $$PID"; exit 1 ;; \
			*) echo "FAIL: PID belongs to another process"; echo "$$CMD"; exit 1 ;; esac; \
	fi; \
	MATCHES=$$(matching_pids); \
	if [ -n "$$MATCHES" ]; then \
		echo "FAIL: Candidate-specific vfkit process exists without a usable PID record"; \
		echo "$$MATCHES"; exit 1; \
	fi; \
	nohup "$(VFKit)" \
		--pidfile "$(PID_FILE)" \
		--cpus "$(CPUS)" \
		--memory "$(MEMORY_MB)" \
		--bootloader "linux,kernel=$(KERNEL_PATH),initrd=$(INITRD_PATH),cmdline=\"console=hvc0 root=LABEL=SPARKROOT rootfstype=ext4 rw panic=1\"" \
		--device "virtio-blk,path=$(ROOTFS_PATH)" \
		--device "virtio-blk,path=$(DATA_DISK)" \
		--device virtio-net,nat \
		--device "virtio-serial,logFilePath=$(SERIAL_LOG)" \
		--device virtio-rng \
		> "$(VFKit_LOG)" 2>&1 & \
	LAUNCH_PID=$$!; \
	I=0; \
	while [ ! -s "$(PID_FILE)" ] && [ "$$I" -lt 10 ]; do \
		kill -0 "$$LAUNCH_PID" 2>/dev/null || break; \
		sleep 1; I=$$((I + 1)); \
	done; \
	test -s "$(PID_FILE)" || { \
		echo "FAIL: vfkit did not publish its PID file"; \
		cat "$(VFKit_LOG)" || true; exit 1; \
	}; \
	PID=$$(cat "$(PID_FILE)"); \
	test "$$PID" = "$$LAUNCH_PID" || { echo "FAIL: vfkit PID-file mismatch"; exit 1; }; \
	CMD=$$(ps -p "$$PID" -o comm=,args= 2>/dev/null || true); \
	case "$$CMD" in *vfkit*"$(ROOTFS_PATH)"*) echo "PASS: vfkit started, PID $$PID" ;; \
		*) echo "FAIL: Cannot verify vfkit identity"; echo "$$CMD"; exit 1 ;; esac; \
	echo "NOTE: Process start is not guest boot readiness."

status-spark-debian:
	@set -eu; \
	matching_pids() { \
		ps -axo pid=,comm=,args= | awk -v p="$(ROOTFS_PATH)" \
			'$$2 ~ /(^|\/)vfkit$$/ && index($$0,p) > 0 {print $$1}'; \
	}; \
	if [ ! -f "$(PID_FILE)" ]; then \
		MATCHES=$$(matching_pids); \
		if [ -n "$$MATCHES" ]; then \
			echo "FAIL: Candidate-specific vfkit process is running without a PID file"; \
			echo "$$MATCHES"; exit 1; \
		fi; \
		echo "STOPPED: No matching vfkit process found; no PID file exists"; exit 0; \
	fi; \
	test ! -L "$(PID_FILE)" || { echo "FAIL: PID file is a symlink"; exit 1; }; \
	PID=$$(cat "$(PID_FILE)"); \
	case "$$PID" in ""|*[!0-9]*) echo "FAIL: Invalid PID file"; exit 1 ;; esac; \
	kill -0 "$$PID" 2>/dev/null || { echo "FAIL: Stale PID file"; exit 1; }; \
	CMD=$$(ps -p "$$PID" -o comm=,args= 2>/dev/null || true); \
	case "$$CMD" in *vfkit*"$(ROOTFS_PATH)"*) echo "PROCESS RUNNING: PID $$PID" ;; \
		*) echo "FAIL: PID identity mismatch"; echo "$$CMD"; exit 1 ;; esac; \
	echo "Guest readiness is not established by process existence."; \
	echo "Serial log: $(SERIAL_LOG)"; \
	echo "vfkit log: $(VFKit_LOG)"

stop-spark-debian:
	@set -eu; \
	matching_pids() { \
		ps -axo pid=,comm=,args= | awk -v p="$(ROOTFS_PATH)" \
			'$$2 ~ /(^|\/)vfkit$$/ && index($$0,p) > 0 {print $$1}'; \
	}; \
	if [ ! -f "$(PID_FILE)" ]; then \
		MATCHES=$$(matching_pids); \
		if [ -n "$$MATCHES" ]; then \
			echo "FAIL: Matching vfkit process exists but PID file is absent"; \
			echo "$$MATCHES"; exit 1; \
		fi; \
		echo "STOPPED: No matching vfkit process found"; exit 0; \
	fi; \
	test ! -L "$(PID_FILE)" || { echo "FAIL: PID file is a symlink"; exit 1; }; \
	PID=$$(cat "$(PID_FILE)"); \
	case "$$PID" in ""|*[!0-9]*) echo "FAIL: Invalid PID file"; exit 1 ;; esac; \
	kill -0 "$$PID" 2>/dev/null || { echo "FAIL: Stale PID file; refusing cleanup"; exit 1; }; \
	CMD=$$(ps -p "$$PID" -o comm=,args= 2>/dev/null || true); \
	case "$$CMD" in *vfkit*"$(ROOTFS_PATH)"*) ;; \
		*) echo "FAIL: PID identity mismatch; refusing to signal"; echo "$$CMD"; exit 1 ;; esac; \
	kill -TERM "$$PID"; \
	I=0; \
	while [ "$$I" -lt 15 ]; do \
		kill -0 "$$PID" 2>/dev/null || break; \
		sleep 1; I=$$((I + 1)); \
	done; \
	if kill -0 "$$PID" 2>/dev/null; then \
		CMD=$$(ps -p "$$PID" -o comm=,args= 2>/dev/null || true); \
		case "$$CMD" in *vfkit*"$(ROOTFS_PATH)"*) kill -KILL "$$PID" ;; \
			*) echo "FAIL: Process identity changed; refusing KILL"; exit 1 ;; esac; \
		I=0; \
		while kill -0 "$$PID" 2>/dev/null && [ "$$I" -lt 5 ]; do \
			sleep 1; I=$$((I + 1)); \
		done; \
	fi; \
	if kill -0 "$$PID" 2>/dev/null; then \
		echo "FAIL: Process still exists; PID record retained"; exit 1; \
	fi; \
	MATCHES=$$(matching_pids); \
	if [ -n "$$MATCHES" ]; then \
		echo "FAIL: Candidate-specific vfkit process remains"; echo "$$MATCHES"; exit 1; \
	fi; \
	if [ -f "$(PID_FILE)" ]; then \
		CURRENT=$$(cat "$(PID_FILE)"); \
		test "$$CURRENT" = "$$PID" || { echo "FAIL: PID file changed during stop"; exit 1; }; \
		rm -f "$(PID_FILE)"; \
	fi; \
	echo "PASS: Spark vfkit stopped"

# SSH
# ============================================================================

launch-ssh:
	@echo "BLOCKED: SSH is not yet provisioned."
	@echo "Missing: guest authorized-key provisioning, guest network discovery,"
	@echo "and a verified host-to-guest SSH transport."
	@echo "No VM was started and no connection was attempted."
	@exit 2

# ============================================================================
# SAFE CLEANUP
# ============================================================================

clean:
	@set -eu; \
	if [ "$(CONFIRM_CLEAN)" != "$(BUILD_CANDIDATE)" ]; then \
		echo "FAIL: Explicit confirmation required."; \
		echo "Use: make clean CONFIRM_CLEAN=$(BUILD_CANDIDATE)"; \
		exit 1; \
	fi; \
	case "$(BUILD_CANDIDATE)" in \
		""|.|..|.*|*[!A-Za-z0-9._-]*) echo "FAIL: Invalid candidate"; exit 1 ;; \
	esac; \
	test -d "$(BUILD_PARENT)" || { echo "FAIL: Build parent missing"; exit 1; }; \
	PARENT_REAL=$$(cd "$(BUILD_PARENT)" && pwd -P); \
	ROOT_REAL=$$(cd "$(ROOT_DIR)" && pwd -P); \
	EXPECTED_PARENT="$$ROOT_REAL/images/spark-debian/build"; \
	test "$$PARENT_REAL" = "$$EXPECTED_PARENT" || { \
		echo "FAIL: Build parent canonical path mismatch"; exit 1; \
	}; \
	if [ -L "$(BUILD_DIR)" ]; then echo "FAIL: Candidate is a symlink"; exit 1; fi; \
	matching_pids() { \
		ps -axo pid=,comm=,args= | awk -v p="$(ROOTFS_PATH)" \
			'$$2 ~ /(^|\/)vfkit$$/ && index($$0,p) > 0 {print $$1}'; \
	}; \
	MATCHES=$$(matching_pids); \
	if [ -n "$$MATCHES" ]; then \
		echo "FAIL: Candidate-specific vfkit process exists; cleanup refused"; \
		echo "$$MATCHES"; exit 1; \
	fi; \
	if [ -f "$(PID_FILE)" ]; then \
		PID=$$(cat "$(PID_FILE)"); \
		case "$$PID" in ""|*[!0-9]*) echo "FAIL: Invalid PID file; inspect manually"; exit 1 ;; esac; \
		if kill -0 "$$PID" 2>/dev/null; then \
			echo "FAIL: PID file references a live process; inspect manually"; exit 1; \
		fi; \
		echo "NOTE: Removing stale PID record after independent process scan."; \
		rm -f "$(PID_FILE)"; \
	fi; \
	if [ -e "$(BUILD_DIR)" ]; then \
		test -d "$(BUILD_DIR)" || { echo "FAIL: Candidate path is not a directory"; exit 1; }; \
		rm -rf "$(BUILD_DIR)"; \
	fi; \
	echo "PASS: Candidate cleanup complete"; \
	echo "Logs preserved: $(LOG_DIR)"

# TAYLORZONE
# Explicit deployment only; never part of the default target.
# ============================================================================

taylorzone-deploy:
	@set -eu; \
	for f in \
		scripts/manage_taylorzone_vault.zsh \
		scripts/configure_taylorzone_syncthing.zsh \
		scripts/deploy_tailscale_acls.zsh \
		scripts/audit_taylorzone.zsh; do \
		test -f "$(ROOT_DIR)/$$f" || { echo "FAIL: Missing $$f"; exit 1; }; \
	done; \
	test -f "$(ROOT_DIR)/taylorzone/policy.hujson" || { echo "FAIL: Missing TaylorZone policy"; exit 1; }; \
	echo "[1/4] Mounting APFS vault"; \
	cd "$(ROOT_DIR)" && zsh scripts/manage_taylorzone_vault.zsh "" mount; \
	echo "[2/4] Configuring Syncthing"; \
	cd "$(ROOT_DIR)" && zsh scripts/configure_taylorzone_syncthing.zsh; \
	echo "[3/4] Deploying Tailscale ACL policy"; \
	cd "$(ROOT_DIR)" && zsh scripts/deploy_tailscale_acls.zsh "$(ROOT_DIR)/taylorzone/policy.hujson"; \
	echo "[4/4] Auditing TaylorZone"; \
	cd "$(ROOT_DIR)" && zsh scripts/audit_taylorzone.zsh; \
	echo "PASS: TaylorZone deployment and audit completed"

