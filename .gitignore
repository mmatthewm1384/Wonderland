###############################################################################
# Wonderland Repository Ignore Policy 2.0
#
# GENERATED FILE. DO NOT EDIT DIRECTLY.
#
# Source:
#   policy/repository/policy.json
#
# Regenerate:
#   wl repo generate
#
###############################################################################

###############################################################################
# Policy principles
###############################################################################

# - Track source, documentation, configuration, schemas, and durable evidence.
# - Ignore generated state, caches, local credentials, backups, and build output.
# - Use narrow path-specific rules instead of broad source-tree exclusions.
# - Never mutate the Git index during generation or verification.

###############################################################################
# Secrets and local credentials
###############################################################################

/secrets/
/vault/secrets/*
!/vault/secrets/.gitkeep
.env
.env.*
!.env.example
!.env.template
*.pem
*.key
*.p12
*.pfx

###############################################################################
# Wonderland local workspace
###############################################################################

/.wl/
/.wl-registry

###############################################################################
# Backups and temporary files
###############################################################################

/.backup/
*.bak
*.bak.*
*.backup
*.backup.*
*.orig
*.rej
*~
/tmp/
/temp/
*.tmp
*.temp
*.lock.tmp

###############################################################################
# Logs
###############################################################################

/logs/
*.log
!tests/fixtures/**/*.log
!**/fixtures/**/*.log

###############################################################################
# Wonderland runtime state
###############################################################################

/runtime/controller/*
!/runtime/controller/.gitkeep
/runtime/chaos/*
!/runtime/chaos/.gitkeep
/state/runtime/
/vault/snapshots/
/vault/ephemeral-runs.log
/vault/chaos/*.json
/vault/chaos/*.jsonl
/vault/chaos/*.log
/vault/chaos/*.pid

###############################################################################
# Generated operational state
###############################################################################

/vault/06-Services/service-health.json
/vault/07-Operations/drift/*.json
/vault/08-Operations/state/
/vault/08-Operations/logs/
/vault/08-Operations/backups/
/vault/08-Operations/checkpoints/
/vault/08-Operations/baselines/
/vault/08-Operations/certifications/
/vault/08-Operations/reports/
/vault/08-Operations/handoffs/
/vault/08-Operations/replication/manifests/latest.*
/vault/08-Operations/recovery/git-rescue/*.tar.gz

###############################################################################
# Generated registry snapshots
###############################################################################

/vault/05-Registry/architecture/baselines/architecture-*.tsv
/vault/05-Registry/gates/latest-gate-check.txt
/vault/05-Registry/gates/latest-gate-promote.txt
/vault/05-Registry/git/latest-git-status.txt
/vault/05-Registry/reports/platform-report.txt

###############################################################################
# Generated Vault pointers and caches
###############################################################################

/vault/**/audit.jsonl
/vault/**/latest.json
/vault/**/latest.diff
/vault/**/latest-status.json
/vault/**/latest-status.md
/vault/**/generated/
/vault/**/cache/
/vault/**/tmp/
/vault/**/.cache/

###############################################################################
# Torrent runtime data
###############################################################################

/vault/data/torrents/config/
/vault/data/torrents/downloads/
/vault/data/torrents/downloads-export/
/vault/data/torrents/quarantine/
*.fastresume
*.torrent

###############################################################################
# Builder-generated workspaces
###############################################################################

/builder/image/
/builder/image-python/
/builder/mount/
/builder/output/
/builder/qcow2/
/builder/rootfs/
/builder/vmware/
/builder/work/
/Wonderland-Builds/

###############################################################################
# Build output
###############################################################################

/build/
/dist/
/out/
/coverage/
/htmlcov/
**/.build/
**/target/
**/node_modules/
apps/**/build/
apps/**/backups/
apps/**/*.app/
*.dSYM/

###############################################################################
# Release binary artifacts
###############################################################################

/releases/**/*.raw
/releases/**/*.raw.zst
/releases/**/*.qcow2
/releases/**/*.vmdk
/releases/**/*.vhdx
/releases/**/*.img
/releases/**/*.iso
/releases/**/*.dmg
/releases/**/*.app
/releases/**/*.vmwarevm

###############################################################################
# Python
###############################################################################

__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.pytype/
.coverage
.coverage.*
*.egg-info/
.eggs/
.venv/
venv/
ENV/

###############################################################################
# Swift, Xcode, Rust, and frontend tooling
###############################################################################

DerivedData/
*.xcuserstate
xcuserdata/
node_modules/
.npm/
.yarn/cache/
.pnpm-store/
*.tsbuildinfo

###############################################################################
# Editor, macOS, and tool caches
###############################################################################

.vscode/
.idea/
*.swp
*.swo
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
