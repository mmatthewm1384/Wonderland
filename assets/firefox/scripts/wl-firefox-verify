#!/usr/bin/env bash
set -euo pipefail

FAIL=0
ROOT="$HOME/Wonderland"
PROFILE_ROOT="$HOME/Library/Application Support/Firefox/Profiles"
GOVERNOR_POLICY="$ROOT/docker/wl-governor/policies/governor-policy.json"

for p in operations research sandbox
do
    [ -d "$PROFILE_ROOT/$p" ] && echo "PASS profile $p" || { echo "FAIL profile $p"; FAIL=1; }
    [ -f "$PROFILE_ROOT/$p/user.js" ] && echo "PASS user.js $p" || { echo "FAIL user.js $p"; FAIL=1; }
    [ -f "$PROFILE_ROOT/$p/chrome/userChrome.css" ] && echo "PASS userChrome.css $p" || { echo "FAIL userChrome.css $p"; FAIL=1; }
done

[ -f /Library/Preferences/org.mozilla.firefox.plist ] && echo "PASS enterprise-policy" || { echo "FAIL enterprise-policy"; FAIL=1; }

if [ -f "$GOVERNOR_POLICY" ] && jq -e '.required_checks[] | select(. == "bin/wl-firefox verify")' "$GOVERNOR_POLICY" >/dev/null; then
    echo "PASS governor-policy"
else
    echo "FAIL governor-policy"
    FAIL=1
fi

if [ "$FAIL" -eq 0 ]; then
    echo "RESULT PASS"
else
    echo "RESULT FAIL"
    exit 1
fi
