{
  "id": "wl-roam-policy-v1",
  "mode": "authorized-only",
  "fail_closed": true,
  "allow_sync_on_untrusted_network": false,
  "allowed_behaviors": [
    "detect_current_network",
    "trust_explicit_networks",
    "audit_network_changes",
    "queue_offline_work",
    "sync_only_when_trusted",
    "use_wireguard_or_tailscale_overlay"
  ],
  "forbidden_behaviors": [
    "crack",
    "harvest",
    "spoof",
    "bypass",
    "join_without_authorization"
  ],
  "overlay_policy": {
    "required": false,
    "preferred": [
      "wireguard",
      "tailscale"
    ],
    "reason": "Tailscale hardware attestation policy prevents this macOS Homebrew daemon from running reliably."
  }
}
