#!/usr/bin/env bash
set -euo pipefail

ROOT="/Users/wonderland/Wonderland"
NAME="${1:-}"

if [[ -z "$NAME" ]]; then
  echo "Usage: wl-runtime-promote-intent <container-name>"
  exit 1
fi

if [[ "$NAME" == wl-* ]]; then
  echo "FAIL: $NAME already follows wl-* naming"
  exit 1
fi

STAMP="$(date +%Y%m%d-%H%M%S)"
SAFE="$(echo "$NAME" | tr -cs 'A-Za-z0-9_-' '-')"
OUT="$ROOT/vault/05-Registry/intents/promote-$SAFE-$STAMP.intent.json"

mkdir -p "$(dirname "$OUT")"

cat > "$OUT" <<JSON
{
  "id": "promote-$SAFE-$STAMP",
  "intent": "promote unmanaged container '$NAME' into Wonderland-managed service",
  "status": "draft",
  "created": "$STAMP",
  "operator": "Matthew Mahaney",
  "source_container": "$NAME",
  "target_service": "wl-$SAFE",
  "required_artifacts": [
    "service definition",
    "verification path",
    "recovery path",
    "rollback path",
    "registry entry"
  ],
  "rollback": "remove generated service definition and registry entry"
}
JSON

echo "intent: $OUT"
