#!/usr/bin/env bash
set -euo pipefail

ROOT="${WONDERLAND_ROOT:-$HOME/Wonderland}"
REGISTRY="$ROOT/.wl-registry"
LOG_DIR="$ROOT/logs/registry"
LOG_FILE="$LOG_DIR/wl-registry.log"

mkdir -p "$LOG_DIR"

log() {
  printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "$LOG_FILE"
}

require_registry() {
  if [ ! -f "$REGISTRY" ]; then
    echo "[FAIL] Registry missing: $REGISTRY"
    echo "Run: wl-governance sync"
    exit 1
  fi
}

require_python() {
  command -v python3 >/dev/null 2>&1 || {
    echo "[FAIL] python3 not found"
    exit 1
  }
}

status() {
  require_registry
  require_python

  python3 - "$REGISTRY" <<'PY'
import json, sys
path = sys.argv[1]
with open(path, "r", encoding="utf-8") as f:
    data = json.load(f)

runtime_inventory = data.get("runtime_inventory", {})

print("Wonderland Registry")
print(f"Generated:       {data.get('generated')}")
print(f"From:            {data.get('generated_from')}")
print(f"At:              {data.get('generated_at')}")
print(f"Inventory At:    {runtime_inventory.get('generated_at', 'not generated')}")
print(f"System:          {data.get('system')}")
print(f"Operator:        {data.get('operator')}")
print(f"Runtime:         {data.get('runtime', {}).get('container_runtime')}")
print(f"Commands:        {len(data.get('commands', []))}")
print(f"Runtime Commands:{len(runtime_inventory.get('commands', []))}")
print(f"Core Scripts:    {len(runtime_inventory.get('core_scripts', []))}")
print(f"Repositories:    {len(runtime_inventory.get('repositories', []))}")
print(f"Services:        {len(runtime_inventory.get('services', []))}")
PY
}

doctor() {
  failures=0

  echo "=== 🧾 Wonderland Registry Doctor ==="

  if [ -f "$REGISTRY" ]; then
    echo "[OK] Registry exists"
  else
    echo "[FAIL] Registry missing"
    failures=$((failures + 1))
  fi

  if command -v python3 >/dev/null 2>&1; then
    echo "[OK] python3 available"
  else
    echo "[FAIL] python3 missing"
    failures=$((failures + 1))
  fi

  if [ -f "$REGISTRY" ] && python3 -m json.tool "$REGISTRY" >/dev/null 2>&1; then
    echo "[OK] Registry JSON valid"
  elif [ -f "$REGISTRY" ]; then
    echo "[FAIL] Registry JSON invalid"
    failures=$((failures + 1))
  fi

  if [ -d "$ROOT/bin" ]; then
    echo "[OK] bin directory exists"
  else
    echo "[FAIL] bin directory missing"
    failures=$((failures + 1))
  fi

  if [ -d "$ROOT/core" ]; then
    echo "[OK] core directory exists"
  else
    echo "[FAIL] core directory missing"
    failures=$((failures + 1))
  fi

  if [ "$failures" -eq 0 ]; then
    echo "=== REGISTRY HEALTHY ==="
    exit 0
  else
    echo "=== REGISTRY UNHEALTHY: $failures failure(s) ==="
    exit 1
  fi
}

show() {
  require_registry
  cat "$REGISTRY"
}

get() {
  require_registry
  require_python
  key="${1:-}"

  if [ -z "$key" ]; then
    echo "Usage: wl-registry get <key>"
    exit 1
  fi

  python3 - "$REGISTRY" "$key" <<'PY'
import json, sys
path, dotted = sys.argv[1], sys.argv[2]
with open(path, "r", encoding="utf-8") as f:
    data = json.load(f)

cur = data
for part in dotted.split("."):
    if isinstance(cur, dict) and part in cur:
        cur = cur[part]
    else:
        print(f"[FAIL] Missing key: {dotted}")
        sys.exit(1)

print(json.dumps(cur, indent=2))
PY
}

inventory() {
  require_registry
  require_python

  python3 - "$ROOT" "$REGISTRY" <<'PY'
import json
import os
import stat
import sys
import datetime
from pathlib import Path

root = Path(sys.argv[1]).expanduser()
registry_path = Path(sys.argv[2]).expanduser()

with registry_path.open("r", encoding="utf-8") as f:
    registry = json.load(f)

def iso_now():
    return datetime.datetime.now(datetime.timezone.utc).replace(microsecond=0).isoformat()

def is_executable(path: Path) -> bool:
    try:
        mode = path.stat().st_mode
        return bool(mode & stat.S_IXUSR)
    except FileNotFoundError:
        return False

def rel(path: Path) -> str:
    try:
        return str(path.relative_to(root))
    except ValueError:
        return str(path)

def executable_files(directory: Path, prefix=None):
    results = []
    if not directory.exists():
        return results
    for p in sorted(directory.iterdir()):
        if p.is_file() and is_executable(p):
            if prefix is None or p.name.startswith(prefix):
                results.append({
                    "name": p.name,
                    "path": str(p),
                    "relative_path": rel(p)
                })
    return results

def files(directory: Path):
    results = []
    if not directory.exists():
        return results
    for p in sorted(directory.iterdir()):
        if p.is_file():
            results.append({
                "name": p.name,
                "path": str(p),
                "relative_path": rel(p),
                "executable": is_executable(p)
            })
    return results

def dirs(directory: Path):
    results = []
    if not directory.exists():
        return results
    for p in sorted(directory.iterdir()):
        if p.is_dir():
            results.append({
                "name": p.name,
                "path": str(p),
                "relative_path": rel(p)
            })
    return results

def git_repositories(base: Path):
    results = []
    if not base.exists():
        return results

    # Keep shallow and safe: do not traverse hidden/runtime-heavy dirs deeply.
    skip = {
        ".git", "logs", "data", "tmp", "secrets", "backups",
        "node_modules", ".venv", "__pycache__"
    }

    for current, subdirs, _files in os.walk(base):
        current_path = Path(current)

        subdirs[:] = [
            d for d in subdirs
            if d not in skip and not d.startswith(".cache")
        ]

        if (current_path / ".git").is_dir():
            results.append({
                "name": current_path.name,
                "path": str(current_path),
                "relative_path": rel(current_path)
            })
            subdirs[:] = []

    return sorted(results, key=lambda x: x["path"])

def secret_references(directory: Path):
    results = []
    if not directory.exists():
        return results

    for p in sorted(directory.iterdir()):
        if p.is_file():
            results.append({
                "name": p.name,
                "path": str(p),
                "relative_path": rel(p),
                "content_recorded": False,
                "policy": "reference_only"
            })
    return results

inventory = {
    "generated": True,
    "generated_at": iso_now(),
    "policy": {
        "source": "runtime discovery",
        "authority": "generated cache only",
        "secrets": "references only",
        "thought_content": "never stored",
        "raw_private_content": "excluded"
    },
    "commands": executable_files(root / "bin", "wl-"),
    "core_scripts": files(root / "core"),
    "repositories": git_repositories(root),
    "services": dirs(root / "services"),
    "zones": dirs(root / "zones"),
    "logs": dirs(root / "logs"),
    "data_paths": dirs(root / "data"),
    "tools": dirs(root / "tools"),
    "intelligence": dirs(root / "intelligence"),
    "secret_references": secret_references(root / "secrets")
}

registry["runtime_inventory"] = inventory
registry["runtime_inventory_generated_at"] = inventory["generated_at"]

registry_path.write_text(json.dumps(registry, indent=2) + "\n", encoding="utf-8")

print(f"[OK] Runtime inventory generated: {registry_path}")
print(f"[OK] Commands: {len(inventory['commands'])}")
print(f"[OK] Core scripts: {len(inventory['core_scripts'])}")
print(f"[OK] Repositories: {len(inventory['repositories'])}")
print(f"[OK] Services: {len(inventory['services'])}")
print(f"[OK] Secret references: {len(inventory['secret_references'])}")
PY

  log "runtime inventory generated"
}

case "${1:-help}" in
  status) status ;;
  doctor) doctor ;;
  show) show ;;
  get) shift; get "$@" ;;
  inventory) inventory ;;
  help|-h|--help)
    cat <<USAGE
Usage: wl-registry <command>

Commands:
  status        Show registry summary
  doctor        Validate generated registry
  inventory     Generate runtime inventory into .wl-registry
  show          Print registry JSON
  get <key>     Read dotted key, example: runtime.container_runtime

Registry is generated from Governance.md.
Runtime inventory is generated cache/state.
Do not edit .wl-registry manually.
USAGE
    ;;
  *)
    echo "[FAIL] Unknown command: $1"
    exit 1
    ;;
esac
