#!/usr/bin/env bash
set -euo pipefail

echo
echo "Wonderland Runtime Verification"
echo

if ! command -v nerdctl >/dev/null 2>&1; then
  echo "FAIL    nerdctl not found"
  exit 1
fi

echo "OK      nerdctl"

if ! nerdctl ps >/dev/null 2>&1; then
  echo "FAIL    nerdctl ps failed"
  exit 1
fi

echo "OK      nerdctl ps"

if [[ -f "/Users/wonderland/Wonderland/vault/06-Services/runtime/runtime.json" ]]; then
  python3 -m json.tool /Users/wonderland/Wonderland/vault/06-Services/runtime/runtime.json >/dev/null
  echo "OK      runtime.json"
else
  echo "FAIL    runtime.json missing"
  exit 1
fi

echo
echo "RESULT  PASS"
