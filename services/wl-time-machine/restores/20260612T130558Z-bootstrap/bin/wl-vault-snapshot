#!/usr/bin/env bash
set -euo pipefail

ROOT="/Users/wonderland/Wonderland"
VAULT="$ROOT/vault"
SNAPSHOT_DIR="$VAULT/snapshots"
STAMP="$(date +%Y%m%d-%H%M%S)"
OUT="$SNAPSHOT_DIR/vault-snapshot-$STAMP.tar.gz"
SUM="$OUT.sha256"

mkdir -p "$SNAPSHOT_DIR"

"$ROOT/bin/wl" verify

tar \
  --exclude="./snapshots" \
  --exclude="./reports" \
  -czf "$OUT" \
  -C "$VAULT" .

shasum -a 256 "$OUT" > "$SUM"

echo "snapshot: $OUT"
echo "checksum: $SUM"
