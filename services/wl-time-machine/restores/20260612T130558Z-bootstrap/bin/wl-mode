#!/usr/bin/env bash
set -euo pipefail

MODE_FILE="/Users/wonderland/Wonderland/vault/07-Operations/platform/runtime-mode.json"

case "${1:-status}" in
  full|light)
    python3 - <<PY
import json
from pathlib import Path

p = Path("$MODE_FILE")
d = json.loads(p.read_text())
d["mode"] = "${1}"
p.write_text(json.dumps(d, indent=2) + "\n")
PY
    echo "PASS runtime mode: $1"
  ;;

  status)
    python3 - <<PY
import json
from pathlib import Path
d = json.loads(Path("$MODE_FILE").read_text())
print(d["mode"])
PY
  ;;

  *)
    echo "Usage: wl mode full|light|status"
    exit 1
  ;;
esac
