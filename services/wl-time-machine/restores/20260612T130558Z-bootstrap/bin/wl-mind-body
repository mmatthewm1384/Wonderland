#!/usr/bin/env bash
set -euo pipefail

WL_HOME="${WL_HOME:-$HOME/Wonderland}"
WL_DATA="${WL_DATA:-$WL_HOME/data}"

MB_HOME="$WL_HOME/99-meta/mind-body-time-travel"
MB_PORTALS="$MB_HOME/portals"
MB_SESSIONS="$MB_HOME/sessions"
MB_CURRENT="$WL_HOME/runtime/mind-body-time-travel/current"
MB_NEXT="$WL_HOME/04-knowledge/next-testament/mind-body-time-travel"
MB_VAULT="$WL_HOME/04-knowledge/vault/Mind Body Time Travel"

mkdir -p "$MB_PORTALS" "$MB_SESSIONS" "$MB_NEXT" "$MB_VAULT/Portals" "$MB_VAULT/Sessions" "$MB_VAULT/Future Self" "$MB_VAULT/Body Maps" "$(dirname "$MB_CURRENT")"

usage() {
  cat <<'EOF'
wl-mind-body

Mind + Body Time Travel for Wonderland-v4.

Usage:
  wl-mind-body init
  wl-mind-body portal past|present|future <name> [note]
  wl-mind-body session
  wl-mind-body list
  wl-mind-body visit <portal-id>
  wl-mind-body where
  wl-mind-body return
  wl-mind-body app
  wl-mind-body verify

Examples:
  wl-mind-body portal future "Calm Strong Operator" "6-month future self"
  wl-mind-body session
  wl-mind-body visit 20260606-090000-future-calm-strong-operator
EOF
}

slugify() {
  printf "%s" "$1" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//'
}

now_id() {
  date +"%Y%m%d-%H%M%S"
}

init() {
  mkdir -p "$MB_PORTALS" "$MB_SESSIONS" "$MB_NEXT" "$MB_VAULT/Portals" "$MB_VAULT/Sessions" "$MB_VAULT/Future Self" "$MB_VAULT/Body Maps"

  cat > "$MB_NEXT/README.md" <<'MD'
# Mind + Body Time Travel

This is the system of moving through personal time:

- Past: memory, integration, lessons
- Present: body state, nervous system, attention
- Future: identity design, embodiment, practice

This is not medical care and does not replace professional support.
MD

  cat > "$MB_VAULT/README.md" <<'MD'
# Mind + Body Time Travel

Use this Obsidian space to track portals, sessions, body maps, and future-self work.

## Portal Types

- Past
- Present
- Future

## Session Pattern

Notice → Name → Breathe → Choose → Act → Record
MD

  cat > "$WL_HOME/03-governance/wellbeing/mind-body-safety.md" <<'MD'
# Mind + Body Safety

This system supports reflection, journaling, and self-regulation. It is not diagnosis, treatment, or emergency care.

If a practice increases distress, stop and return to a grounding action:

- look around the room
- name five visible objects
- feel feet on the floor
- take slow comfortable breaths
- contact a trusted person or professional support if needed
MD

  echo "Mind + Body Time Travel initialized."
}

portal() {
  local era="${1:-}"
  local name="${2:-}"
  local note="${3:-}"

  case "$era" in
    past|present|future) ;;
    *) echo "ERROR: era must be past, present, or future"; exit 2 ;;
  esac

  test -n "$name" || { echo "ERROR: portal name required"; exit 2; }

  local ts slug id dest md
  ts="$(now_id)"
  slug="$(slugify "$era-$name")"
  id="$ts-$slug"
  dest="$MB_PORTALS/$id"
  md="$MB_VAULT/Portals/$id.md"

  mkdir -p "$dest"

  cat > "$dest/portal.json" <<JSON
{
  "id": "$id",
  "era": "$era",
  "name": "$name",
  "note": "$note",
  "created_at": "$(date -Iseconds)",
  "type": "mind-body-time-portal",
  "safety": "reflective_self_regulation_not_medical_treatment"
}
JSON

  cat > "$md" <<MD
# Portal: $name

- ID: $id
- Era: $era
- Created: $(date -Iseconds)
- Note: $note

## Entering This Time

What does this time-space feel like?

## Mind

What thoughts, beliefs, memories, or expectations belong here?

## Body

Where do you feel this in the body?

- Head:
- Chest:
- Gut:
- Hands:
- Legs:
- Breath:
- Energy:

## Message From This Time

What does this version of you want to say?

## Action

What is one grounded action to take now?

## Visit

\`\`\`bash
wl-mind-body visit $id
\`\`\`
MD

  cp "$md" "$MB_NEXT/$id.md"

  echo "$id" > "$MB_HOME/latest"
  echo "Mind + Body portal created: $id"
}

session() {
  local ts id md
  ts="$(now_id)"
  id="$ts-session"
  md="$MB_VAULT/Sessions/$id.md"

  mkdir -p "$MB_SESSIONS"

  cat > "$MB_SESSIONS/$id.json" <<JSON
{
  "id": "$id",
  "created_at": "$(date -Iseconds)",
  "type": "mind-body-session"
}
JSON

  cat > "$md" <<MD
# Mind + Body Session: $ts

## 1. Notice

What is present right now?

## 2. Name

Emotion:
Body sensation:
Thought loop:
Need:

## 3. Breathe

Comfortable breath count:
Pace:
What changed?

## 4. Choose

What time are you visiting?

- Past
- Present
- Future

## 5. Act

One small action:

## 6. Record

What should future you remember?

## Completion

I returned to present time with one grounded action.
MD

  echo "Session created:"
  echo "$md"
}

list() {
  if ! find "$MB_PORTALS" -mindepth 1 -maxdepth 1 -type d | grep -q .; then
    echo "No mind-body portals yet."
    return 0
  fi

  find "$MB_PORTALS" -mindepth 1 -maxdepth 1 -type d | sort | while read -r d; do
    id="$(basename "$d")"
    python3 - "$d/portal.json" <<'PY' 2>/dev/null || echo "$id"
import json, sys
p=json.load(open(sys.argv[1]))
print(f'{p.get("id")} | {p.get("era")} | {p.get("name")}')
PY
  done
}

visit() {
  local id="${1:-}"
  test -n "$id" || { echo "ERROR: portal id required"; exit 2; }

  local src="$MB_PORTALS/$id/portal.json"
  test -f "$src" || { echo "ERROR: portal not found: $id"; exit 1; }

  ln -sfn "$MB_PORTALS/$id" "$MB_CURRENT"

  local era name
  era="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("era",""))' "$src")"
  name="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("name",""))' "$src")"

  cat <<EOF
Entered mind-body time-space:

$id
Era: $era
Name: $name

Open the Obsidian portal note:

$MB_VAULT/Portals/$id.md

Suggested transition:
1. Pause.
2. Feel feet on the floor.
3. Take three comfortable breaths.
4. Read the portal note.
5. Choose one action from that time-space.
EOF
}

where() {
  if test -L "$MB_CURRENT"; then
    echo "Current mind-body time-space:"
    readlink "$MB_CURRENT"
  else
    echo "Present body. Present mind."
  fi
}

return_home() {
  rm -f "$MB_CURRENT"
  cat <<'EOF'
Returned to present mind and body.

Grounding:
- look around
- feel your feet
- unclench jaw and hands
- choose the next small action
EOF
}

verify() {
  echo "Mind + Body Time Travel Verify"
  echo "=============================="
  test -d "$WL_HOME" && echo "WL_HOME: OK" || echo "WL_HOME: FAIL"
  test -d "$MB_PORTALS" && echo "portals: OK" || echo "portals: FAIL"
  test -d "$MB_SESSIONS" && echo "sessions: OK" || echo "sessions: FAIL"
  test -d "$MB_NEXT" && echo "next testament: OK" || echo "next testament: FAIL"
  test -d "$MB_VAULT" && echo "obsidian: OK" || echo "obsidian: FAIL"
}

app() {
  python3 "$WL_HOME/apps/wl-mind-body-time-travel/app.py"
}

case "${1:-help}" in
  init) init ;;
  portal) shift; portal "$@" ;;
  session) session ;;
  list|portals) list ;;
  visit|jump) shift; visit "$@" ;;
  where) where ;;
  return|leave) return_home ;;
  verify) verify ;;
  app) app ;;
  *) usage ;;
esac
