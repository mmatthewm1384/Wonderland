#!/usr/bin/env bash
set -euo pipefail

WL_HOME="${WL_HOME:-$HOME/Wonderland}"
WL_DATA="${WL_DATA:-$WL_HOME/data}"
WL_MIRROR="${WL_MIRROR:-/Volumes/T7_Wonderland}"
COMPOSE="$WL_HOME/docker/compose.yml"

need_cmd() { command -v "$1" >/dev/null 2>&1; }

compose() {
  if ! need_cmd nerdctl; then
    echo "ERROR: nerdctl missing." >&2
    exit 127
  fi
  nerdctl compose -f "$COMPOSE" "$@"
}

status() {
  echo "Wonderland-v4 GA+"
  echo "WL_HOME=$WL_HOME"
  echo "WL_DATA=$WL_DATA"
  echo "WL_MIRROR=$WL_MIRROR"
  echo
  test -d "$WL_HOME" && echo "home: OK" || echo "home: FAIL"
  test -d "$WL_DATA" && echo "data: OK" || echo "data: FAIL"
  test -d "$WL_MIRROR" && echo "mirror: available" || echo "mirror: unavailable"
  echo
  if need_cmd nerdctl; then
    nerdctl ps --format 'table {{.Names}}\t{{.Status}}\t{{.Ports}}' || true
  else
    echo "nerdctl: missing"
  fi
}

dns_test() {
  if need_cmd dig; then
    if dig @127.0.0.1 -p 1053 grafana.wl +short | grep -q .; then
      echo "dns: OK grafana.wl"
      return 0
    fi
    echo "dns: FAIL grafana.wl"
    return 1
  fi
  echo "dns: SKIP dig missing"
}

doctor() {
  local fail=0
  echo "Wonderland-v4 GA+ Doctor"
  echo "=========================="
  for c in nerdctl curl rsync; do
    if need_cmd "$c"; then echo "$c: OK"; else echo "$c: MISSING"; fail=1; fi
  done
  if need_cmd dig; then echo "dig: OK"; else echo "dig: optional/missing"; fi
  test -d "$WL_HOME" && echo "WL_HOME: OK" || { echo "WL_HOME: FAIL"; fail=1; }
  test -d "$WL_DATA" && echo "WL_DATA: OK" || { echo "WL_DATA: FAIL"; fail=1; }
  test -f "$COMPOSE" && echo "compose: OK" || { echo "compose: FAIL"; fail=1; }

  echo
  echo "Governance:"
  test -f "$WL_HOME/03-governance/constitution/wonderland-charter.md" && echo "charter: OK" || { echo "charter: FAIL"; fail=1; }
  test -f "$WL_HOME/03-governance/security/encryption-standard.md" && echo "security standards: OK" || { echo "security standards: FAIL"; fail=1; }

  echo
  echo "Knowledge:"
  test -d "$WL_HOME/04-knowledge/vault/Next Testament" && echo "obsidian vault: OK" || { echo "obsidian vault: FAIL"; fail=1; }
  test -f "$WL_HOME/04-knowledge/next-testament/genesis/0001-genesis.md" && echo "next testament: OK" || { echo "next testament: FAIL"; fail=1; }

  echo
  echo "DNS:"
  dns_test || fail=1

  echo
  echo "HTTP health:"
  curl -fsS http://127.0.0.1:9090/-/healthy >/dev/null && echo "prometheus: OK" || echo "prometheus: unavailable"
  curl -fsS http://127.0.0.1:3000/api/health >/dev/null && echo "grafana: OK" || echo "grafana: unavailable"
  curl -fsS http://127.0.0.1:8222/healthz >/dev/null && echo "nats: OK" || echo "nats: unavailable"

  return "$fail"
}

mirror_once() {
  if ! test -d "$WL_MIRROR"; then
    echo "ERROR: mirror unavailable: $WL_MIRROR" >&2
    return 1
  fi
  mkdir -p "$WL_MIRROR"/{knowledge,media,archive,backups,snapshots,vaults}
  for d in knowledge media archive backups snapshots vaults; do
    mkdir -p "$WL_DATA/$d"
    rsync -a --delete "$WL_DATA/$d/" "$WL_MIRROR/$d/"
  done
  echo "mirror complete"
}

snapshot() {
  local ts
  ts="$(date +%Y%m%d-%H%M%S)"
  mkdir -p "$WL_DATA/snapshots/$ts" "$WL_HOME/99-meta/timeline/snapshots"
  {
    echo "# Snapshot $ts"
    echo
    echo "WL_HOME=$WL_HOME"
    echo "WL_DATA=$WL_DATA"
    echo
    if need_cmd nerdctl; then nerdctl ps || true; fi
  } > "$WL_DATA/snapshots/$ts/runtime.md"
  cp "$WL_DATA/snapshots/$ts/runtime.md" "$WL_HOME/99-meta/timeline/snapshots/$ts.md"
  echo "snapshot: $WL_DATA/snapshots/$ts"
}

timeline_add() {
  mkdir -p "$WL_HOME/99-meta/timeline/events"
  local ts
  ts="$(date +%Y%m%d-%H%M%S)"
  echo "# $ts" > "$WL_HOME/99-meta/timeline/events/$ts.md"
  echo >> "$WL_HOME/99-meta/timeline/events/$ts.md"
  echo "${*:-event}" >> "$WL_HOME/99-meta/timeline/events/$ts.md"
  echo "timeline event written: $ts"
}

security_doctor() {
  echo "Security doctor"
  for c in age sops exiftool rg; do
    if need_cmd "$c"; then echo "$c: OK"; else echo "$c: optional/missing"; fi
  done
  echo
  echo "Standards:"
  for f in encryption-standard.md anonymization-standard.md data-classification.md key-management.md; do
    test -f "$WL_HOME/03-governance/security/$f" && echo "$f: OK" || echo "$f: missing"
  done
}

vm_list() {
  cat <<'EOF'
Wonderland VM Plane
wl-citadel   secure enclave
wl-build     clean builder
wl-lab       disposable sandbox
wl-recovery  restore environment
EOF
}

graph_status() {
  echo "Knowledge graph files:"
  ls -1 "$WL_HOME/04-knowledge/graph" 2>/dev/null || true
}

case "${1:-help}" in
  status) status ;;
  doctor) doctor ;;
  start) compose up -d; timeline_add "runtime started" ;;
  stop) snapshot; compose down; timeline_add "runtime stopped" ;;
  restart) compose down; compose up -d; timeline_add "runtime restarted" ;;
  logs) compose logs -f "${2:-}" ;;
  dns)
    case "${2:-status}" in
      status) nerdctl ps --format 'table {{.Names}}\t{{.Status}}\t{{.Ports}}' | grep -E 'wl-dns|NAMES' || true ;;
      test|doctor) dns_test ;;
      logs) nerdctl logs wl-dns ;;
      *) echo "usage: wl dns status|test|doctor|logs"; exit 2 ;;
    esac
    ;;
  security)
    case "${2:-doctor}" in doctor) security_doctor ;; *) echo "usage: wl security doctor"; exit 2 ;; esac
    ;;
  mirror)
    case "${2:-once}" in once) mirror_once ;; *) echo "usage: wl mirror once"; exit 2 ;; esac
    ;;
  snapshot) snapshot ;;
  timeline)
    case "${2:-add}" in add) shift 2; timeline_add "$@" ;; *) echo "usage: wl timeline add <message>"; exit 2 ;; esac
    ;;
  vm)
    case "${2:-list}" in list) vm_list ;; *) echo "usage: wl vm list"; exit 2 ;; esac
    ;;
  graph) graph_status ;;
  chats)
    find "$WL_HOME/01-architect/chatgpt/prompts" -type f -maxdepth 1 -print 2>/dev/null | sed 's#^.*/##;s#.md$##'
    ;;
  help|*)
    cat <<'EOF'
Wonderland-v4 GA+

Usage:
  wl status
  wl doctor
  wl start
  wl stop
  wl restart
  wl logs [service]
  wl dns status|test|doctor|logs
  wl security doctor
  wl mirror once
  wl snapshot
  wl timeline add <message>
  wl vm list
  wl graph
  wl chats
EOF
    ;;
esac
