{
  "id": "wl-torrent-vpn-service-v4",
  "name": "wl-torrent-vpn",
  "status": "active",
  "version": 4,
  "runtime": "containerd",
  "engine": "nerdctl",
  "container": "wl-torrent-vpn",
  "compose": "services/torrent/compose.yml",
  "verify": "nerdctl ps --filter name=wl-torrent-vpn --format '{{.Names}}' | grep -qx wl-torrent-vpn",
  "recover": "wl torrent repair",
  "rollback": "wl torrent down",
  "dependencies": [],
  "ports": [
    "9091"
  ],
  "volumes": [
    "vault/secrets/vpn.env",
    "vault/data/torrents"
  ]
}
