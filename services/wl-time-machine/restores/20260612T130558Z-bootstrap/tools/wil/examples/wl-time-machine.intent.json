{
  "kind": "intent",
  "id": "promote-wl-time-machine",
  "version": 0,
  "target": {
    "artifact": "wl-time-machine"
  },
  "desired_state": {
    "status": "active",
    "health": "passing"
  },
  "requires": [
    {
      "artifact": "wl-governor"
    },
    {
      "artifact": "wl-recovery"
    }
  ],
  "verify": [
    {
      "name": "service-files-exist",
      "command": "test -d services/wl-time-machine"
    },
    {
      "name": "cli-exists",
      "command": "test -x bin/wl-time-machine"
    }
  ],
  "recovery": [
    {
      "name": "restore-last-snapshot",
      "command": "bin/wl-recovery restore latest"
    }
  ],
  "rollback": [
    {
      "name": "git-revert",
      "command": "git revert --no-edit HEAD"
    }
  ],
  "consequences": {
    "storage_mb": 50,
    "services_added": 1,
    "maintenance_level": "medium"
  },
  "risks": [
    {
      "id": "service-drift",
      "severity": "medium",
      "mitigation": "governor-verification"
    }
  ]
}
