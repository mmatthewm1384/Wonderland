name: wonderland-v4-ga-plus

services:
  wl-dns:
    image: coredns/coredns:1.11.3
    container_name: wl-dns
    command: ["-conf", "/etc/coredns/Corefile"]
    ports:
      - "1053:53/udp"
      - "1053:53/tcp"
    volumes:
      - ./wl-dns/config/Corefile:/etc/coredns/Corefile:ro
      - ./wl-dns/config/wl.zone:/etc/coredns/wl.zone:ro
    restart: unless-stopped

  wl-nats:
    image: nats:2.10
    container_name: wl-nats
    command: ["-js", "-m", "8222"]
    ports:
      - "4222:4222"
      - "8222:8222"
    restart: unless-stopped

  wl-prometheus:
    image: prom/prometheus:v2.54.1
    container_name: wl-prometheus
    ports:
      - "9090:9090"
    volumes:
      - ./wl-prometheus/config/prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - wl-prometheus-data:/prometheus
    restart: unless-stopped

  wl-loki:
    image: grafana/loki:3.1.1
    container_name: wl-loki
    command: ["-config.file=/etc/loki/local-config.yaml"]
    ports:
      - "3100:3100"
    volumes:
      - ./wl-loki/config/local-config.yaml:/etc/loki/local-config.yaml:ro
      - wl-loki-data:/loki
    restart: unless-stopped

  wl-grafana:
    image: grafana/grafana:11.1.4
    container_name: wl-grafana
    ports:
      - "3000:3000"
    environment:
      GF_SECURITY_ADMIN_USER: admin
      GF_SECURITY_ADMIN_PASSWORD: wonderland
      GF_USERS_ALLOW_SIGN_UP: "false"
    volumes:
      - wl-grafana-data:/var/lib/grafana
      - ./wl-grafana/provisioning:/etc/grafana/provisioning:ro
      - ./wl-grafana/dashboards:/var/lib/grafana/dashboards:ro
    restart: unless-stopped

volumes:
  wl-prometheus-data:
    name: wl-prometheus-data
  wl-loki-data:
    name: wl-loki-data
  wl-grafana-data:
    name: wl-grafana-data
