#!/usr/bin/env sh
set -eu

ROOT="${WONDERLAND_ROOT:-$HOME/Wonderland}"
FAILED=0

check_dir() {
  if [ -d "$1" ]; then
    echo "OK   $1"
  else
    echo "MISS $1"
    FAILED=1
  fi
}

echo "Wonderland status"
echo "Root: $ROOT"

check_dir "$ROOT"
check_dir "$ROOT/vault"
check_dir "$ROOT/repos"
check_dir "$ROOT/data"
check_dir "$ROOT/backups"
check_dir "$ROOT/exports"
check_dir "$ROOT/logs"
check_dir "$ROOT/secrets"
check_dir "$ROOT/tmp"
check_dir "$ROOT/tools"

if command -v git >/dev/null 2>&1; then
  echo "OK   git"
else
  echo "MISS git"
  FAILED=1
fi

if command -v docker >/dev/null 2>&1; then
  echo "OK   docker"
elif command -v nerdctl >/dev/null 2>&1; then
  echo "OK   nerdctl"
else
  echo "WARN no container runtime found"
fi

exit "$FAILED"
