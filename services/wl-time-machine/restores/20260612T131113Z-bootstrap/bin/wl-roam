#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
SVC="$ROOT/services/wl-roam"
CFG="$SVC/config"
STATE="$SVC/state"
POLICY="$CFG/roam-policy.json"

mkdir -p "$CFG" "$STATE" "$SVC/queue/outbound" "$SVC/queue/done" "$SVC/logs"

verify() {
  echo "Verifying wl-roam..."
  result="PASS"

  [ -x "$ROOT/bin/wl-roam" ] && echo "PASS executable" || { echo "FAIL executable"; result="FAIL"; }
  [ -d "$SVC/config" ] && echo "PASS config-dir" || { echo "FAIL config-dir"; result="FAIL"; }
  [ -d "$SVC/state" ] && echo "PASS state-dir" || { echo "FAIL state-dir"; result="FAIL"; }
  [ -d "$SVC/queue/outbound" ] && echo "PASS queue-outbound" || { echo "FAIL queue-outbound"; result="FAIL"; }
  [ -f "$POLICY" ] && echo "PASS policy" || { echo "FAIL policy"; result="FAIL"; }

  if command -v jq >/dev/null 2>&1 && [ -f "$POLICY" ]; then
    jq -e '.mode=="authorized-only"
      and (.forbidden_behaviors | index("crack"))
      and (.forbidden_behaviors | index("harvest"))
      and (.forbidden_behaviors | index("spoof"))
      and (.forbidden_behaviors | index("bypass"))
      and (.forbidden_behaviors | index("join_without_authorization"))' "$POLICY" >/dev/null \
      && echo "PASS governance-boundary" \
      || { echo "FAIL governance-boundary"; result="FAIL"; }
  else
    echo "WARN jq-or-policy-missing"
  fi

  echo "RESULT $result"
}

status() {
  echo "Wonderland Roam"
  echo
  echo "Mode:            authorized-only"
  echo "Policy:          $POLICY"
  echo "Overlay:         optional"
  echo
  echo "RESULT PASS"
}

doctor() {
  echo "Wonderland Roam Doctor"
  echo
  verify
}

net_status() {
  echo "Wonderland Roam Network"
  echo

  dev="$(networksetup -listallhardwareports 2>/dev/null | awk '/Wi-Fi|AirPort/{getline; print $2; exit}')"
  ssid="NONE"
  if [ -n "${dev:-}" ]; then
    ssid="$(networksetup -getairportnetwork "$dev" 2>/dev/null | sed 's/^Current Wi-Fi Network: //' | sed 's/^You are not associated with an AirPort network.*/NONE/')"
  fi

  gw="$(route -n get default 2>/dev/null | awk '/gateway:/{print $2; exit}' || true)"
  dns="$(scutil --dns 2>/dev/null | awk '/nameserver\[[0-9]+\]/{print $3}' | sort -u | paste -sd, - || true)"

  echo "SSID:            ${ssid:-NONE}"
  echo "Interface:       ${dev:-UNKNOWN}"
  echo "Gateway:         ${gw:-UNKNOWN}"
  echo "DNS:             ${dns:-UNKNOWN}"
  echo "Overlay:         skipped"
  echo
  echo "RESULT PASS"
}

case "${1:-status}" in
  verify) verify ;;
  status) status ;;
  doctor) doctor ;;
  net-status|network) net_status ;;
  *) echo "usage: wl-roam status|doctor|verify|net-status" ;;
esac
