#!/usr/bin/env bash
set -euo pipefail

WL_ROOT="${WONDERLAND_ROOT:-$HOME/Wonderland}"
GRAPH_DIR="$WL_ROOT/vault/07-Operations/platform"
GRAPH_FILE="$GRAPH_DIR/universe-graph.json"

usage() {
  cat <<'USAGE'
Usage:
  wl universe graph
  wl universe graph --json
  wl universe graph --doctor
USAGE
}

write_graph() {
  mkdir -p "$GRAPH_DIR"

  python3 - "$GRAPH_FILE" <<'PY'
import json
import pathlib
import sys
from datetime import datetime, timezone

graph_file = pathlib.Path(sys.argv[1])

graph = {
    "id": "wl-universe-graph-v1",
    "generated": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
    "root": str(pathlib.Path.home() / "Wonderland"),
    "nodes": [
        {"id": "universe", "type": "authority", "label": "Universe Authority"},

        {"id": "mode", "type": "authority", "label": "Runtime Mode"},
        {"id": "storage", "type": "authority", "label": "Storage Authority"},
        {"id": "governance", "type": "authority", "label": "Governance"},
        {"id": "recovery", "type": "authority", "label": "Recovery"},
        {"id": "snapshot", "type": "authority", "label": "Snapshots"},

        {"id": "runtime", "type": "group", "label": "Runtime"},
        {"id": "dns", "type": "service", "label": "DNS"},
        {"id": "nats", "type": "service", "label": "NATS"},
        {"id": "observability", "type": "service", "label": "Observability"},

        {"id": "capability", "type": "group", "label": "Capabilities"},
        {"id": "media", "type": "capability", "label": "Media"},
        {"id": "torrent", "type": "capability", "label": "Torrent"},
        {"id": "music", "type": "capability", "label": "Music Authority"},
        {"id": "seed", "type": "service", "label": "Seed Service"},
    ],
    "edges": [
        {"from": "universe", "to": "mode", "relation": "requires"},
        {"from": "universe", "to": "storage", "relation": "requires"},
        {"from": "universe", "to": "governance", "relation": "requires"},
        {"from": "universe", "to": "runtime", "relation": "requires"},
        {"from": "universe", "to": "capability", "relation": "requires"},

        {"from": "governance", "to": "recovery", "relation": "requires"},
        {"from": "recovery", "to": "snapshot", "relation": "requires"},

        {"from": "runtime", "to": "dns", "relation": "contains"},
        {"from": "runtime", "to": "nats", "relation": "contains"},
        {"from": "runtime", "to": "observability", "relation": "contains"},

        {"from": "capability", "to": "media", "relation": "contains"},
        {"from": "capability", "to": "torrent", "relation": "contains"},
        {"from": "capability", "to": "music", "relation": "contains"},
        {"from": "capability", "to": "seed", "relation": "contains"},

        {"from": "storage", "to": "media", "relation": "backs"},
        {"from": "storage", "to": "torrent", "relation": "backs"},
        {"from": "storage", "to": "music", "relation": "backs"},

        {"from": "nats", "to": "observability", "relation": "feeds"},
        {"from": "dns", "to": "observability", "relation": "feeds"},
    ],
}

graph_file.write_text(json.dumps(graph, indent=2) + "\n")
print(graph_file)
PY
}

doctor() {
  write_graph >/dev/null

  python3 - "$GRAPH_FILE" <<'PY'
import json
import pathlib
import sys

path = pathlib.Path(sys.argv[1])

if not path.exists():
    print(f"FAIL missing graph: {path}")
    sys.exit(1)

data = json.loads(path.read_text())

required = {"id", "generated", "nodes", "edges"}
missing = required - set(data)

if missing:
    print(f"FAIL missing fields: {sorted(missing)}")
    sys.exit(1)

node_ids = {node["id"] for node in data["nodes"]}

failures = []

for edge in data["edges"]:
    if edge["from"] not in node_ids:
        failures.append(f"missing edge source: {edge['from']}")
    if edge["to"] not in node_ids:
        failures.append(f"missing edge target: {edge['to']}")

if failures:
    for failure in failures:
        print(f"FAIL {failure}")
    sys.exit(1)

print("PASS universe graph")
print(f"nodes: {len(data['nodes'])}")
print(f"edges: {len(data['edges'])}")
print(f"graph: {path}")
print("RESULT PASS")
PY
}

tree_output() {
  write_graph >/dev/null

  cat <<TREE
Universe
├── mode
├── storage
│   ├── media
│   ├── torrent
│   └── music
├── governance
│   └── recovery
│       └── snapshot
├── runtime
│   ├── dns
│   ├── nats
│   └── observability
└── capability
    ├── media
    ├── torrent
    ├── music
    └── seed

graph: $GRAPH_FILE
TREE
}

case "${1:-}" in
  "")
    tree_output
    ;;
  --json|json)
    write_graph >/dev/null
    cat "$GRAPH_FILE"
    ;;
  --doctor|doctor)
    doctor
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    usage
    exit 1
    ;;
esac
