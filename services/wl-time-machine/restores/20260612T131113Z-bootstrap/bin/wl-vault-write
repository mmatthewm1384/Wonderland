#!/usr/bin/env bash
set -euo pipefail

ROOT="/Users/wonderland/Wonderland"
TARGET="${1:-}"

if [[ -z "$TARGET" ]]; then
  echo "Usage: wl-vault-write <target-path> -- <command...>"
  exit 1
fi

if [[ "${2:-}" != "--" ]]; then
  echo "Usage: wl-vault-write <target-path> -- <command...>"
  exit 1
fi

shift 2

if [[ "$#" -eq 0 ]]; then
  echo "FAIL missing command"
  exit 1
fi

"$ROOT/bin/wl-vault-guard" "$TARGET"

exec "$@"
