#!/usr/bin/env bash
set -euo pipefail

REG="vault/07-Operations/certifications/service-certifications.json"

service="${2:-}"

case "${1:-}" in

  certify)

    [[ -n "$service" ]] || {
      echo "Usage: wl certify certify <service>"
      exit 1
    }

    python3 - <<PY
import json
from pathlib import Path
from datetime import datetime

p = Path("$REG")
data = json.loads(p.read_text())

data["services"].append({
    "service": "$service",
    "certified": datetime.now().isoformat(),
    "status": "certified"
})

p.write_text(json.dumps(data, indent=2) + "\n")
PY

    echo "CERTIFIED $service"
    ;;

  list)
    cat "$REG"
    ;;

  *)
    echo "Usage:"
    echo "  wl certify certify <service>"
    echo "  wl certify list"
    exit 1
    ;;
esac
