#!/usr/bin/env bash
set -euo pipefail

ROOT="/Users/wonderland/Wonderland"
REG="$ROOT/vault/05-Registry"

"$ROOT/bin/wl-registry-refresh-intents" >/dev/null
"$ROOT/bin/wl-registry-refresh-plans" >/dev/null

python3 - "$REG" <<'PY'
import json
import pathlib
import sys

reg = pathlib.Path(sys.argv[1])

def load(name):
    p = reg / name
    if not p.exists():
        return {}
    return json.loads(p.read_text())

intents = load("intents.json").get("intents", [])
plans_payload = load("plans.json")
plans = plans_payload.get("plans", [])
executions = plans_payload.get("executions", [])

print("Wonderland Lifecycle")
print()

print(f"intents:    {len(intents)}")
for x in intents:
    print(f"  {x.get('status','?'):10} {x.get('id')}")

print()
print(f"plans:      {len(plans)}")
for x in plans:
    print(f"  {x.get('status','?'):10} {x.get('id')}")

print()
print(f"executions: {len(executions)}")
for x in executions:
    print(f"  {x.get('status','?'):10} {x.get('id')}")
PY
