#!/usr/bin/env bash
set -euo pipefail

WL_HOME="${WL_HOME:-$HOME/Wonderland}"
WL_DATA="${WL_DATA:-$WL_HOME/data}"

CH_ROOT="$WL_HOME/09-chronosphere"
CH_PORTALS="$CH_ROOT/portals"
CH_IDENTITIES="$CH_ROOT/identities"
CH_PLACES="$CH_ROOT/places"
CH_TIMELINES="$CH_ROOT/timelines"
CH_REALITIES="$CH_ROOT/realities"
CH_SIMULATIONS="$CH_ROOT/simulations"
CH_MEMORIES="$CH_ROOT/memories"
CH_SESSIONS="$CH_ROOT/sessions"
CH_RUNTIME="$WL_HOME/runtime/chronosphere-v2"
CH_CURRENT="$CH_RUNTIME/current"
CH_STATE="$CH_RUNTIME/state.json"
CH_VAULT="$WL_HOME/04-knowledge/vault/Chronosphere-v2"
CH_NEXT="$WL_HOME/04-knowledge/next-testament/chronosphere-v2"

mkdir -p "$CH_PORTALS" "$CH_IDENTITIES" "$CH_PLACES" "$CH_TIMELINES" "$CH_REALITIES" "$CH_SIMULATIONS" "$CH_MEMORIES" "$CH_SESSIONS" "$CH_RUNTIME" "$CH_VAULT/Portals" "$CH_VAULT/Sessions" "$CH_NEXT"

usage() {
  cat <<'EOF'
wl-chrono-v2

Chronosphere v2: Reality Reconstruction Engine.

Usage:
  wl-chrono-v2 init
  wl-chrono-v2 create <portal-id> --time <time> --place <place> --identity <identity> --reality <reality> [--note <note>]
  wl-chrono-v2 list
  wl-chrono-v2 enter <portal-id>
  wl-chrono-v2 status
  wl-chrono-v2 leave
  wl-chrono-v2 session
  wl-chrono-v2 verify

Examples:
  wl-chrono-v2 create future-matthew --time "2035-01-01" --place "Wonderland HQ" --identity "Future Matthew" --reality "Projected"
  wl-chrono-v2 enter future-matthew
  wl-chrono-v2 status
  wl-chrono-v2 leave
EOF
}

slugify() {
  printf "%s" "$1" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//'
}

now_iso() {
  date -Iseconds
}

init() {
  mkdir -p "$CH_PORTALS" "$CH_IDENTITIES" "$CH_PLACES" "$CH_TIMELINES" "$CH_REALITIES" "$CH_SIMULATIONS" "$CH_MEMORIES" "$CH_SESSIONS" "$CH_RUNTIME" "$CH_VAULT/Portals" "$CH_VAULT/Sessions" "$CH_NEXT"

  cat > "$CH_ROOT/README.md" <<'MD'
# Chronosphere v2

Reality Reconstruction Engine.

Portal coordinate:

```text
time + place + identity + reality
```
MD

  cat > "$CH_NEXT/README.md" <<'MD'
# Chronosphere v2

Chronosphere v2 records reconstructed realities, portal entries, sessions, and returns.
MD

  cat > "$CH_VAULT/README.md" <<'MD'
# Chronosphere v2

Obsidian interface for Chronosphere v2.

## Visit Pattern

Enter → Reconstruct → Embody → Act → Record → Return
MD

  cat > "$WL_HOME/03-governance/chronosphere/chronosphere-v2-safety.md" <<'MD'
# Chronosphere v2 Safety

Chronosphere v2 is a contextual simulation and reflection system. It does not provide literal physical time travel, teleportation, medical treatment, or guaranteed personal transformation.

A portal visit must include a return ritual:

1. State the current date.
2. State the current location.
3. Feel feet on the floor.
4. Choose one grounded next action.
MD

  echo "Chronosphere v2 initialized."
}

create() {
  local portal_id="${1:-}"
  shift || true

  test -n "$portal_id" || { echo "ERROR: portal-id required"; exit 2; }

  local time="" place="" identity="" reality="" note=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --time) time="${2:-}"; shift 2 ;;
      --place) place="${2:-}"; shift 2 ;;
      --identity) identity="${2:-}"; shift 2 ;;
      --reality) reality="${2:-}"; shift 2 ;;
      --note) note="${2:-}"; shift 2 ;;
      *) echo "ERROR: unknown argument: $1"; exit 2 ;;
    esac
  done

  test -n "$time" || { echo "ERROR: --time required"; exit 2; }
  test -n "$place" || { echo "ERROR: --place required"; exit 2; }
  test -n "$identity" || { echo "ERROR: --identity required"; exit 2; }
  test -n "$reality" || { echo "ERROR: --reality required"; exit 2; }

  local id
  id="$(slugify "$portal_id")"
  local dest="$CH_PORTALS/$id"
  mkdir -p "$dest"

  cat > "$dest/portal.json" <<JSON
{
  "id": "$id",
  "created_at": "$(now_iso)",
  "coordinate": {
    "time": "$time",
    "place": "$place",
    "identity": "$identity",
    "reality": "$reality"
  },
  "note": "$note",
  "engine": "chronosphere-v2",
  "mode": "reconstructed-reality"
}
JSON

  cat > "$dest/identity.json" <<JSON
{
  "identity": "$identity",
  "beliefs": [],
  "habits": [],
  "goals": [],
  "body_state": "",
  "decision_framework": ""
}
JSON

  cat > "$dest/environment.json" <<JSON
{
  "place": "$place",
  "visual_atmosphere": "",
  "soundscape": "",
  "weather": "",
  "lighting": "",
  "workspace": ""
}
JSON

  cat > "$dest/timeline.json" <<JSON
{
  "time": "$time",
  "events": [],
  "context": [],
  "artifacts": []
}
JSON

  cat > "$dest/reality.json" <<JSON
{
  "reality": "$reality",
  "rules": [],
  "constraints": [],
  "opportunities": []
}
JSON

  cat > "$dest/actions.json" <<JSON
{
  "entry_actions": [
    "Open portal note",
    "Name present date and location",
    "Read coordinate",
    "Choose one action"
  ],
  "return_actions": [
    "State current date",
    "State current location",
    "Record artifact brought back"
  ]
}
JSON

  local md="$CH_VAULT/Portals/$id.md"
  cat > "$md" <<MD
# Chronosphere v2 Portal: $id

## Coordinate

- Time: $time
- Place: $place
- Identity: $identity
- Reality: $reality

## Note

$note

## Arrival

What does this reconstructed reality look like?

## Atmosphere

- Weather:
- Lighting:
- Sound:
- Objects:
- People / Presence:

## Identity Load

What does $identity believe, do, notice, and choose?

## Timeline Context

What belongs to $time?

## Place Context

What belongs to $place?

## Reality Rules

What is possible in $reality?

## Artifact to Bring Back

What should present Matthew bring back?

## One Action

What action should happen in present time?

## Commands

\`\`\`bash
wl-chrono-v2 enter $id
wl-chrono-v2 status
wl-chrono-v2 leave
\`\`\`
MD

  cp "$md" "$CH_NEXT/$id.md"

  mkdir -p "$CH_IDENTITIES/$(slugify "$identity")" "$CH_PLACES/$(slugify "$place")" "$CH_TIMELINES/$(slugify "$time")" "$CH_REALITIES/$(slugify "$reality")"

  echo "$id" > "$CH_ROOT/latest"
  echo "Chronosphere v2 portal created: $id"
  echo "Portal note: $md"
}

list() {
  if ! find "$CH_PORTALS" -mindepth 1 -maxdepth 1 -type d | grep -q .; then
    echo "No Chronosphere v2 portals yet."
    return 0
  fi

  find "$CH_PORTALS" -mindepth 1 -maxdepth 1 -type d | sort | while read -r d; do
    python3 - "$d/portal.json" <<'PY' 2>/dev/null || basename "$d"
import json, sys
p=json.load(open(sys.argv[1]))
c=p.get("coordinate",{})
print(f'{p.get("id")} | time={c.get("time")} | place={c.get("place")} | identity={c.get("identity")} | reality={c.get("reality")}')
PY
  done
}

enter() {
  local id="${1:-}"
  test -n "$id" || { echo "ERROR: portal id required"; exit 2; }

  local src="$CH_PORTALS/$id/portal.json"
  test -f "$src" || { echo "ERROR: portal not found: $id"; exit 1; }

  ln -sfn "$CH_PORTALS/$id" "$CH_CURRENT"

  python3 - "$src" "$CH_STATE" <<'PY'
import json, sys, datetime
portal=json.load(open(sys.argv[1]))
state={
  "active": True,
  "entered_at": datetime.datetime.now().isoformat(),
  "portal": portal
}
json.dump(state, open(sys.argv[2],"w"), indent=2)
PY

  local jump_md="$CH_VAULT/Sessions/$(date +%Y%m%d-%H%M%S)-enter-$id.md"
  python3 - "$src" "$jump_md" <<'PY'
import json, sys, datetime
p=json.load(open(sys.argv[1]))
c=p["coordinate"]
md=f"""# Chronosphere v2 Entry: {p['id']}

Entered: {datetime.datetime.now().isoformat()}

## Coordinate

- Time: {c['time']}
- Place: {c['place']}
- Identity: {c['identity']}
- Reality: {c['reality']}

## Entry Ritual

1. State present date and location.
2. Read portal coordinate.
3. Read portal note.
4. Choose one action to embody.

## Observations

## Artifact Brought Back

## Return

```bash
wl-chrono-v2 leave
```
"""
open(sys.argv[2],"w").write(md)
PY

  python3 - "$src" <<'PY'
import json, sys
p=json.load(open(sys.argv[1]))
c=p["coordinate"]
print("Entered Chronosphere v2 reconstructed reality:")
print()
print(f"Portal:   {p['id']}")
print(f"Time:     {c['time']}")
print(f"Place:    {c['place']}")
print(f"Identity: {c['identity']}")
print(f"Reality:  {c['reality']}")
print()
print("Enter → Reconstruct → Embody → Act → Record → Return")
PY
}

status() {
  if test -f "$CH_STATE"; then
    cat "$CH_STATE"
  else
    echo "Present reality. No active Chronosphere v2 portal."
  fi
}

leave() {
  rm -f "$CH_CURRENT"

  if test -f "$CH_STATE"; then
    python3 - "$CH_STATE" <<'PY'
import json, sys, datetime
s=json.load(open(sys.argv[1]))
s["active"]=False
s["left_at"]=datetime.datetime.now().isoformat()
json.dump(s, open(sys.argv[1],"w"), indent=2)
PY
  fi

  cat <<'EOF'
Returned to present reality.

Return ritual:
1. Say the current date.
2. Say the current location.
3. Feel feet on the floor.
4. Choose the next grounded action.
EOF
}

session() {
  local id
  id="$(date +%Y%m%d-%H%M%S)-session"
  local md="$CH_VAULT/Sessions/$id.md"
  cat > "$md" <<MD
# Chronosphere v2 Session: $id

## Portal

## Coordinate

- Time:
- Place:
- Identity:
- Reality:

## Reconstruction

## Embodiment

## Action

## Artifact Brought Back

## Return Check

- Current date:
- Current location:
- Body state:
- Next action:
MD
  echo "Session created: $md"
}

verify() {
  echo "Chronosphere v2 Verify"
  echo "======================="
  test -d "$WL_HOME" && echo "WL_HOME: OK" || echo "WL_HOME: FAIL"
  test -d "$CH_ROOT" && echo "09-chronosphere: OK" || echo "09-chronosphere: FAIL"
  test -d "$CH_PORTALS" && echo "portals: OK" || echo "portals: FAIL"
  test -d "$CH_IDENTITIES" && echo "identities: OK" || echo "identities: FAIL"
  test -d "$CH_PLACES" && echo "places: OK" || echo "places: FAIL"
  test -d "$CH_TIMELINES" && echo "timelines: OK" || echo "timelines: FAIL"
  test -d "$CH_REALITIES" && echo "realities: OK" || echo "realities: FAIL"
  test -d "$CH_VAULT" && echo "obsidian: OK" || echo "obsidian: FAIL"
  test -d "$CH_NEXT" && echo "next testament: OK" || echo "next testament: FAIL"
  command -v python3 >/dev/null 2>&1 && echo "python3: OK" || echo "python3: FAIL"
}

case "${1:-help}" in
  init) init ;;
  create) shift; create "$@" ;;
  list) list ;;
  enter|visit|open) shift; enter "$@" ;;
  status|where) status ;;
  leave|return|close) leave ;;
  session) session ;;
  verify) verify ;;
  help|*) usage ;;
esac
