#!/usr/bin/env bash
set -euo pipefail

ROOT="${WONDERLAND_ROOT:-$HOME/Wonderland}"
REGISTRY="$ROOT/.wl-registry"
GOV="$ROOT/intelligence/obsidian/00-Core/Governance.md"

ok() { printf "  ✓ %s\n" "$*"; }
warn() { printf "  ⚠ %s\n" "$*"; }
fail() { printf "  ✗ %s\n" "$*"; }

json_get() {
  local key="$1"
  python3 - "$REGISTRY" "$key" <<'PY' 2>/dev/null || true
import json, sys
path, dotted = sys.argv[1], sys.argv[2]

try:
    with open(path, "r", encoding="utf-8") as f:
        data = json.load(f)
except Exception:
    sys.exit(0)

cur = data
for part in dotted.split("."):
    if isinstance(cur, dict) and part in cur:
        cur = cur[part]
    else:
        sys.exit(0)

if isinstance(cur, (dict, list)):
    print(json.dumps(cur))
else:
    print(cur)
PY
}

json_len() {
  local key="$1"
  python3 - "$REGISTRY" "$key" <<'PY' 2>/dev/null || echo "0"
import json, sys
path, dotted = sys.argv[1], sys.argv[2]

try:
    with open(path, "r", encoding="utf-8") as f:
        data = json.load(f)
except Exception:
    print(0)
    sys.exit(0)

cur = data
for part in dotted.split("."):
    if isinstance(cur, dict) and part in cur:
        cur = cur[part]
    else:
        print(0)
        sys.exit(0)

if isinstance(cur, (list, dict)):
    print(len(cur))
else:
    print(0)
PY
}

doctor_state() {
  local cmd="$1"
  if [ -x "$cmd" ]; then
    if "$cmd" doctor >/dev/null 2>&1; then
      echo "healthy"
    else
      echo "unhealthy"
    fi
  else
    echo "missing"
  fi
}

echo "=== Wonderland Status ==="
echo

echo "Root"
echo "  $ROOT"
echo

echo "Authority"
if [ -f "$GOV" ]; then
  ok "Governance hub present"
else
  fail "Governance hub missing"
fi

if [ -f "$REGISTRY" ]; then
  ok "Generated registry present"
else
  fail "Generated registry missing"
fi
echo

echo "Health"
GOV_STATE="$(doctor_state "$ROOT/bin/wl-governance")"
REG_STATE="$(doctor_state "$ROOT/bin/wl-registry")"

case "$GOV_STATE" in
  healthy) ok "Governance healthy" ;;
  unhealthy) fail "Governance unhealthy" ;;
  missing) warn "wl-governance missing" ;;
esac

case "$REG_STATE" in
  healthy) ok "Registry healthy" ;;
  unhealthy) fail "Registry unhealthy" ;;
  missing) warn "wl-registry missing" ;;
esac
echo

echo "Registry"
if [ -f "$REGISTRY" ] && command -v python3 >/dev/null 2>&1; then
  echo "  Generated At: $(json_get generated_at)"
  echo "  Inventory At: $(json_get runtime_inventory.generated_at)"
  echo "  Runtime:      $(json_get runtime.container_runtime)"
  echo "  Operator:     $(json_get operator)"
else
  warn "Registry unavailable"
fi
echo

echo "Inventory"
if [ -f "$REGISTRY" ] && command -v python3 >/dev/null 2>&1; then
  echo "  Commands:     $(json_len runtime_inventory.commands)"
  echo "  Core Scripts: $(json_len runtime_inventory.core_scripts)"
  echo "  Repositories: $(json_len runtime_inventory.repositories)"
  echo "  Services:     $(json_len runtime_inventory.services)"
  echo "  Zones:        $(json_len runtime_inventory.zones)"
  echo "  Logs:         $(json_len runtime_inventory.logs)"
  echo "  Data Paths:   $(json_len runtime_inventory.data_paths)"
  echo "  Tools:        $(json_len runtime_inventory.tools)"
  echo "  Secrets Refs: $(json_len runtime_inventory.secret_references)"
else
  warn "Inventory unavailable"
fi
echo

echo "Security Boundary"
if [ -f "$REGISTRY" ] && command -v python3 >/dev/null 2>&1; then
  echo "  Secrets:      $(json_get security.secrets_policy)"
  echo "  Plaintext:    $(json_get security.plaintext_secrets)"
  echo "  Encryption:   $(json_get encryption.required)"
  echo "  Raw Thought:  $(json_get privacy.thought_content_policy)"
  echo "  Anonymity:    $(json_get anonymity.derived_metadata_only)"
else
  warn "Security metadata unavailable"
fi
echo

echo "Recommended Refresh"
echo "  wl-governance sync"
echo "  wl-registry inventory"
echo "  wl-status"
