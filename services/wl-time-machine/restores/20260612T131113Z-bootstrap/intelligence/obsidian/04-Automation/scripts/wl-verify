#!/usr/bin/env sh
set -eu

ROOT="${WONDERLAND_ROOT:-$HOME/Wonderland}"

echo "Running Wonderland verification..."

if ! command -v wl-status >/dev/null 2>&1; then
  echo "wl-status not found in PATH. Trying local script path."
  SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
  "$SCRIPT_DIR/wl-status"
else
  wl-status
fi

test -d "$ROOT/vault" || exit 4
test -d "$ROOT/repos" || exit 4
test -d "$ROOT/backups" || exit 4

echo "Verification complete."
