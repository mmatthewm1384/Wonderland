#!/usr/bin/env sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
. "$SCRIPT_DIR/../lib/wl-common.sh" 2>/dev/null || . "$HOME/Wonderland/tools/lib/wl-common.sh"

case "${1:-}" in
  --help)
    echo "Usage: wl-export"
    echo "Create an export snapshot of vault governance docs."
    exit 0
    ;;
  --version)
    echo "$WL_VERSION"
    exit 0
    ;;
esac

stamp="$(date +%Y%m%d-%H%M%S)"
dest="$WL_ROOT/exports/wonderland-export-$stamp"
mkdir -p "$dest"

if [ -d "$WL_ROOT/vault" ]; then
  tar -czf "$dest/vault-export.tar.gz" -C "$WL_ROOT" vault
fi

wl_info "Created export at $dest"
