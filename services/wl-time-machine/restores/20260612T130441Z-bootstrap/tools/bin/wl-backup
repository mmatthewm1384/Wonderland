#!/usr/bin/env sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
. "$SCRIPT_DIR/../lib/wl-common.sh" 2>/dev/null || . "$HOME/Wonderland/tools/lib/wl-common.sh"

case "${1:-}" in
  --help)
    echo "Usage: wl-backup"
    echo "Create a baseline timestamped backup directory."
    exit 0
    ;;
  --version)
    echo "$WL_VERSION"
    exit 0
    ;;
esac

stamp="$(date +%Y%m%d-%H%M%S)"
dest="$WL_ROOT/backups/baseline-$stamp"
mkdir -p "$dest"

[ -d "$WL_ROOT/vault" ] && tar -czf "$dest/vault.tar.gz" -C "$WL_ROOT" vault
[ -d "$WL_ROOT/repos" ] && tar -czf "$dest/repos.tar.gz" -C "$WL_ROOT" repos

wl_info "Created baseline backup at $dest"
