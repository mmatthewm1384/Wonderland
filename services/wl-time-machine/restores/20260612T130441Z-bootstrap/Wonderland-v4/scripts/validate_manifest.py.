#!/usr/bin/env python3
import os
import re
from pathlib import Path

def validate_manifest():
    root = Path(os.path.expanduser("~/Wonderland/intelligence/obsidian"))
    manifest = root / "MANIFEST.md"
    
    if not manifest.exists():
        print("CRITICAL: MANIFEST.md not found.")
        return

    print(f"\n[AUDITING ARCHITECTURE AGAINST MANIFEST.md]")
    missing = []
    
    # Parse MANIFEST.md for file paths (ignoring headers/blank lines)
    with open(manifest, 'r') as f:
        for line in f:
            line = line.strip()
            # Regex to find lines that look like file paths (e.g., '00-governance/...')
            if re.match(r'^\d{2}-[\w/-]+\.\w{2,3}$', line):
                file_path = root / line
                if not file_path.exists():
                    print(f"  └── [MISSING] {line}")
                    missing.append(line)
                else:
                    pass # File exists

    if not missing:
        print("STATUS: COMPLETE (All files in MANIFEST.md verified on disk)")
    else:
        print(f"\nSTATUS: INCOMPLETE (Found {len(missing)} missing file(s))")

if __name__ == "__main__":
    validate_manifest()
