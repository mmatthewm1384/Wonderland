#!/usr/bin/env bash
set -euo pipefail

WL_HOME="${WL_HOME:-$HOME/Wonderland}"
WL_DATA="${WL_DATA:-$WL_HOME/data}"

CH_HOME="$WL_HOME/99-meta/chronosphere"
CH_PORTALS="$CH_HOME/portals"
CH_SESSIONS="$CH_HOME/sessions"
CH_JUMPS="$CH_HOME/jumps"
CH_CURRENT="$WL_HOME/runtime/chronosphere/current"
CH_NEXT="$WL_HOME/04-knowledge/next-testament/chronosphere"
CH_VAULT="$WL_HOME/04-knowledge/vault/Chronosphere"

mkdir -p "$CH_PORTALS" "$CH_SESSIONS" "$CH_JUMPS" "$CH_NEXT" "$CH_VAULT"/{Portals,Sessions,Places,Times,Identities,Simulations} "$(dirname "$CH_CURRENT")"

usage() {
  cat <<'EOF'
wl-chronosphere

Visit times, places, identities, memories, and simulated worlds.

Usage:
  wl-chronosphere init
  wl-chronosphere portal time <date-or-era> [note]
  wl-chronosphere portal place <location> [note]
  wl-chronosphere portal identity <identity> [note]
  wl-chronosphere portal world <world> [note]
  wl-chronosphere portal memory <name> [note]
  wl-chronosphere list
  wl-chronosphere visit <portal-id>
  wl-chronosphere where
  wl-chronosphere return
  wl-chronosphere session
  wl-chronosphere app
  wl-chronosphere verify

Examples:
  wl-chronosphere portal time "2024-06-15" "Portland summer"
  wl-chronosphere portal place "Tokyo" "Future trip simulation"
  wl-chronosphere portal identity "Future Matthew" "Calm strong operator"
  wl-chronosphere portal world "Paris 1889" "World's Fair simulation"
EOF
}

slugify() {
  printf "%s" "$1" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//'
}

now_id() {
  date +"%Y%m%d-%H%M%S"
}

init() {
  mkdir -p "$CH_PORTALS" "$CH_SESSIONS" "$CH_JUMPS" "$CH_NEXT" "$CH_VAULT"/{Portals,Sessions,Places,Times,Identities,Simulations}

  cat > "$CH_NEXT/README.md" <<'MD'
# Chronosphere

Chronosphere records Wonderland portals through:

- Time
- Place
- Identity
- Memory
- World simulation

A portal is a navigable symbolic environment. A visit changes the working context, not physical reality.
MD

  cat > "$CH_VAULT/README.md" <<'MD'
# Chronosphere

This Obsidian space contains portals into times, locations, identities, memories, and simulated worlds.

## Portal Types

- Time
- Place
- Identity
- Memory
- World

## Visit Pattern

Enter → Observe → Embody → Record → Return
MD

  cat > "$WL_HOME/03-governance/chronosphere/chronosphere-safety.md" <<'MD'
# Chronosphere Safety

Chronosphere is a reflective simulation system.

It does not create physical time travel, teleportation, medical treatment, or guaranteed emotional effects.

If a visit feels destabilizing:

1. Stop.
2. Return.
3. Look around the room.
4. Feel your feet.
5. Name the present date and location.
6. Choose one grounded action.
MD

  echo "Chronosphere initialized."
}

portal() {
  local kind="${1:-}"
  local name="${2:-}"
  local note="${3:-}"

  case "$kind" in
    time|place|identity|memory|world) ;;
    *) echo "ERROR: portal type must be time, place, identity, memory, or world"; exit 2 ;;
  esac

  test -n "$name" || { echo "ERROR: portal name required"; exit 2; }

  local ts slug id dest md subdir
  ts="$(now_id)"
  slug="$(slugify "$kind-$name")"
  id="$ts-$slug"
  dest="$CH_PORTALS/$id"

  case "$kind" in
    time) subdir="Times" ;;
    place) subdir="Places" ;;
    identity) subdir="Identities" ;;
    memory) subdir="Portals" ;;
    world) subdir="Simulations" ;;
  esac

  mkdir -p "$dest"

  cat > "$dest/portal.json" <<JSON
{
  "id": "$id",
  "kind": "$kind",
  "name": "$name",
  "note": "$note",
  "created_at": "$(date -Iseconds)",
  "type": "chronosphere-portal",
  "mode": "contextual-simulation",
  "wl_home": "$WL_HOME",
  "wl_data": "$WL_DATA"
}
JSON

  md="$CH_VAULT/$subdir/$id.md"

  cat > "$md" <<MD
# Chronosphere Portal: $name

- ID: $id
- Type: $kind
- Created: $(date -Iseconds)
- Note: $note

## Coordinates

Time:
Place:
Identity:
Mood:
Weather:
Sound:
Visual Atmosphere:
Body State:

## Arrival

What do you see?

What do you hear?

What does your body do first?

## Context

What belongs to this time/place/identity/world?

## Objects

List objects, artifacts, tools, symbols, or documents present here.

## People / Presence

Who or what is present?

## Message

What does this portal want you to understand?

## Action

What is one action to bring back into present time?

## Visit

\`\`\`bash
wl-chronosphere visit $id
\`\`\`

## Return

\`\`\`bash
wl-chronosphere return
\`\`\`
MD

  cp "$md" "$CH_NEXT/$id.md"

  mkdir -p "$WL_HOME/99-meta/timeline/events"
  cat > "$WL_HOME/99-meta/timeline/events/$id-chronosphere-portal.md" <<MD
# Chronosphere Portal Created

- ID: $id
- Type: $kind
- Name: $name
- Note: $note
MD

  echo "$id" > "$CH_HOME/latest"
  echo "Chronosphere portal created: $id"
  echo "Note: $md"
}

list() {
  if ! find "$CH_PORTALS" -mindepth 1 -maxdepth 1 -type d | grep -q .; then
    echo "No Chronosphere portals yet."
    return 0
  fi

  find "$CH_PORTALS" -mindepth 1 -maxdepth 1 -type d | sort | while read -r d; do
    python3 - "$d/portal.json" <<'PY' 2>/dev/null || basename "$d"
import json, sys
p=json.load(open(sys.argv[1]))
print(f'{p.get("id")} | {p.get("kind")} | {p.get("name")}')
PY
  done
}

visit() {
  local id="${1:-}"
  test -n "$id" || { echo "ERROR: portal id required"; exit 2; }

  local src="$CH_PORTALS/$id/portal.json"
  test -f "$src" || { echo "ERROR: portal not found: $id"; exit 1; }

  ln -sfn "$CH_PORTALS/$id" "$CH_CURRENT"

  local kind name note
  kind="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("kind",""))' "$src")"
  name="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("name",""))' "$src")"
  note="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("note",""))' "$src")"

  local jump_id
  jump_id="$(now_id)-jump-$id"
  cat > "$CH_JUMPS/$jump_id.json" <<JSON
{
  "jump_id": "$jump_id",
  "portal_id": "$id",
  "kind": "$kind",
  "name": "$name",
  "started_at": "$(date -Iseconds)",
  "mode": "contextual-simulation"
}
JSON

  cat <<EOF
Entered Chronosphere portal:

$id
Type: $kind
Name: $name
Note: $note

Transition:
1. State out loud: "I am entering $name."
2. Name present date and location once.
3. Open the portal note.
4. Read Arrival, Context, and Action.
5. Act as visitor for 10 minutes.
6. Record what you bring back.

Portal files:
$CH_PORTALS/$id

Obsidian:
$CH_VAULT
EOF
}

where() {
  if test -L "$CH_CURRENT"; then
    echo "Current Chronosphere portal:"
    readlink "$CH_CURRENT"
    if test -f "$(readlink "$CH_CURRENT")/portal.json"; then
      cat "$(readlink "$CH_CURRENT")/portal.json"
    fi
  else
    echo "Present time. Present location. Present identity."
  fi
}

return_home() {
  rm -f "$CH_CURRENT"
  cat <<'EOF'
Returned to present.

Grounding:
- Say the current date.
- Say your current location.
- Feel your feet.
- Take one grounded action.
EOF
}

session() {
  local ts id md
  ts="$(now_id)"
  id="$ts-session"
  md="$CH_VAULT/Sessions/$id.md"

  mkdir -p "$CH_SESSIONS" "$CH_VAULT/Sessions"

  cat > "$CH_SESSIONS/$id.json" <<JSON
{
  "id": "$id",
  "created_at": "$(date -Iseconds)",
  "type": "chronosphere-session"
}
JSON

  cat > "$md" <<MD
# Chronosphere Session: $ts

## Portal

Which time/place/identity/world did you visit?

## Arrival

What changed in attention, emotion, body, or imagination?

## Coordinates

Time:
Location:
Identity:
Atmosphere:

## Observations

## Message

## Artifact Brought Back

## Action in Present Time

## Return Check

- Current date:
- Current location:
- Body state:
- Next grounded action:
MD

  echo "Session created: $md"
}

verify() {
  echo "Chronosphere Verify"
  echo "==================="
  test -d "$WL_HOME" && echo "WL_HOME: OK" || echo "WL_HOME: FAIL"
  test -d "$CH_PORTALS" && echo "portals: OK" || echo "portals: FAIL"
  test -d "$CH_SESSIONS" && echo "sessions: OK" || echo "sessions: FAIL"
  test -d "$CH_NEXT" && echo "next testament: OK" || echo "next testament: FAIL"
  test -d "$CH_VAULT" && echo "obsidian: OK" || echo "obsidian: FAIL"
  command -v python3 >/dev/null 2>&1 && echo "python3: OK" || echo "python3: FAIL"
}

app() {
  python3 "$WL_HOME/apps/wl-chronosphere/app.py"
}

case "${1:-help}" in
  init) init ;;
  portal) shift; portal "$@" ;;
  list|portals) list ;;
  visit|jump|open) shift; visit "$@" ;;
  where) where ;;
  return|leave|close) return_home ;;
  session) session ;;
  verify) verify ;;
  app) app ;;
  *) usage ;;
esac
