#!/usr/bin/env bash
set -euo pipefail

ROOT="/Users/wonderland/Wonderland"
SERVICE_DIR="$ROOT/vault/06-Services"
REGISTRY="$SERVICE_DIR/service-registry.json"
OUT="$SERVICE_DIR/service-status.json"

python3 - "$ROOT" "$REGISTRY" "$OUT" <<'PY'
import json
import pathlib
import socket
import sys

root = pathlib.Path(sys.argv[1])
registry_path = pathlib.Path(sys.argv[2])
out = pathlib.Path(sys.argv[3])

registry = json.loads(registry_path.read_text())
statuses = []

def port_open(host, port, timeout=0.25):
    try:
        with socket.create_connection((host, int(port)), timeout=timeout):
            return True
    except Exception:
        return False

for svc in registry.get("services", []):
    definition = root / "vault" / "06-Services" / svc["path"]
    data = json.loads(definition.read_text())

    ports = []
    for p in data.get("ports", []):
        host_port = p.get("host")
        if host_port:
            ports.append({
                "host": host_port,
                "container": p.get("container"),
                "open": port_open("127.0.0.1", host_port)
            })

    statuses.append({
        "name": data["name"],
        "status": data.get("status"),
        "compose": data.get("compose"),
        "ports": ports
    })

payload = {
    "id": "service-status-v4",
    "version": 4,
    "services": statuses
}

out.write_text(json.dumps(payload, indent=2) + "\n")
print(json.dumps(payload, indent=2))
PY
