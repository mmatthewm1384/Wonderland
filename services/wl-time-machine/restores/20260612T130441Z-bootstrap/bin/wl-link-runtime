#!/usr/bin/env bash
set -euo pipefail

TARGET_BIN="nerdctl"
DESTINATION_DIR="/Users/wonderland/Wonderland/bin"

echo "=== 🔍 Searching for Rootless Runtime Binary ==="

# Define potential paths where OrbStack, Lima, or Homebrew hides nerdctl
SEARCH_PATHS=(
    "/Applications/OrbStack.app/Contents/MacOS/bin/$TARGET_BIN"
    "$HOME/.orbstack/bin/$TARGET_BIN"
    "/opt/homebrew/bin/$TARGET_BIN"
    "/usr/local/bin/$TARGET_BIN"
)

FOUND_PATH=""

for p in "${SEARCH_PATHS[@]}"; do
    if [[ -x "$p" ]]; then
        FOUND_PATH="$p"
        break
    fi
done

# If not found in standard paths, run a quick targeted scan of your home profile apps
if [[ -z "$FOUND_PATH" ]]; then
    echo "[SCAN] Searching alternative local paths..."
    FOUND_PATH=$(find "$HOME/.orbstack" "$HOME/.local" -name "$TARGET_BIN" -type f -permalink +111 2>/dev/null | head -n 1 || true)
fi

if [[ -n "$FOUND_PATH" ]]; then
    echo "[FOUND] Located usable binary at: $FOUND_PATH"
    echo "[LINK] Mapping binary into your active path layer..."
    ln -sf "$FOUND_PATH" "$DESTINATION_DIR/$TARGET_BIN"
    echo "[SUCCESS] $TARGET_BIN is now permanently accessible via your workspace."
else
    echo "[FAIL] Could not locate the $TARGET_BIN binary on this machine."
    echo "       Please ensure your rootless runtime engine is installed."
    exit 1
fi
