#!/usr/bin/env bash
set -euo pipefail

ROOT="/Users/wonderland/Wonderland"
LOCK="$ROOT/vault/locks/vault-lock.json"
STATE="${1:-status}"

case "$STATE" in
  lock) NEW="locked" ;;
  unlock) NEW="unlocked" ;;
  status) jq -r '.state' "$LOCK"; exit 0 ;;
  *) echo "Usage: wl-vault-lock [lock|unlock|status]"; exit 1 ;;
esac

python3 - "$LOCK" "$NEW" <<'PY'
import json, pathlib, sys, datetime
p = pathlib.Path(sys.argv[1])
state = sys.argv[2]
data = json.loads(p.read_text())
data["state"] = state
data["updated"] = datetime.datetime.now().isoformat(timespec="seconds")
p.write_text(json.dumps(data, indent=2) + "\n")
print(f"vault lock: {state}")
PY
