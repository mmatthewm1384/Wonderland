#!/usr/bin/env bash
set -euo pipefail

NAME="wl-nats"
IMAGE="docker.io/library/nats:2-alpine"

case "${1:-status}" in
  up|repair)
    nerdctl rm -f "$NAME" >/dev/null 2>&1 || true

    nerdctl run -d \
      --name "$NAME" \
      -p 4222:4222 \
      -p 8222:8222 \
      "$IMAGE" \
      -js -m 8222

    echo "PASS wl-nats up"
  ;;

  down|rollback)
    nerdctl rm -f "$NAME" >/dev/null 2>&1 || true
    echo "PASS wl-nats down"
  ;;

  status)
    nerdctl ps -a --filter "name=$NAME"
  ;;

  logs)
    nerdctl logs "$NAME"
  ;;

  doctor|verify)
    nerdctl ps --filter "name=$NAME" --format '{{.Names}}' | grep -qx "$NAME"

    if command -v timeout >/dev/null 2>&1; then
      timeout 5 curl -fsS http://127.0.0.1:8222/healthz >/dev/null
    elif command -v gtimeout >/dev/null 2>&1; then
      gtimeout 5 curl -fsS http://127.0.0.1:8222/healthz >/dev/null
    else
      curl --max-time 5 -fsS http://127.0.0.1:8222/healthz >/dev/null
    fi

    echo "PASS wl-nats doctor"
  ;;

  *)
    echo "Usage: wl-nats up|down|status|logs|doctor|repair|rollback"
    exit 1
  ;;
esac
