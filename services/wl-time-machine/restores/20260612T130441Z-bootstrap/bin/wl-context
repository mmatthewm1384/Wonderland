#!/usr/bin/env bash
# Wonderland Hardened Unified Context Router Engine
set -euo pipefail

ROOT="${WONDERLAND_ROOT:-$HOME/Wonderland}"
ROOT_V4="${WONDERLAND_ROOT_V4:-$HOME/Wonderland-v4}"
BIN="$ROOT/bin"
CORE="$ROOT/core"
GOV="$ROOT/intelligence/obsidian/00-Core/Governance.md"
LOG_DIR="$ROOT/logs/context"
LOG_FILE="$LOG_DIR/wl-context.log"

mkdir -p "$LOG_DIR"

log() { printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "$LOG_FILE"; }
fail() { echo "[FAIL] $*" >&2; }

main() {
  local cmd="${1:-help}"
  shift || true

  case "$cmd" in
    help|-h|--help|"")
      echo "Wonderland Unified Context Router"
      echo "Usage: wl [command] [args...]"
      ;;
    vm)
      # INTERCEPT VM COMMANDS HERE
      local sub_action="${1:-}"
      if [ "$sub_action" = "bootstrap" ]; then
        "$ROOT_V4/core/vm_transport.sh" bootstrap "${2:-}"
      else
        # Translates 'wl vm webserver doctor' to execution parameters
        "$ROOT_V4/core/vm_transport.sh" exec "${1:-}" "${2:-doctor}"
      fi
      ;;
    status|doctor|repair)
      if [ -d "$ROOT_V4" ] && [ -x "$ROOT_V4/bin/wl" ]; then
        "$ROOT_V4/bin/wl" "$cmd" "$@"
      else
        if [ "$cmd" = "doctor" ] && [ -x "$CORE/doctor.sh" ]; then
          "$CORE/doctor.sh" "$@"
        elif [ -x "$BIN/wl-$cmd" ]; then
          "$BIN/wl-$cmd" "$@"
        else
          fail "No execution strategy found for: wl $cmd"
          exit 1
        fi
      fi
      ;;
    *)
      if [ -x "$BIN/wl-$cmd" ]; then
        "$BIN/wl-$cmd" "$@"
      else
        fail "Command unresolved: $cmd"
        exit 1
      fi
      ;;
  esac
}

[ -d "$ROOT" ] || { fail "Wonderland baseline missing at $ROOT"; exit 1; }
main "$@"
