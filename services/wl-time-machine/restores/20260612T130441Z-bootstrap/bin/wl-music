#!/usr/bin/env bash
set -euo pipefail

WL_ROOT="${WL_ROOT:-$HOME/Wonderland}"
MUSIC_ROOT="${WL_MUSIC_ROOT:-/Volumes/T7_Wonderland/media/music}"
MANIFEST_DIR="$MUSIC_ROOT/manifests"
REPORT_DIR="$WL_ROOT/vault/08-Operations/reports"

mkdir -p "$REPORT_DIR"

report_file() {
  echo "$REPORT_DIR/music-$1-report.json"
}

require_music_root() {
  if [ ! -d "$MUSIC_ROOT" ]; then
    echo "FAIL music root missing: $MUSIC_ROOT"
    echo
    echo "Recovery:"
    echo "  wl storage attach"
    exit 1
  fi
}

status() {
  require_music_root

  local size flac_count manifest_count
  size="$(du -sh "$MUSIC_ROOT" 2>/dev/null | awk '{print $1}')"
  flac_count="$(find "$MUSIC_ROOT" -type f -iname "*.flac" 2>/dev/null | wc -l | tr -d ' ')"
  manifest_count="$(find "$MANIFEST_DIR" -type f \( -name "*.sha256" -o -name "*.json" \) 2>/dev/null | wc -l | tr -d ' ')"

  echo "Wonderland Music Status"
  echo
  echo "Root:       $MUSIC_ROOT"
  echo "Size:       $size"
  echo "FLAC:       $flac_count"
  echo "Manifests:  $manifest_count"
  echo
  echo "RESULT PASS"

  cat > "$(report_file status)" <<JSON
{
  "generated": "$(date -u +"%Y-%m-%dT%H:%M:%SZ")",
  "root": "$MUSIC_ROOT",
  "size": "$size",
  "flac_count": $flac_count,
  "manifest_count": $manifest_count,
  "result": "PASS"
}
JSON
}

audit() {
  require_music_root

  local artist_dirs album_dirs flac_count size
  size="$(du -sh "$MUSIC_ROOT" 2>/dev/null | awk '{print $1}')"
  flac_count="$(find "$MUSIC_ROOT" -type f -iname "*.flac" 2>/dev/null | wc -l | tr -d ' ')"
  artist_dirs="$(find "$MUSIC_ROOT" -mindepth 1 -maxdepth 1 -type d ! -name manifests ! -name backups ! -name archive ! -name music-archive 2>/dev/null | wc -l | tr -d ' ')"
  album_dirs="$(find "$MUSIC_ROOT" -mindepth 2 -maxdepth 2 -type d 2>/dev/null | wc -l | tr -d ' ')"

  echo "Wonderland Music Audit"
  echo
  echo "Artists:    $artist_dirs"
  echo "Albums:     $album_dirs"
  echo "FLAC:       $flac_count"
  echo "Size:       $size"
  echo
  echo "RESULT PASS"

  cat > "$(report_file audit)" <<JSON
{
  "generated": "$(date -u +"%Y-%m-%dT%H:%M:%SZ")",
  "root": "$MUSIC_ROOT",
  "artist_dirs": $artist_dirs,
  "album_dirs": $album_dirs,
  "flac_count": $flac_count,
  "size": "$size",
  "result": "PASS"
}
JSON
}

verify() {
  require_music_root

  if ! command -v flac >/dev/null 2>&1; then
    echo "FAIL flac command missing"
    echo
    echo "Install:"
    echo "  brew install flac"
    exit 1
  fi

  local tmp count fail_count
  tmp="$(mktemp)"
  count="$(find "$MUSIC_ROOT" -type f -iname "*.flac" 2>/dev/null | wc -l | tr -d ' ')"

  echo "Wonderland Music Integrity Verify"
  echo
  echo "Checking FLAC files: $count"
  echo

  fail_count=0

  while IFS= read -r file; do
    if flac -t -s "$file" >/dev/null 2>&1; then
      :
    else
      echo "$file" >> "$tmp"
      fail_count=$((fail_count+1))
    fi
  done < <(find "$MUSIC_ROOT" -type f -iname "*.flac" 2>/dev/null)

  if [ "$fail_count" -eq 0 ]; then
    echo "PASS integrity"
    result="PASS"
  else
    echo "FAIL corrupt files: $fail_count"
    cat "$tmp"
    result="FAIL"
  fi

  cat > "$(report_file integrity)" <<JSON
{
  "generated": "$(date -u +"%Y-%m-%dT%H:%M:%SZ")",
  "root": "$MUSIC_ROOT",
  "flac_checked": $count,
  "corrupt_count": $fail_count,
  "result": "$result"
}
JSON

  rm -f "$tmp"

  echo
  echo "RESULT $result"

  [ "$result" = "PASS" ]
}

manifest() {
  require_music_root
  mkdir -p "$MANIFEST_DIR"

  local date_id sha_file json_file flac_count size
  date_id="$(date +"%Y%m%d")"
  sha_file="$MANIFEST_DIR/music-$date_id.sha256"
  json_file="$MANIFEST_DIR/music-$date_id.json"

  find "$MUSIC_ROOT" \
    -path "$MANIFEST_DIR" -prune -o \
    -type f \
    -print0 | xargs -0 shasum -a 256 > "$sha_file"

  flac_count="$(find "$MUSIC_ROOT" -type f -iname "*.flac" 2>/dev/null | wc -l | tr -d ' ')"
  size="$(du -sh "$MUSIC_ROOT" 2>/dev/null | awk '{print $1}')"

  cat > "$json_file" <<JSON
{
  "id": "wl-music-manifest-$date_id",
  "generated": "$(date -u +"%Y-%m-%dT%H:%M:%SZ")",
  "root": "$MUSIC_ROOT",
  "sha256_manifest": "$sha_file",
  "size": "$size",
  "flac_count": $flac_count,
  "status": "verified"
}
JSON

  cat > "$(report_file manifest)" <<JSON
{
  "generated": "$(date -u +"%Y-%m-%dT%H:%M:%SZ")",
  "sha256_manifest": "$sha_file",
  "json_manifest": "$json_file",
  "result": "PASS"
}
JSON

  echo "Wonderland Music Manifest"
  echo
  echo "SHA256: $sha_file"
  echo "JSON:   $json_file"
  echo
  echo "RESULT PASS"
}

doctor() {
  require_music_root

  echo "Wonderland Music Doctor"
  echo

  local failures=0
  local warnings=0

  if [ -d "$MANIFEST_DIR" ]; then
    echo "PASS manifests directory"
  else
    echo "WARN manifests directory missing"
    warnings=$((warnings+1))
  fi

  local flac_count
  flac_count="$(find "$MUSIC_ROOT" -type f -iname "*.flac" 2>/dev/null | wc -l | tr -d ' ')"

  if [ "$flac_count" -gt 0 ]; then
    echo "PASS flac files: $flac_count"
  else
    echo "FAIL no FLAC files found"
    failures=$((failures+1))
  fi

  if find "$MANIFEST_DIR" -type f -name "*.sha256" 2>/dev/null | grep -q .; then
    echo "PASS sha256 manifest present"
  else
    echo "WARN sha256 manifest missing"
    warnings=$((warnings+1))
  fi

  if command -v flac >/dev/null 2>&1; then
    echo "PASS flac verifier installed"
  else
    echo "WARN flac verifier missing"
    warnings=$((warnings+1))
  fi

  local result="PASS"
  if [ "$failures" -gt 0 ]; then
    result="FAIL"
  fi

  cat > "$(report_file doctor)" <<JSON
{
  "generated": "$(date -u +"%Y-%m-%dT%H:%M:%SZ")",
  "root": "$MUSIC_ROOT",
  "flac_count": $flac_count,
  "failures": $failures,
  "warnings": $warnings,
  "result": "$result"
}
JSON

  echo
  echo "RESULT $result"
  [ "$result" = "PASS" ]
}

case "${1:-status}" in
  status) status ;;
  audit) audit ;;
  verify) verify ;;
  manifest) manifest ;;
  doctor) doctor ;;
  *)
    echo "Usage:"
    echo "  wl music status"
    echo "  wl music audit"
    echo "  wl music verify"
    echo "  wl music manifest"
    echo "  wl music doctor"
    exit 2
    ;;
esac
