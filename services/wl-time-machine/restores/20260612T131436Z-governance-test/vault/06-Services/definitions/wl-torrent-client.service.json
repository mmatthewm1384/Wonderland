{
  "id": "wl-torrent-client-service-v4",
  "name": "wl-torrent-client",
  "status": "active",
  "version": 4,
  "runtime": "containerd",
  "engine": "nerdctl",
  "container": "wl-torrent-client",
  "compose": "services/torrent/compose.yml",
  "verify": "nerdctl ps --filter name=wl-torrent-client --format '{{.Names}}' | grep -qx wl-torrent-client",
  "recover": "wl torrent repair",
  "rollback": "wl torrent down",
  "dependencies": [
    "wl-torrent-vpn"
  ],
  "ports": [
    "9091"
  ],
  "volumes": [
    "vault/data/torrents/downloads",
    "vault/data/torrents/watch",
    "vault/data/torrents/downloads-export"
  ]
}
