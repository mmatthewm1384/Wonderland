{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "manifest.schema.json",
  "title": "Wonderland Manifest",
  "type": "object",
  "required": ["id", "version"],
  "properties": {
    "id": { "type": "string" },
    "version": { "type": "integer" },
    "state": { "type": "string" },
    "lock": { "type": "string" },
    "authority": { "type": "string" }
  }
}
