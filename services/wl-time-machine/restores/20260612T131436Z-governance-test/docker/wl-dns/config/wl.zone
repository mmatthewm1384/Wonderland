$ORIGIN wl.
$TTL 30
@       IN SOA  ns.wl. admin.wl. (
            2026060601 ; serial
            60         ; refresh
            30         ; retry
            120        ; expire
            30 )       ; minimum
        IN NS   ns.wl.
ns          IN A    127.0.0.1
dns         IN A    127.0.0.1
grafana     IN A    127.0.0.1
prometheus  IN A    127.0.0.1
loki        IN A    127.0.0.1
nats        IN A    127.0.0.1
vault       IN A    127.0.0.1
dashboard   IN A    127.0.0.1
operator    IN A    127.0.0.1
