#!/usr/bin/env sh
set -eu

. "$HOME/Wonderland/tools/lib/wl-common.sh" 2>/dev/null || {
  SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
  . "$SCRIPT_DIR/../lib/wl-common.sh"
}

case "${1:-}" in
  --help)
    echo "Usage: wl-export"
    echo "Create an export snapshot of wonderland-docs."
    exit 0
    ;;
  --version)
    echo "$WL_VERSION"
    exit 0
    ;;
esac

stamp="$(date +%Y%m%d-%H%M%S)"
dest="$WL_ROOT/exports/wonderland-docs-export-$stamp"
mkdir -p "$dest"

if [ -d "$WL_DOCS_REPO" ]; then
  tar -czf "$dest/wonderland-docs.tar.gz" -C "$WL_REPOS" wonderland-docs
fi

wl_info "Created export at $dest"
