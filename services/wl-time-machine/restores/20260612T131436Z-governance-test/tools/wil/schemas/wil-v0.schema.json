{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WIL v0",
  "type": "object",
  "required": ["kind", "id", "version"],
  "properties": {
    "kind": {
      "type": "string",
      "enum": ["artifact", "world", "intent", "trajectory", "assumption", "event"]
    },
    "id": {
      "type": "string"
    },
    "version": {
      "type": "integer"
    },
    "target": {
      "type": "object"
    },
    "desired_state": {
      "type": "object"
    },
    "requires": {
      "type": "array"
    },
    "verify": {
      "type": "array"
    },
    "recovery": {
      "type": "array"
    },
    "rollback": {
      "type": "array"
    },
    "consequences": {
      "type": "object"
    },
    "risks": {
      "type": "array"
    }
  }
}
