#!/usr/bin/env bash
set -euo pipefail

ROOT="/Users/wonderland/Wonderland"
SERVICE="$ROOT/services/document-cleaner"
COMPOSE="$SERVICE/compose.yml"

case "${1:-help}" in
  up)
    nerdctl compose -f "$COMPOSE" up -d --build
    ;;
  down)
    nerdctl compose -f "$COMPOSE" down --remove-orphans
    ;;
  status)
    nerdctl ps -a --filter "name=wl-document-cleaner"
    ;;
  logs)
    nerdctl logs wl-document-cleaner
    ;;
  doctor|verify)
    python3 "$SERVICE/scripts/doctor.py"
    ;;
  repair)
    python3 "$SERVICE/scripts/repair.py"
    ;;
  sanitize)
    shift
    curl -sS -X POST -F "file=@$1" -F "mode=${2:-metadata}" http://127.0.0.1:8024/sanitize --output "${3:-cleaned-$(basename "$1")}"
    ;;
  *)
    echo "Usage: wl-document-cleaner [up|down|status|logs|doctor|repair|sanitize <file> [metadata|rasterize] [output]]"
    ;;
esac
