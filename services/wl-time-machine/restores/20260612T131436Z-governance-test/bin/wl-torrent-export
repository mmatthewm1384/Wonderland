#!/usr/bin/env bash
set -euo pipefail

ROOT="${WONDERLAND_ROOT:-$HOME/Wonderland}"
DEST="$ROOT/vault/data/torrents/downloads-export"

mkdir -p "$DEST"

if ! nerdctl ps --format '{{.Names}}' | grep -qx 'wl-torrent-client'; then
  echo "FAIL no wl-torrent-client container"
  exit 1
fi

TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

mkdir -p "$TMP/downloads"

nerdctl exec wl-torrent-client sh -lc '
  cd /downloads
  tar cf - .
' | tar xf - -C "$TMP/downloads"

rsync -a "$TMP/downloads/" "$DEST/"

find "$DEST" -type f ! -name manifest.sha256 -exec shasum -a 256 {} \; \
  > "$DEST/manifest.sha256"

echo "exported: $DEST"
