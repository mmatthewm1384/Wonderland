#!/usr/bin/env bash
set -euo pipefail

CORE="${WONDERLAND_CORE:-$HOME/Wonderland/intelligence/obsidian/00-Core}"
TARGET="$CORE/knowledge-architecture.md"

append_once() {
  local file="$1"
  local marker="$2"
  local block="$3"

  [ -f "$file" ] || return 0

  if grep -q "$marker" "$file"; then
    echo "[OK] Already linked: $file"
  else
    printf "\n%s\n" "$block" >> "$file"
    echo "[OK] Added link: $file"
  fi
}

if [ ! -f "$TARGET" ]; then
  echo "[FAIL] Missing knowledge architecture: $TARGET"
  exit 1
fi

append_once \
  "$CORE/Governance.md" \
  "knowledge-architecture" \
  "## Architecture References

- [[knowledge-architecture]]

The Knowledge Architecture document defines the separation of knowledge, governance, generated state, execution, and recovery."

append_once \
  "$CORE/index.md" \
  "knowledge-architecture" \
  "## Architecture

- [[knowledge-architecture]]"

append_once \
  "$CORE/Home.md" \
  "knowledge-architecture" \
  "## System Architecture

- [[knowledge-architecture]]"

echo "[OK] Knowledge architecture drop-in complete"
