#!/usr/bin/env bash
set -euo pipefail

# Define new clean data space paths
NEW_HF_HOME="/Users/wonderland/Wonderland/data/models/whisper"

echo "=== 🧹 Wonderland Path & Variable Optimization ==="

# 1. Update machine learning environment locations
export HF_HOME="$NEW_HF_HOME"
export TRANSFORMERS_CACHE="$NEW_HF_HOME"
echo "[ALIGN] Remapped model cache targets to: $NEW_HF_HOME"

# 2. De-duplicate and strip v3 from $PATH safely using standard bash parsing
OLD_PATH="$PATH"
NEW_PATH=""

IFS=':' read -ra ADDR <<< "$OLD_PATH"
for dir in "${ADDR[@]}"; do
    # Filter out empty paths, duplicates, and any strings matching v3
    if [[ -z "$dir" ]] || [[ "$dir" == *"Wonderland-v3"* ]] || [[ ":$NEW_PATH:" == *":$dir:"* ]]; then
        continue
    fi
    if [[ -z "$NEW_PATH" ]]; then
        NEW_PATH="$dir"
    else
        NEW_PATH="$NEW_PATH:$dir"
    fi
done

export PATH="$NEW_PATH"
echo "[CLEAN] Successfully purged duplicate segments and v3 references from active PATH."

# 3. Output structural check block
echo "=== Optimized Environment Variables ==="
echo "PATH=$PATH"
echo "HF_HOME=$HF_HOME"
echo "======================================="
