#!/usr/bin/env bash
set -euo pipefail

WL_ROOT="${WL_ROOT:-$HOME/Wonderland}"
CAP_FILE="$WL_ROOT/vault/07-Operations/platform/runtime-capabilities.json"
MODE_FILE="$WL_ROOT/vault/07-Operations/platform/runtime-mode.json"

capability="${1:-}"

if [ -z "$capability" ]; then
  echo "Usage: wl-require-capability <capability>"
  exit 2
fi

if [ ! -f "$CAP_FILE" ]; then
  echo "FAIL capability registry missing:"
  echo "$CAP_FILE"
  exit 1
fi

if [ ! -f "$MODE_FILE" ]; then
  echo "FAIL runtime mode file missing:"
  echo "$MODE_FILE"
  echo
  echo "Recovery:"
  echo "  bin/wl-mode light"
  exit 1
fi

result="$(python3 - <<PY
import json
from pathlib import Path

cap = "$capability"
cap_file = Path("$CAP_FILE")
mode_file = Path("$MODE_FILE")

try:
    caps = json.loads(cap_file.read_text())
    mode = json.loads(mode_file.read_text()).get("mode", "unknown")
    allowed = caps.get("modes", {}).get(mode, {}).get(cap, None)

    if allowed is True:
        print(f"PASS {mode} {cap}")
    elif allowed is False:
        print(f"FAIL {mode} {cap}")
    else:
        print(f"UNKNOWN {mode} {cap}")
except Exception as e:
    print(f"ERROR {e}")
PY
)"

case "$result" in
  PASS*)
    echo "$result"
    exit 0
    ;;
  FAIL*)
    echo "FAIL capability unavailable"
    echo
    echo "$result"
    echo
    echo "Recovery:"
    echo "  bin/wl-storage attach"
    echo "  bin/wl-mode full"
    exit 1
    ;;
  UNKNOWN*)
    echo "FAIL unknown capability"
    echo
    echo "$result"
    exit 1
    ;;
  *)
    echo "FAIL capability check error"
    echo "$result"
    exit 1
    ;;
esac
