#!/usr/bin/env bash
set -euo pipefail

ROOT="/Users/wonderland/Wonderland"
OUT_DIR="$ROOT/vault/07-Operations/state"

mkdir -p "$OUT_DIR"

STAMP="$(date +%Y%m%d-%H%M%S)"
OUT="$OUT_DIR/state-$STAMP.json"

python3 - "$ROOT" "$OUT" <<'PY'
import json
import pathlib
import subprocess
import datetime
import sys

root = pathlib.Path(sys.argv[1])
out = pathlib.Path(sys.argv[2])

def run(cmd):
    try:
        return subprocess.run(
            cmd,
            capture_output=True,
            text=True
        ).stdout.splitlines()
    except Exception:
        return []

payload = {
    "id": "wonderland-state-v4",
    "timestamp": datetime.datetime.now().isoformat(timespec="seconds"),
    "runtime": run(["nerdctl","ps","--format","{{.Names}}"]),
    "git": run(["git","status","--short"]),
    "vault": {
        "root": str(root / "vault")
    }
}

out.write_text(json.dumps(payload, indent=2) + "\n")

print(out)
PY
