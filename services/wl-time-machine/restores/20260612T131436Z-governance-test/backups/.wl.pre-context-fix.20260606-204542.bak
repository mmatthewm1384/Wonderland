# Wonderland Unified Core Utility Environment Profile (v4 VM Capable)

_wl_orchestrator() {
    local cmd="${1:-}"
    local V4_ROOT="${HOME}/Wonderland-v4"

    case "$cmd" in
        vm)
            local sub_action="${2:-}"
            if [ "$sub_action" = "bootstrap" ]; then
                "${V4_ROOT}/core/vm_transport.sh" bootstrap "${3:-}"
            else
                "${V4_ROOT}/core/vm_transport.sh" exec "${2:-}" "${3:-doctor}"
            fi
            ;;
        doctor)
            echo "::: Running Environment Verification :::"
            if [ -f "/sys/hypervisor/uuid" ] || [ -d "/proc/xen" ]; then
                echo "[GUEST ENVIRONMENT DETECTED]"
                [ -f ~/.wl-registry-v4/guest_state.json ] && echo "  [OK] Guest local state storage valid." || echo "  [FAIL] Guest registry missing."
            else
                echo "[HOST ENVIRONMENT DETECTED]"
                "${V4_ROOT}/bin/wl" doctor || true
            fi
            ;;
        repair)
            if [ -x "${V4_ROOT}/core/repair.sh" ]; then
                "${V4_ROOT}/core/repair.sh" run
            else
                echo "[GUEST] Running local guest environment clean..."
                echo "{\"repaired\": $(date +%s)}" > ~/.wl-registry-v4/guest_state.json
            fi
            ;;
        *)
            if [ -x "${V4_ROOT}/bin/wl" ]; then
                "${V4_ROOT}/bin/wl" "$@"
            else
                echo "[+] Guest execution command context fallback: $cmd"
            fi
            ;;
    esac
}

alias wl="_wl_orchestrator"
