#!/usr/bin/env bash
# Wonderland System Operations Orchestration Entrypoint CLI Wrapper

WORKSPACE_DIR="$HOME/Wonderland/Wonderland-v4"
SCRIPTS_DIR="$WORKSPACE_DIR/scripts"

if [ ! -d "$WORKSPACE_DIR/.venv" ]; then
    python3 -m venv "$WORKSPACE_DIR/.venv"
fi
source "$WORKSPACE_DIR/.venv/bin/activate"

if [ "$1" == "sync" ]; then
    python3 ~/Wonderland/Wonderland-v4/scripts/sync_governance.py
fi

case "$1" in
    ui)
        python3 "$SCRIPTS_DIR/tui_dashboard.py"
        ;;
    inventory)
        python3 "$SCRIPTS_DIR/inventory_core.py"
        ;;
    investigate)
        python3 "$SCRIPTS_DIR/investigate_vault.py"
        ;;
    *)
        echo "Wonderland Control Engine CLI"
        echo "Usage: wl [ui | inventory | investigate]"
        exit 1
        ;;
esac
