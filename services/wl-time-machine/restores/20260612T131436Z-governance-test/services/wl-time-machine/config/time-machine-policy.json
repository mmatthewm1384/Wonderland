{
  "id": "wl-time-machine-policy-v1",
  "mode": "append-only-local-snapshots",
  "restore_mode": "staged-only",
  "delete_snapshots_by_default": false,
  "allowed_behaviors": [
    "create_local_snapshot",
    "write_manifest",
    "verify_snapshot_manifest",
    "stage_restore_copy",
    "create_recovery_bundle"
  ],
  "forbidden_behaviors": [
    "overwrite_live_files_without_operator_action",
    "delete_snapshots_without_explicit_command",
    "restore_without_staging",
    "capture_secret_material_by_default"
  ],
  "default_excludes": [
    ".git",
    "node_modules",
    ".venv",
    "__pycache__",
    "services/wl-time-machine/snapshots",
    "services/wl-time-machine/restores",
    "services/wl-time-machine/recovery"
  ]
}
