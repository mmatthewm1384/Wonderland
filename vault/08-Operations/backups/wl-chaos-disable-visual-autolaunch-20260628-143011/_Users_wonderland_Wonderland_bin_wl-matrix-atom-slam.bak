#!/usr/bin/env bash
set -euo pipefail

ROOT="${WL_ROOT:-$HOME/Wonderland}"
EVENTS="$ROOT/vault/08-Operations/matrix/events/incoming"

strength="${1:-88}"
kind="${2:-impulse}"

mkdir -p "$EVENTS"

stamp="$(date -u +%Y%m%dT%H%M%SZ)"
id="evt-matrix-atom-slam-$stamp"
out="$EVENTS/$id.json"

cat > "$out" <<JSON
{
  "id": "$id",
  "source": "matrix-atom-slam",
  "type": "$kind",
  "strength": $strength,
  "timestamp": "$(date -u +%Y-%m-%dT%H:%M:%SZ)",
  "payload": {
    "mode": "manual-slam",
    "target": "matrix-fluderation"
  }
}
JSON

python3 -m json.tool "$out" >/dev/null

echo "PASS matrix atom slam event"
echo "$out"
