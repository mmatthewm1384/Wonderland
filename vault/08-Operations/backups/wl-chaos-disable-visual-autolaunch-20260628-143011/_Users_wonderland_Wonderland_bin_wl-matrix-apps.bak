#!/usr/bin/env bash
set -euo pipefail

WL_ROOT="${WL_ROOT:-$HOME/Wonderland}"
APP_DIR="$WL_ROOT/apps/macos"

case "${1:-status}" in
  status)
    echo "Wonderland Matrix Apps"
    for app in "Spin City Wave" "Agitate Waves" "Matrix Atom Destroyer"; do
      if [[ -d "$APP_DIR/$app.app" ]]; then
        echo "PASS $app"
      else
        echo "FAIL $app"
      fi
    done
    ;;

  spin-city)
    open "$APP_DIR/Spin City Wave.app"
    ;;

  agitate)
    open "$APP_DIR/Agitate Waves.app"
    ;;

  matrix)
    open "$APP_DIR/Matrix Atom Destroyer.app"
    ;;

  all)
    open "$APP_DIR/Spin City Wave.app"
    open "$APP_DIR/Agitate Waves.app"
    open "$APP_DIR/Matrix Atom Destroyer.app"
    ;;

  *)
    echo "Usage: wl-matrix-apps status|spin-city|agitate|matrix|all"
    exit 1
    ;;
esac
