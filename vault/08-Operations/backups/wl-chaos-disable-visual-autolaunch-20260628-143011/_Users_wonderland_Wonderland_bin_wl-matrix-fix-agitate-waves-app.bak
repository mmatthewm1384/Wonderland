#!/usr/bin/env bash
set -euo pipefail

WL_ROOT="${WL_ROOT:-$HOME/Wonderland}"
MATRIX_DIR="$WL_ROOT/assets/visualizations/matrix-atom-destroyer"
BIN_DIR="$WL_ROOT/bin"
APP_DIR="$MATRIX_DIR/apps/agitate-waves"
IPHONE_DIR="$APP_DIR/iphone"
PORTAL="$MATRIX_DIR/iphone/index.html"

mkdir -p "$IPHONE_DIR"

cat > "$IPHONE_DIR/agitate-waves-iphone.html" <<'HTML'
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover,user-scalable=no">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<title>Agitate Waves</title>
<style>
:root {
  --bg: #05070A;
  --cyan: #00E5FF;
  --purple: #7000FF;
  --green: #00FF66;
}
html, body {
  margin: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: var(--bg);
  color: var(--green);
  font-family: -apple-system, BlinkMacSystemFont, system-ui, sans-serif;
  touch-action: none;
}
canvas {
  display: block;
  width: 100vw;
  height: 100vh;
}
#hud {
  position: fixed;
  top: calc(env(safe-area-inset-top) + 12px);
  left: calc(env(safe-area-inset-left) + 14px);
  right: calc(env(safe-area-inset-right) + 14px);
  color: var(--green);
  text-shadow: 0 0 14px var(--green);
  font-size: 12px;
  letter-spacing: 1px;
  pointer-events: none;
}
#title {
  font-size: 18px;
  font-weight: 700;
}
#hint {
  margin-top: 4px;
  color: rgba(255,255,255,.68);
}
</style>
</head>
<body>
<canvas id="c"></canvas>
<div id="hud">
  <div id="title">AGITATE WAVES</div>
  <div id="hint">Tap pulse · Double tap reverse · Long press randomize · Swipe amplitude</div>
</div>

<script>
const COLORS = {
  bg: "#05070A",
  cyan: "#00E5FF",
  purple: "#7000FF",
  green: "#00FF66"
};

const canvas = document.getElementById("c");
const ctx = canvas.getContext("2d");

let W = 0;
let H = 0;
let dpr = 1;
let t = 0;
let last = performance.now();

let amplitude = 42;
let frequency = 0.018;
let speed = 0.0022;
let reverse = false;
let pulse = 0;
let chaos = 0.35;

let lastTap = 0;
let pressTimer = null;
let touchStartY = 0;

function resize() {
  dpr = Math.min(window.devicePixelRatio || 1, 3);
  W = Math.floor(window.innerWidth * dpr);
  H = Math.floor(window.innerHeight * dpr);
  canvas.width = W;
  canvas.height = H;
}

function randomize() {
  amplitude = 22 + Math.random() * 76;
  frequency = 0.01 + Math.random() * 0.035;
  speed = 0.001 + Math.random() * 0.005;
  chaos = 0.15 + Math.random() * 0.85;
  pulse = 1;
}

function triggerPulse() {
  pulse = 1;
}

function reverseDirs() {
  reverse = !reverse;
  pulse = 1;
}

function drawBackground() {
  ctx.fillStyle = "rgba(5,7,10,0.30)";
  ctx.fillRect(0, 0, W, H);

  ctx.strokeStyle = "rgba(0,229,255,0.08)";
  ctx.lineWidth = 1;

  const grid = Math.max(36 * dpr, W * 0.08);

  for (let x = 0; x < W; x += grid) {
    ctx.beginPath();
    ctx.moveTo(x, 0);
    ctx.lineTo(x, H);
    ctx.stroke();
  }

  for (let y = 0; y < H; y += grid) {
    ctx.beginPath();
    ctx.moveTo(0, y);
    ctx.lineTo(W, y);
    ctx.stroke();
  }
}

function drawWaves() {
  const centerY = H * 0.52;
  const layers = 11;

  for (let layer = 0; layer < layers; layer++) {
    const yBase = centerY + (layer - layers / 2) * (H * 0.045);
    const phaseDir = reverse ? -1 : 1;
    const phase = t * speed * phaseDir + layer * 0.65;
    const color = layer % 3 === 0 ? COLORS.green : layer % 3 === 1 ? COLORS.cyan : COLORS.purple;

    ctx.beginPath();
    ctx.strokeStyle = color;
    ctx.lineWidth = Math.max(2, 3.5 * dpr);
    ctx.shadowColor = color;
    ctx.shadowBlur = 18 * dpr + pulse * 32 * dpr;
    ctx.globalAlpha = 0.48 + pulse * 0.25;

    for (let x = 0; x <= W; x += 5 * dpr) {
      const n =
        Math.sin(x * frequency + phase) * amplitude +
        Math.sin(x * frequency * 2.7 - phase * 1.8) * amplitude * chaos +
        Math.sin((x + layer * 80) * frequency * 0.55 + phase * 2.4) * amplitude * 0.45;

      const y = yBase + n + pulse * Math.sin(x * 0.025 + layer) * 80 * dpr;

      if (x === 0) ctx.moveTo(x, y);
      else ctx.lineTo(x, y);
    }

    ctx.stroke();
  }

  ctx.globalAlpha = 1;
  ctx.shadowBlur = 0;
}

function drawCore() {
  const cx = W / 2;
  const cy = H / 2;

  ctx.save();
  ctx.translate(cx, cy);
  ctx.rotate(t * 0.001);

  for (let i = 0; i < 3; i++) {
    ctx.strokeStyle = i === 0 ? COLORS.green : i === 1 ? COLORS.cyan : COLORS.purple;
    ctx.lineWidth = 2.5 * dpr;
    ctx.shadowColor = ctx.strokeStyle;
    ctx.shadowBlur = 20 * dpr;
    ctx.beginPath();
    ctx.ellipse(0, 0, 64 * dpr + pulse * 30 * dpr, 22 * dpr, i * Math.PI / 1.5, 0, Math.PI * 2);
    ctx.stroke();
  }

  ctx.restore();
}

function loop(now) {
  const dt = Math.min(now - last, 50);
  last = now;
  t += dt;

  drawBackground();
  drawWaves();
  drawCore();

  if (pulse > 0) pulse *= 0.92;
  if (pulse < 0.01) pulse = 0;

  requestAnimationFrame(loop);
}

canvas.addEventListener("touchstart", e => {
  e.preventDefault();
  touchStartY = e.touches[0].clientY;

  const now = Date.now();

  if (now - lastTap < 300) {
    reverseDirs();
  } else {
    triggerPulse();
  }

  lastTap = now;
  pressTimer = setTimeout(randomize, 650);
}, { passive: false });

canvas.addEventListener("touchmove", e => {
  e.preventDefault();
  const y = e.touches[0].clientY;
  const dy = touchStartY - y;
  amplitude = Math.max(10, Math.min(130, amplitude + dy * 0.05));
}, { passive: false });

canvas.addEventListener("touchend", e => {
  e.preventDefault();
  clearTimeout(pressTimer);
}, { passive: false });

canvas.addEventListener("click", triggerPulse);

resize();
window.addEventListener("resize", resize);
window.addEventListener("orientationchange", resize);
requestAnimationFrame(loop);
</script>
</body>
</html>
HTML

python3 - <<'PY'
from pathlib import Path

portal = Path.home() / "Wonderland/assets/visualizations/matrix-atom-destroyer/iphone/index.html"
text = portal.read_text()

old = '''  <a class="card" href="../apps/agitate-waves/exports/agitate-lines.txt">
    <strong>Agitate Waves Data</strong>
    <span>Generated flat-frequency wave output from the Matrix sub-app engine.</span>
  </a>'''

new = '''  <a class="card" href="../apps/agitate-waves/iphone/agitate-waves-iphone.html">
    <strong>Agitate Waves</strong>
    <span>Real iPhone wave app: tap pulse, double-tap reverse, long-press randomize, swipe amplitude.</span>
  </a>'''

if old in text:
    text = text.replace(old, new)
elif "agitate-waves-iphone.html" not in text:
    marker = '''  <a class="card" href="../apps/spin-city-wave/iphone/spin-city-wave-iphone.html">'''
    text = text.replace(marker, new + "\n\n" + marker)

portal.write_text(text)
PY

cat > "$BIN_DIR/wl-matrix-agitate-iphone" <<SH2
#!/usr/bin/env bash
set -euo pipefail
open "$IPHONE_DIR/agitate-waves-iphone.html"
SH2

chmod +x "$BIN_DIR/wl-matrix-agitate-iphone"

echo "PASS Agitate Waves iPhone app created"
echo "Run local: wl-matrix-agitate-iphone"
echo "Serve:     wl-matrix-iphone-server 8888"
echo "iPhone:    http://<mac-ip>:8888/iphone/"
