#!/usr/bin/env bash
set -euo pipefail

WL_ROOT="${WL_ROOT:-$HOME/Wonderland}"
APP_ROOT="$WL_ROOT/apps/tauri"
OUT="$WL_ROOT/apps/macos"

mkdir -p "$OUT"

copy_app() {
  local id="$1"
  local name="$2"
  local app="$APP_ROOT/$id/src-tauri/target/release/bundle/macos/$name.app"

  if [[ ! -d "$app" ]]; then
    echo "FAIL missing app: $app"
    exit 1
  fi

  rm -rf "$OUT/$name.app"
  cp -R "$app" "$OUT/$name.app"

  echo "PASS $name.app"
}

copy_app "wl-spin-city" "Spin City Wave"
copy_app "wl-agitate" "Agitate Waves"
copy_app "wl-matrix" "Matrix Atom Destroyer"

echo
echo "Certified apps:"
find "$OUT" -maxdepth 1 -name "*.app" -print

echo
echo "Open:"
echo "open '$OUT/Spin City Wave.app'"
echo "open '$OUT/Agitate Waves.app'"
echo "open '$OUT/Matrix Atom Destroyer.app'"
