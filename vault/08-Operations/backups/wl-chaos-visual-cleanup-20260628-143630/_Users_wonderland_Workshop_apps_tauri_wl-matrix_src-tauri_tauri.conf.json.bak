{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Matrix Atom Destroyer",
  "version": "1.0.0",
  "identifier": "com.wonderland.wl-matrix",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "Matrix Atom Destroyer",
        "width": 430,
        "height": 932,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns"
    ]
  }
}
