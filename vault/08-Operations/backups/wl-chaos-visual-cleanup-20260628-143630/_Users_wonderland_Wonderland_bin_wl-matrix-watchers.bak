#!/usr/bin/env bash
set -euo pipefail

ROOT="$HOME/Wonderland"
STATE="$ROOT/.wl/state/the-matrix"
WATCHERS="$STATE/watchers.json"
PRESENCE="$STATE/presence.json"

init_if_missing() {
  mkdir -p "$STATE"
  if [[ ! -f "$WATCHERS" ]]; then
    cat > "$WATCHERS" <<'JSON'
{
  "suite": "THE∅MATRIX",
  "version": 1,
  "updated_at": "initial",
  "memory": {
    "global_attention": 0.0,
    "global_interest": 0.0,
    "encounters": 0
  },
  "watchers": [
    { "id": "watcher-01", "age": 1, "attention": 0.10, "interest": 0.12, "curiosity": 0.22, "memory": 0.05 },
    { "id": "watcher-02", "age": 2, "attention": 0.08, "interest": 0.18, "curiosity": 0.34, "memory": 0.07 },
    { "id": "watcher-03", "age": 3, "attention": 0.14, "interest": 0.10, "curiosity": 0.28, "memory": 0.04 },
    { "id": "watcher-04", "age": 5, "attention": 0.06, "interest": 0.24, "curiosity": 0.42, "memory": 0.11 },
    { "id": "watcher-05", "age": 8, "attention": 0.16, "interest": 0.16, "curiosity": 0.31, "memory": 0.09 }
  ]
}
JSON
  fi
}

sync_presence() {
  [[ -f "$PRESENCE" ]] || return 0

  tmp="$(mktemp)"
  jq --slurpfile watchers "$WATCHERS" --arg ts "$(date -u +%Y%m%dT%H%M%SZ)" '
    .watcher_memory = $watchers[0].memory
    | .watchers = $watchers[0].watchers
    | .watcher_state.population = ($watchers[0].watchers | length)
    | .watcher_state.attention = $watchers[0].memory.global_attention
    | .watcher_state.interest = $watchers[0].memory.global_interest
    | .updated_at = $ts
  ' "$PRESENCE" > "$tmp"

  mv "$tmp" "$PRESENCE"

  "$ROOT/bin/wl-matrix-influence" >/dev/null 2>&1 || true
}

case "${1:-show}" in
  show|status)
    init_if_missing
    jq . "$WATCHERS"
    ;;

  summary)
    init_if_missing
    echo "THE∅MATRIX Watcher Memory"
    echo "global_attention=$(jq -r .memory.global_attention "$WATCHERS")"
    echo "global_interest=$(jq -r .memory.global_interest "$WATCHERS")"
    echo "encounters=$(jq -r .memory.encounters "$WATCHERS")"
    echo "population=$(jq -r '.watchers | length' "$WATCHERS")"
    ;;

  tick)
    init_if_missing
    tmp="$(mktemp)"
    jq --arg ts "$(date -u +%Y%m%dT%H%M%SZ)" '
      .watchers |= map(
        .age += 1
        | .attention = ([0, (.attention * 0.92)] | max)
        | .interest = ([0, (.interest * 0.985)] | max)
        | .memory = ([1, (.memory + (.interest * 0.015))] | min)
      )
      | .memory.global_attention = (([.watchers[].attention] | add) / (.watchers | length))
      | .memory.global_interest = (([.watchers[].interest] | add) / (.watchers | length))
      | .updated_at = $ts
    ' "$WATCHERS" > "$tmp"
    mv "$tmp" "$WATCHERS"
    sync_presence
    echo "PASS watcher memory tick"
    ;;

  notice)
    init_if_missing
    strength="${2:-0.25}"
    tmp="$(mktemp)"
    jq --argjson strength "$strength" --arg ts "$(date -u +%Y%m%dT%H%M%SZ)" '
      .memory.encounters += 1
      | .watchers |= map(
          .attention = ([1, (.attention + ($strength * (.curiosity + 0.25)))] | min)
          | .interest = ([1, (.interest + ($strength * 0.45))] | min)
          | .memory = ([1, (.memory + ($strength * 0.18))] | min)
        )
      | .memory.global_attention = (([.watchers[].attention] | add) / (.watchers | length))
      | .memory.global_interest = (([.watchers[].interest] | add) / (.watchers | length))
      | .updated_at = $ts
    ' "$WATCHERS" > "$tmp"
    mv "$tmp" "$WATCHERS"
    sync_presence
    echo "PASS watcher notice strength=$strength"
    ;;

  reset)
    rm -f "$WATCHERS"
    init_if_missing
    sync_presence
    echo "PASS watcher memory reset"
    ;;

  *)
    echo "usage: wl-matrix-watchers {show|status|summary|tick|notice [strength]|reset}"
    exit 2
    ;;
esac
