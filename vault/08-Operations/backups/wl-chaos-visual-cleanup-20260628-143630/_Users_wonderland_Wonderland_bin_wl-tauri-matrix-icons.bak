#!/usr/bin/env bash
set -euo pipefail

WL_ROOT="${WL_ROOT:-$HOME/Wonderland}"
APP_ROOT="$WL_ROOT/apps/tauri"

python3 - <<'PY'
from pathlib import Path
import json, struct, zlib, math

root = Path.home() / "Wonderland/apps/tauri"

apps = {
    "wl-spin-city": ("DISABLED-Spin City Wave", "rings"),
    "wl-agitate": ("DISABLED-Agitate Waves", "waves"),
    "wl-matrix": ("DISABLED-Matrix Atom Destroyer", "atom"),
}

def write_png(path, size, mode):
    w = h = size
    bg = (5, 7, 10, 255)
    green = (0, 255, 102, 255)
    cyan = (0, 229, 255, 255)
    purple = (112, 0, 255, 255)

    rows = []
    cx = cy = size // 2

    for y in range(h):
        row = bytearray([0])
        for x in range(w):
            dx = x - cx
            dy = y - cy
            r = math.sqrt(dx*dx + dy*dy)
            th = math.atan2(dy, dx)

            color = bg

            if mode == "rings":
                if any(abs(r - rr) < 5 for rr in [85, 120, 155, 190]):
                    color = cyan if int(r) % 2 == 0 else green
                if r < 24:
                    color = purple

            elif mode == "waves":
                wave = cy + math.sin(x * 0.035) * 42
                wave2 = cy + math.sin(x * 0.055 + 2) * 68
                if abs(y - wave) < 5:
                    color = cyan
                elif abs(y - wave2) < 5:
                    color = purple
                elif abs(dx) < 5 and abs(dy) < 95:
                    color = green

            elif mode == "atom":
                ring1 = abs((dx*dx)/(150*150) + (dy*dy)/(54*54) - 1) < 0.055
                ring2 = abs(((dx*0.5+dy*0.86)**2)/(150*150) + ((-dx*0.86+dy*0.5)**2)/(54*54) - 1) < 0.055
                ring3 = abs(((dx*0.5-dy*0.86)**2)/(150*150) + ((dx*0.86+dy*0.5)**2)/(54*54) - 1) < 0.055
                if ring1:
                    color = green
                elif ring2:
                    color = cyan
                elif ring3:
                    color = purple
                if r < 20:
                    color = green

            # soft border
            if 230 < r < 238:
                color = cyan

            row.extend(color)
        rows.append(bytes(row))

    raw = b"".join(rows)

    def chunk(kind, data):
        return (
            struct.pack(">I", len(data))
            + kind
            + data
            + struct.pack(">I", zlib.crc32(kind + data) & 0xffffffff)
        )

    data = (
        b"\x89PNG\r\n\x1a\n"
        + chunk(b"IHDR", struct.pack(">IIBBBBB", w, h, 8, 6, 0, 0, 0))
        + chunk(b"IDAT", zlib.compress(raw, 9))
        + chunk(b"IEND", b"")
    )

    path.write_bytes(data)

for app, (_, mode) in apps.items():
    app_dir = root / app
    icons = app_dir / "src-tauri/icons"
    icons.mkdir(parents=True, exist_ok=True)

    write_png(icons / "icon.png", 512, mode)
    write_png(icons / "32x32.png", 32, mode)
    write_png(icons / "128x128.png", 128, mode)
    write_png(icons / "128x128@2x.png", 256, mode)

    conf = app_dir / "src-tauri/tauri.conf.json"
    data = json.loads(conf.read_text())

    data.setdefault("bundle", {})
    data["bundle"]["targets"] = ["app"]
    data["bundle"]["icon"] = [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.png"
    ]

    conf.write_text(json.dumps(data, indent=2) + "\n")

    print(f"PASS icon configured: {app}")
PY
