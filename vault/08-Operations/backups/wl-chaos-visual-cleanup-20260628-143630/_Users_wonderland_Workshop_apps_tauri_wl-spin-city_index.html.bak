<!doctype html>
<html>
<head>
  <meta charset="UTF-8" />
  <title>wl-spin-city</title>
  <style>
    html, body {
      margin: 0;
      width: 100%;
      height: 100%;
      overflow: hidden;
      background: #05070A;
    }
    canvas {
      display: block;
      width: 100vw;
      height: 100vh;
      background: radial-gradient(circle at center, #101030 0%, #05070A 55%, #000 100%);
    }
    #boot {
      position: fixed;
      top: 14px;
      left: 14px;
      color: #00E5FF;
      font: 13px monospace;
      z-index: 10;
      text-shadow: 0 0 12px #00E5FF;
    }
  </style>
</head>
<body>
  <div id="boot">wl-spin-city booting...</div>
  <canvas id="spin-city"></canvas>
  <script type="module" src="./src/main.js"></script>
</body>
</html>
