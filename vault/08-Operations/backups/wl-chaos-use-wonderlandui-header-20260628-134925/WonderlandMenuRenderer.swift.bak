import AppKit

@MainActor
final class WonderlandMenuRenderer {
    private weak var target: NSObject?

    init(target: NSObject?) {
        self.target = target
    }

    func render(_ state: ChaosMenuState) -> NSMenu {
        let menu = NSMenu()

        menu.addItem(WonderlandMenuFactory.header(
            status: state.operational ? "OPERATIONAL" : "STANDBY",
            detail: "Authority Verified"
        ))

        menu.addItem(WonderlandMenuFactory.section("Authority"))
        menu.addItem(WonderlandMenuFactory.row(icon: "◆", label: "Fingerprint", value: state.fingerprint, ok: state.fingerprint != "unknown"))
        menu.addItem(WonderlandMenuFactory.row(icon: "◆", label: "Lease", value: "\(state.leaseText) remaining", ok: !state.leaseText.lowercased().contains("expired")))
        menu.addItem(WonderlandMenuFactory.row(icon: "◆", label: "Touch ID", value: state.touchIDReady ? "Ready" : "Unavailable", ok: state.touchIDReady))
        menu.addItem(WonderlandMenuFactory.row(icon: "◆", label: "Controller", value: state.controllerOnline ? "Online" : "Offline", ok: state.controllerOnline))

        menu.addItem(.separator())

        menu.addItem(WonderlandMenuFactory.section("Scheduler"))
        menu.addItem(WonderlandMenuFactory.row(icon: "◌", label: "Enabled", value: state.schedulerEnabled ? "Yes" : "No", ok: state.schedulerEnabled))
        menu.addItem(WonderlandMenuFactory.row(icon: "⌁", label: "Strategy", value: state.schedulerStrategy, ok: true))
        menu.addItem(WonderlandMenuFactory.row(icon: "◎", label: "Current", value: state.currentModel.capitalized, ok: true))
        menu.addItem(WonderlandMenuFactory.row(icon: "◷", label: "Next", value: state.nextModelText.capitalized, ok: true))

        menu.addItem(.separator())

        menu.addItem(NSMenuItem(title: "Chaos Models", action: nil, keyEquivalent: ""))
        let scheduleItem = NSMenuItem(title: "Escalation Schedule", action: nil, keyEquivalent: "")
        let scheduleMenu = NSMenu(title: "Escalation Schedule")

        let runNow = NSMenuItem(
            title: "Run Schedule Now",
            action: #selector(ChaosMenubarApp.runScheduleNowV2(_:)),
            keyEquivalent: ""
        )
        runNow.target = target
        scheduleMenu.addItem(runNow)

        let start = NSMenuItem(
            title: "Start Scheduler",
            action: #selector(ChaosMenubarApp.startSchedulerV2(_:)),
            keyEquivalent: ""
        )
        start.target = target
        scheduleMenu.addItem(start)

        let pause = NSMenuItem(
            title: "Pause Scheduler",
            action: #selector(ChaosMenubarApp.pauseSchedulerV2(_:)),
            keyEquivalent: ""
        )
        pause.target = target
        scheduleMenu.addItem(pause)

        let resume = NSMenuItem(
            title: "Resume Scheduler",
            action: #selector(ChaosMenubarApp.resumeSchedulerV2(_:)),
            keyEquivalent: ""
        )
        resume.target = target
        scheduleMenu.addItem(resume)


        let stop = NSMenuItem(
            title: "Stop Scheduler",
            action: #selector(ChaosMenubarApp.stopSchedulerV2(_:)),
            keyEquivalent: ""
        )
        stop.target = target
        scheduleMenu.addItem(stop)

        scheduleItem.submenu = scheduleMenu
        menu.addItem(scheduleItem)
        let renewLease = NSMenuItem(title: "Renew Lease", action: nil, keyEquivalent: "")
        let renewMenu = NSMenu(title: "Renew Lease")

        let renewCurrent = NSMenuItem(title: "Renew Current Lease (12h)", action: #selector(ChaosMenubarApp.renewLease12hV2(_:)), keyEquivalent: "")
        renewCurrent.target = target
        renewMenu.addItem(renewCurrent)

        let forceRenew = NSMenuItem(title: "Force Renew…", action: #selector(ChaosMenubarApp.renewLease12hV2(_:)), keyEquivalent: "")
        forceRenew.target = target
        renewMenu.addItem(forceRenew)

        renewLease.submenu = renewMenu
        menu.addItem(renewLease)

        menu.addItem(.separator())

        menu.addItem(NSMenuItem(title: "Open Dashboard…", action: nil, keyEquivalent: ""))
        menu.addItem(NSMenuItem(title: "Open Logs", action: nil, keyEquivalent: ""))
        menu.addItem(NSMenuItem(title: "Open Chaos Folder", action: nil, keyEquivalent: ""))

        let checkIn = NSMenuItem(
            title: "Check In",
            action: #selector(ChaosMenubarApp.checkInV2(_:)),
            keyEquivalent: ""
        )
        checkIn.target = target
        menu.addItem(checkIn)

        menu.addItem(.separator())

        menu.addItem(WonderlandMenuFactory.action(icon: "⏻", label: "Quit") {
            NSApp.terminate(nil)
        })

        return menu
    }
}
