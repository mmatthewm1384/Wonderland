import Foundation

struct ChaosMenuState {
    let operational: Bool
    let displayState: String
    let statusText: String

    let fingerprint: String
    let leaseText: String
    let touchIDReady: Bool
    let controllerOnline: Bool

    let schedulerEnabled: Bool
    let schedulerStrategy: String
    let currentModel: String
    let nextModelText: String

    let lastCheckText: String

    static func from(status: ChaosStatus, statusText: String) -> ChaosMenuState {
        let authority = ChaosAuthorityStatusReader.load()
        let scheduler = ChaosScheduleStatusReader.load()

        return ChaosMenuState(
            operational: status.chaos_active,
            displayState: status.displayState,
            statusText: statusText,
            fingerprint: authority.fingerprintShort ?? "unknown",
            leaseText: authority.leaseSummary ?? "unknown",
            touchIDReady: authority.touchIDReady,
            controllerOnline: authority.controllerOnline,
            schedulerEnabled: scheduler.enabled,
            schedulerStrategy: scheduler.strategy ?? "unknown",
            currentModel: scheduler.currentModel ?? status.mode,
            nextModelText: scheduler.nextSummary ?? "unknown",
            lastCheckText: status.lastCheckText
        )
    }
}
