import AppKit
import Foundation

extension ChaosMenubarApp {
    @objc func runModelCalmV2(_ sender: NSMenuItem) { runModelV2("calm") }
    @objc func runModelNudgeV2(_ sender: NSMenuItem) { runModelV2("nudge") }
    @objc func runModelDriftV2(_ sender: NSMenuItem) { runModelV2("drift") }
    @objc func runModelStormV2(_ sender: NSMenuItem) { runModelV2("storm") }
    @objc func runModelBlackoutV2(_ sender: NSMenuItem) { runModelV2("blackout") }
    @objc func runModelCataclysmV2(_ sender: NSMenuItem) { runModelV2("cataclysm") }
    @objc func runModelRecoveryV2(_ sender: NSMenuItem) { runModelV2("recovery") }

    private func runModelV2(_ mode: String) {
        guard let model = ChaosModels.find(mode) else {
            statusText = "Denied: unknown model"
            refreshMenu()
            return
        }

        statusText = "Authorizing \(model.name)…"
        refreshMenu()

        executeChaosModel(model)
        refreshMenu()
    }
}
