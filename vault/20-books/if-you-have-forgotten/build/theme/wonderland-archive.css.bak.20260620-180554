:root {
  --wl-bg: #05070A;
  --wl-panel: #0B0F14;
  --wl-text: #D2DAE4;
  --wl-muted: #8A96A3;
  --wl-cyan: #00E5FF;
  --wl-purple: #7000FF;
  --wl-green: #00FF66;
}

html {
  background: var(--wl-bg);
}

body {
  background: var(--wl-bg);
  color: var(--wl-text);
  font-family: "JetBrainsMono Nerd Font", "JetBrains Mono", Menlo, monospace;
  font-size: 13px;
  line-height: 1.55;
  letter-spacing: .01em;
  word-spacing: .02em;
  max-width: 820px;
  margin: 0 auto;
  padding: 64px 32px 96px;
}

h1 {
  color: var(--wl-cyan);
  font-size: 2.1rem;
  letter-spacing: 0.04em;
  margin-top: 4rem;
  margin-bottom: 1.6rem;
}

h2 {
  color: var(--wl-purple);
  font-size: 1.35rem;
  margin-top: 2.8rem;
  margin-bottom: 1.2rem;
}

h3,
h4 {
  color: var(--wl-green);
  margin-top: 2rem;
}

p {
  margin: 1.05rem 0;
}

blockquote {
  border-left: 2px solid var(--wl-purple);
  color: var(--wl-muted);
  padding-left: 1rem;
  margin-left: 0;
  font-style: italic;
}

hr {
  border: 0;
  border-top: 1px solid var(--wl-muted);
  opacity: 0.45;
  margin: 2rem 0;
}

pre {
  background: var(--wl-panel);
  color: var(--wl-text);
  border: 1px solid rgba(0, 229, 255, 0.40);
  border-radius: 10px;
  padding: 1.25rem;
  overflow-x: auto;
  line-height: 1.35;
}

code {
  font-family: "JetBrainsMono Nerd Font", "JetBrains Mono", Menlo, monospace;
}

table {
  width: 100%;
  border-collapse: collapse;
  margin: 2rem 0;
}

th {
  color: var(--wl-cyan);
  border-bottom: 1px solid var(--wl-purple);
  text-align: left;
  padding: 0.55rem;
}

td {
  border-bottom: 1px solid rgba(138, 150, 163, 0.25);
  padding: 0.55rem;
}

a {
  color: var(--wl-cyan);
}

@media print {
  body {
    max-width: none;
  }
}
