#[no_mangle]
pub extern "C" fn wonderland_sanitize_ephemeral_buffer(ptr: *mut c_void, len: usize) {
    if !ptr.is_null() && len > 0 {
        unsafe {
            std::ptr::write_bytes(ptr, 0, len);
        }
    }
}

#[no_mangle]
pub extern "C" fn wonderland_crystal_verify_raw(
    payload_ptr: *const u8,
    payload_len: c_uint,
    signature_ptr: *const c_char,
) -> c_int {
    if payload_ptr.is_null() || signature_ptr.is_null() {
        return 0;
    }

    let payload = unsafe { std::slice::from_raw_parts(payload_ptr, payload_len as usize) };
    let c_str = unsafe { CStr::from_ptr(signature_ptr) };

    let Ok(sig_str) = c_str.to_str() else {
        return 0;
    };

    let crystal = MemoryCrystal {
        id: uuid::Uuid::nil(),
        payload: payload.to_vec(),
        signature: sig_str.to_string(),
    };

    if crystal.verify() { 1 } else { 0 }
}
