{
  "info": {
    "description": "REST API for the Wonderland local control plane.",
    "title": "Wonderland Platform API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/config": {
      "get": {
        "responses": {
          "200": {
            "description": "Effective configuration"
          }
        },
        "summary": "Return effective controller configuration"
      }
    },
    "/drift": {
      "get": {
        "responses": {
          "200": {
            "description": "Drift state"
          }
        },
        "summary": "Return drifted services"
      }
    },
    "/events": {
      "get": {
        "responses": {
          "200": {
            "description": "Recent events"
          }
        },
        "summary": "Return recent event stream"
      }
    },
    "/metrics": {
      "get": {
        "responses": {
          "200": {
            "description": "Prometheus exposition format"
          }
        },
        "summary": "Return Prometheus metrics"
      }
    },
    "/plugins": {
      "get": {
        "responses": {
          "200": {
            "description": "Plugin status"
          }
        },
        "summary": "Return loaded plugin status"
      }
    },
    "/ready": {
      "get": {
        "responses": {
          "200": {
            "description": "Readiness state"
          }
        },
        "summary": "Return platform readiness summary"
      }
    },
    "/schema": {
      "get": {
        "responses": {
          "200": {
            "description": "Schema validation result"
          }
        },
        "summary": "Return schema validation state"
      }
    },
    "/services": {
      "get": {
        "responses": {
          "200": {
            "description": "Service registry"
          }
        },
        "summary": "Return service registry"
      }
    },
    "/state": {
      "get": {
        "responses": {
          "200": {
            "description": "PlatformState"
          }
        },
        "summary": "Return full PlatformState"
      }
    },
    "/status": {
      "get": {
        "responses": {
          "200": {
            "description": "Status response"
          }
        },
        "summary": "Return platform status"
      }
    },
    "/stream": {
      "get": {
        "responses": {
          "200": {
            "description": "SSE stream"
          }
        },
        "summary": "Stream platform state changes as Server-Sent Events"
      }
    },
    "/timeline": {
      "get": {
        "responses": {
          "200": {
            "description": "Timeline summary"
          }
        },
        "summary": "Return timeline summary"
      }
    },
    "/version": {
      "get": {
        "responses": {
          "200": {
            "description": "Version manifest"
          }
        },
        "summary": "Return platform version metadata"
      }
    }
  },
  "servers": [
    {
      "url": "http://127.0.0.1:9105/api/v1"
    }
  ]
}
