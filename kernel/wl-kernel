#!/usr/bin/env bash
set -euo pipefail

WL_ROOT="${WL_ROOT:-$HOME/Wonderland}"
AUTH_ROOT="$WL_ROOT/authorities"
EVENT_DIR="$WL_ROOT/vault/registry/events"
INTENT_DIR="$WL_ROOT/vault/registry/intents"

mkdir -p "$EVENT_DIR" "$INTENT_DIR"

ts() { date -u '+%Y-%m-%dT%H:%M:%SZ'; }

event() {
  local authority="$1"
  local action="$2"
  local result="$3"
  local id
  id="$(date -u '+%Y%m%dT%H%M%SZ')-$authority-$action"

  cat > "$EVENT_DIR/$id.json" <<JSON
{
  "id": "$id",
  "timestamp": "$(ts)",
  "authority": "$authority",
  "action": "$action",
  "result": "$result"
}
JSON
}

usage() {
  cat <<EOF_USAGE
Usage:
  wl-kernel dispatch <authority> <action> [args...]
  wl-kernel status
  wl-kernel doctor
  wl-kernel certify
EOF_USAGE
}

dispatch() {
  local authority="$1"; shift
  local action="$1"; shift || true
  local bin="$AUTH_ROOT/$authority/$authority"

  if [ ! -x "$bin" ]; then
    echo "FAIL authority missing: $authority"
    event "$authority" "$action" "missing"
    exit 1
  fi

  if "$bin" "$action" "$@"; then
    event "$authority" "$action" "pass"
    "$WL_ROOT/bin/wl-audit" append "$authority" "$action" "pass" >/dev/null 2>&1 || true
  else
    event "$authority" "$action" "fail"
    "$WL_ROOT/bin/wl-audit" append "$authority" "$action" "fail" >/dev/null 2>&1 || true
    exit 1
  fi
}

case "${1:-}" in
  dispatch)
    shift
    dispatch "$@"
    ;;

  status)
    for a in "$AUTH_ROOT"/*; do
      [ -d "$a" ] || continue
      name="$(basename "$a")"
      if [ -x "$a/$name" ]; then
        "$a/$name" status || true
      fi
    done
    ;;

  doctor)
    failures=0
    for a in "$AUTH_ROOT"/*; do
      [ -d "$a" ] || continue
      name="$(basename "$a")"
      if [ -x "$a/$name" ]; then
        "$a/$name" doctor || failures=$((failures+1))
      else
        echo "FAIL $name authority executable missing"
        failures=$((failures+1))
      fi
    done

    [ "$failures" -eq 0 ] && echo "RESULT PASS" || { echo "RESULT FAIL"; exit 1; }
    ;;

  certify)
    "$0" doctor
    mkdir -p "$WL_ROOT/vault/registry/certifications"
    "$0" status > "$WL_ROOT/vault/registry/certifications/kernel-certification-$(date +%Y%m%d-%H%M%S).txt"
    echo "PASS kernel certified"
    ;;

  *)
    usage
    exit 2
    ;;
esac
