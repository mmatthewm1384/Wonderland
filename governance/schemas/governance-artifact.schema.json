{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wonderland:governance:artifact:1",
  "title": "Wonderland Governance Artifact",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "title",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft",
        "active",
        "deprecated",
        "retired"
      ]
    },
    "description": {
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": true
}
