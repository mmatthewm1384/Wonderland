#!/usr/bin/env bash
set -euo pipefail


# Platform Core 2.2 dispatch

# Platform Core 2.3 engineering dispatch

# Platform Core 2.3 maintenance dispatch

# Platform Core 2.3 report dispatch
case "${1:-}" in
  report)
    shift
    . "${WL_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}/lib/report/cli.sh"
    wl_report_main "$@"
    exit $?
    ;;
esac

case "${1:-}" in
  migrate)
    shift
    . "${WL_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}/lib/migrate/cli.sh"
    wl_migrate_main "$@"
    exit $?
    ;;
  refactor)
    shift
    . "${WL_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}/lib/refactor/cli.sh"
    wl_refactor_main "$@"
    exit $?
    ;;
esac

case "${1:-}" in
  architecture)
    shift
    . "${WL_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}/lib/architecture/cli.sh"
    wl_architecture_main "$@"
    exit $?
    ;;
  inventory)
    shift
    . "${WL_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}/lib/inventory/cli.sh"
    wl_inventory_main "$@"
    exit $?
    ;;
  lint)
    shift
    . "${WL_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}/lib/lint/cli.sh"
    wl_lint_main "$@"
    exit $?
    ;;
esac

case "${1:-}" in
  doctor)
    shift
    . "${WL_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}/lib/doctor/cli.sh"
    wl_doctor_main "$@"
    exit $?
    ;;
  registry)
    shift
    . "${WL_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}/lib/core/registry/command_registry_cli.sh"
    wl_registry_main "$@"
    exit $?
    ;;
esac

WL_HOME="${WL_HOME:-$HOME/Wonderland}"
WL_BOOTSTRAP="$WL_HOME/lib/wl-bootstrap.sh"

if [[ ! -f "$WL_BOOTSTRAP" ]]; then
  echo "FAIL bootstrap missing: $WL_BOOTSTRAP"
  echo "RESULT FAIL"
  exit 1
fi

source "$WL_BOOTSTRAP"
wl_dispatch "$@"
