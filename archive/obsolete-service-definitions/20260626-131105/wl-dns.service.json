{
  "id": "wl-dns-service-v4",
  "name": "wl-dns",
  "status": "active",
  "version": 4,
  "runtime": "containerd",
  "engine": "nerdctl",
  "container": "wl-dns",
  "compose": null,
  "verify": "bin/wl-dns doctor",
