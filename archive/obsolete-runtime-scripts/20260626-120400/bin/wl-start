#!/usr/bin/env bash
set -euo pipefail

WL_HOME="${WL_HOME:-$HOME/Wonderland}"
source "$WL_HOME/lib/wl-lifecycle-lib.sh"

wl_step "Wonderland Start"

wl_step "Preflight"
command -v limactl >/dev/null 2>&1 && wl_pass "limactl" || wl_fail "limactl"
command -v nerdctl >/dev/null 2>&1 && wl_pass "nerdctl" || wl_fail "nerdctl"
[ -d "$WL_HOME" ] && wl_pass "root" "$WL_HOME" || wl_fail "root"
[ -f "$WL_SERVICE_REGISTRY" ] && wl_pass "service registry" || wl_fail "service registry"
wl storage authority >/dev/null 2>&1 && wl_pass "storage authority" || wl_warn "storage authority"
wl governance status >/dev/null 2>&1 && wl_pass "governance" || wl_warn "governance"

wl_step "Starting Lima default"
limactl start default >/dev/null 2>&1 || true
wl_lima_running default && wl_pass "default running" || wl_fail "default not running"

wl_step "Starting core services"
for svc in $(wl_services); do
  nerdctl start "$svc" >/dev/null 2>&1 || true
  wl_container_running "$svc" && wl_pass "$svc" "up" || wl_warn "$svc" "not up"
done

wl_step "Starting wonderland-rootless"
limactl start wonderland-rootless >/dev/null 2>&1 || true
wl_lima_running wonderland-rootless && wl_pass "wonderland-rootless running" || wl_warn "wonderland-rootless not running"

wl_step "Ensuring rootless Loki config"
mkdir -p "$WL_HOME/runtime/wl-loki/config"

if [ ! -f "$WL_HOME/runtime/wl-loki/config/local-config.yaml" ]; then
cat > "$WL_HOME/runtime/wl-loki/config/local-config.yaml" <<'YAML'
auth_enabled: false
server:
  http_listen_port: 3100
  grpc_listen_port: 9096
common:
  path_prefix: /loki
  storage:
    filesystem:
      chunks_directory: /loki/chunks
      rules_directory: /loki/rules
  replication_factor: 1
  ring:
    kvstore:
      store: inmemory
schema_config:
  configs:
    - from: 2024-01-01
      store: tsdb
      object_store: filesystem
      schema: v13
      index:
        prefix: index_
        period: 24h
limits_config:
  allow_structured_metadata: false
  retention_period: 168h
compactor:
  working_directory: /loki/compactor
  retention_enabled: true
  delete_request_store: filesystem
YAML
  wl_pass "rootless loki config" "created"
else
  wl_pass "rootless loki config" "exists"
fi

wl_step "Starting rootless services"
for svc in $(wl_rootless_services); do
  LIMA_INSTANCE=wonderland-rootless nerdctl start "$svc" >/dev/null 2>&1 || true
  wl_rootless_container_running "$svc" && wl_pass "rootless $svc" "up" || wl_warn "rootless $svc" "not up"
done

wl_step "Verification"
"$WL_HOME/bin/wl-doctor-lifecycle" || true
"$WL_HOME/bin/wl-lifecycle-report" start || true
"$WL_HOME/bin/wl-universe" status
