{
  "orchestrator": "runtime-execution-orchestrator-v1",

  "flow": [
    "receive_command",
    "resolve_target",
    "select_adapter",
    "create_transaction",
    "capture_state",
    "execute",
    "verify",
    "commit",
    "emit_certificate"
  ],

  "failure_flow": [
    "capture_failure",
    "invoke_recovery",
    "restore_state",
    "emit_failure_certificate"
  ],

  "dependencies": [
    "runtime-lifecycle-controller-v1",
    "runtime-transaction-engine-v1",
    "runtime-target-resolver-v1",
    "runtime-adapter-lima-v1",
    "runtime-state-store-v1",
    "runtime-evidence-certificate-v1"
  ]
}
