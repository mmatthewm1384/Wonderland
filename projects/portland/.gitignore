.DS_Store
.AppleDouble
.LSOverride
._*
*.swp
*.swo
*~
.env
.env.*
!.env.example
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.cache/
.tmp/
tmp/
build/
dist/
*.log

# Spatial / analytical data: keep data manifests, not bulk source payloads.
data/**/*
!data/**/README.md
!data/**/.gitkeep
!data/**/manifest.yaml
!data/**/manifest.json
!data/**/LICENSE.txt
!data/**/NOTICE.txt

# Generated outputs are reproducible derivatives unless intentionally promoted.
outputs/
reports/generated/
maps/exports/
models/runs/
evidence/runs/**/*
!evidence/runs/README.md
!evidence/runs/.gitkeep

# Secrets, credentials, and private access material.
*.pem
*.key
*.p12
*.pfx
credentials.*
secrets.*
