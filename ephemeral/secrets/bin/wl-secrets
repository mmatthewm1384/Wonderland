#!/usr/bin/env bash
set -euo pipefail

SECRETS_DIR="${SECRETS_DIR:-$HOME/Wonderland/ephemeral/secrets}"

usage() {
  cat <<HELP
wl secrets

Usage:
  wl secrets doctor
  wl secrets unlock
  wl secrets lock
  wl secrets status
  wl secrets list
  wl secrets ram-get <item> [field]
  wl secrets pipe <item> [field] -- <command...>
  wl secrets certify
HELP
}

need_bw() {
  command -v bw >/dev/null 2>&1 || {
    echo "FAIL missing Bitwarden CLI: bw"
    exit 1
  }
}

bw_session() {
  if [[ -n "${BW_SESSION:-}" ]]; then
    echo "$BW_SESSION"
    return 0
  fi

  local status
  status="$(bw status 2>/dev/null | jq -r '.status // empty' || true)"

  case "$status" in
    unlocked)
      bw unlock --raw
      ;;
    locked)
      bw unlock --raw
      ;;
    unauthenticated|"")
      echo "FAIL Bitwarden unauthenticated. Run: bw login" >&2
      return 1
      ;;
    *)
      echo "FAIL unknown Bitwarden status: $status" >&2
      return 1
      ;;
  esac
}

cmd="${1:-help}"
shift || true

case "$cmd" in
  doctor)
    need_bw
    echo "== wl-secrets doctor =="
    echo "SECRETS_DIR=$SECRETS_DIR"
    echo "bw version: $(bw --version)"
    bw status
    echo "RESULT PASS"
    ;;

  unlock)
    need_bw
    bw unlock --raw | awk '{print "export BW_SESSION=\"" $0 "\""}'
    ;;

  lock)
    need_bw
    bw lock >/dev/null || true
    echo "PASS bw locked"
    ;;

  status)
    need_bw
    bw status
    ;;

  list)
    need_bw
    SESSION="$(bw_session)"
    bw list items --session "$SESSION" | jq -r '.[].name'
    ;;

  ram-get)
    need_bw
    item="${1:-}"
    field="${2:-password}"

    [[ -n "$item" ]] || {
      echo "FAIL usage: wl secrets ram-get <item> [field]" >&2
      exit 1
    }

    SESSION="$(bw_session)"
    bw get "$field" "$item" --session "$SESSION"
    ;;

  pipe)
    need_bw
    item="${1:-}"
    field="${2:-password}"
    shift 2 || true

    [[ "${1:-}" == "--" ]] || {
      echo "FAIL usage: wl secrets pipe <item> [field] -- <command...>" >&2
      exit 1
    }
    shift

    [[ -n "$item" ]] || {
      echo "FAIL missing item" >&2
      exit 1
    }

    [[ "$#" -gt 0 ]] || {
      echo "FAIL missing command" >&2
      exit 1
    }

    SESSION="$(bw_session)"
    bw get "$field" "$item" --session "$SESSION" | "$@"
    ;;

  certify)
    need_bw
    CERT="$HOME/Wonderland/vault/certifications/secrets-certified-$(date +%Y%m%d).md"

    {
      echo "# Secrets Layer Certification"
      echo
      echo "Date: $(date -Iseconds)"
      echo
      echo "## Checks"
      echo
    } > "$CERT"

    bw status >> "$CERT"

    {
      echo
      echo "RESULT PASS"
    } >> "$CERT"

    cat "$CERT"
    ;;

  help|--help|-h)
    usage
    ;;

  *)
    echo "Unknown wl secrets command: $cmd"
    usage
    exit 1
    ;;
esac
