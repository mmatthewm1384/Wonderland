#!/usr/bin/env bash
set -euo pipefail

APP="$HOME/Wonderland/ephemeral/theomatrix/app"

case "${1:-help}" in
start) cd "$APP" && npm start ;;
doctor) cd "$APP" && npm run doctor ;;
certify) cd "$APP" && npm run certify ;;
replay) cd "$APP" && npm run replay ;;
path) echo "$APP" ;;
*)
cat <<HELP
wl-theomatrix commands:
start
doctor
certify
replay
path
HELP
;;
esac
