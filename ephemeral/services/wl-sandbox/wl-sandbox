#!/usr/bin/env bash
set -e

SERVICE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VENV_DIR="$SERVICE_DIR/.venv"

# Automated isolated python sandbox execution virtual environment wrapper
if [ ! -d "$VENV_DIR" ]; then
    python3 -m venv "$VENV_DIR"
fi

exec "$VENV_DIR/bin/python3" "$SERVICE_DIR/sandbox_manager.py" "$@"
