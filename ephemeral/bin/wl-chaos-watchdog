#!/usr/bin/env bash
set -euo pipefail

ROOT="${WL_ROOT:-$HOME/Wonderland}"
EPH="$ROOT/ephemeral"
WATCH="$EPH/agents/chaos-watchdog-v4/chaos_watchdog.py"
CHAOS="$ROOT/vault/chaos"
PID="$CHAOS/chaos-watchdog.pid"
LOG="$CHAOS/watchdog.log"

mkdir -p "$CHAOS"

case "${1:-status}" in
  up)
    if [[ -f "$PID" ]] && kill -0 "$(cat "$PID")" 2>/dev/null; then
      echo "chaos-watchdog already running: $(cat "$PID")"
      exit 0
    fi
    nohup python3 "$WATCH" run >> "$LOG" 2>&1 &
    echo $! > "$PID"
    echo "chaos-watchdog started: $!"
    ;;
  down)
    if [[ -f "$PID" ]]; then
      P="$(cat "$PID")"
      kill "$P" 2>/dev/null || true
      sleep 2
      kill -9 "$P" 2>/dev/null || true
      rm -f "$PID"
    fi
    echo "chaos-watchdog stopped"
    ;;
  status)
    if [[ -f "$PID" ]] && kill -0 "$(cat "$PID")" 2>/dev/null; then
      echo "chaos-watchdog running: $(cat "$PID")"
    else
      echo "chaos-watchdog stopped"
    fi
    python3 "$WATCH" aether-status
    ;;
  doctor)
    python3 "$WATCH" doctor
    ;;
  logs)
    tail -80 "$LOG" 2>/dev/null || true
    ;;
  repair)
    if [[ -f "$PID" ]] && ! kill -0 "$(cat "$PID")" 2>/dev/null; then
      rm -f "$PID"
    fi
    "$0" up
    python3 "$WATCH" doctor
    ;;
  reset)
    "$0" down || true
    python3 "$WATCH" reset
    ;;
  install-launchd)
    mkdir -p "$HOME/Library/LaunchAgents" "$CHAOS"
    PLIST="$HOME/Library/LaunchAgents/com.wonderland.chaos-watchdog.plist"

    cat > "$PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
 "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.wonderland.chaos-watchdog</string>

  <key>ProgramArguments</key>
  <array>
    <string>$0</string>
    <string>up</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>WL_ROOT</key>
    <string>$ROOT</string>
    <key>PATH</key>
    <string>$ROOT/ephemeral/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <false/>

  <key>StandardOutPath</key>
  <string>$CHAOS/launchd.out.log</string>

  <key>StandardErrorPath</key>
  <string>$CHAOS/launchd.err.log</string>

  <key>WorkingDirectory</key>
  <string>$ROOT</string>
</dict>
</plist>
EOF

    launchctl bootout "gui/$(id -u)" "$PLIST" >/dev/null 2>&1 || true
    launchctl bootstrap "gui/$(id -u)" "$PLIST"
    launchctl enable "gui/$(id -u)/com.wonderland.chaos-watchdog"
    launchctl kickstart -k "gui/$(id -u)/com.wonderland.chaos-watchdog"

    echo "Installed LaunchAgent: $PLIST"
    ;;
  uninstall-launchd)
    PLIST="$HOME/Library/LaunchAgents/com.wonderland.chaos-watchdog.plist"
    launchctl bootout "gui/$(id -u)" "$PLIST" >/dev/null 2>&1 || true
    rm -f "$PLIST"
    echo "Removed LaunchAgent: $PLIST"
    ;;
  launchd-status)
    PLIST="$HOME/Library/LaunchAgents/com.wonderland.chaos-watchdog.plist"
    echo "LaunchAgent plist: $PLIST"
    [[ -f "$PLIST" ]] && echo "plist: present" || echo "plist: missing"
    launchctl print "gui/$(id -u)/com.wonderland.chaos-watchdog" 2>/dev/null || echo "launchd: not loaded"
    ;;
  launchd-restart)
    PLIST="$HOME/Library/LaunchAgents/com.wonderland.chaos-watchdog.plist"
    if [[ ! -f "$PLIST" ]]; then
      echo "LaunchAgent missing. Run: wl-chaos-watchdog install-launchd"
      exit 1
    fi
    launchctl kickstart -k "gui/$(id -u)/com.wonderland.chaos-watchdog"
    echo "Restarted LaunchAgent"
    ;;
  aether-status)
    python3 "$WATCH" aether-status
    ;;
  checkin)
    python3 "$WATCH" checkin
    ;;
  countdown)
    python3 "$WATCH" countdown
    ;;
  escalate)
    python3 "$WATCH" escalate
    ;;
  *)
    echo "Usage: wl-chaos-watchdog up|down|status|doctor|logs|repair|reset|aether-status|checkin|countdown|escalate|install-launchd|uninstall-launchd|launchd-status|launchd-restart"
    exit 2
    ;;
esac
