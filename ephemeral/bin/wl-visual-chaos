#!/usr/bin/env bash
set -euo pipefail

ROOT="${WL_HOME:-$HOME/Wonderland}"
AUDIT="$ROOT/vault/chaos/visual-chaos-audit.jsonl"
APP_DIR="$ROOT/releases/the-matrix"
mkdir -p "$(dirname "$AUDIT")"

launch_app() {
  local app="$1"
  if [[ -d "$app" ]]; then
    open "$app" || true
    echo "PASS launched: $app"
  else
    echo "WARN missing app: $app"
  fi
}

case "${1:-launch-all}" in
  launch-all|up|start)
    launch_app "$APP_DIR/Spin City Wave.app"
    launch_app "$APP_DIR/Agitate Waves.app"
    launch_app "$APP_DIR/Matrix Atom Destroyer.app"
    ;;
  *)
    echo "Usage: wl-visual-chaos launch-all"
    exit 64
    ;;
esac

NOW="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
printf '{"ts":"%s","event":"visual_chaos_launch","surface":"the-matrix"}\n' "$NOW" >> "$AUDIT"
