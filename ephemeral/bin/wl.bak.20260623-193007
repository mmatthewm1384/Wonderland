#!/usr/bin/env bash

# wl-secrets route
if [ "${1:-}" = "secrets" ]; then
  exec "$HOME/Wonderland/ephemeral/secrets/bin/wl-secrets" "${@:2}"
fi

set -euo pipefail

ROOT="${WL_ROOT:-$HOME/Wonderland}"
MANAGER="$ROOT/ephemeral/ephemeral_manager.py"

mkdir -p "$ROOT/ephemeral" "$ROOT/vault/renders"

if [[ ! -f "$MANAGER" ]]; then
  echo "Missing manager: $MANAGER"
  exit 1
fi

exec python3 "$MANAGER" "$@"
