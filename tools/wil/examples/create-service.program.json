{
  "kind": "program",
  "id": "create-service",
  "version": 0,
  "intent": "Create a Wonderland service skeleton",
  "variables": {
    "service": "wl-time-machine"
  },
  "do": [
    {
      "name": "create-service-dir",
      "run": "mkdir -p services/${service}"
    },
    {
      "name": "create-data-dir",
      "run": "mkdir -p services/${service}/data"
    },
    {
      "name": "create-readme",
      "run": "test -f services/${service}/README.md || echo '# ${service}' > services/${service}/README.md"
    }
  ],
  "prove": [
    {
      "name": "service-dir-exists",
      "command": "test -d services/${service}"
    },
    {
      "name": "readme-exists",
      "command": "test -f services/${service}/README.md"
    }
  ],
  "recover": [
    {
      "name": "recreate-service-dir",
      "run": "mkdir -p services/${service}"
    },
    {
      "name": "recreate-data-dir",
      "run": "mkdir -p services/${service}/data"
    },
    {
      "name": "recreate-readme",
      "run": "test -f services/${service}/README.md || echo '# ${service}' > services/${service}/README.md"
    }
  ],
  "rollback": [
    {
      "name": "remove-service-skeleton",
      "run": "rm -rf services/${service}"
    }
  ],
  "outputs": [
    {
      "kind": "directory",
      "path": "services/${service}"
    },
    {
      "kind": "directory",
      "path": "services/${service}/data"
    },
    {
      "kind": "file",
      "path": "services/${service}/README.md"
    }
  ]
}