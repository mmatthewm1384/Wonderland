#!/usr/bin/env python3
import json
from pathlib import Path

root = Path.cwd()
reg = root / "01-Platform/registry/builder-ownership.json"
data = json.loads(reg.read_text())
failures = 0

for name, item in sorted(data["builders"].items()):
    for key in ["legacy_path", "constitutional_area", "target", "owner", "purpose", "outputs", "state"]:
        if key not in item:
            print(f"FAIL builder {name} missing {key}")
            failures += 1

    if (root / item["legacy_path"]).exists():
        print(f"PASS builder {name} legacy path present: {item['legacy_path']}")
    else:
        print(f"WARN builder {name} legacy path missing: {item['legacy_path']}")

    if (root / item["constitutional_area"]).exists():
        print(f"PASS builder {name} constitutional area: {item['constitutional_area']}")
    else:
        print(f"FAIL builder {name} constitutional area missing: {item['constitutional_area']}")
        failures += 1

    print(f"INFO builder {name} target: {item['target']}")

if failures:
    print("RESULT FAIL")
    raise SystemExit(1)

print("PASS builder ownership registry verified")
print("RESULT PASS")
