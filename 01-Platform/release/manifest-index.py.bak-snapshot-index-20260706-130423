#!/usr/bin/env python3
from __future__ import annotations

import json
from datetime import datetime, timezone
from pathlib import Path


ROOT = Path(__file__).resolve().parents[2]
OUT = ROOT / "05-Vault/generated/indexes/manifest-index.json"

SOURCES = [
    ROOT / "05-Vault/generated/releases",
    ROOT / "05-Vault/generated/certifications",
    ROOT / "05-Vault/generated/platform-certifications",
]


def load_manifest(path: Path) -> dict:
    try:
        data = json.loads(path.read_text())
    except Exception as exc:
        return {
            "path": str(path.relative_to(ROOT)),
            "status": "INVALID",
            "error": str(exc),
        }

    return {
        "path": str(path.relative_to(ROOT)),
        "id": data.get("release_id") or data.get("certification_id") or data.get("platform_certification_id") or path.parent.name,
        "status": data.get("status", "UNKNOWN"),
        "created_at": data.get("created_at", ""),
        "mode": data.get("mode", ""),
        "destructive_changes": data.get("destructive_changes", None),
    }


def main() -> int:
    manifests = []

    for source in SOURCES:
        if not source.exists():
            continue
        for path in sorted(source.rglob("*-manifest.json")):
            manifests.append(load_manifest(path))

    index = {
        "created_at": datetime.now(timezone.utc).isoformat(),
        "manifest_count": len(manifests),
        "manifests": manifests,
    }

    OUT.parent.mkdir(parents=True, exist_ok=True)
    OUT.write_text(json.dumps(index, indent=2, sort_keys=True) + "\n")

    print("Wonderland Manifest Index")
    print()
    print(f"Manifests: {len(manifests)}")
    print(f"Index: {OUT.relative_to(ROOT)}")

    failures = sum(1 for item in manifests if item.get("status") not in {"PASS"})
    invalid = sum(1 for item in manifests if item.get("status") == "INVALID")

    print(f"Non-pass manifests: {failures}")
    print(f"Invalid manifests: {invalid}")

    if invalid:
        print("RESULT FAIL")
        return 1

    print("RESULT PASS")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
