{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wonderland.local/schemas/SOVEREIGN-001/v0.1/common.schema.json",
  "title": "SOVEREIGN-001 Common Definitions",
  "type": "object",
  "$defs": {
    "identity": { "type": "string", "minLength": 1 },
    "uri": { "type": "string", "format": "uri" },
    "hash": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
    "status": { "type": "string", "minLength": 1 },
    "objectClass": {
      "type": "string",
      "enum": ["PROPERTY", "PARCEL", "TITLE", "JURISDICTION", "SOVEREIGNTY", "GOVERNMENTAL_AUTHORITY", "CONTRACTUAL_RIGHT", "ORGANIZATION", "OTHER"]
    },
    "transferType": {
      "type": "string",
      "enum": ["SALE", "PURCHASE", "TRANSFER", "CESSION", "ASSIGNMENT", "CONVEYANCE", "EXCHANGE", "GIFT", "SUCCESSION", "MERGER", "OTHER"]
    },
    "party": {
      "type": "object",
      "properties": {
        "identity": { "$ref": "#/$defs/identity" },
        "legal_capacity": { "type": "string", "minLength": 1 },
        "authority": { "type": "string", "minLength": 1 }
      },
      "required": ["identity"],
      "additionalProperties": false
    },
    "instrument": {
      "type": "object",
      "properties": {
        "instrument_id": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "issuer": { "type": "string", "minLength": 1 },
        "date": { "type": "string", "format": "date" },
        "execution_date": { "type": "string", "format": "date" },
        "effective_date": { "type": "string", "format": "date" },
        "repository": { "$ref": "#/$defs/uri" },
        "original_reference": { "type": "string", "minLength": 1 },
        "content_hash": { "$ref": "#/$defs/hash" },
        "authenticity_status": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["IDENTIFIED", "NOT_FOUND", "UNKNOWN"] }
      },
      "additionalProperties": false
    },
    "authority": {
      "type": "object",
      "properties": {
        "authority_id": { "type": "string", "minLength": 1 },
        "authority_holder": { "type": "string", "minLength": 1 },
        "authority_type": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "scope": { "type": "string", "minLength": 1 },
        "limitations": { "type": "array", "items": { "type": "string" } },
        "verification_status": { "type": "string", "enum": ["VERIFIED", "UNVERIFIED", "UNESTABLISHED", "UNKNOWN"] }
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "properties": {
        "date": { "type": "string", "format": "date" },
        "location": { "type": "string", "minLength": 1 },
        "signatories": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "witnesses": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "seals": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "authentication": { "type": "string", "minLength": 1 },
        "notarization": { "type": "string", "minLength": 1 },
        "diplomatic_exchange": { "type": "string", "minLength": 1 },
        "execution_evidence": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    },
    "dateRecord": {
      "type": "object",
      "properties": {
        "date": { "type": "string", "format": "date" },
        "date_type": { "type": "string", "enum": ["SIGNING_DATE", "EXECUTION_DATE", "ACCEPTANCE_DATE", "REGISTRATION_DATE", "EFFECTIVE_DATE"] },
        "source": { "type": "string", "minLength": 1 }
      },
      "required": ["date", "date_type"],
      "additionalProperties": false
    },
    "consideration": {
      "type": "object",
      "properties": {
        "status": { "type": "string", "enum": ["KNOWN", "UNKNOWN", "NOT_FOUND", "NOT_APPLICABLE"] },
        "required": { "type": "boolean" },
        "type": { "type": "string", "minLength": 1 },
        "amount": { "type": "number", "minimum": 0 },
        "currency": { "type": "string", "minLength": 1 },
        "payer": { "type": "string", "minLength": 1 },
        "recipient": { "type": "string", "minLength": 1 },
        "payment_date": { "type": "string", "format": "date" },
        "payment_instrument": { "type": "string", "minLength": 1 },
        "evidence": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    },
    "register": {
      "type": "object",
      "properties": {
        "register_id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "registrar_id": { "type": "string", "minLength": 1 },
        "jurisdiction": { "type": "string", "minLength": 1 },
        "register_type": { "type": "string", "minLength": 1 },
        "repository": { "$ref": "#/$defs/uri" },
        "access_method": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["REGISTER_IDENTIFIED", "REGISTER_NOT_IDENTIFIED", "REGISTER_INACCESSIBLE", "REGISTER_DESTROYED", "REGISTER_ARCHIVED", "REGISTER_CLOSED", "UNKNOWN"] }
      },
      "additionalProperties": false
    },
    "registerEntry": {
      "type": "object",
      "properties": {
        "entry_id": { "type": "string", "minLength": 1 },
        "register_id": { "type": "string", "minLength": 1 },
        "entry_number": { "type": "string", "minLength": 1 },
        "registration_date": { "type": "string", "format": "date" },
        "recorded_parties": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "recorded_object": { "type": "string", "minLength": 1 },
        "recorded_instrument": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "content_hash": { "$ref": "#/$defs/hash" },
        "authenticity_status": { "type": "string", "minLength": 1 }
      },
      "required": ["entry_id", "register_id"],
      "additionalProperties": false
    },
    "registerEntryReference": {
      "type": "object",
      "properties": {
        "status": { "type": "string", "enum": ["FOUND", "NOT_FOUND", "UNKNOWN"] },
        "entry": { "$ref": "#/$defs/registerEntry" }
      },
      "required": ["status"],
      "allOf": [
        { "if": { "properties": { "status": { "const": "FOUND" } } }, "then": { "required": ["entry"] } },
        { "if": { "properties": { "status": { "const": "NOT_FOUND" } } }, "then": { "not": { "required": ["entry"] } } }
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "evidence_id": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "issuer": { "type": "string", "minLength": 1 },
        "retrieved_at": { "type": "string", "format": "date-time" },
        "original_location": { "$ref": "#/$defs/uri" },
        "content": {},
        "content_hash": { "$ref": "#/$defs/hash" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "authenticity": { "type": "string", "minLength": 1 },
        "integrity": { "type": "string", "minLength": 1 },
        "supports": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "contradicts": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
      "required": ["evidence_id", "type", "source", "content_hash", "provenance", "integrity"],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "obtained_by": { "type": "string", "minLength": 1 },
        "obtained_at": { "type": "string", "format": "date-time" },
        "source_location": { "$ref": "#/$defs/uri" },
        "method": { "type": "string", "minLength": 1 },
        "modified": { "type": "boolean" }
      },
      "required": ["obtained_by", "obtained_at", "method", "modified"],
      "additionalProperties": false
    },
    "contradiction": {
      "type": "object",
      "properties": {
        "evidence_id": { "type": "string", "minLength": 1 },
        "proposition": { "type": "string", "minLength": 1 },
        "conflict": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "explanation": { "type": "string", "minLength": 1 }
      },
      "required": ["evidence_id", "proposition", "conflict", "source", "explanation"],
      "additionalProperties": false
    },
    "determination": {
      "type": "object",
      "properties": {
        "status": { "type": "string", "enum": ["ESTABLISHED", "SUPPORTED", "UNESTABLISHED", "CONTRADICTED", "CONFLICTING", "INCOMPLETE", "UNKNOWN"] },
        "proposition": { "type": "string", "minLength": 1 },
        "evidence": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "contradictions": { "type": "array", "items": { "$ref": "#/$defs/contradiction" } },
        "unresolved": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "methodology": { "type": "string", "minLength": 1 },
        "verifier": { "type": "string", "minLength": 1 },
        "verified_at": { "type": "string", "format": "date-time" }
      },
      "required": ["status", "proposition", "methodology"],
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "properties": {
        "sequence": { "type": "integer", "minimum": 1 },
        "previous_hash": { "$ref": "#/$defs/hash" },
        "event_hash": { "$ref": "#/$defs/hash" },
        "timestamp": { "type": "string", "format": "date-time" },
        "actor": { "type": "string", "minLength": 1 },
        "operation": { "type": "string", "minLength": 1 },
        "payload": {}
      },
      "required": ["sequence", "event_hash", "timestamp", "actor", "operation", "payload"],
      "additionalProperties": false
    }
  }
}
