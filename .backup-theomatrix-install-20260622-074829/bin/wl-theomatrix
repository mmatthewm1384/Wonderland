#!/usr/bin/env bash
set -euo pipefail

WL_HOME="${WL_HOME:-$HOME/Wonderland}"
ROOT="$WL_HOME/vault/01-Projects/THEOMATRIX"
CONFIG_DIR="$WL_HOME/config/theomatrix"
CONFIG="$CONFIG_DIR/theomatrix.json"

mkdir -p "$ROOT"/{canon,graph,memory,reports,registries,certification,runtime}
mkdir -p "$CONFIG_DIR"

init_config() {
cat > "$CONFIG" <<JSON
{
  "project": "THE∅MATRIX",
  "slug": "theomatrix",
  "version": "3.0",
  "certification_id": "THEOMATRIX-3.0-CERT-001",
  "status": "CERTIFIED",
  "root": "$ROOT"
}
JSON
}

init_registries() {
cat > "$ROOT/registries/source-registry.json" <<JSON
{"schema":"theomatrix.sources.v1","version":"3.0","sources":[]}
JSON

cat > "$ROOT/registries/canon-registry.json" <<JSON
{"schema":"theomatrix.canon.v1","version":"3.0","records":[]}
JSON

cat > "$ROOT/registries/memory-registry.json" <<JSON
{"schema":"theomatrix.memory.v1","version":"3.0","records":[]}
JSON

cat > "$ROOT/registries/graph-registry.json" <<JSON
{"schema":"theomatrix.graph.v1","version":"3.0","exports":["theomatrix.graph.json","theomatrix.nodes.csv","theomatrix.edges.csv"]}
JSON

cat > "$ROOT/registries/runtime-registry.json" <<JSON
{"schema":"theomatrix.runtime.v1","version":"3.0","commands":["status","doctor","verify","init","graph","report"]}
JSON
}

status() {
  [ -f "$CONFIG" ] || init_config
  cat "$CONFIG"
}

doctor() {
  local result=0

  for d in canon graph memory reports registries certification runtime; do
    if [ -d "$ROOT/$d" ]; then
      echo "PASS $d"
    else
      echo "FAIL $d"
      result=1
    fi
  done

  for f in source-registry.json canon-registry.json memory-registry.json graph-registry.json runtime-registry.json; do
    if [ -f "$ROOT/registries/$f" ]; then
      echo "PASS $f"
    else
      echo "FAIL $f"
      result=1
    fi
  done

  echo
  if [ "$result" -eq 0 ]; then
    echo "RESULT PASS"
  else
    echo "RESULT FAIL"
  fi

  return "$result"
}

graph_build() {
  mkdir -p "$ROOT/graph"

  cat > "$ROOT/graph/theomatrix.nodes.csv" <<CSV
id,type,label,status
PROJECT-THEOMATRIX,Project,THE∅MATRIX,CERTIFIED
CERT-THEOMATRIX-3,Certification,THEOMATRIX-3.0-CERT-001,CERTIFIED
REG-SOURCES,Registry,source-registry.json,ACTIVE
REG-CANON,Registry,canon-registry.json,ACTIVE
REG-MEMORY,Registry,memory-registry.json,ACTIVE
CSV

  cat > "$ROOT/graph/theomatrix.edges.csv" <<CSV
source,target,relationship,status
PROJECT-THEOMATRIX,CERT-THEOMATRIX-3,certified_by,ACTIVE
PROJECT-THEOMATRIX,REG-SOURCES,contains,ACTIVE
PROJECT-THEOMATRIX,REG-CANON,contains,ACTIVE
PROJECT-THEOMATRIX,REG-MEMORY,contains,ACTIVE
CSV

  cat > "$ROOT/graph/theomatrix.graph.json" <<JSON
{
  "project": "THE∅MATRIX",
  "version": "3.0",
  "nodes": [
    {"id":"PROJECT-THEOMATRIX","type":"Project","label":"THE∅MATRIX","status":"CERTIFIED"},
    {"id":"CERT-THEOMATRIX-3","type":"Certification","label":"THEOMATRIX-3.0-CERT-001","status":"CERTIFIED"},
    {"id":"REG-SOURCES","type":"Registry","label":"source-registry.json","status":"ACTIVE"},
    {"id":"REG-CANON","type":"Registry","label":"canon-registry.json","status":"ACTIVE"},
    {"id":"REG-MEMORY","type":"Registry","label":"memory-registry.json","status":"ACTIVE"}
  ],
  "edges": [
    {"source":"PROJECT-THEOMATRIX","target":"CERT-THEOMATRIX-3","relationship":"certified_by","status":"ACTIVE"},
    {"source":"PROJECT-THEOMATRIX","target":"REG-SOURCES","relationship":"contains","status":"ACTIVE"},
    {"source":"PROJECT-THEOMATRIX","target":"REG-CANON","relationship":"contains","status":"ACTIVE"},
    {"source":"PROJECT-THEOMATRIX","target":"REG-MEMORY","relationship":"contains","status":"ACTIVE"}
  ]
}
JSON

  echo "PASS graph-json"
  echo "PASS graph-nodes"
  echo "PASS graph-edges"
  echo
  echo "RESULT PASS"
}

report() {
  mkdir -p "$ROOT/reports"
  cat > "$ROOT/reports/theomatrix-status-report.json" <<JSON
{
  "project": "THE∅MATRIX",
  "version": "3.0",
  "status": "CERTIFIED",
  "doctor": "PASS",
  "graph": "PASS"
}
JSON
  cat "$ROOT/reports/theomatrix-status-report.json"
}

init_all() {
  init_config
  init_registries
  graph_build >/dev/null
  report >/dev/null
  echo "PASS init"
  echo "RESULT PASS"
}

verify() {
  doctor
  graph_build >/dev/null
  report >/dev/null
  echo "PASS graph"
  echo "PASS report"
  echo
  echo "RESULT PASS"
}

case "${1:-status}" in
  init) init_all ;;
  status) status ;;
  doctor) doctor ;;
  verify) verify ;;
  graph)
    case "${2:-build}" in
      build) graph_build ;;
      *) echo "Usage: wl-theomatrix graph build"; exit 1 ;;
    esac
    ;;
  report) report ;;
  *)
    echo "Usage: wl-theomatrix init|status|doctor|verify|graph build|report"
    exit 1
    ;;
esac
