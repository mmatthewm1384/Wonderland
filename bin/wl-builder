#!/usr/bin/env bash
set -Eeuo pipefail

ROOT="${WL_HOME:-${WONDERLAND_ROOT:-}}"

if [[ -z "$ROOT" ]]; then
  ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
fi

export WL_HOME="$ROOT"
export WONDERLAND_ROOT="$ROOT"

usage() {
  cat <<'USAGE'
Usage:
  wl builder status
  wl builder doctor
  wl builder verify [--json] [--verbose]
  wl builder certify [--json] [--full]
  wl builder build [args...]
  wl builder shell [args...]
  wl builder start [args...]
  wl builder stop [args...]
  wl builder help

Command classes:
  verify    Host-safe, read-only structural verification
  certify   Generate deterministic certification evidence
  build     Explicit image or artifact build; may start the Builder VM
  start     Explicitly start Builder infrastructure
  stop      Explicitly stop Builder infrastructure
  shell     Explicitly enter the Builder environment
  status    Read-only operational status
  doctor    Host-side Builder diagnostics
USAGE
}

find_legacy_launcher() {
  local candidate

  for candidate in \
    "$ROOT/bin/wl-builder-legacy" \
    "$ROOT/bin/wlbuilder" \
    "$ROOT/builder/bin/wl-builder" \
    "$ROOT/builder/wl-builder"
  do
    if [[ -x "$candidate" && "$candidate" != "$ROOT/bin/wl-builder" ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done

  return 1
}

run_legacy() {
  local legacy

  if ! legacy="$(find_legacy_launcher)"; then
    printf 'FAIL no legacy Builder operational launcher available\n' >&2
    exit 1
  fi

  exec "$legacy" "$@"
}

status_command() {
  local legacy

  if legacy="$(find_legacy_launcher)"; then
    WL_NONINTERACTIVE=1 \
    WL_STATUS_ONLY=1 \
      "$legacy" status "$@"
    return $?
  fi

  if command -v limactl >/dev/null 2>&1; then
    local output

    output="$(limactl list --json 2>/dev/null || true)"

    if [[ -n "$output" ]]; then
      printf '%s\n' "$output"
      return 0
    fi
  fi

  printf 'Builder VM: UNKNOWN\n'
  printf 'RESULT WARN\n'
  return 0
}

doctor_command() {
  local failures=0

  printf 'Wonderland Builder Doctor\n\n'

  if [[ -d "$ROOT/builder" ]]; then
    printf 'PASS builder root\n'
  else
    printf 'FAIL builder root missing\n'
    failures=$((failures + 1))
  fi

  if [[ -d "$ROOT/builder/python/wlbuilder" ]]; then
    printf 'PASS wlbuilder Python package\n'
  else
    printf 'FAIL wlbuilder Python package missing\n'
    failures=$((failures + 1))
  fi

  if [[ -x "$ROOT/bin/wl-builder-verify" ]]; then
    printf 'PASS Builder verifier\n'
  else
    printf 'FAIL Builder verifier unavailable\n'
    failures=$((failures + 1))
  fi

  if [[ -x "$ROOT/bin/wl-builder-certify" ]]; then
    printf 'PASS Builder certification authority\n'
  else
    printf 'FAIL Builder certification authority unavailable\n'
    failures=$((failures + 1))
  fi

  if command -v python3 >/dev/null 2>&1; then
    printf 'PASS python3\n'
  else
    printf 'FAIL python3 unavailable\n'
    failures=$((failures + 1))
  fi

  if command -v limactl >/dev/null 2>&1; then
    printf 'PASS limactl available\n'
  else
    printf 'WARN limactl unavailable\n'
  fi

  printf '\n'

  if (( failures > 0 )); then
    printf 'RESULT FAIL\n'
    return 1
  fi

  printf 'RESULT PASS\n'
}

command_name="${1:-help}"

if [[ $# -gt 0 ]]; then
  shift
fi

case "$command_name" in
  verify)
    exec "$ROOT/bin/wl-builder-verify" "$@"
    ;;

  certify)
    exec "$ROOT/bin/wl-builder-certify" "$@"
    ;;

  doctor)
    doctor_command "$@"
    ;;

  status)
    status_command "$@"
    ;;

  build|shell|start|stop|clean|graph)
    run_legacy "$command_name" "$@"
    ;;

  help|--help|-h)
    usage
    ;;

  *)
    printf 'FAIL unknown Builder command: %s\n\n' "$command_name" >&2
    usage >&2
    exit 2
    ;;
esac
