#!/usr/bin/env bash
# Wonderland deterministic Builder authority.
set -Eeuo pipefail

export PATH="/Users/wonderland/Wonderland/bin:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"

readonly WL_ROOT="${WL_ROOT:-/Users/wonderland/Wonderland}"
readonly BUILDER_SELF="$WL_ROOT/bin/wl-builder"
readonly INSTANCE="${WL_BUILDER_INSTANCE:-wonderland-os-builder}"
readonly LIMA_DIR="${LIMA_HOME:-$HOME/.lima}"
readonly INSTANCE_DIR="$LIMA_DIR/$INSTANCE"
readonly LEGACY="$WL_ROOT/bin/wl-builder-legacy"

fail() {
  printf 'FAIL %s\n' "$*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Usage:
  wl builder status
  wl builder doctor
  wl builder verify
  wl builder root
  wl builder shell
  wl builder build [--profile development|release]
  wl builder certify
  wl builder recreate
  wl builder start
  wl builder stop
  wl builder restart
  wl builder clean
  wl builder logs
EOF
}

# Executes limactl list with a strict process timeout and returns plain output.
bounded_lima_list() {
  python3 - "$INSTANCE" <<'PY'
from __future__ import annotations

import subprocess
import sys

instance = sys.argv[1]

try:
    completed = subprocess.run(
        ["limactl", "list"],
        text=True,
        capture_output=True,
        timeout=10,
        check=False,
    )
except subprocess.TimeoutExpired:
    print("FAIL limactl list timed out", file=sys.stderr)
    raise SystemExit(124)
except OSError as exc:
    print(f"FAIL limactl unavailable: {exc}", file=sys.stderr)
    raise SystemExit(127)

if completed.stderr:
    print(completed.stderr, end="", file=sys.stderr)

print(completed.stdout, end="")
raise SystemExit(completed.returncode)
PY
}

instance_row() {
  local output

  output="$(bounded_lima_list)" || return $?

  awk -v instance="$INSTANCE" '
    $1 == instance {
      print
      exit
    }
  ' <<<"$output"
}

instance_status() {
  local row

  row="$(instance_row 2>/dev/null || true)"

  if [[ -z "$row" ]]; then
    if [[ -d "$INSTANCE_DIR" ]]; then
      printf 'Registered\n'
    else
      printf 'Missing\n'
    fi
    return
  fi

  awk '{print $2}' <<<"$row"
}

builder_status() {
  local status

  status="$(instance_status)"

  cat <<EOF
== Wonderland Builder Status ==

Instance: $INSTANCE
Status:   $status
Host:     $WL_ROOT
Lima:     $INSTANCE_DIR
EOF

  if [[ "$status" == "Missing" ]]; then
    printf '\nRESULT FAIL\n'
    return 1
  fi

  printf '\nRESULT PASS\n'
}

builder_doctor() {
  local failures=0

  printf 'Wonderland Builder Doctor\n\n'

  if command -v limactl >/dev/null 2>&1; then
    printf 'PASS limactl              %s\n' \
      "$(command -v limactl)"
  else
    printf 'FAIL limactl unavailable\n'
    (( failures++ ))
  fi

  if [[ -d "$INSTANCE_DIR" ]]; then
    printf 'PASS builder VM registry  %s\n' "$INSTANCE_DIR"
  else
    printf 'FAIL builder VM missing   %s\n' "$INSTANCE_DIR"
    (( failures++ ))
  fi

  if [[ -d "$WL_ROOT" ]]; then
    printf 'PASS host repository      %s\n' "$WL_ROOT"
  else
    printf 'FAIL host repository missing\n'
    (( failures++ ))
  fi

  if [[ -x "$LEGACY" ]]; then
    printf 'PASS mutation backend     %s\n' "$LEGACY"
  else
    printf 'FAIL mutation backend missing\n'
    (( failures++ ))
  fi

  printf '\n'

  if (( failures == 0 )); then
    printf 'RESULT PASS\n'
    return 0
  fi

  printf 'RESULT FAIL\n'
  return 1
}

builder_verify() {
  local failures=0
  local component
  local status

  printf 'Wonderland Builder Verify\n\n'

  if bash -n "$BUILDER_SELF"; then
    printf 'PASS Builder authority syntax\n'
  else
    printf 'FAIL Builder authority syntax\n'
    (( failures++ ))
  fi

  if bash -n "$LEGACY"; then
    printf 'PASS legacy backend syntax\n'
  else
    printf 'FAIL legacy backend syntax\n'
    (( failures++ ))
  fi

  if [[ -x "$WL_ROOT/bin/wl-build" ]] &&
     bash -n "$WL_ROOT/bin/wl-build"
  then
    printf 'PASS build launcher syntax\n'
  else
    printf 'FAIL build launcher syntax\n'
    (( failures++ ))
  fi

  # Architecture is verified independently by Platform and Governance.
  # Builder verification must remain subsystem-local and non-recursive.
  printf 'PASS architecture boundary delegated\n'

  if [[ -d "$INSTANCE_DIR" ]]; then
    status="$(instance_status)"
    printf 'PASS builder VM registered status=%s\n' "$status"
  else
    printf 'FAIL builder VM not registered\n'
    (( failures++ ))
  fi

  for component in \
    bin/wl-builder-certify \
    bin/wl-builder-ownership \
    bin/wl-builder-recreate
  do
    if [[ -x "$WL_ROOT/$component" ]]; then
      printf 'PASS builder component    %s\n' "$component"
    else
      printf 'FAIL builder component    %s\n' "$component"
      (( failures++ ))
    fi
  done

  # Do not run limactl shell, start a VM, inspect guest tools, or build images.
  printf 'PASS verification is read-only\n'

  printf '\n'

  if (( failures == 0 )); then
    printf 'RESULT PASS\n'
    return 0
  fi

  printf 'RESULT FAIL\n'
  return 1
}

builder_root() {
  printf 'Host:     %s\n' "$WL_ROOT"
  printf 'Instance: %s\n' "$INSTANCE"
  printf 'Lima:     %s\n' "$INSTANCE_DIR"
  printf 'Status:   %s\n' "$(instance_status)"
}

command_name="${1:---help}"

case "$command_name" in
  --help|-h|help)
    usage
    ;;

  status)
    builder_status
    ;;

  doctor)
    builder_doctor
    ;;

  verify)
    builder_verify
    ;;

  root)
    builder_root
    ;;

  shell)
    shift

    [[ "$(instance_status)" == "Running" ]] ||
      fail "Builder VM is not running; use: wl builder start"

    exec limactl shell "$INSTANCE" -- "$@"
    ;;

  build|certify|recreate|start|stop|restart|clean|logs)
    [[ -x "$LEGACY" ]] ||
      fail "Builder mutation backend unavailable: $LEGACY"

    exec "$LEGACY" "$@"
    ;;

  *)
    fail "unknown Builder command: $command_name"
    ;;
esac
