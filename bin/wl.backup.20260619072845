#!/usr/bin/env bash
set -euo pipefail

ROOT="${WONDERLAND_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"

cmd="${1:-help}"
shift || true

case "$cmd" in
  universe)
    exec "$ROOT/bin/wl-universe" "$@"
    ;;

  storage)
    exec "$ROOT/bin/wl-storage" "$@"
    ;;

  time-machine)
    exec "$ROOT/bin/wl-time-machine" "$@"
    ;;

  portainer)
    exec "$ROOT/bin/wl-portainer" "$@"
    ;;


  recovery)
    exec "$ROOT/bin/wl-recovery" "$@"
    ;;

  grafana-dashboard)
    exec "$ROOT/bin/wl-grafana-dashboard" "$@"
    ;;

  help|-h|--help)
    echo "Wonderland CLI"
    echo "Commands:"
    echo "  wl universe status"
    echo "  wl storage doctor"
    echo "  wl time-machine verify"
    echo "  wl portainer doctor"
    echo "  wl grafana-dashboard doctor"
    ;;

  *)
    target="$ROOT/bin/wl-$cmd"
    if [ -x "$target" ]; then
      exec "$target" "$@"
    fi
    echo "Unknown wl command: $cmd"
    exit 1
    ;;
esac
