#!/usr/bin/env bash
set -euo pipefail

ROOT="${WL_ROOT:-$HOME/Wonderland}"
APP="$ROOT/apps/matrix/wl-matrix-fluderation-pusher"
WATCH="${WL_MATRIX_FLUDERATION_PATH:-$ROOT}"

cmd="${1:-run}"

case "$cmd" in
  run)
    cd "$APP"
    WL_MATRIX_FLUDERATION_PATH="$WATCH" exec swift run wl-matrix-fluderation-pusher
    ;;

  build)
    swift build --package-path "$APP"
    ;;

  verify)
    swift build --package-path "$APP" >/dev/null
    test -x "$ROOT/bin/wl-matrix-fluderation"
    test -f "$APP/wl-matrix-fluderation-pusher.intent.json"
    test -f "$ROOT/apps/matrix/matrix-app-profile.json"
    echo "PASS wl-matrix-fluderation verify"
    ;;

  test)
    swift build --package-path "$APP" >/dev/null
    log="$(mktemp)"
    WL_MATRIX_FLUDERATION_PATH="$WATCH" "$ROOT/bin/wl-matrix-fluderation" run >"$log" 2>&1 &
    pid="$!"
    sleep 2
    touch "$WATCH/.matrix-fluderation-test"
    rm -f "$WATCH/.matrix-fluderation-test"
    sleep 2
    kill "$pid" >/dev/null 2>&1 || true
    cat "$log"
    grep -q "MATRIX_FLUDERATION_PUSH" "$log"
    echo "PASS wl-matrix-fluderation test"
    ;;

  status)
    echo "app=$APP"
    echo "watch=$WATCH"
    echo "binary=$ROOT/bin/wl-matrix-fluderation"
    ;;

  clean)
    rm -rf "$APP/.build"
    echo "PASS clean"
    ;;

  *)
    echo "Usage: wl-matrix-fluderation run|build|verify|test|status|clean"
    exit 2
    ;;
esac
