#!/usr/bin/env python3
"""
Wonderland Governance certification authority.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import subprocess
import sys
import tarfile
import tempfile
import time
from datetime import datetime, timezone
from pathlib import Path


PASS = "PASS"
FAIL = "FAIL"


class CertificationError(RuntimeError):
    pass


def repository_root() -> Path:
    configured = os.environ.get("WL_HOME") or os.environ.get("WONDERLAND_ROOT")

    if configured:
        candidate = Path(configured).expanduser().resolve()
        if (candidate / ".git").exists():
            return candidate

    candidate = Path(__file__).resolve().parent.parent

    if (candidate / ".git").exists():
        return candidate

    completed = subprocess.run(
        ["git", "rev-parse", "--show-toplevel"],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        check=False,
    )

    if completed.returncode == 0 and completed.stdout.strip():
        return Path(completed.stdout.strip()).resolve()

    raise CertificationError("unable to locate repository root")


def sha256(path: Path) -> str:
    digest = hashlib.sha256()

    with path.open("rb") as stream:
        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
            digest.update(chunk)

    return digest.hexdigest()


def git_value(root: Path, *args: str) -> str:
    completed = subprocess.run(
        ["git", *args],
        cwd=root,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        check=False,
    )

    if completed.returncode != 0:
        return "unknown"

    return completed.stdout.strip()


def write_json(path: Path, payload: object) -> None:
    path.write_text(
        json.dumps(payload, indent=2, sort_keys=True) + "\n"
    )


def relevant_files(root: Path) -> list[Path]:
    candidates = (
        root / "bin/wl-governance",
        root / "bin/wl-governance-verify",
        root / "bin/wl-governance-certify",
        root / "vault/04-Governance",
        root / "vault/05-Governance",
        root / "vault/Governance",
        root / "governance",
        root / "01-Platform/governance",
        root / "docs/governance",
        root / "config/governance",
    )

    files: set[Path] = set()

    for candidate in candidates:
        if candidate.is_file():
            files.add(candidate)
        elif candidate.is_dir():
            for path in candidate.rglob("*"):
                if not path.is_file():
                    continue
                if "__pycache__" in path.parts:
                    continue
                files.add(path)

    return sorted(files)


def verify_archive(
    archive_path: Path,
    archive_digest_path: Path,
) -> None:
    expected = archive_digest_path.read_text().split()[0]
    actual = sha256(archive_path)

    if actual != expected:
        raise CertificationError("archive checksum mismatch")

    with tempfile.TemporaryDirectory(
        prefix="wl-governance-certify-"
    ) as tmp:
        extraction_root = Path(tmp).resolve()

        with tarfile.open(archive_path, "r:gz") as archive:
            for member in archive.getmembers():
                destination = (
                    extraction_root / member.name
                ).resolve()

                if (
                    destination != extraction_root
                    and extraction_root not in destination.parents
                ):
                    raise CertificationError(
                        "unsafe archive member path"
                    )

            archive.extractall(extraction_root)

        sums_path = extraction_root / "SHA256SUMS"

        if not sums_path.is_file():
            raise CertificationError("archive missing SHA256SUMS")

        for line in sums_path.read_text().splitlines():
            expected_digest, filename = line.split(maxsplit=1)
            candidate = extraction_root / filename.strip()

            if not candidate.is_file():
                raise CertificationError(
                    f"archive missing evidence file: {filename}"
                )

            if sha256(candidate) != expected_digest:
                raise CertificationError(
                    f"evidence checksum mismatch: {filename}"
                )


def certify(root: Path) -> Path:
    created = datetime.now(timezone.utc)
    stamp = created.strftime("%Y%m%dT%H%M%SZ")

    output = (
        root
        / "vault/08-Operations/certifications/governance"
        / stamp
    )
    output.mkdir(parents=True, exist_ok=False)

    env = os.environ.copy()
    env["WL_HOME"] = str(root)
    env["WONDERLAND_ROOT"] = str(root)
    env["CI"] = "1"
    env["WL_NONINTERACTIVE"] = "1"

    completed = subprocess.run(
        [str(root / "bin/wl-governance-verify"), "--json"],
        cwd=root,
        env=env,
        stdin=subprocess.DEVNULL,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        timeout=180,
        check=False,
    )

    (output / "governance-verify.json").write_text(
        completed.stdout
    )
    (output / "governance-verify.stderr.txt").write_text(
        completed.stderr
    )

    if completed.returncode != 0:
        raise CertificationError(
            f"Governance verification exited {completed.returncode}"
        )

    try:
        verification = json.loads(completed.stdout)
    except json.JSONDecodeError as exc:
        raise CertificationError(
            f"invalid verification JSON: {exc}"
        ) from exc

    if verification.get("result") not in {"PASS", "WARN"}:
        raise CertificationError(
            f"verification result was {verification.get('result')}"
        )

    manifest = {
        str(path.relative_to(root)): {
            "sha256": sha256(path),
            "size_bytes": path.stat().st_size,
        }
        for path in relevant_files(root)
    }

    write_json(
        output / "governance-source-manifest.json",
        {
            "schema_version": 1,
            "files": manifest,
        },
    )

    certification = {
        "schema_version": 1,
        "subsystem": "governance",
        "created_at": created.isoformat(),
        "result": PASS,
        "repository": {
            "root": str(root),
            "branch": git_value(root, "branch", "--show-current"),
            "commit": git_value(root, "rev-parse", "HEAD"),
            "dirty": bool(
                git_value(root, "status", "--porcelain")
            ),
        },
        "verification": {
            "result": verification.get("result"),
            "check_count": len(
                verification.get("checks", [])
            ),
        },
    }

    write_json(
        output / "governance-certification.json",
        certification,
    )

    evidence = sorted(
        path
        for path in output.iterdir()
        if path.is_file() and path.name != "SHA256SUMS"
    )

    sums = output / "SHA256SUMS"
    sums.write_text(
        "".join(
            f"{sha256(path)}  {path.name}\n"
            for path in evidence
        )
    )

    archive = output / (
        f"governance-certification-{stamp}.tar.gz"
    )

    with tarfile.open(archive, "w:gz") as tar:
        for path in sorted(output.iterdir()):
            if path == archive:
                continue
            tar.add(path, arcname=path.name)

    archive_digest = output / f"{archive.name}.sha256"
    archive_digest.write_text(
        f"{sha256(archive)}  {archive.name}\n"
    )

    verify_archive(archive, archive_digest)

    return output


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Certify Wonderland Governance",
    )
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args()

    started = time.monotonic()

    try:
        root = repository_root()
        output = certify(root)
    except (
        CertificationError,
        subprocess.TimeoutExpired,
        OSError,
    ) as exc:
        payload = {
            "schema_version": 1,
            "result": FAIL,
            "error": str(exc),
            "duration_ms": round(
                (time.monotonic() - started) * 1000
            ),
        }

        if args.json:
            print(json.dumps(payload, indent=2, sort_keys=True))
        else:
            print("Wonderland Governance Certification")
            print()
            print(f"FAIL {exc}")
            print()
            print("RESULT FAIL")

        return 1

    payload = {
        "schema_version": 1,
        "result": PASS,
        "certification": str(output),
        "duration_ms": round(
            (time.monotonic() - started) * 1000
        ),
    }

    if args.json:
        print(json.dumps(payload, indent=2, sort_keys=True))
    else:
        print("Wonderland Governance Certification")
        print()
        print(f"evidence: {output}")
        print()
        print("RESULT PASS")

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
