#!/usr/bin/env bash
set -euo pipefail

ROOT="${WL_AUTHORITY_ROOT:-${WL_HOME:-$HOME/Wonderland}}"

for file in \
  service-registry.json \
  service-health.json \
  service-dependencies.json
do
  test -f "$ROOT/vault/06-Services/$file" || {
    echo "FAIL missing $file"
    exit 1
  }
done

echo "RESULT PASS"
