#!/usr/bin/env bash
set -euo pipefail

WL_ROOT="${WL_ROOT:-$HOME/Wonderland}"
REPORT_DIR="$WL_ROOT/vault/08-Operations/reports"
REPORT_FILE="$REPORT_DIR/universe-status-report.json"

mkdir -p "$REPORT_DIR"

pass() { printf "PASS %-22s %s\n" "$1" "${2:-}"; }
fail() { printf "FAIL %-22s %s\n" "$1" "${2:-}"; }
warn() { printf "WARN %-22s %s\n" "$1" "${2:-}"; }

check_cmd() {
  local label="$1"
  shift

  if "$@" >/tmp/wl-universe-check.out 2>/tmp/wl-universe-check.err; then
    pass "$label"
    return 0
  else
    fail "$label"
    return 1
  fi
}

mode_value() {
  python3 - <<PY
import json
from pathlib import Path
p = Path("$WL_ROOT/vault/07-Operations/platform/runtime-mode.json")
try:
    print(json.loads(p.read_text()).get("mode", "unknown"))
except Exception:
    print("unknown")
PY
}

status() {
  local failures=0
  local mode
  mode="$(mode_value)"

  echo "Wonderland Universe Status"
  echo
  echo "Root:  $WL_ROOT"
  echo "Mode:  $mode"
  echo

  echo "Authority"
  check_cmd "mode" "$WL_ROOT/bin/wl-mode" status || failures=$((failures+1))
  check_cmd "storage" "$WL_ROOT/bin/wl-storage" status || failures=$((failures+1))
  check_cmd "storage authority" "$WL_ROOT/bin/wl-storage" authority || failures=$((failures+1))

  echo
  echo "Governance"
  check_cmd "governance" "$WL_ROOT/bin/wl" governance status || failures=$((failures+1))
  check_cmd "recovery" "$WL_ROOT/bin/wl" recovery verify || failures=$((failures+1))
  check_cmd "snapshot" "$WL_ROOT/bin/wl" snapshot doctor || failures=$((failures+1))

  echo
  echo "Runtime"
  required_services="wl-vaultwarden wl-vaultwarden-db wl-loki"
missing=0

for svc in $required_services; do
  if LIMA_INSTANCE=wonderland-rootless nerdctl ps --format '{{.Names}}' | grep -qx "$svc"; then
    :
  else
    echo "FAIL service $svc"
    missing=$((missing+1))
  fi
done

if [ "$missing" -eq 0 ]; then
  echo "PASS services"
else
  echo "FAIL services"
  failures=$((failures+1))
fi

  echo
  echo "Capability"
  if "$WL_ROOT/bin/wl-require-capability" media >/dev/null 2>&1; then
    pass "media"
  else
    warn "media" "unavailable in current mode"
  fi

  if "$WL_ROOT/bin/wl-require-capability" torrent >/dev/null 2>&1; then
    pass "torrent"
  else
    warn "torrent" "unavailable in current mode"
  fi

  local result="PASS"
  if [ "$failures" -ne 0 ]; then
    result="FAIL"
  fi

  cat > "$REPORT_FILE" <<JSON
{
  "generated": "$(date -u +"%Y-%m-%dT%H:%M:%SZ")",
  "root": "$WL_ROOT",
  "mode": "$mode",
  "failures": $failures,
  "result": "$result"
}
JSON

  echo
  echo "RESULT $result"
}

doctor() {
  echo "Wonderland Universe Doctor"
  echo

  status
  status_rc=$?

  echo
  echo "Recommendations"

  recs=0

  if grep -R "WIREGUARD_PRIVATE_KEY=" "$WL_ROOT/services/torrent" >/dev/null 2>&1; then
    echo "WARN rotate Surfshark WireGuard credentials"
    recs=$((recs+1))
  fi

  if [ -d "/Volumes/T7_Wonderland/media/music/taylor-swift" ]; then
    if [ ! -f "/Volumes/T7_Wonderland/media/music/manifests/taylor-swift-20260611.sha256" ]; then
      echo "WARN create Taylor Swift music manifest"
      recs=$((recs+1))
    fi
  fi

  if [ ! -f "$REPORT_DIR/universe-certification-status.json" ]; then
    echo "WARN universe certification status missing"
    recs=$((recs+1))
  fi

  if [ "$recs" -eq 0 ]; then
    echo "PASS no recommendations"
  fi

  echo
  if [ "$status_rc" -eq 0 ]; then
    echo "RESULT PASS"
  else
    echo "RESULT FAIL"
    exit "$status_rc"
  fi
}

case "${1:-status}" in
  dashboard)
    shift || true
    exec "$WL_ROOT/bin/wl-universe-dashboard" "$@"
    ;;


  graph)
    shift || true
    exec "$WL_ROOT/bin/wl-universe-graph" "$@"
    ;;


  status) status ;;
  doctor) doctor ;;
  report)
    if [ -f "$REPORT_FILE" ]; then
      cat "$REPORT_FILE"
    else
      echo "No universe status report found."
      exit 1
    fi
    ;;
  *)
    echo "Usage:"
    echo "  wl universe status"
    echo "  wl universe report"
    exit 2
    ;;
esac
