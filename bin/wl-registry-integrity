#!/usr/bin/env bash
set -euo pipefail

ROOT="/Users/wonderland/Wonderland"
REG="$ROOT/vault/05-Registry"
OUT="$ROOT/vault/07-Operations/drift/registry-integrity.json"

mkdir -p "$(dirname "$OUT")"

python3 - "$ROOT" "$REG" "$OUT" <<'PY'
import json
import pathlib
import sys
import datetime

root = pathlib.Path(sys.argv[1])
reg = pathlib.Path(sys.argv[2])
out = pathlib.Path(sys.argv[3])

failures = []
checks = []

def check_file(rel):
    p = root / rel
    ok = p.exists()
    checks.append({"path": rel, "exists": ok})
    if not ok:
        failures.append(f"missing referenced file: {rel}")

for name in ["documents", "services", "intents", "plans", "assets"]:
    p = reg / f"{name}.json"
    if not p.exists():
        failures.append(f"missing registry: {p}")
        continue

    data = json.loads(p.read_text())
    items = data.get(name, [])

    for item in items:
        rel = item.get("path")
        if rel:
            if rel.startswith("vault/"):
                check_file(rel)
            else:
                check_file(str(reg.relative_to(root) / rel))

payload = {
    "id": "registry-integrity-v4",
    "version": 4,
    "timestamp": datetime.datetime.now().isoformat(timespec="seconds"),
    "checks": checks,
    "failures": failures
}

out.write_text(json.dumps(payload, indent=2) + "\n")

print(f"registry integrity: {out}")
print(f"checks: {len(checks)}")
print(f"failures: {len(failures)}")

if failures:
    for failure in failures:
        print(f"FAIL {failure}")
    sys.exit(1)
PY
