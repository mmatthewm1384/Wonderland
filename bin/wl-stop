#!/usr/bin/env bash
set -euo pipefail

ok(){ echo "PASS $*"; }
warn(){ echo "WARN $*"; }
step(){ echo; echo "== $* =="; }

step "Wonderland Stop"

step "Stopping rootless services"
LIMA_INSTANCE=wonderland-rootless nerdctl stop wl-loki >/dev/null 2>&1 || true
ok "rootless stop attempted"

step "Stopping wonderland-rootless"
limactl stop wonderland-rootless >/dev/null 2>&1 || true
ok "wonderland-rootless stop attempted"

step "Stopping core services"
for svc in wl-grafana wl-prometheus wl-loki wl-nats wl-dns; do
  nerdctl stop "$svc" >/dev/null 2>&1 || true
  ok "$svc stop attempted"
done

step "Syncing filesystem"
sync
ok "filesystem synced"

step "Final state"
limactl list
nerdctl ps 2>/dev/null || true

echo
echo "PASS wl-stop complete"
