#!/usr/bin/env bash
set -euo pipefail

status_of() {
  limactl list --format '{{.Name}} {{.Status}}' 2>/dev/null \
    | awk -v n="$1" '$1==n {print $2; found=1} END{if(!found) print "Missing"}'
}

stop_lima() {
  local name="$1"
  local status
  status="$(status_of "$name")"

  case "$status" in
    Running)
      limactl stop "$name" || limactl stop "$name" --force || true
      ;;
    Stopped)
      echo "PASS $name already stopped"
      ;;
    Missing)
      echo "WARN $name missing"
      ;;
    *)
      echo "WARN $name status=$status; forcing stop"
      limactl stop "$name" --force || true
      ;;
  esac
}

target="${1:-rootless}"

case "$target" in
  rootless|wonderland-rootless)
    echo "== Stopping Wonderland Rootless Runtime =="
    stop_lima wonderland-rootless
    ;;

  default|legacy)
    echo "== Stopping Legacy Default Runtime =="
    stop_lima default
    ;;

  all)
    echo "== Stopping Wonderland Runtimes =="
    stop_lima wonderland-rootless
    stop_lima default
    ;;

  *)
    echo "Usage: wl-stop [rootless|default|legacy|all]"
    exit 2
    ;;
esac
