#!/usr/bin/env bash
set -euo pipefail

ROOT="${WL_AUTHORITY_ROOT:-${WL_HOME:-$HOME/Wonderland}}"
LOCK="$ROOT/vault/locks/vault-lock.json"
TARGET="${1:-}"

if [[ -z "$TARGET" ]]; then
  echo "Usage: wl-vault-guard <target-path>"
  exit 1
fi

python3 - "$ROOT" "$LOCK" "$TARGET" <<'PY'
import json
import pathlib
import sys

root = pathlib.Path(sys.argv[1]).resolve()
lock = pathlib.Path(sys.argv[2])
target = pathlib.Path(sys.argv[3]).resolve()

data = json.loads(lock.read_text())
state = data.get("state")

if state != "locked":
    print("OK unlocked")
    sys.exit(0)

vault = root / "vault"

try:
    rel = target.relative_to(vault)
except ValueError:
    print("OK outside vault")
    sys.exit(0)

protected = data.get("protected_layers", [])

for layer in protected:
    if rel.parts and rel.parts[0] == layer:
        print(f"FAIL vault locked; protected layer: {layer}")
        sys.exit(1)

print("OK unprotected")
PY
