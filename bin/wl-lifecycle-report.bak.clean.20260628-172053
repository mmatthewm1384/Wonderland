#!/usr/bin/env bash
set -euo pipefail

WL_HOME="${WL_HOME:-$HOME/Wonderland}"
REPORT_DIR="$WL_HOME/vault/08-Operations/reports"
mkdir -p "$REPORT_DIR"

ACTION="${1:-status}"
STAMP="$(date +%Y%m%d-%H%M%S)"
OUT="$REPORT_DIR/lifecycle-${ACTION}-${STAMP}.json"

CHECK="$(mktemp)"
trap 'rm -f "$CHECK"' EXIT

result="PASS"

case "$ACTION" in
  stop|sleep)
    fail=0
    {
      echo "== Stop Verification =="
      for svc in wl-dns wl-nats wl-prometheus wl-grafana wl-loki; do
        if nerdctl ps --format '{{.Names}}' 2>/dev/null | grep -qx "$svc"; then
          echo "FAIL $svc still-running"
          fail=1
        else
          echo "PASS $svc stopped"
        fi
      done

      if limactl list 2>/dev/null | awk '{print $1, $2}' | grep -qx "wonderland-rootless Running"; then
        echo "FAIL wonderland-rootless still-running"
        fail=1
      else
        echo "PASS wonderland-rootless stopped"
      fi

      [[ "$fail" -eq 0 ]] && echo "RESULT PASS" || echo "RESULT FAIL"
    } > "$CHECK"

    [[ "$fail" -eq 0 ]] && result="PASS" || result="FAIL"
    ;;
  *)
    if wl doctor > "$CHECK" 2>&1 && grep -q "RESULT PASS" "$CHECK"; then
      result="PASS"
    else
      result="FAIL"
    fi
    ;;
esac

python3 - "$OUT" "$ACTION" "$WL_HOME" "$result" "$CHECK" <<'PY'
import json, sys, datetime
out, action, root, result, check = sys.argv[1:]
payload = {
    "action": action,
    "timestamp": datetime.datetime.now().astimezone().isoformat(),
    "root": root,
    "result": result,
    "check_output": open(check).read(),
}
with open(out, "w") as f:
    json.dump(payload, f, indent=2)
    f.write("\n")
PY

echo "REPORT $OUT"
echo "RESULT $result"
[[ "$result" == "PASS" ]] && exit 0 || exit 1
