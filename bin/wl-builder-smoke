#!/usr/bin/env bash
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

echo "Builder v2 smoke test"
echo

python3 -m wlbuilder --help >/dev/null
echo "PASS wlbuilder help"

python3 -m wlbuilder status >/dev/null
echo "PASS wlbuilder status"

python3 -m wlbuilder doctor >/dev/null
echo "PASS wlbuilder doctor"

python3 -m wlbuilder verify >/dev/null
echo "PASS wlbuilder verify"

python3 -m wlbuilder artifacts >/dev/null
echo "PASS wlbuilder artifacts"

python3 -m wlbuilder stages >/dev/null
echo "PASS wlbuilder stages"

python3 -m wlbuilder native-state >/dev/null
echo "PASS wlbuilder native-state"

python3 -m wlbuilder native-state --json >/dev/null
echo "PASS wlbuilder native-state json"

python3 -m wlbuilder config >/dev/null
echo "PASS wlbuilder config"

python3 -m wlbuilder config --json >/dev/null
echo "PASS wlbuilder config json"

python3 -m wlbuilder migration >/dev/null
echo "PASS wlbuilder migration"

python3 -m wlbuilder migration --json >/dev/null
echo "PASS wlbuilder migration json"

bin/wl builder migration >/dev/null
echo "PASS wl builder migration"

bin/wl builder config >/dev/null
echo "PASS wl builder config"

bin/wl builder native-state >/dev/null
echo "PASS wl builder native-state"

python3 -m wlbuilder docs >/dev/null
echo "PASS wlbuilder docs"

bin/wl builder docs >/dev/null
echo "PASS wl builder docs"

bin/wl builder stages >/dev/null
echo "PASS wl builder stages"

bin/wl builder artifacts >/dev/null
echo "PASS wl builder artifacts"

bin/wl builder verify >/dev/null
echo "PASS wl builder verify"

python3 -m wlbuilder build --help >/dev/null
echo "PASS wlbuilder build help"

bin/wl builder certify >/dev/null
echo "PASS wl builder certify"

bin/wl builder doctor >/dev/null
echo "PASS wl builder doctor"

echo
echo "PASS Builder v2 smoke test"
