#!/usr/bin/env bash
set -euo pipefail

ROOT="${WL_AUTHORITY_ROOT:-${WL_HOME:-$HOME/Wonderland}}"
PLANS="$ROOT/vault/05-Registry/plans"

echo
echo "Wonderland Plan Verification"
echo "root: $PLANS"
echo

mkdir -p "$PLANS"

python3 - "$PLANS" <<'PY'
import json
import pathlib
import sys

plans = pathlib.Path(sys.argv[1])
failures = []

required = {"id", "version", "created", "intent_id", "status", "steps", "rollback"}
allowed = {"draft", "approved", "executed", "archived"}

for path in sorted(plans.glob("*.plan.json")):
    print(f"OK      {path.name}")
    data = json.loads(path.read_text())

    missing = required - set(data.keys())
    if missing:
        failures.append(f"missing fields in {path.name}: {sorted(missing)}")

    if data.get("status") not in allowed:
        failures.append(f"invalid status in {path.name}: {data.get('status')}")

    if not isinstance(data.get("steps"), list):
        failures.append(f"steps must be list in {path.name}")

if failures:
    print()
    for failure in failures:
        print(f"FAIL    {failure}")
    print()
    print("RESULT  FAIL")
    sys.exit(1)

print()
print("RESULT  PASS")
PY
