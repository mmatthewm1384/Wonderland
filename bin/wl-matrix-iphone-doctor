#!/usr/bin/env bash
set -euo pipefail

WL_ROOT="${WL_ROOT:-$HOME/Wonderland}"
ROOT="$WL_ROOT/assets/visualizations/matrix-atom-destroyer"

fail=0
check_file() { [[ -f "$1" ]] && echo "PASS $2" || { echo "FAIL $2"; fail=1; }; }
check_exec() { [[ -x "$1" ]] && echo "PASS $2" || { echo "FAIL $2"; fail=1; }; }

echo "Matrix iPhone Access Doctor"

check_file "$ROOT/iphone/index.html" "iphone-portal"
check_file "$ROOT/matrix-atom-destroyer.html" "matrix-main"
check_file "$ROOT/apps/spin-city-wave/iphone/spin-city-wave-iphone.html" "spin-city-iphone"
check_exec "$WL_ROOT/bin/wl-matrix-iphone-server" "iphone-server"

if [[ "$fail" -eq 0 ]]; then
  echo "RESULT PASS"
else
  echo "RESULT FAIL"
  exit 1
fi
