#!/usr/bin/env bash
set -uo pipefail

WL_HOME="${WL_HOME:-$HOME/Wonderland}"
. "$WL_HOME/lib/wl-bootstrap.sh"

CHECKPOINT_DIR="$WL_HOME/vault/05-Registry/platform"
CURRENT="$CHECKPOINT_DIR/current.json"
cmd="${1:-create}"

latest_checkpoint() {
  ls -t "$CHECKPOINT_DIR"/wonderland-platform-checkpoint-*.json 2>/dev/null | head -1
}

create_checkpoint() {
  STAMP="$(date +%Y%m%d-%H%M%S)"
  CHECKPOINT="$CHECKPOINT_DIR/wonderland-platform-checkpoint-${STAMP}.json"

  mkdir -p "$CHECKPOINT_DIR"

  verify_rc=0
  "$WL_HOME/bin/wl-verify" >/tmp/wl-checkpoint-verify.out 2>&1 || verify_rc=$?

  result="PASS"
  [[ "$verify_rc" -eq 0 ]] || result="FAIL"

  stable="$WL_HOME/releases/stable/current.json"
  baseline="$("$WL_HOME/bin/wl-baseline" latest 2>/dev/null || true)"
  handoff="$(ls -t "$WL_HOME"/vault/08-Operations/handoffs/wonderland-platform-handoff-*.md 2>/dev/null | head -1)"
  docs="$WL_HOME/vault/02-Documentation/generated/wonderland-command-reference.md"

  python3 - "$CHECKPOINT" "$result" "$stable" "$baseline" "$handoff" "$docs" <<'PY'
import json
import subprocess
import sys

out, result, stable, baseline, handoff, docs = sys.argv[1:7]

def j(cmd):
    return json.loads(subprocess.check_output(cmd, text=True))

data = {
    "schema": "wonderland.platform.checkpoint.v1",
    "result": result,
    "stable_release": stable,
    "baseline": baseline,
    "handoff": handoff,
    "documentation": docs,
    "context": j(["wl", "context", "show"]),
    "state": j(["wl", "state", "show"]),
    "capabilities": j(["wl", "state", "capabilities"]),
    "health": j(["wl", "state", "health"]),
}

with open(out, "w") as f:
    json.dump(data, f, indent=2)
    f.write("\n")
PY

  python3 -m json.tool "$CHECKPOINT" >/dev/null
  cp "$CHECKPOINT" "$CURRENT"

  echo "CHECKPOINT $CHECKPOINT"
  echo "CURRENT $CURRENT"
  echo "RESULT $result"
  exit "$verify_rc"
}

case "$cmd" in
  create|new)
    create_checkpoint
    ;;

  latest|path)
    latest="$(latest_checkpoint)"
    if [[ -n "$latest" ]]; then
      echo "$latest"
    else
      echo "FAIL no checkpoint found"
      echo "RESULT FAIL"
      exit 1
    fi
    ;;

  current)
    echo "$CURRENT"
    ;;

  show)
    if [[ -f "$CURRENT" ]]; then
      cat "$CURRENT"
    else
      echo "FAIL no current checkpoint found"
      echo "RESULT FAIL"
      exit 1
    fi
    ;;

  status)
    echo "Wonderland Checkpoint Status"
    echo

    if [[ -f "$CURRENT" ]] && python3 -m json.tool "$CURRENT" >/dev/null 2>&1; then
      echo "Current: $CURRENT"
      python3 -m json.tool "$CURRENT"
      echo "RESULT PASS"
    else
      echo "FAIL current checkpoint invalid or missing: $CURRENT"
      echo "RESULT FAIL"
      exit 1
    fi
    ;;

  *)
    echo "Usage: wl checkpoint {create|latest|current|show|status}"
    echo "RESULT FAIL"
    exit 1
    ;;
esac
