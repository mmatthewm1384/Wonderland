#!/usr/bin/env bash
set -euo pipefail

WL_ROOT="${WL_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}"

PASS=0
FAIL=0

check() {
    local name="$1"
    shift

    printf "%-45s" "$name"

    if "$@" >/tmp/wl-test.out 2>&1; then
        echo "PASS"
        PASS=$((PASS+1))
    else
        echo "FAIL"
        cat /tmp/wl-test.out
        FAIL=$((FAIL+1))
    fi
}

echo
echo "WONDERLAND CERTIFICATION SUITE"
echo "=============================="
echo

check "CLI executable" test -x "$WL_ROOT/bin/wl"

check "Python runtime import" \
python3 -c "import sys; sys.path.insert(0,'$WL_ROOT/builder/python/wlplatform/src'); import wlplatform"

check "CLI status" \
"$WL_ROOT/bin/wl" status

check "Registry verification" \
"$WL_ROOT/bin/wl" registry validate

check "Lima certification" \
"$WL_ROOT/bin/wl" certification lima

echo
echo "Oblivion smoke test"

TMP="/tmp/wl-oblivion-test.$$"
echo "OBLIVION TEST" > "$TMP"

if [ -x "$WL_ROOT/bin/wl-oblivion" ]; then
    check "Oblivion purge" "$WL_ROOT/bin/wl-oblivion" purge "$TMP"
else
    echo "SKIP: wl-oblivion unavailable"
fi

echo
echo "RESULT"
echo "======"
echo "PASS: $PASS"
echo "FAIL: $FAIL"

if [ "$FAIL" -ne 0 ]; then
    exit 1
fi
