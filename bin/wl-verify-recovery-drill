#!/usr/bin/env bash
set -euo pipefail

ROOT="${WL_AUTHORITY_ROOT:-${WL_HOME:-$HOME/Wonderland}}"
DIR="$ROOT/vault/07-Operations/reports/recovery-drills"

echo
echo "Wonderland Recovery Drill Verification"
echo

LATEST="$(ls -t "$DIR"/recovery-drill-*.json 2>/dev/null | head -1 || true)"

if [[ -z "$LATEST" ]]; then
  echo "FAIL    no recovery drill report found"
  exit 1
fi

python3 - "$LATEST" <<'PY'
import json
import pathlib
import sys

p = pathlib.Path(sys.argv[1])
data = json.loads(p.read_text())

if data.get("id") != "recovery-drill-report-v4":
    print("FAIL    recovery drill id mismatch")
    sys.exit(1)

if data.get("result") != "PASS":
    print(f"FAIL    recovery drill result: {data.get('result')}")
    sys.exit(1)

print(f"OK      {p}")
print()
print("RESULT  PASS")
PY
