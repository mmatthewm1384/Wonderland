#!/usr/bin/env bash
set -euo pipefail

BUILD_ROOT="${WONDERLAND_BUILD_ROOT:-$HOME/Wonderland-Builds}"

mkdir -p "$BUILD_ROOT"/{images/{raw,qcow2,iso,vmware},releases,logs,cache,tmp,archives}

echo "Cleaning disposable Wonderland artifacts..."

rm -rf "$HOME/Wonderland/builder/output/tmp/"* 2>/dev/null || true
rm -rf "$HOME/Wonderland/builder/output/logs/"* 2>/dev/null || true
rm -rf "$BUILD_ROOT/tmp/"* 2>/dev/null || true
rm -rf "$BUILD_ROOT/logs/"* 2>/dev/null || true

echo "Cleaning safe user caches..."

rm -rf "$HOME/Library/Caches/Homebrew/"* 2>/dev/null || true
rm -rf "$HOME/Library/Caches/lima/"* 2>/dev/null || true
rm -rf "$HOME/Library/Caches/com.apple.nsurlsessiond/Downloads/"* 2>/dev/null || true
rm -rf "$HOME/.npm/_cacache" 2>/dev/null || true
rm -rf "$HOME/.cache/"* 2>/dev/null || true

echo
echo "Done."
df -h /
