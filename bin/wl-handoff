#!/usr/bin/env bash
set -uo pipefail

WL_HOME="${WL_HOME:-$HOME/Wonderland}"
. "$WL_HOME/lib/wl-bootstrap.sh"

HANDOFF_DIR="$WL_HOME/vault/08-Operations/handoffs"
STAMP="$(date +%Y%m%d-%H%M%S)"
HANDOFF="$HANDOFF_DIR/wonderland-platform-handoff-${STAMP}.md"

mkdir -p "$HANDOFF_DIR"

verify_rc=0
"$WL_HOME/bin/wl-verify" >/tmp/wl-handoff-verify.out 2>&1 || verify_rc=$?

result="PASS"
[[ "$verify_rc" -eq 0 ]] || result="FAIL"

stable="$WL_HOME/releases/stable/current.json"
baseline="$("$WL_HOME/bin/wl-baseline" latest 2>/dev/null || true)"
docs="$WL_HOME/vault/02-Documentation/generated/wonderland-command-reference.md"

cat > "$HANDOFF" <<MD
# Wonderland Platform Handoff

Generated: $STAMP

## Result

$result

## Runtime

- Root: $(wl_context_get root)
- Mode: $(wl_context_get mode)
- Profile: $(wl_context_get profile)
- Version: $(wl_context_get version)
- Build: $(wl_context_get build)
- Runtime: $(wl_context_get runtime_instance)

## Runtime Objects

- Context: $WL_HOME/runtime/context.json
- State: $WL_HOME/runtime/state.json
- Capabilities: $WL_HOME/runtime/capabilities.json
- Health: $WL_HOME/runtime/health.json

## Release Artifacts

- Stable release: $stable
- Latest baseline: $baseline
- Docs: $docs

## Current State

\`\`\`json
$(wl_state_dump)
\`\`\`

## Capabilities

\`\`\`json
$(wl_capabilities_dump)
\`\`\`

## Health

\`\`\`json
$(wl_health_dump)
\`\`\`

## Verification

\`\`\`text
$(cat /tmp/wl-handoff-verify.out)
\`\`\`
MD

echo "HANDOFF $HANDOFF"
echo "RESULT $result"
exit "$verify_rc"
