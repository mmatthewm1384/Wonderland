#!/usr/bin/env bash
set -euo pipefail

WL_ROOT="${WL_ROOT:-$HOME/Wonderland}"

case "${1:-}" in
  status|doctor|certify)
    "$WL_ROOT/kernel/wl-kernel" "$1"
    ;;

  dispatch)
    shift
    "$WL_ROOT/kernel/wl-kernel" dispatch "$@"
    ;;

  *)
    echo "Usage: wl-authority [status|doctor|certify|dispatch <authority> <action>]"
    exit 2
    ;;
esac
