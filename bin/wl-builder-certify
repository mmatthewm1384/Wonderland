#!/usr/bin/env bash
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

fail=0

require_file() {
  local path="$1"

  if [[ -f "$path" ]]; then
    echo "PASS file: $path"
  else
    echo "FAIL file: $path"
    fail=1
  fi
}

require_dir() {
  local path="$1"

  if [[ -d "$path" ]]; then
    echo "PASS dir: $path"
  else
    echo "FAIL dir: $path"
    fail=1
  fi
}

echo "Wonderland Builder Certification"
echo

require_dir "builder/python/wlbuilder"

require_file "builder/python/wlbuilder/__init__.py"
require_file "builder/python/wlbuilder/__main__.py"
require_file "builder/python/wlbuilder/runtime.py"
require_file "builder/python/wlbuilder/cli.py"

require_file "wlbuilder/__init__.py"
require_file "wlbuilder/__main__.py"

echo
python3 -m wlbuilder --help >/dev/null && echo "PASS wlbuilder help" || {
  echo "FAIL wlbuilder help"
  fail=1
}

python3 -m wlbuilder status >/dev/null && echo "PASS wlbuilder status" || {
  echo "FAIL wlbuilder status"
  fail=1
}

python3 -m wlbuilder verify >/dev/null && echo "PASS wlbuilder verify" || {
  echo "FAIL wlbuilder verify"
  fail=1
}

python3 - <<'PYVERIFY' && echo "PASS wlbuilder runtime import" || {
import wlbuilder.runtime
from pathlib import Path

runtime = Path(wlbuilder.runtime.__file__).as_posix()
expected = "builder/python/wlbuilder/runtime.py"

if not runtime.endswith(expected):
    raise SystemExit(f"wrong runtime import: {runtime}")
PYVERIFY
  echo "FAIL wlbuilder runtime import"
  fail=1
}

echo
if [[ "$fail" -eq 0 ]]; then
  echo "PASS builder certification"
else
  echo "FAIL builder certification"
fi

exit "$fail"
