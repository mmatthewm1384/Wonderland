#!/usr/bin/env bash
set -euo pipefail

WL_HOME="${WL_HOME:-$HOME/Wonderland}"
rm -f "$WL_HOME/state/runtime/stop.requested" 2>/dev/null || true


WONDERLAND_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export PYTHONPATH="$WONDERLAND_ROOT${PYTHONPATH:+:$PYTHONPATH}"

exec python3 -m wl.runtime.commands.start "$@"
