#!/usr/bin/env bash
set -euo pipefail

ROOT="${WL_AUTHORITY_ROOT:-${WL_HOME:-$HOME/Wonderland}}"

wl_lima_running() {
  local name="$1"
  limactl list --format '{{.Name}} {{.Status}}' 2>/dev/null \
    | grep -Eq "^${name}[[:space:]]+Running$"
}

echo "== Starting Wonderland Rootless Runtime =="

limactl start wonderland-rootless >/dev/null 2>&1 || true

if wl_lima_running wonderland-rootless; then
  echo "PASS wonderland-rootless primary"
else
  echo "FAIL wonderland-rootless primary"
  exit 1
fi

echo
echo "== Starting Legacy Default Runtime =="
limactl start default >/dev/null 2>&1 || true

if wl_lima_running default; then
  echo "PASS default legacy"
else
  echo "WARN default legacy unavailable"
fi

echo
echo "== Status =="
"$ROOT/bin/wl-status"
