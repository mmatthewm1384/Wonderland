#!/usr/bin/env bash
set -euo pipefail

SRC="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
WL_HOME="${WL_HOME:-$HOME/Wonderland}"

mkdir -p "$WL_HOME"
rsync -a "$SRC"/ "$WL_HOME"/

chmod +x "$WL_HOME"/bin/wl-mind-body "$WL_HOME"/bin/wl-body-time "$WL_HOME"/bin/wl-mind-body-app || true

PROFILE="$HOME/.zshrc"
touch "$PROFILE"

grep -q 'WONDERLAND_MIND_BODY_TIME_TRAVEL' "$PROFILE" || cat >> "$PROFILE" <<'EOF'

# WONDERLAND_MIND_BODY_TIME_TRAVEL
export WL_HOME="${WL_HOME:-$HOME/Wonderland}"
export WL_DATA="${WL_DATA:-$WL_HOME/data}"
export PATH="$WL_HOME/bin:$PATH"
EOF

echo "Mind + Body Time Travel installed."
echo "Run:"
echo "  source ~/.zshrc"
echo "  wl-mind-body init"
