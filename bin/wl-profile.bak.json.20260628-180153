#!/usr/bin/env bash
set -uo pipefail

WL_HOME="${WL_HOME:-$HOME/Wonderland}"
. "$WL_HOME/lib/wl-bootstrap.sh"

cmd="${1:-status}"

case "$cmd" in
  status)
    wl_profile_status
    wl_exit
    ;;

  path)
    wl_profile_path
    ;;

  show)
    cat "$(wl_profile_path)"
    ;;

  *)
    echo "Usage: wl profile {status|path|show}"
    echo "RESULT FAIL"
    exit 1
    ;;
esac
