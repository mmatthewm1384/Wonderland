#!/usr/bin/env bash
set -uo pipefail

WL_HOME="${WL_HOME:-$HOME/Wonderland}"
. "$WL_HOME/lib/wl-bootstrap.sh"

cmd="${1:-status}"

case "$cmd" in
  status)
    wl_context_refresh
    wl_state_refresh

    runtime_state="$(wl_state_get runtime)"
    result="PASS"
    rc=0

    if [[ "$runtime_state" != "running" ]]; then
      result="FAIL"
      rc=1
    fi

    cat <<JSON
{
  "schema": "wonderland.api.status.v2",
  "result": "$result",
  "context": $(wl_context_dump),
  "state": $(wl_state_dump),
  "capabilities": $(wl_capabilities_dump),
  "health": $(wl_health_dump)
}
JSON
    exit "$rc"
    ;;

  *)
    echo "Usage: wl api status"
    echo "RESULT FAIL"
    exit 1
    ;;
esac
