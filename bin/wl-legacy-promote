#!/usr/bin/env bash
set -euo pipefail

ROOT="/Users/wonderland/Wonderland"
LEGACY="/Wonderland"
MANIFEST="$ROOT/vault/07-Operations/legacy-import/promotion/legacy-promotion-manifest.tsv"
ROLLBACK="$ROOT/vault/07-Operations/legacy-import/rollback/rollback-$(date +%Y%m%d-%H%M%S).tsv"

[[ -f "$MANIFEST" ]] || { echo "FAIL missing manifest: $MANIFEST"; exit 1; }

mkdir -p "$(dirname "$ROLLBACK")"

echo -e "destination\tbackup" > "$ROLLBACK"

tail -n +2 "$MANIFEST" | while IFS=$'\t' read -r source classification destination reason; do
  [[ -n "${source:-}" ]] || continue

  src="$LEGACY/$source"

  case "$classification" in
    promote)
      [[ -f "$src" ]] || { echo "WARN missing promote source: $source"; continue; }

      dest="$ROOT/$destination"
      mkdir -p "$(dirname "$dest")"

      if [[ -e "$dest" ]]; then
        backup="$dest.pre-legacy-import.$(date +%Y%m%d-%H%M%S)"
        cp -p "$dest" "$backup"
        echo -e "$dest\t$backup" >> "$ROLLBACK"
      else
        echo -e "$dest\t" >> "$ROLLBACK"
      fi

      cp -p "$src" "$dest"
      echo "PROMOTE $source -> $destination"
    ;;

    archive)
      [[ -e "$src" ]] || { echo "WARN missing archive source: $source"; continue; }

      dest="$destination"
      mkdir -p "$(dirname "$dest")"
      rsync -a "$src" "$dest"
      echo "ARCHIVE $source -> $destination"
    ;;

    reject)
      echo "REJECT $source"
    ;;

    *)
      echo "WARN unknown classification: $classification $source"
    ;;
  esac
done

echo "PASS legacy promotion"
echo "$ROLLBACK"
