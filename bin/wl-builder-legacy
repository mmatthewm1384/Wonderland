#!/usr/bin/env bash
set -euo pipefail

host_command_requires_limactl() {
  case "${1:-}" in
    status|start|stop|restart|shell|logs|root)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

if [[ "$(uname -s)" != "Darwin" ]] && host_command_requires_limactl "${1:-}"; then
  if ! command -v limactl >/dev/null 2>&1; then
    echo "FAIL: wl builder ${1:-} is a host-side command and requires limactl."
    echo "Inside the builder VM, use:"
    echo "  python3 -m wlbuilder status"
    echo "  python3 -m wlbuilder build --profile development"
    exit 1
  fi
fi


ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
INSTANCE="${WL_BUILDER_INSTANCE:-wonderland-os-builder}"
REMOTE_ROOT="${WL_BUILDER_ROOT:-/home/wonderland/wonderland-os}"

usage() {
cat <<EOF
Usage:
  wl builder status
  wl builder doctor
  wl builder shell
  wl builder root
  wl builder build [--profile development|release]
  wl builder verify
  wl builder certify
  wl builder recreate
  wl builder start
  wl builder stop
  wl builder restart
  wl builder clean
  wl builder logs
EOF
}

remote() {
  limactl shell "$INSTANCE" -- bash -lc "cd '$REMOTE_ROOT' && $*"
}

instance_status() {
  limactl list 2>/dev/null | awk -v name="$INSTANCE" '$1 == name {print $2}'
}

case "${1:-help}" in
  status)
    echo "== Wonderland Builder Status =="
    echo
    echo "Instance: $INSTANCE"
    echo "Status:   $(instance_status || echo unknown)"
    echo "Host:     $ROOT"
    echo "Builder:  $REMOTE_ROOT"
    echo
    remote '
      echo "Repository:"
      pwd
      test -x bin/wl && echo "bin/wl: PASS" || echo "bin/wl: FAIL"
      echo
      echo "Root:"
      bin/wl root
      echo
      echo "Python:"
      python3 --version
      python3 -m wlbuilder --help >/dev/null && echo "wlbuilder: PASS" || echo "wlbuilder: FAIL"
      echo
      echo "Tools:"
      for tool in debootstrap parted losetup mkfs.ext4 qemu-img; do
        if command -v "$tool" >/dev/null 2>&1; then
          echo "$tool: PASS"
        else
          echo "$tool: FAIL"
        fi
      done
      echo
      echo "Artifacts:"
      ls -lh releases/*.qcow2 2>/dev/null || echo "No QCOW2 release artifacts found"
      ls -lh build/vmware/*.vmdk 2>/dev/null || echo "No VMware VMDK artifacts found"
    '
    ;;

  doctor)
    if [[ "$(uname -s)" == "Darwin" ]]; then
      echo "Builder environment:"
      command -v limactl >/dev/null 2>&1 && echo "limactl: PASS" || echo "limactl: FAIL"
      limactl list "$INSTANCE" >/dev/null 2>&1 && echo "builder VM: PASS" || echo "builder VM: FAIL"
      exit 0
    fi

    exec python3 -m wlbuilder doctor
    ;;

  shell)
    exec limactl shell "$INSTANCE" -- bash -lc "cd '$REMOTE_ROOT' && exec bash"
    ;;

  root)
    remote 'pwd && bin/wl root'
    ;;

  build)
    if [[ "$(uname -s)" == "Darwin" ]]; then
      exec limactl shell "$INSTANCE" -- bash -lc "cd '$REMOTE_ROOT' && python3 -m wlbuilder build ${*:-}"
    fi

    exec python3 -m wlbuilder build "${@:2}"
    ;;

  verify)
    exec python3 -m wlbuilder verify
    ;;

  certify)
    exec bin/wl-builder-certify
    ;;

  recreate)
    exec "$ROOT/bin/wl-builder-recreate"
    ;;

  start)
    exec limactl start "$INSTANCE"
    ;;

  stop)
    exec limactl stop "$INSTANCE"
    ;;

  restart)
    limactl stop "$INSTANCE" || true
    exec limactl start "$INSTANCE"
    ;;

  clean)
    remote '
      rm -rf \
        builder/image \
        builder/image-python \
        builder/qcow2 \
        builder/mount \
        builder/rootfs \
        builder/work \
        build/image \
        build/image-python \
        build/qcow2 \
        build/vmware
      echo "PASS: builder generated artifacts cleaned"
    '
    ;;

  logs)
    LOG_DIR="$HOME/.lima/$INSTANCE"
    find "$LOG_DIR" -maxdepth 2 -type f \( -name "*.log" -o -name "ha.stderr.log" -o -name "ha.stdout.log" \) -print
    ;;

  help|-h|--help)
    usage
    ;;

  *)
    usage
    exit 1
    ;;
esac
