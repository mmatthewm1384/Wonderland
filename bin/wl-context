#!/usr/bin/env bash
set -uo pipefail

WL_HOME="${WL_HOME:-$HOME/Wonderland}"
. "$WL_HOME/lib/wl-bootstrap.sh"

cmd="${1:-show}"

case "$cmd" in
  show|dump)
    wl_context_dump
    ;;

  get)
    wl_context_get "${2:-}"
    ;;

  refresh)
    wl_context_refresh
    echo "RESULT PASS"
    ;;

  path)
    echo "$WL_CONTEXT_FILE"
    ;;

  *)
    echo "Usage: wl context {show|get <key>|refresh|path}"
    echo "RESULT FAIL"
    exit 1
    ;;
esac
