#!/usr/bin/env bash
set -euo pipefail

ROOT="${WL_AUTHORITY_ROOT:-${WL_HOME:-$HOME/Wonderland}}"
OUT="$ROOT/vault/06-Services/runtime/runtime-inventory.json"

mkdir -p "$(dirname "$OUT")"

python3 - "$OUT" <<'PY'
import json
import subprocess
import datetime
import pathlib
import sys

out = pathlib.Path(sys.argv[1])

def run(cmd):
    r = subprocess.run(
        cmd,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True
    )
    return {
        "ok": r.returncode == 0,
        "exit_code": r.returncode,
        "lines": [x for x in r.stdout.splitlines() if x.strip()]
    }

payload = {
    "id": "runtime-inventory-v4",
    "version": 4,
    "timestamp": datetime.datetime.now().isoformat(timespec="seconds"),
    "engine": "nerdctl",
    "containers": run(["nerdctl", "ps", "-a", "--format", "{{json .}}"]),
    "images": run(["nerdctl", "images", "--format", "{{json .}}"]),
    "networks": run(["nerdctl", "network", "ls", "--format", "{{json .}}"]),
    "volumes": run(["nerdctl", "volume", "ls", "--format", "{{json .}}"])
}

out.write_text(json.dumps(payload, indent=2) + "\n")

print(f"runtime inventory: {out}")
print(f"containers: {len(payload['containers']['lines'])}")
print(f"images: {len(payload['images']['lines'])}")
print(f"networks: {len(payload['networks']['lines'])}")
print(f"volumes: {len(payload['volumes']['lines'])}")
PY
