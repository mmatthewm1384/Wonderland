#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

echo "== Wonderland Secrets Certification =="

run() {
  echo
  echo "## $*"
  "$@"
}

run bin/wl secrets verify
run bin/wl secrets list
run bin/wl secrets report

echo
echo "PASS: secrets certification complete"
