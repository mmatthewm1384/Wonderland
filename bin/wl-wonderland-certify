#!/usr/bin/env python3
from __future__ import annotations

import argparse
import hashlib
import json
import os
import subprocess
import sys
import tarfile
import tempfile
import time
from datetime import datetime, timezone
from pathlib import Path
from typing import Any


PASS = "PASS"
FAIL = "FAIL"


class CertificationError(RuntimeError):
    pass


def repository_root() -> Path:
    configured = os.environ.get("WL_HOME") or os.environ.get(
        "WONDERLAND_ROOT"
    )

    if configured:
        candidate = Path(configured).expanduser().resolve()

        if (candidate / ".git").exists():
            return candidate

    candidate = Path(__file__).resolve().parent.parent

    if (candidate / ".git").exists():
        return candidate

    completed = subprocess.run(
        ["git", "rev-parse", "--show-toplevel"],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        check=False,
    )

    if completed.returncode == 0 and completed.stdout.strip():
        return Path(completed.stdout.strip()).resolve()

    raise CertificationError("unable to locate Wonderland repository")


def sha256(path: Path) -> str:
    digest = hashlib.sha256()

    with path.open("rb") as stream:
        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
            digest.update(chunk)

    return digest.hexdigest()


def write_json(path: Path, payload: Any) -> None:
    path.write_text(
        json.dumps(payload, indent=2, sort_keys=True) + "\n"
    )


def run_json(
    root: Path,
    name: str,
    command: list[str],
    timeout: int = 600,
) -> dict[str, Any]:
    env = os.environ.copy()
    env["WL_HOME"] = str(root)
    env["WONDERLAND_ROOT"] = str(root)
    env["WL_NONINTERACTIVE"] = "1"
    env["CI"] = "1"

    completed = subprocess.run(
        command,
        cwd=root,
        env=env,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        timeout=timeout,
        check=False,
    )

    if completed.returncode != 0:
        raise CertificationError(
            f"{name} exited {completed.returncode}: "
            f"{completed.stderr.strip() or completed.stdout.strip()}"
        )

    try:
        payload = json.loads(completed.stdout)
    except json.JSONDecodeError as exc:
        raise CertificationError(
            f"{name} emitted invalid JSON: {exc}"
        ) from exc

    result = payload.get("result")

    if result not in {"PASS", "WARN", "IDLE"}:
        raise CertificationError(
            f"{name} reported {result}"
        )

    return {
        "name": name,
        "command": command,
        "result": result,
        "payload": payload,
    }


def git_value(root: Path, *args: str) -> str:
    completed = subprocess.run(
        ["git", *args],
        cwd=root,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        check=False,
    )

    return (
        completed.stdout.strip()
        if completed.returncode == 0
        else "unknown"
    )


def verify_archive(
    archive_path: Path,
    digest_path: Path,
) -> None:
    expected = digest_path.read_text().split()[0]

    if sha256(archive_path) != expected:
        raise CertificationError(
            "Wonderland evidence archive checksum mismatch"
        )

    with tempfile.TemporaryDirectory(
        prefix="wl-wonderland-certify-"
    ) as temporary:
        extraction = Path(temporary).resolve()

        with tarfile.open(archive_path, "r:gz") as archive:
            for member in archive.getmembers():
                destination = (
                    extraction / member.name
                ).resolve()

                if (
                    destination != extraction
                    and extraction not in destination.parents
                ):
                    raise CertificationError(
                        "unsafe Wonderland evidence archive member"
                    )

            archive.extractall(extraction)

        sums = extraction / "SHA256SUMS"

        if not sums.is_file():
            raise CertificationError(
                "Wonderland evidence archive missing SHA256SUMS"
            )

        for line in sums.read_text().splitlines():
            expected_digest, filename = line.split(maxsplit=1)
            candidate = extraction / filename.strip()

            if not candidate.is_file():
                raise CertificationError(
                    f"missing evidence file: {filename}"
                )

            if sha256(candidate) != expected_digest:
                raise CertificationError(
                    f"evidence checksum mismatch: {filename}"
                )


def certify(root: Path) -> Path:
    created = datetime.now(timezone.utc)
    stamp = created.strftime("%Y%m%dT%H%M%SZ")
    output = (
        root
        / "vault/08-Operations/releases/wonderland/1.0.0"
        / stamp
    )
    output.mkdir(parents=True, exist_ok=False)

    checks = [
        run_json(
            root,
            "runtime",
            [str(root / "bin/wl"), "runtime", "verify", "--json"],
        ),
        run_json(
            root,
            "builder",
            [str(root / "bin/wl"), "builder", "verify", "--json"],
        ),
        run_json(
            root,
            "governance",
            [str(root / "bin/wl"), "governance", "verify", "--json"],
        ),
        run_json(
            root,
            "mirror",
            [str(root / "bin/wl"), "mirror", "verify", "--json"],
        ),
        run_json(
            root,
            "academy",
            [str(root / "bin/wl"), "academy", "verify", "--json"],
        ),
        run_json(
            root,
            "platform",
            [str(root / "bin/wl"), "platform", "verify", "--json"],
        ),
    ]

    for check in checks:
        write_json(
            output / f"{check['name']}-verification.json",
            check["payload"],
        )

    manifest = {
        "schema_version": 1,
        "release": "Wonderland 1.0.0",
        "created_at": created.isoformat(),
        "result": PASS,
        "repository": {
            "root": str(root),
            "branch": git_value(root, "branch", "--show-current"),
            "commit": git_value(root, "rev-parse", "HEAD"),
            "dirty": bool(
                git_value(root, "status", "--porcelain")
            ),
        },
        "subsystems": {
            check["name"]: {
                "result": check["result"],
                "command": check["command"],
            }
            for check in checks
        },
    }

    write_json(
        output / "wonderland-release-manifest.json",
        manifest,
    )

    evidence = sorted(
        path
        for path in output.iterdir()
        if path.is_file()
        and path.name != "SHA256SUMS"
    )

    sums = output / "SHA256SUMS"
    sums.write_text(
        "".join(
            f"{sha256(path)}  {path.name}\n"
            for path in evidence
        )
    )

    archive = output / (
        f"wonderland-1.0.0-evidence-{stamp}.tar.gz"
    )

    with tarfile.open(archive, "w:gz") as tar:
        for path in sorted(output.iterdir()):
            if path == archive:
                continue

            tar.add(path, arcname=path.name)

    archive_digest = output / f"{archive.name}.sha256"
    archive_digest.write_text(
        f"{sha256(archive)}  {archive.name}\n"
    )

    verify_archive(archive, archive_digest)

    return output


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Certify Wonderland 1.0"
    )
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args()

    started = time.monotonic()

    try:
        output = certify(repository_root())
    except (
        CertificationError,
        subprocess.TimeoutExpired,
        OSError,
    ) as exc:
        payload = {
            "schema_version": 1,
            "result": FAIL,
            "error": str(exc),
            "duration_ms": round(
                (time.monotonic() - started) * 1000
            ),
        }

        if args.json:
            print(json.dumps(payload, indent=2, sort_keys=True))
        else:
            print("Wonderland 1.0 Certification")
            print()
            print(f"FAIL {exc}")
            print()
            print("RESULT FAIL")

        return 1

    payload = {
        "schema_version": 1,
        "release": "Wonderland 1.0.0",
        "result": PASS,
        "evidence": str(output),
        "duration_ms": round(
            (time.monotonic() - started) * 1000
        ),
    }

    if args.json:
        print(json.dumps(payload, indent=2, sort_keys=True))
    else:
        print("Wonderland 1.0 Certification")
        print()
        print(f"evidence: {output}")
        print()
        print("RESULT PASS")

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
