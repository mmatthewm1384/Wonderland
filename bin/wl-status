#!/usr/bin/env bash
set -uo pipefail

WL_HOME="${WL_HOME:-$HOME/Wonderland}"
. "$WL_HOME/lib/wl-bootstrap.sh"

format="${1:-}"

if [[ "$format" == "--json" || "$format" == "json" ]]; then
  exec "$WL_HOME/bin/wl-api" status
fi

wl_context_refresh
wl_state_refresh

echo "Wonderland Status"
echo
echo "Root:    $(wl_context_get root)"
echo "Mode:    $(wl_context_get mode)"
echo "Profile: $(wl_context_get profile)"
echo "Version: $(wl_context_get version)"
echo "Build:   $(wl_context_get build)"

runtime_state="$(wl_state_get runtime)"
t7_state="$(wl_state_get t7)"
media_state="$(wl_state_get media)"
torrent_state="$(wl_state_get torrent)"

wl_section "Runtime"
[[ "$runtime_state" == "running" ]] \
  && wl_health_pass "$(wl_context_get runtime_instance)" "running" \
  || wl_health_fail "$(wl_context_get runtime_instance)" "$runtime_state"

wl_section "Storage"
[[ "$t7_state" == "attached" ]] \
  && wl_health_pass "t7" "$(wl_context_get t7_path)" \
  || wl_health_warn "t7" "detached"

wl_section "Capabilities"
[[ "$media_state" == "available" ]] \
  && wl_health_pass "media" "available" \
  || wl_health_warn "media" "unavailable"

[[ "$torrent_state" == "available" ]] \
  && wl_health_pass "torrent" "available" \
  || wl_health_warn "torrent" "unavailable"

wl_health_write
wl_health_exit
