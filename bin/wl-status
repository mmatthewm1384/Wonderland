#!/usr/bin/env bash
set -euo pipefail

ROOT="${WL_AUTHORITY_ROOT:-${WL_HOME:-$HOME/Wonderland}}"

pass(){ echo "PASS $*"; }
fail(){ echo "FAIL $*"; }
warn(){ echo "WARN $*"; }

lima_running() {
  local name="$1"
  limactl list --format '{{.Name}} {{.Status}}' 2>/dev/null \
    | grep -Eq "^${name}[[:space:]]+Running$"
}

container_running() {
  local name="$1"
  nerdctl ps --format '{{.Names}}' 2>/dev/null | grep -qx "$name"
}

echo "Wonderland Status"
echo "================="
echo

echo "Universe"
if [[ -x "$ROOT/bin/wl-universe" ]]; then
  "$ROOT/bin/wl-universe" status >/dev/null 2>&1 && pass universe || fail universe
elif [[ -x "$ROOT/bin/wl-universe-status" ]]; then
  "$ROOT/bin/wl-universe-status" >/dev/null 2>&1 && pass universe || fail universe
else
  warn "universe checker missing"
fi

echo
echo "Lima"
lima_running default && pass "default legacy" || warn "default legacy unavailable"
lima_running wonderland-rootless && pass "wonderland-rootless primary" || fail "wonderland-rootless primary"

echo
echo "Services"
for svc in wl-dns wl-nats wl-loki wl-prometheus wl-grafana; do
  container_running "$svc" && pass "$svc" || fail "$svc"
done

echo
echo "Storage"
if [[ -x "$ROOT/bin/wl-storage" ]]; then
  "$ROOT/bin/wl-storage" status 2>/dev/null || true
else
  warn "storage checker missing"
fi

echo
echo "Governance"
if [[ -x "$ROOT/bin/wl-governance" ]]; then
  "$ROOT/bin/wl-governance" status >/dev/null 2>&1 && pass governance || fail governance
else
  warn "governance checker missing"
fi

echo
echo "Doctor"
if [[ -x "$ROOT/bin/wl-doctor" ]]; then
  "$ROOT/bin/wl-doctor" || true
else
  warn "doctor missing"
fi
