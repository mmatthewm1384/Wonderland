#!/usr/bin/env bash
set -uo pipefail

WL_HOME="${WL_HOME:-$HOME/Wonderland}"
. "$WL_HOME/lib/wl-bootstrap.sh"

MANIFEST="$WL_HOME/config/commands.env"
lint_rc=0

wl_section "Wonderland Lint"

lint_bash() {
  local file="$1"
  bash -n "$file"
}

lint_python() {
  local file="$1"
  python3 -m py_compile "$file"
}

lint_one() {
  local rel="$1"
  local lang="$2"
  local enabled="$3"
  local file="$WL_HOME/$rel"

  [[ "$enabled" == "yes" ]] || {
    wl_warn "skip" "$rel disabled"
    return 0
  }

  [[ -f "$file" ]] || {
    wl_warn "missing" "$rel"
    return 0
  }

  case "$lang" in
    bash|sh)
      if lint_bash "$file"; then
        wl_pass "bash" "$rel"
      else
        wl_fail "bash" "$rel"
        lint_rc=1
      fi
      ;;

    python|py)
      if lint_python "$file"; then
        wl_pass "python" "$rel"
      else
        wl_fail "python" "$rel"
        lint_rc=1
      fi
      ;;

    none|skip)
      wl_warn "skip" "$rel"
      ;;

    *)
      wl_warn "unknown language" "$rel: $lang"
      ;;
  esac
}

if [[ ! -f "$MANIFEST" ]]; then
  wl_fail "manifest" "missing: $MANIFEST"
  echo
  echo "RESULT FAIL"
  exit 1
fi

while IFS='|' read -r rel lang enabled; do
  [[ -z "${rel:-}" ]] && continue
  [[ "$rel" == \#* ]] && continue
  lint_one "$rel" "$lang" "${enabled:-yes}"
done < "$MANIFEST"

wl_section "Config Validation"

profile_file="$WL_HOME/profiles/${WL_PROFILE:-internal-light}.json"
if [[ -f "$profile_file" ]]; then
  if python3 -m json.tool "$profile_file" >/dev/null; then
    wl_pass "profile json" "${WL_PROFILE:-internal-light}"
  else
    wl_fail "profile json" "${WL_PROFILE:-internal-light}"
    lint_rc=1
  fi
else
  wl_fail "profile json" "missing: $profile_file"
  lint_rc=1
fi

if [[ -f "$WL_HOME/config/services.env" ]]; then
  if bash -n "$WL_HOME/config/services.env"; then
    wl_pass "services config" "services.env"
  else
    wl_fail "services config" "services.env"
    lint_rc=1
  fi
else
  wl_warn "services config" "missing"
fi


context_file="$WL_HOME/runtime/context.json"
if [[ -f "$context_file" ]]; then
  if python3 -m json.tool "$context_file" >/dev/null && "$WL_HOME/lib/wl-context-validate.py" "$context_file" >/dev/null; then
    wl_pass "context schema" "runtime/context.json"
  else
    wl_fail "context schema" "runtime/context.json"
    lint_rc=1
  fi
else
  wl_warn "context json" "missing; will be generated by bootstrap"
fi

if [[ -f "$WL_HOME/config/wonderland.env" ]]; then
  if bash -n "$WL_HOME/config/wonderland.env"; then
    wl_pass "runtime config" "wonderland.env"
  else
    wl_fail "runtime config" "wonderland.env"
    lint_rc=1
  fi
else
  wl_fail "runtime config" "missing"
  lint_rc=1
fi

if (( lint_rc == 0 )); then
  echo
  echo "RESULT PASS"
  exit 0
else
  echo
  echo "RESULT FAIL"
  exit 1
fi
