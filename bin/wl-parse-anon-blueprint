#!/usr/bin/env bash
set -euo pipefail

ROOT="${WL_AUTHORITY_ROOT:-${WL_HOME:-$HOME/Wonderland}}"
BLUEPRINT="$ROOT/vault/blueprints/anon-gateway.md"
OUT_DIR="$ROOT/vault/06-Services/definitions"
REGISTRY="$ROOT/vault/06-Services/service-registry.json"

if [[ ! -f "$BLUEPRINT" ]]; then
  echo "FAIL blueprint missing: $BLUEPRINT"
  exit 1
fi

mkdir -p "$OUT_DIR"

python3 - "$ROOT" "$BLUEPRINT" "$OUT_DIR" "$REGISTRY" <<'PY'
import json
import pathlib
import re
import sys

root = pathlib.Path(sys.argv[1])
blueprint = pathlib.Path(sys.argv[2])
out_dir = pathlib.Path(sys.argv[3])
registry = pathlib.Path(sys.argv[4])

text = blueprint.read_text(errors="replace")

def ports_for(name):
    block = text.lower()
    candidates = []
    for m in re.finditer(r"(\d{2,5})\s*[:\-]\s*(\d{2,5})", block):
        candidates.append({"host": m.group(1), "container": m.group(2)})
    return candidates

def volumes_for(name):
    vols = []
    for m in re.finditer(r"([A-Za-z0-9_.-]+):(/[A-Za-z0-9_./-]+)", text):
        vols.append(m.group(1))
    return sorted(set(vols))

services = [
    {
        "source_name": "anon-gateway",
        "name": "wl-anon-gateway",
        "dependencies": [],
    },
    {
        "source_name": "anon-scraper",
        "name": "wl-anon-scraper",
        "dependencies": ["wl-anon-gateway"],
    },
]

entries = []

for svc in services:
    name = svc["name"]
    payload = {
        "id": f"{name}-service-v4",
        "name": name,
        "status": "draft",
        "version": 4,
        "runtime": "containerd",
        "engine": "nerdctl",
        "container": svc["source_name"],
        "blueprint": str(blueprint.relative_to(root)),
        "compose": None,
        "verify": f"wl runtime inspect {svc['source_name']}",
        "recover": f"wl services recover {name}",
        "rollback": f"wl services rollback {name}",
        "dependencies": svc["dependencies"],
        "ports": ports_for(svc["source_name"]),
        "volumes": volumes_for(svc["source_name"])
    }

    out = out_dir / f"{name}.service.json"
    out.write_text(json.dumps(payload, indent=2) + "\n")

    entries.append({
        "id": payload["id"],
        "name": name,
        "path": str(out.relative_to(root / "vault" / "06-Services")),
        "runtime": "containerd",
        "engine": "nerdctl",
        "container": svc["source_name"],
        "status": "draft"
    })

current = {"id": "service-registry-v4", "version": 4, "services": []}
if registry.exists():
    try:
        current = json.loads(registry.read_text())
    except Exception:
        pass

existing = {x.get("name"): x for x in current.get("services", [])}

for entry in entries:
    existing[entry["name"]] = entry

current["id"] = "service-registry-v4"
current["version"] = 4
current["services"] = sorted(existing.values(), key=lambda x: x["name"])

registry.write_text(json.dumps(current, indent=2) + "\n")

print(f"parsed: {blueprint}")
for e in entries:
    print(f"generated: {e['path']}")
PY
