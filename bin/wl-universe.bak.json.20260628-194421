#!/usr/bin/env bash
set -uo pipefail

WL_HOME="${WL_HOME:-$HOME/Wonderland}"
. "$WL_HOME/lib/wl-bootstrap.sh"

cmd="${1:-status}"

case "$cmd" in
  status)
    echo "Wonderland Universe Status"
    echo
    echo "Root:  $WL_HOME"
    echo "Mode:  ${WL_MODE:-light}"

    wl_section "Authority"
    [[ -n "${WL_MODE:-}" ]] && wl_pass "mode" "${WL_MODE:-light}" || wl_fail "mode" "missing"
    wl_required_path "storage" "$WL_HOME"
    wl_storage_t7_attached && wl_pass "storage authority" "external attached" || wl_warn "storage authority" "T7 detached; internal authority active"

    wl_section "Governance"
    wl_optional_path "governance" "$WL_HOME/vault/00-Governance"
    wl_optional_path "recovery" "$WL_HOME/vault/08-Operations/recovery"
    wl_optional_path "snapshot" "$WL_HOME/vault/08-Operations/snapshots"

    wl_section "Runtime"
    wl_runtime_running && wl_pass "services" "runtime available" || wl_fail "services" "runtime unavailable"

    wl_section "Capability"
    wl_capability_available media && wl_pass "media" "available" || wl_warn "media" "unavailable in current mode"
    wl_capability_available torrent && wl_pass "torrent" "available" || wl_warn "torrent" "unavailable in current mode"

    wl_exit
    ;;

  *)
    echo "Usage: wl universe status"
    echo "RESULT FAIL"
    exit 1
    ;;
esac
