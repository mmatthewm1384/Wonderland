#!/usr/bin/env bash
set -euo pipefail

ROOT="${WL_AUTHORITY_ROOT:-${WL_HOME:-$HOME/Wonderland}}"
OUT="$ROOT/vault/05-Registry/commands.json"

python3 - "$ROOT" "$OUT" <<'PY'
import json
import pathlib
import sys

root = pathlib.Path(sys.argv[1])
out = pathlib.Path(sys.argv[2])
bin_dir = root / "bin"

commands = []

for path in sorted(bin_dir.glob("wl*")):
    if not path.is_file():
        continue

    rel = path.relative_to(root)

    commands.append({
        "name": path.name,
        "path": str(rel),
        "category": "vault" if "vault" in path.name or "registry" in path.name else "core",
        "executable": bool(path.stat().st_mode & 0o111)
    })

payload = {
    "id": "commands-registry-v4",
    "version": 4,
    "commands": commands
}

out.write_text(json.dumps(payload, indent=2) + "\n")
print(f"commands refreshed: {out}")
print(f"count: {len(commands)}")
PY
