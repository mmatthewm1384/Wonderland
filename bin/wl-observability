#!/usr/bin/env bash
set -euo pipefail

ROOT="/Users/wonderland/Wonderland"

PROM_NAME="wl-prometheus"
LOKI_NAME="wl-loki"
GRAFANA_NAME="wl-grafana"

PROM_IMAGE="docker.io/prom/prometheus:latest"
LOKI_IMAGE="docker.io/grafana/loki:latest"
GRAFANA_IMAGE="docker.io/grafana/grafana:latest"

timeout_curl() {
  local url="$1"
  if command -v timeout >/dev/null 2>&1; then
    timeout 5 curl -fsS "$url" >/dev/null
  elif command -v gtimeout >/dev/null 2>&1; then
    gtimeout 5 curl -fsS "$url" >/dev/null
  else
    curl --max-time 5 -fsS "$url" >/dev/null
  fi
}

wait_curl() {
  local url="$1"
  local tries="${2:-12}"
  local delay="${3:-2}"

  for _ in $(seq 1 "$tries"); do
    if timeout_curl "$url"; then
      return 0
    fi
    sleep "$delay"
  done

  return 1
}

container_up() {
  local name="$1"
  nerdctl ps --filter "name=$name" --format '{{.Names}}' | grep -qx "$name"
}

up_prometheus() {
  nerdctl rm -f "$PROM_NAME" >/dev/null 2>&1 || true
  nerdctl run -d \
    --name "$PROM_NAME" \
    -p 9090:9090 \
    -v "$ROOT/docker/wl-prometheus/config/prometheus.yml:/etc/prometheus/prometheus.yml:ro" \
    "$PROM_IMAGE" \
    --config.file=/etc/prometheus/prometheus.yml
}

up_loki() {
  nerdctl rm -f "$LOKI_NAME" >/dev/null 2>&1 || true
  nerdctl run -d \
    --name "$LOKI_NAME" \
    -p 3100:3100 \
    -v "$ROOT/docker/wl-loki/config/local-config.yaml:/etc/loki/local-config.yaml:ro" \
    "$LOKI_IMAGE" \
    -config.file=/etc/loki/local-config.yaml
}

up_grafana() {
  nerdctl rm -f "$GRAFANA_NAME" >/dev/null 2>&1 || true
  nerdctl run -d \
    --name "$GRAFANA_NAME" \
    -p 3000:3000 \
    -e GF_SECURITY_ADMIN_USER=admin \
    -e GF_SECURITY_ADMIN_PASSWORD=admin \
    -v "$ROOT/docker/wl-grafana/provisioning:/etc/grafana/provisioning:ro" \
    -v "$ROOT/docker/wl-grafana/dashboards:/var/lib/grafana/dashboards:ro" \
    "$GRAFANA_IMAGE"
}

case "${1:-status}" in
  up|repair)
    up_loki
    up_prometheus
    up_grafana
    echo "PASS observability up"
  ;;

  down|rollback)
    nerdctl rm -f "$GRAFANA_NAME" "$PROM_NAME" "$LOKI_NAME" >/dev/null 2>&1 || true
    echo "PASS observability down"
  ;;

  status)
    nerdctl ps -a --filter "name=wl-prometheus"
    nerdctl ps -a --filter "name=wl-loki"
    nerdctl ps -a --filter "name=wl-grafana"
  ;;

  logs)
    service="${2:-}"
    case "$service" in
      prometheus) nerdctl logs "$PROM_NAME" ;;
      loki) nerdctl logs "$LOKI_NAME" ;;
      grafana) nerdctl logs "$GRAFANA_NAME" ;;
      *) echo "Usage: wl observability logs prometheus|loki|grafana"; exit 1 ;;
    esac
  ;;

  doctor|verify)
    FAIL=0

    printf "%-24s" "prometheus container"
    container_up "$PROM_NAME" && echo "PASS" || { echo "FAIL"; FAIL=1; }

    printf "%-24s" "loki container"
    container_up "$LOKI_NAME" && echo "PASS" || { echo "FAIL"; FAIL=1; }

    printf "%-24s" "grafana container"
    container_up "$GRAFANA_NAME" && echo "PASS" || { echo "FAIL"; FAIL=1; }

    printf "%-24s" "prometheus api"
    wait_curl "http://127.0.0.1:9090/-/ready" 10 2 && echo "PASS" || { echo "FAIL"; FAIL=1; }

    printf "%-24s" "loki api"
    wait_curl "http://127.0.0.1:3100/ready" 15 2 && echo "PASS" || { echo "FAIL"; FAIL=1; }

    printf "%-24s" "grafana api"
    wait_curl "http://127.0.0.1:3000/api/health" 15 2 && echo "PASS" || wait_curl "http://127.0.0.1:3000/login" 5 2 && echo "PASS" || { echo "FAIL"; FAIL=1; }

    [[ "$FAIL" -eq 0 ]] || exit 1
    echo "PASS observability doctor"
  ;;

  doctor-prometheus)
    container_up "$PROM_NAME"
    timeout_curl "http://127.0.0.1:9090/-/ready"
    echo "PASS wl-prometheus doctor"
  ;;

  doctor-loki)
    container_up "$LOKI_NAME"
    wait_curl "http://127.0.0.1:3100/ready" 15 2
    echo "PASS wl-loki doctor"
  ;;

  doctor-grafana)
    container_up "$GRAFANA_NAME"
    wait_curl "http://127.0.0.1:3000/api/health" 15 2 || wait_curl "http://127.0.0.1:3000/login" 5 2
    echo "PASS wl-grafana doctor"
  ;;

  *)
    echo "Usage: wl-observability up|down|status|logs|doctor|repair|rollback|doctor-prometheus|doctor-loki|doctor-grafana"
    exit 1
  ;;
esac
