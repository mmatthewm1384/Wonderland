#!/usr/bin/env bash
set -euo pipefail

WL_ROOT="${WL_ROOT:-$HOME/Wonderland}"
BIN="$WL_ROOT/bin"
APP_DIR="$WL_ROOT/apps/macos"

# Remove old symlink-style commands if present.
rm -f "$BIN/wl-spin-city-app" "$BIN/wl-agitate-app"

# Dedicated permanent launchers.
cat > "$BIN/wl-spin-city" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
open "$HOME/Wonderland/apps/macos/Spin City Wave.app"
EOF

cat > "$BIN/wl-agitate" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
open "$HOME/Wonderland/apps/macos/Agitate Waves.app"
EOF

cat > "$BIN/wl-matrix-native" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
open "$HOME/Wonderland/apps/macos/Matrix Atom Destroyer.app"
EOF

chmod +x "$BIN/wl-spin-city" "$BIN/wl-agitate" "$BIN/wl-matrix-native"

echo "Permanent Matrix app launchers"

for app in \
  "$APP_DIR/Spin City Wave.app" \
  "$APP_DIR/Agitate Waves.app" \
  "$APP_DIR/Matrix Atom Destroyer.app"
do
  [[ -d "$app" ]] && echo "PASS $app" || echo "FAIL $app"
done

echo
echo "Commands:"
echo "  wl-spin-city"
echo "  wl-agitate"
echo "  wl-matrix-native"
