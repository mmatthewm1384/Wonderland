#!/usr/bin/env bash
set -uo pipefail

WL_HOME="${WL_HOME:-$HOME/Wonderland}"
. "$WL_HOME/lib/wl-bootstrap.sh"

cmd="${1:-status}"
format="${2:-}"

runtime_state() {
  if wl_runtime_running; then
    echo "running"
  elif wl_runtime_exists; then
    echo "stopped"
  else
    echo "missing"
  fi
}

case "$cmd" in
  status)
    state="$(runtime_state)"
    limactl_state="missing"
    command -v limactl >/dev/null 2>&1 && limactl_state="available"

    result="PASS"
    rc=0

    if [[ "$limactl_state" != "available" || "$state" == "missing" ]]; then
      result="FAIL"
      rc=1
    elif [[ "$state" == "stopped" ]]; then
      result="PASS"
      rc=0
    fi

    if [[ "$format" == "--json" || "$format" == "json" ]]; then
      cat <<JSON
{
  "result": "$result",
  "runtime_instance": "$WL_RUNTIME_INSTANCE",
  "limactl": "$limactl_state",
  "state": "$state"
}
JSON
      exit "$rc"
    fi

    wl_section "Wonderland Runtime"

    [[ "$limactl_state" == "available" ]] && wl_pass "limactl" "$(command -v limactl)" || wl_fail "limactl" "missing"

    case "$state" in
      running)
        wl_pass "$WL_RUNTIME_INSTANCE" "running"
        ;;
      stopped)
        wl_warn "$WL_RUNTIME_INSTANCE" "exists but stopped"
        ;;
      *)
        wl_fail "$WL_RUNTIME_INSTANCE" "missing"
        ;;
    esac

    wl_exit
    ;;

  start)
    wl_section "Starting Wonderland Runtime"
    wl_runtime_start
    wl_runtime_running && wl_pass "$WL_RUNTIME_INSTANCE" "running" || wl_fail "$WL_RUNTIME_INSTANCE" "not running"
    wl_exit
    ;;

  stop)
    wl_section "Stopping Wonderland Runtime"
    wl_runtime_stop
    wl_runtime_running && wl_warn "$WL_RUNTIME_INSTANCE" "still running" || wl_pass "$WL_RUNTIME_INSTANCE" "stopped"
    wl_exit
    ;;

  restart)
    "$0" stop || true
    "$0" start
    ;;

  *)
    echo "Usage: wl runtime {status [--json]|start|stop|restart}"
    echo "RESULT FAIL"
    exit 1
    ;;
esac
