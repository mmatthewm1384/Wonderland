#!/usr/bin/env bash
set -euo pipefail

case "${1:-help}" in
  publish)
    echo "FAIL: wl release publish is not implemented yet."
    exit 1
    ;;
  list)
    find releases -maxdepth 3 -type f 2>/dev/null | sort || true
    ;;
  help|-h|--help|*)
    cat <<'EOF'
Usage:
  wl release publish
  wl release list
EOF
    ;;
esac
