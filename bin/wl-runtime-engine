#!/usr/bin/env bash
set -Eeuo pipefail

ROOT="${WL_HOME:-${WONDERLAND_ROOT:-}}"

if [[ -z "$ROOT" ]]; then
  ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
fi

CORE="$ROOT/bin/wl-runtime-engine-core"

[[ -x "$CORE" ]] || {
  printf 'FAIL Runtime core launcher unavailable: %s\n' "$CORE" >&2
  exit 1
}

if [[ "${1:-}" == "verify" ]]; then
  shift

  json=false
  forwarded=()

  for argument in "$@"; do
    case "$argument" in
      --json)
        json=true
        ;;
      *)
        forwarded+=("$argument")
        ;;
    esac
  done

  # Bash with `set -u` can reject an empty array expansion. Build the optional
  # argument vector explicitly so `verify` with no forwarded arguments is safe.
  core_args=(verify)
  if ((${#forwarded[@]})); then
    core_args+=("${forwarded[@]}")
  fi

  if [[ "$json" == true ]]; then
    stdout_file="$(mktemp)"
    stderr_file="$(mktemp)"

    cleanup() {
      rm -f "$stdout_file" "$stderr_file"
    }

    trap cleanup EXIT

    set +e
    "$CORE" "${core_args[@]}" \
      > "$stdout_file" \
      2> "$stderr_file"
    rc=$?
    set -e

    python3 - \
      "$rc" \
      "$stdout_file" \
      "$stderr_file" \
      "$ROOT" <<'PY'
import json
import sys
from pathlib import Path

return_code = int(sys.argv[1])
stdout = Path(sys.argv[2]).read_text()
stderr = Path(sys.argv[3]).read_text()
root = sys.argv[4]

combined = f"{stdout}\n{stderr}".upper()

if return_code != 0 or "RESULT FAIL" in combined:
    result = "FAIL"
elif "RESULT WARN" in combined:
    result = "WARN"
elif "RESULT IDLE" in combined:
    result = "IDLE"
else:
    result = "PASS"

payload = {
    "schema_version": 1,
    "subsystem": "runtime",
    "command": "verify",
    "root": root,
    "result": result,
    "exit_code": return_code,
    "stdout": stdout.strip(),
    "stderr": stderr.strip(),
}

print(json.dumps(payload, indent=2, sort_keys=True))
PY

    exit "$rc"
  fi

  exec "$CORE" "${core_args[@]}"
fi

exec "$CORE" "$@"
