#!/usr/bin/env bash
set -euo pipefail

ROOT="${WL_AUTHORITY_ROOT:-${WL_HOME:-$HOME/Wonderland}}"
OUT_DIR="$ROOT/vault/07-Operations/audits"

mkdir -p "$OUT_DIR"

STAMP="$(date +%Y%m%d-%H%M%S)"
OUT="$OUT_DIR/audit-$STAMP.md"

{
echo "# Wonderland Audit Report"
echo
echo "Timestamp: $(date)"
echo
echo "## Verification"
"$ROOT/bin/wl" verify || true
echo
echo "## Runtime"
nerdctl ps || true
} > "$OUT"

echo "$OUT"
