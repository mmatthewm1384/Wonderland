#!/usr/bin/env bash
set -euo pipefail

WL_HOME="${WL_HOME:-$HOME/Wonderland}"
cd "$WL_HOME"

stamp="$(date +%Y%m%d-%H%M%S)"
dest="archive/obsolete-runtime-scripts/$stamp"
mkdir -p "$dest"

matches="$(grep -RIl --exclude-dir=.git \
  -E 'LIMA_INSTANCE=default|limactl (start|stop|shell|delete) default|lima://default' \
  bin scripts config services apps 2>/dev/null || true)"

if [[ -z "$matches" ]]; then
  echo "PASS no obsolete default-runtime scripts found"
  exit 0
fi

echo "$matches" | while read -r file; do
  mkdir -p "$dest/$(dirname "$file")"
  cp -p "$file" "$dest/$file"
  sed -i.bak \
    -e 's/LIMA_INSTANCE=default/LIMA_INSTANCE=wonderland-rootless/g' \
    -e 's/limactl start wonderland-rootless/limactl start wonderland-rootless/g' \
    -e 's/limactl stop wonderland-rootless/limactl stop wonderland-rootless/g' \
    -e 's/limactl shell wonderland-rootless/limactl shell wonderland-rootless/g' \
    "$file"
  rm -f "$file.bak"
  echo "PATCH $file"
done

echo "ARCHIVE $dest"
