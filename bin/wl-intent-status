#!/usr/bin/env bash
set -euo pipefail

ROOT="/Users/wonderland/Wonderland"
INTENTS="$ROOT/vault/05-Registry/intents"
ID="${1:-}"
STATUS="${2:-}"

if [[ -z "$ID" || -z "$STATUS" ]]; then
  echo "Usage: wl-intent-status <intent-id-or-file> <draft|approved|rejected|executed|archived>"
  exit 1
fi

case "$STATUS" in
  draft|approved|rejected|executed|archived) ;;
  *)
    echo "FAIL invalid status: $STATUS"
    exit 1
    ;;
esac

python3 - "$INTENTS" "$ID" "$STATUS" <<'PY'
import json
import pathlib
import sys

intents = pathlib.Path(sys.argv[1])
target = sys.argv[2]
status = sys.argv[3]

matches = []

p = pathlib.Path(target)
if p.exists():
    matches = [p]
else:
    for f in intents.glob("*.intent.json"):
        try:
            data = json.loads(f.read_text())
        except Exception:
            continue
        if data.get("id") == target or f.name == target:
            matches.append(f)

if not matches:
    print(f"FAIL intent not found: {target}")
    sys.exit(1)

if len(matches) > 1:
    print(f"FAIL multiple intents matched: {target}")
    for m in matches:
        print(m)
    sys.exit(1)

f = matches[0]
data = json.loads(f.read_text())
data["status"] = status
f.write_text(json.dumps(data, indent=2) + "\n")

print(f"updated: {f}")
print(f"status: {status}")
PY

"$ROOT/bin/wl-registry-refresh-intents" >/dev/null
"$ROOT/bin/wl-verify-intents"
