#!/usr/bin/env bash
set -euo pipefail

ROOT="/Users/wonderland/Wonderland"
REG="$ROOT/vault/05-Registry/services.json"
OUT="$ROOT/vault/07-Operations/recovery/certifications/service-recovery-certifications.json"

mkdir -p "$(dirname "$OUT")"

service="${2:-}"

check_cmd() {
  local label="$1"
  local cmd="$2"

  printf "%-24s" "$label"

  if [[ -z "$cmd" || "$cmd" == "null" ]]; then
    echo "FAIL missing command"
    return 1
  fi

  if timeout 20 bash -lc "cd '$ROOT' && $cmd" >/tmp/wl-service-certify.log 2>&1; then
    echo "PASS"
    return 0
  else
    echo "FAIL"
    sed 's/^/  /' /tmp/wl-service-certify.log
    return 1
  fi
}

certify_one() {
  local svc="$1"
  local def
  local doctor
  local recover
  local rollback
  local fail=0

  def="$(python3 - <<PY
import json
from pathlib import Path
root = Path("$ROOT")
reg = json.loads(Path("$REG").read_text())
svc = "$svc"
for s in reg.get("services", []):
    if s.get("name") == svc or s.get("container") == svc:
        print(root / "vault" / s["path"])
        break
PY
)"

  echo
  echo "Wonderland Service Recovery Certification"
  echo "service: $svc"
  echo

  [[ -n "$def" && -f "$def" ]] && echo "definition               PASS" || { echo "definition               FAIL"; return 1; }

  doctor="$(python3 - <<PY
import json
from pathlib import Path
d=json.loads(Path("$def").read_text())
print(d.get("verify") or d.get("doctor") or "")
PY
)"

  recover="$(python3 - <<PY
import json
from pathlib import Path
d=json.loads(Path("$def").read_text())
print(d.get("recover") or "")
PY
)"

  rollback="$(python3 - <<PY
import json
from pathlib import Path
d=json.loads(Path("$def").read_text())
print(d.get("rollback") or "")
PY
)"

  check_cmd "doctor" "$doctor" || fail=1

  printf "%-24s" "recovery"
  if [[ -n "$recover" && "$recover" != "null" ]]; then
    echo "PASS declared"
  else
    echo "FAIL missing command"
    fail=1
  fi

  printf "%-24s" "rollback"
  if [[ -n "$rollback" && "$rollback" != "null" ]]; then
    echo "PASS declared"
  else
    echo "FAIL missing command"
    fail=1
  fi

  if [[ "$fail" -eq 0 ]]; then
    python3 - <<PY
import json
from pathlib import Path
from datetime import datetime

out=Path("$OUT")
if out.exists():
    data=json.loads(out.read_text())
else:
    data={"id":"service-recovery-certifications-v1","services":[]}

svc="$svc"
data["services"]=[x for x in data["services"] if x.get("service") != svc]
data["services"].append({
    "service": svc,
    "status": "certified",
    "certified": datetime.now().isoformat(),
    "definition": "$def"
})
out.write_text(json.dumps(data, indent=2) + "\\n")
PY
    echo
    echo "CERTIFIED $svc"
  else
    echo
    echo "UNCERTIFIED $svc"
    exit 1
  fi
}

case "${1:-}" in
  certify)
    [[ -n "$service" ]] || { echo "Usage: wl service-certify certify <service>"; exit 1; }
    certify_one "$service"
  ;;

  verify-all|doctor)
    services="$(python3 - <<PY
import json
from pathlib import Path
reg=json.loads(Path("$REG").read_text())
for s in reg.get("services", []):
    if s.get("status") == "active":
        print(s.get("name"))
PY
)"
    for s in $services; do
      certify_one "$s"
    done
  ;;

  list)
    [[ -f "$OUT" ]] && cat "$OUT" || echo '{"id":"service-recovery-certifications-v1","services":[]}'
  ;;

  *)
    echo "Usage:"
    echo "  wl service-certify certify <service>"
    echo "  wl service-certify verify-all"
    echo "  wl service-certify list"
    exit 1
  ;;
esac
