#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BACKUP_DIR="$ROOT/builder/backups"

latest="$(
  find "$BACKUP_DIR" -maxdepth 1 -type f -name 'wl-before-mirror-dispatch-*' 2>/dev/null \
    | sort \
    | tail -n 1
)"

if [[ -z "${latest:-}" ]]; then
  echo "FAIL: no wl dispatcher backup found in $BACKUP_DIR"
  exit 1
fi

cp "$latest" "$ROOT/bin/wl"
chmod +x "$ROOT/bin/wl"

echo "PASS: restored bin/wl from $latest"
