#!/usr/bin/env bash
set -euo pipefail

WL_HOME="${WL_HOME:-$HOME/Wonderland}"
source "$WL_HOME/lib/wl-lifecycle-lib.sh"

echo "Wonderland Lifecycle Audit"
echo

for f in \
  bin/wl \
  bin/wl-lifecycle \
  bin/wl-start \
  bin/wl-stop \
  bin/wl-status \
  bin/wl-doctor-lifecycle \
  bin/wl-lifecycle-report \
  bin/wl-lifecycle-services \
  bin/wl-lifecycle-snapshot \
  lib/wl-lifecycle-lib.sh
do
  [ -x "$WL_HOME/$f" ] || [ -f "$WL_HOME/$f" ] \
    && wl_pass "$f" \
    || wl_fail "$f"
done

echo
echo "Routes"
grep -q 'start) exec "$WL_HOME/bin/wl-lifecycle" start' "$WL_HOME/bin/wl" \
  && wl_pass "wl start route" \
  || wl_fail "wl start route"

grep -q 'stop) exec "$WL_HOME/bin/wl-lifecycle" stop' "$WL_HOME/bin/wl" \
  && wl_pass "wl stop route" \
  || wl_fail "wl stop route"

grep -q 'doctor) exec "$WL_HOME/bin/wl-doctor-lifecycle"' "$WL_HOME/bin/wl" \
  && wl_pass "wl doctor route" \
  || wl_fail "wl doctor route"

echo
echo "Registries"
[ -f "$WL_HOME/governance/registries/lifecycle-services.json" ] \
  && wl_pass "lifecycle-services.json" \
  || wl_fail "lifecycle-services.json"

[ -f "$WL_HOME/governance/registries/lifecycle-certification.json" ] \
  && wl_pass "lifecycle-certification.json" \
  || wl_warn "lifecycle-certification.json"
