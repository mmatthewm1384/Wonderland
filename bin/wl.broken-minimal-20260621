#!/usr/bin/env bash
set -euo pipefail

WL_HOME="${WL_HOME:-$HOME/Wonderland}"
WL_BIN="$WL_HOME/bin"
WL_VAULT="$WL_HOME/vault"

usage() {
  cat <<USAGE
wl

Available:
  wl status
  wl doctor

  wl storage <command>
  wl governance <command>
  wl universe <command>
  wl firefox <command>
  wl ephemeral <command>

  wl vault status
  wl vault open

  wl obsidian status
  wl obsidian open
  wl obsidian list
  wl obsidian run <intent>

  wl matrix fluderation
USAGE
}

run_bin() {
  local name="$1"
  shift

  if [[ -x "$WL_BIN/$name" ]]; then
    exec "$WL_BIN/$name" "$@"
  fi

  echo "FAIL missing executable: $WL_BIN/$name"
  exit 1
}

vault_status() {
  echo "WL_HOME=$WL_HOME"
  echo "WL_VAULT=$WL_VAULT"

  test -d "$WL_HOME" && echo "PASS home" || echo "FAIL home"
  test -d "$WL_BIN" && echo "PASS bin" || echo "FAIL bin"
  test -d "$WL_VAULT" && echo "PASS vault" || echo "FAIL vault"
}

doctor() {
  fail=0

  test -d "$WL_HOME" && echo "PASS home" || { echo "FAIL home"; fail=1; }
  test -d "$WL_BIN" && echo "PASS bin" || { echo "FAIL bin"; fail=1; }
  test -d "$WL_VAULT" && echo "PASS vault" || { echo "FAIL vault"; fail=1; }
  test -x "$WL_BIN/wl" && echo "PASS wl-router" || { echo "FAIL wl-router"; fail=1; }

  for bin in wl-storage wl-governance wl-universe wl-firefox wl-obsidian; do
    if [[ -x "$WL_BIN/$bin" ]]; then
      echo "PASS $bin"
    else
      echo "WARN missing $bin"
    fi
  done

  if [[ -x "$WL_HOME/Wonderland/ephemeral/bin/wl-ephemeral" ]]; then
    echo "PASS wl-ephemeral"
  else
    echo "WARN missing wl-ephemeral"
  fi

  test "$fail" -eq 0 && echo "RESULT PASS" || { echo "RESULT FAIL"; exit 1; }
}

matrix_fluderation() {
  app="$WL_HOME/apps/tauri/wl-spin-city"
  if test -d "$app"; then
    echo "matrix fluderation target: $app"
    cd "$app"
    npm run tauri dev
  else
    echo "PASS matrix fluderation route"
    echo "WARN no Tauri app found at: $app"
  fi
}

case "${1:-}" in
  status)
    vault_status
    ;;

  doctor)
    doctor
    ;;

  storage)
    shift
    run_bin wl-storage "$@"
    ;;

  governance)
    shift
    run_bin wl-governance "$@"
    ;;

  universe)
    shift
    run_bin wl-universe "$@"
    ;;

  firefox)
    shift
    run_bin wl-firefox "$@"
    ;;

  ephemeral)
    shift
    if [[ -x "$WL_HOME/Wonderland/ephemeral/bin/wl-ephemeral" ]]; then
      exec "$WL_HOME/Wonderland/ephemeral/bin/wl-ephemeral" "$@"
    fi
    echo "FAIL missing executable: $WL_HOME/Wonderland/ephemeral/bin/wl-ephemeral"
    exit 1
    ;;

  vault)
    case "${2:-}" in
      status) vault_status ;;
      open) open "$WL_VAULT" ;;
      *) usage; exit 2 ;;
    esac
    ;;

  obsidian)
    shift
    run_bin wl-obsidian "$@"
    ;;

  matrix)
    case "${2:-}" in
      fluderation) matrix_fluderation ;;
      *) usage; exit 2 ;;
    esac
    ;;

  *)
    usage
    exit 2
    ;;
esac
