#!/usr/bin/env bash
set -euo pipefail

WL_HOME="${WL_HOME:-$HOME/Wonderland}"
SERVICES_ROOT="${SERVICES_ROOT:-$HOME/Workshop/services}"
REGISTRY="$WL_HOME/vault/05-Registry/services.json"
REPORT_DIR="$WL_HOME/vault/08-Operations/reports/services"

mkdir -p "$(dirname "$REGISTRY")" "$REPORT_DIR"

python3 - "$SERVICES_ROOT" "$REGISTRY" <<'PY'
import json
import hashlib
import sys
from pathlib import Path
from datetime import datetime, timezone
from collections import defaultdict, deque

services_root = Path(sys.argv[1])
registry_path = Path(sys.argv[2])

def sha256(path: Path):
    return hashlib.sha256(path.read_bytes()).hexdigest()

services = {}
errors = []

for d in sorted(services_root.iterdir()):
    if not d.is_dir():
        continue

    compose = d / "compose.yaml"
    meta_path = d / "service.json"

    if not compose.exists():
        continue

    meta = {
        "name": d.name,
        "runtime": "wonderland-rootless",
        "compose": "compose.yaml",
        "containers": [d.name],
        "depends_on": [],
        "critical": True,
        "autostart": True,
    }

    if meta_path.exists():
        try:
            loaded = json.loads(meta_path.read_text())
            meta.update(loaded)
        except Exception as e:
            errors.append({
                "service": d.name,
                "error": f"invalid service.json: {e}"
            })

    name = meta.get("name") or d.name

    depends_on = meta.get("depends_on") or []
    containers = meta.get("containers") or [name]

    if not isinstance(depends_on, list):
        errors.append({"service": name, "error": "depends_on must be a list"})
        depends_on = []

    if not isinstance(containers, list):
        errors.append({"service": name, "error": "containers must be a list"})
        containers = [name]

    services[name] = {
        "name": name,
        "directory": str(d),
        "runtime": meta.get("runtime", "wonderland-rootless"),
        "compose": str(compose),
        "compose_file": meta.get("compose", "compose.yaml"),
        "compose_sha256": sha256(compose),
        "service_json": str(meta_path) if meta_path.exists() else None,
        "service_json_sha256": sha256(meta_path) if meta_path.exists() else None,
        "containers": containers,
        "depends_on": depends_on,
        "critical": bool(meta.get("critical", True)),
        "autostart": bool(meta.get("autostart", True)),
        "health": meta.get("health"),
        "metadata": meta,
    }

for name, svc in services.items():
    for dep in svc["depends_on"]:
        if dep not in services:
            errors.append({
                "service": name,
                "error": f"missing dependency: {dep}"
            })

incoming = {name: 0 for name in services}
outgoing = defaultdict(list)

for name, svc in services.items():
    for dep in svc["depends_on"]:
        if dep in services:
            outgoing[dep].append(name)
            incoming[name] += 1

q = deque(sorted([name for name, count in incoming.items() if count == 0]))
start_order = []

while q:
    node = q.popleft()
    start_order.append(node)
    for child in sorted(outgoing[node]):
        incoming[child] -= 1
        if incoming[child] == 0:
            q.append(child)

cycle_nodes = sorted([name for name, count in incoming.items() if count > 0])
if cycle_nodes:
    errors.append({
        "service": ",".join(cycle_nodes),
        "error": "dependency cycle detected"
    })

registry = {
    "generated_at": datetime.now(timezone.utc).isoformat(),
    "runtime": "wonderland-rootless",
    "services_root": str(services_root),
    "valid": not errors,
    "errors": errors,
    "start_order": start_order,
    "stop_order": list(reversed(start_order)),
    "services": [services[name] for name in sorted(services)],
}

registry_path.write_text(json.dumps(registry, indent=2) + "\n")

print(f"REGISTRY {registry_path}")
print(f"VALID {str(registry['valid']).upper()}")
print("START_ORDER " + " ".join(start_order))

if errors:
    for e in errors:
        print(f"ERROR {e['service']}: {e['error']}")
    raise SystemExit(1)
PY

cp "$REGISTRY" "$REPORT_DIR/latest-services-registry.json"

echo "RESULT PASS"
