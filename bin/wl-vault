#!/usr/bin/env bash
set -euo pipefail
VOLUME_NAME="Wonderland_Secret_Zone"
RAM_DISK_SIZE_SECTORS=204800
ROOT="${WL_AUTHORITY_ROOT:-${WL_HOME:-$HOME/Wonderland}}"
REGISTRY_TOKEN="$ROOT/secrets/.vault_token"
up() {
    if [ -f "$REGISTRY_TOKEN" ]; then echo "[WARN] Active."; exit 0; fi
    echo "[INIT] Allocating memory blocks..."
    DISK_DEV=$(hdid -nomount "ram://$RAM_DISK_SIZE_SECTORS" | xargs)
    sleep 1
    PASSPHRASE=$(dd if=/dev/urandom bs=32 count=1 2>/dev/null | base64)
    echo "$PASSPHRASE" | diskutil apfs create "$DISK_DEV" "$VOLUME_NAME" > /dev/null
    echo "$DISK_DEV" > "$REGISTRY_TOKEN"
    echo "[SUCCESS] Mounted at: /Volumes/$VOLUME_NAME"
}
down() {
    if [ ! -f "$REGISTRY_TOKEN" ]; then echo "[INFO] No active vault."; exit 0; fi
    DISK_DEV=$(cat "$REGISTRY_TOKEN" | xargs)
    echo "[DESTRUCT] Purging memory space..."
    diskutil eject "$DISK_DEV" >/dev/null 2>&1 || true
    rm -f "$REGISTRY_TOKEN"
    echo "[SUCCESS] Secure RAM Crypt destroyed."
}
COMMAND="${1:-}"
if [[ "$COMMAND" == "up" ]]; then up; elif [[ "$COMMAND" == "down" ]]; then down; else echo "Usage: $0 {up|down}"; exit 1; fi
