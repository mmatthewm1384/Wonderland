#!/usr/bin/env bash
set -euo pipefail

WL_ROOT="${WL_ROOT:-$HOME/Wonderland}"
ROOT="$WL_ROOT/assets/visualizations/matrix-atom-destroyer"
PORT="${1:-8888}"

cd "$ROOT"

IP="$(ipconfig getifaddr en0 2>/dev/null || true)"
if [[ -z "$IP" ]]; then
  IP="$(ifconfig | awk '/inet / && $2 != "127.0.0.1" {print $2; exit}')"
fi

echo
echo "Wonderland Matrix iPhone Access"
echo "URL: http://${IP}:${PORT}/iphone/"
echo
echo "Direct:"
echo "Matrix:    http://${IP}:${PORT}/matrix-atom-destroyer.html"
echo "Spin City: http://${IP}:${PORT}/apps/spin-city-wave/iphone/spin-city-wave-iphone.html"
echo

python3 -m http.server "$PORT" --bind 0.0.0.0
