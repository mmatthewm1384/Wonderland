#!/usr/bin/env zsh
set -euo pipefail

export WL_HOME="${WL_HOME:-$HOME/Wonderland}"
export PATH="$WL_HOME/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"

ACTION="${1:-}"
LOG="$WL_HOME/vault/chaos/menubar-actions.log"
mkdir -p "$(dirname "$LOG")"

{
  echo "----- $(date -u +%Y-%m-%dT%H:%M:%SZ) action=$ACTION -----"
  command -v wl-chaos || true

  case "$ACTION" in
    checkin) wl-chaos checkin ;;
    reset)   wl-chaos reset ;;
    panic)   wl-chaos escalate ;;
    status)  wl-chaos status ;;
    doctor)  wl-chaos doctor ;;
    logs)    wl-chaos logs ;;
    *)
      echo "invalid action: $ACTION"
      exit 64
      ;;
  esac
} >>"$LOG" 2>&1
