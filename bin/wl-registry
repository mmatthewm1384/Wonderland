#!/usr/bin/env bash
set -euo pipefail
ROOT="${WL_AUTHORITY_ROOT:-${WL_HOME:-$HOME/Wonderland}}"

case "${1:-status}" in
  status|doctor)
    test -d "$ROOT/vault/05-Registry"
    test -f "$ROOT/.wl-registry" || true
    echo "PASS registry"
    ;;
  refresh|rebuild)
    "$ROOT/bin/wl-registry-refresh" 2>/dev/null || "$ROOT/bin/wl-phase-2-registry-refresh"
    ;;
  *)
    echo "Usage: wl registry [status|doctor|refresh|rebuild]"
    exit 2
    ;;
esac
