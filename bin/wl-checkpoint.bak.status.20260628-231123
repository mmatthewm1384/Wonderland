#!/usr/bin/env bash
set -uo pipefail

WL_HOME="${WL_HOME:-$HOME/Wonderland}"
. "$WL_HOME/lib/wl-bootstrap.sh"

CHECKPOINT_DIR="$WL_HOME/vault/05-Registry/platform"
STAMP="$(date +%Y%m%d-%H%M%S)"
CHECKPOINT="$CHECKPOINT_DIR/wonderland-platform-checkpoint-${STAMP}.json"
CURRENT="$CHECKPOINT_DIR/current.json"

mkdir -p "$CHECKPOINT_DIR"

verify_rc=0
"$WL_HOME/bin/wl-verify" >/tmp/wl-checkpoint-verify.out 2>&1 || verify_rc=$?

result="PASS"
[[ "$verify_rc" -eq 0 ]] || result="FAIL"

stable="$WL_HOME/releases/stable/current.json"
baseline="$("$WL_HOME/bin/wl-baseline" latest 2>/dev/null || true)"
handoff="$(ls -t "$WL_HOME"/vault/08-Operations/handoffs/wonderland-platform-handoff-*.md 2>/dev/null | head -1)"
docs="$WL_HOME/vault/02-Documentation/generated/wonderland-command-reference.md"

python3 - "$CHECKPOINT" "$result" "$stable" "$baseline" "$handoff" "$docs" <<'PY'
import json
import subprocess
import sys

out, result, stable, baseline, handoff, docs = sys.argv[1:7]

def j(cmd):
    return json.loads(subprocess.check_output(cmd, text=True))

data = {
    "schema": "wonderland.platform.checkpoint.v1",
    "result": result,
    "stable_release": stable,
    "baseline": baseline,
    "handoff": handoff,
    "documentation": docs,
    "context": j(["wl", "context", "show"]),
    "state": j(["wl", "state", "show"]),
    "capabilities": j(["wl", "state", "capabilities"]),
    "health": j(["wl", "state", "health"]),
}

with open(out, "w") as f:
    json.dump(data, f, indent=2)
    f.write("\n")
PY

python3 -m json.tool "$CHECKPOINT" >/dev/null
cp "$CHECKPOINT" "$CURRENT"

echo "CHECKPOINT $CHECKPOINT"
echo "CURRENT $CURRENT"
echo "RESULT $result"
exit "$verify_rc"
