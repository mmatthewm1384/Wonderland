#!/usr/bin/env bash
set -uo pipefail

WL_HOME="${WL_HOME:-$HOME/Wonderland}"
. "$WL_HOME/lib/wl-bootstrap.sh"

wl_section "Wonderland Lint"

lint_rc=0

lint_file() {
  local file="$1"

  if bash -n "$file"; then
    wl_pass "syntax" "${file#$WL_HOME/}"
  else
    wl_fail "syntax" "${file#$WL_HOME/}"
    lint_rc=1
  fi
}

while IFS= read -r file; do
  lint_file "$file"
done < <(
  find "$WL_HOME/bin" "$WL_HOME/lib" \
    -type f \
    ! -name "*.bak*" \
    ! -name "*.json" \
    ! -name "*.env" \
    2>/dev/null
)

if command -v shellcheck >/dev/null 2>&1; then
  while IFS= read -r file; do
    if shellcheck "$file"; then
      wl_pass "shellcheck" "${file#$WL_HOME/}"
    else
      wl_warn "shellcheck" "${file#$WL_HOME/}"
    fi
  done < <(
    find "$WL_HOME/bin" "$WL_HOME/lib" \
      -type f \
      ! -name "*.bak*" \
      ! -name "*.json" \
      ! -name "*.env" \
      2>/dev/null
  )
else
  wl_warn "shellcheck" "not installed"
fi

if [[ -f "$WL_HOME/profiles/${WL_PROFILE:-internal-light}.json" ]]; then
  python3 -m json.tool "$WL_HOME/profiles/${WL_PROFILE:-internal-light}.json" >/dev/null \
    && wl_pass "profile json" "${WL_PROFILE:-internal-light}" \
    || { wl_fail "profile json" "${WL_PROFILE:-internal-light}"; lint_rc=1; }
else
  wl_fail "profile json" "missing"
  lint_rc=1
fi

if (( lint_rc == 0 )); then
  echo
  echo "RESULT PASS"
  exit 0
else
  echo
  echo "RESULT FAIL"
  exit 1
fi
