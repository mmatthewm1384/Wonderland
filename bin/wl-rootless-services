#!/usr/bin/env bash
set -euo pipefail

WL_HOME="${WL_HOME:-$HOME/Wonderland}"
source "$WL_HOME/bin/wl-runtime-env"

services=(
  wl-vaultwarden
  wl-vaultwarden-db
  wl-loki
  wl-prometheus
  wl-grafana
  wl-nats
  wl-dns
)

fail=0

echo "== Wonderland Rootless Services =="

for svc in "${services[@]}"; do
  if LIMA_INSTANCE="$LIMA_INSTANCE" nerdctl ps --format '{{.Names}}' | grep -qx "$svc"; then
    echo "PASS $svc up"
  else
    echo "FAIL $svc not up"
    fail=1
  fi
done

exit "$fail"
