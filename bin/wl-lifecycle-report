#!/usr/bin/env bash
set -uo pipefail

WL_HOME="${WL_HOME:-$HOME/Wonderland}"
. "$WL_HOME/lib/wl-bootstrap.sh"

REPORT_TYPE="${1:-status}"
REPORT_DIR="$(wl_context_get report_dir)"
STAMP="$(date +%Y%m%d-%H%M%S)"
REPORT="$REPORT_DIR/lifecycle-${REPORT_TYPE}-${STAMP}.json"

mkdir -p "$REPORT_DIR"

wl_section "Lifecycle Report"

wl_required_path "root" "$WL_HOME"
wl_required_path "bin" "$WL_HOME/bin"
wl_required_path "vault" "$WL_HOME/vault"

wl_storage_t7_attached && wl_pass "t7" "$WL_T7_PATH" || wl_warn "t7" "detached"
wl_runtime_running && wl_pass "$WL_RUNTIME_INSTANCE" "running" || wl_fail "$WL_RUNTIME_INSTANCE" "not running"

result="PASS"
rc=0

if (( wl_corruptions > 0 )); then
  result="CORRUPT"
  rc=2
elif (( wl_failures > 0 )); then
  result="FAIL"
  rc=1
fi

cat > "$REPORT" <<JSON
{
  "schema": "wonderland.lifecycle.report.v2",
  "type": "$REPORT_TYPE",
  "timestamp": "$STAMP",
  "context": $(wl_context_dump),
  "health": {
    "pass": $wl_passes,
    "warn": $wl_warnings,
    "fail": $wl_failures,
    "corrupt": $wl_corruptions,
    "result": "$result"
  }
}
JSON

echo "REPORT $REPORT"
echo "RESULT $result"
exit "$rc"
