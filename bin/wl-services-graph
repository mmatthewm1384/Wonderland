#!/usr/bin/env bash
set -euo pipefail

WL_HOME="${WL_HOME:-$HOME/Wonderland}"
REGISTRY="$WL_HOME/vault/05-Registry/services.json"
MODE="${1:-order}"

if [ ! -f "$REGISTRY" ]; then
  "$WL_HOME/bin/wl-services-refresh" >/dev/null
fi

case "$MODE" in
  json)
    cat "$REGISTRY"
    ;;
  stop-order)
    jq -r '.stop_order[]' "$REGISTRY"
    ;;
  order|start-order)
    jq -r '.start_order[]' "$REGISTRY"
    ;;
  *)
    echo "Usage: wl services graph {order|start-order|stop-order|json}"
    exit 2
    ;;
esac
