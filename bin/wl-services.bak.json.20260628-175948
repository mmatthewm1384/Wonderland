#!/usr/bin/env bash
set -uo pipefail

WL_HOME="${WL_HOME:-$HOME/Wonderland}"
. "$WL_HOME/lib/wl-bootstrap.sh"

cmd="${1:-status}"

case "$cmd" in
  status)
    wl_section "Wonderland Services"

    for svc in $WL_REQUIRED_SERVICES; do
      if wl_service_running "$svc"; then
        wl_pass "$svc" "required up"
      else
        wl_fail "$svc" "required not up"
      fi
    done

    for svc in $WL_OPTIONAL_SERVICES; do
      if wl_service_running "$svc"; then
        wl_pass "$svc" "optional up"
      else
        wl_warn "$svc" "optional not up"
      fi
    done

    wl_exit
    ;;

  start)
    wl_section "Starting Wonderland Services"
    wl_services_start_all
    wl_exit
    ;;

  stop)
    wl_section "Stopping Wonderland Services"

    for svc in $WL_OPTIONAL_SERVICES $WL_REQUIRED_SERVICES; do
      LIMA_INSTANCE="$WL_RUNTIME_INSTANCE" nerdctl stop "$svc" >/dev/null 2>&1 || true
      if wl_service_running "$svc"; then
        wl_warn "$svc" "still running"
      else
        wl_pass "$svc" "stopped"
      fi
    done

    wl_exit
    ;;

  restart)
    "$0" stop || true
    "$0" start
    ;;

  list)
    echo "Required:"
    for svc in $WL_REQUIRED_SERVICES; do
      echo "  $svc"
    done

    echo
    echo "Optional:"
    for svc in $WL_OPTIONAL_SERVICES; do
      echo "  $svc"
    done
    ;;

  *)
    echo "Usage: wl services {status|start|stop|restart|list}"
    echo "RESULT FAIL"
    exit 1
    ;;
esac
