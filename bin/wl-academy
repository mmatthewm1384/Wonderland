#!/usr/bin/env bash
set -euo pipefail

WL_ROOT="${WL_ROOT:-$HOME/Wonderland}"

case "${1:-help}" in
  init)
    exec "$WL_ROOT/lib/academy/init.sh"
    ;;
  doctor)
    exec "$WL_ROOT/lib/academy/doctor.sh"
    ;;
  release)
    shift || true
    exec "$WL_ROOT/lib/academy/release.sh" "${1:-0.3.0}"
    ;;
  path)
    echo "$WL_ROOT/academy"
    ;;
  tree)
    find "$WL_ROOT/academy" -maxdepth 2 -type d | sort
    ;;
  lint|migrate|author)
    exec "$WL_ROOT/lib/academy/content.sh" "$@"
    ;;
  status|today|start|lesson|lab|quiz|journal|build|generate|complete|progress|inventory|report|review|certify|quality|module1|open|help)
    exec "$WL_ROOT/lib/academy/cli.sh" "$@"
    ;;
  *)
    exec "$WL_ROOT/lib/academy/cli.sh" help
    ;;
esac
