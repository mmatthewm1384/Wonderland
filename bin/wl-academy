#!/usr/bin/env bash
set -euo pipefail

WL_ROOT="${WL_ROOT:-$HOME/Wonderland}"

case "${1:-help}" in
  init)
    exec "$WL_ROOT/lib/academy/init.sh"
    ;;
  doctor)
    exec "$WL_ROOT/lib/academy/doctor.sh"
    ;;
  path)
    echo "$WL_ROOT/academy"
    ;;
  tree)
    find "$WL_ROOT/academy" -maxdepth 2 -type d | sort
    ;;
  status|today|start|journal|build|generate|complete|progress|review|help)
    exec "$WL_ROOT/lib/academy/cli.sh" "$@"
    ;;
  *)
    exec "$WL_ROOT/lib/academy/cli.sh" help
    ;;
esac
