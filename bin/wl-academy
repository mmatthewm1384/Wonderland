#!/usr/bin/env bash
set -euo pipefail

WL_ROOT="${WL_ROOT:-$HOME/Wonderland}"

case "${1:-help}" in
  init)
    exec "$WL_ROOT/lib/academy/init.sh"
    ;;
  path)
    echo "$WL_ROOT/academy"
    ;;
  doctor)
    exec "$WL_ROOT/lib/academy/doctor.sh"
    ;;
  tree)
    find "$WL_ROOT/academy" -maxdepth 2 -type d | sort
    ;;
  help|*)
    cat <<'HELP'
Usage:
  wl-academy init     Initialize Wonderland Academy
  wl-academy path     Print Academy path
  wl-academy doctor   Verify Academy exists
  wl-academy tree     Print Academy directory tree
HELP
    ;;
esac
