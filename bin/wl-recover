#!/usr/bin/env bash
set -euo pipefail

ROOT="${WL_AUTHORITY_ROOT:-${WL_HOME:-$HOME/Wonderland}}"
REPORT_DIR="$ROOT/vault/07-Operations/recovery/reports"
STAMP="$(date +%Y%m%d-%H%M%S)"
REPORT="$REPORT_DIR/platform-recovery-$STAMP.txt"

mkdir -p "$REPORT_DIR"

run_check() {
  local name="$1"
  shift

  printf "%-28s" "$name" | tee -a "$REPORT"

  if "$@" >>"$REPORT" 2>&1; then
    echo "PASS" | tee -a "$REPORT"
  else
    echo "FAIL" | tee -a "$REPORT"
    echo "RESULT FAIL" | tee -a "$REPORT"
    exit 1
  fi
}

case "${1:-}" in
  platform)
    echo "Wonderland Platform Recovery" | tee "$REPORT"
    echo "generated: $STAMP" | tee -a "$REPORT"
    echo "root: $ROOT" | tee -a "$REPORT"
    echo | tee -a "$REPORT"

    run_check "authority backup" "$ROOT/bin/wl-authority" backup
    run_check "authority verify" "$ROOT/bin/wl-authority" verify-backup
    run_check "authority restore drill" "$ROOT/bin/wl-authority" restore-drill

    run_check "dns repair" "$ROOT/bin/wl-dns" repair
    run_check "nats repair" "$ROOT/bin/wl-nats" repair
    run_check "observability repair" "$ROOT/bin/wl-observability" repair
    run_check "torrent repair" "$ROOT/bin/wl-torrent" repair

    run_check "service certification" "$ROOT/bin/wl-service-certify" verify-all
    run_check "doctor" "$ROOT/bin/wl-doctor"

    echo | tee -a "$REPORT"
    echo "RESULT PASS" | tee -a "$REPORT"
    echo "$REPORT"
  ;;

  *)
    echo "Usage: wl recover platform"
    exit 1
  ;;
esac
