#!/usr/bin/env bash
set -euo pipefail

ROOT="/Users/wonderland/Wonderland"
SNAP_ROOT="/Volumes/T7_Wonderland/Wonderland/persistence/snapshots/platform"
REPORT_ROOT="$ROOT/vault/07-Operations/snapshots/reports"
STAMP="$(date +%Y%m%d-%H%M%S)"
SNAP="$SNAP_ROOT/platform-$STAMP"

case "${1:-}" in
  create)
    mkdir -p "$SNAP" "$REPORT_ROOT"

    rsync -a \
      --exclude ".git" \
      --exclude "runtime" \
      --exclude "tmp" \
      --exclude "logs" \
      --exclude "data/torrents/downloads" \
      "$ROOT/" "$SNAP/"

    (
      cd "$SNAP"
      find . -type f ! -name "manifest.sha256" -print0 \
        | sort -z \
        | xargs -0 shasum -a 256 > manifest.sha256
    )

    echo "PASS snapshot create"
    echo "$SNAP"
  ;;

  verify)
    snap="${2:-$(find "$SNAP_ROOT" -maxdepth 1 -type d -name 'platform-*' 2>/dev/null | sort | tail -1)}"
    [[ -n "$snap" ]] || { echo "FAIL no snapshot found"; exit 1; }
    [[ -f "$snap/manifest.sha256" ]] || { echo "FAIL missing manifest: $snap"; exit 1; }

    (
      cd "$snap"
      shasum -a 256 -c manifest.sha256 >/tmp/wl-snapshot-verify.log 2>&1
    ) || {
      echo "FAIL snapshot verify"
      cat /tmp/wl-snapshot-verify.log
      exit 1
    }

    echo "PASS snapshot verify"
    echo "$snap"
  ;;

  restore-drill)
    snap="${2:-$(find "$SNAP_ROOT" -maxdepth 1 -type d -name 'platform-*' 2>/dev/null | sort | tail -1)}"
    drill="/tmp/wl-platform-snapshot-restore-drill"

    [[ -n "$snap" ]] || { echo "FAIL no snapshot found"; exit 1; }
    [[ -f "$snap/manifest.sha256" ]] || { echo "FAIL missing manifest: $snap"; exit 1; }

    rm -rf "$drill"
    mkdir -p "$drill"

    rsync -a "$snap/" "$drill/"

    (
      cd "$drill"
      shasum -a 256 -c manifest.sha256 >/tmp/wl-snapshot-restore-drill.log 2>&1
    ) || {
      echo "FAIL snapshot restore drill"
      cat /tmp/wl-snapshot-restore-drill.log
      exit 1
    }

    echo "PASS snapshot restore drill"
    echo "$snap"
  ;;

  list)
    find "$SNAP_ROOT" -maxdepth 1 -type d -name 'platform-*' | sort
  ;;

  doctor|verify-latest)
    "$0" verify
    "$0" restore-drill
    echo "RESULT PASS"
  ;;

  *)
    echo "Usage: wl snapshot create|verify|restore-drill|list|doctor"
    exit 1
  ;;
esac
