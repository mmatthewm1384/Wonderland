#!/usr/bin/env bash
set -euo pipefail

ROOT="$HOME/Wonderland"
PRESENCE="$ROOT/.wl/state/the-matrix/presence.json"

test -f "$PRESENCE" || {
  echo "FAIL missing presence"
  exit 1
}

tmp="$(mktemp)"

jq --arg ts "$(date -u +%Y%m%dT%H%M%SZ)" '
  .watcher_state //= {
    "population": 12,
    "attention": 0,
    "interest": 0,
    "false_positive_rate": 0.006
  }

  | .cross_realm = {
      "watchers_to_reactor": (
        ((.watcher_state.attention // 0) * 0.65) +
        ((.watcher_state.interest // 0) * 0.35)
      ),

      "reactor_to_swarm": (
        (((.watcher_state.attention // 0) * 0.65) +
        ((.watcher_state.interest // 0) * 0.35)) * 0.82
      ),

      "swarm_to_waves": (
        ((((.watcher_state.attention // 0) * 0.65) +
        ((.watcher_state.interest // 0) * 0.35)) * 0.82) * 0.74
      ),

      "wave_turbulence": (
        1.0 +
        (((((.watcher_state.attention // 0) * 0.65) +
        ((.watcher_state.interest // 0) * 0.35)) * 0.82) * 0.74)
      )
    }

  | .entities.matrix_energy = ((90 + (.cross_realm.watchers_to_reactor * 60)) | floor)
  | .entities.swarm_density = ((76 + (.cross_realm.reactor_to_swarm * 84)) | floor)
  | .entities.wave_tension = (1.3 + (.cross_realm.swarm_to_waves * 1.1))
  | .updated_at = $ts
' "$PRESENCE" > "$tmp"

mv "$tmp" "$PRESENCE"

echo "PASS cross-realm influence"
jq .cross_realm "$PRESENCE"
