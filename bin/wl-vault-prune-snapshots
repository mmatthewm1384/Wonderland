#!/usr/bin/env bash
set -euo pipefail

ROOT="${WL_AUTHORITY_ROOT:-${WL_HOME:-$HOME/Wonderland}}"
SNAPSHOT_DIR="$ROOT/vault/snapshots"
KEEP="${1:-20}"

if ! [[ "$KEEP" =~ ^[0-9]+$ ]]; then
  echo "Usage: wl-vault-prune-snapshots [keep-count]"
  exit 1
fi

"$ROOT/bin/wl" verify

mkdir -p "$SNAPSHOT_DIR"

OLD=$(
  ls -t "$SNAPSHOT_DIR"/*.tar.gz 2>/dev/null |
  tail -n +"$((KEEP + 1))" || true
)

if [[ -z "$OLD" ]]; then
  echo "No snapshots to prune. keep=$KEEP"
  exit 0
fi

echo "$OLD" | while read -r snap; do
  [[ -z "$snap" ]] && continue

  echo "PRUNE $snap"
  rm -f "$snap" "$snap.sha256"
done

echo "Prune complete. keep=$KEEP"
