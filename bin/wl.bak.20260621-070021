#!/usr/bin/env bash
set -euo pipefail

WL_HOME="${WL_HOME:-$HOME/Wonderland}"
export WL_HOME

cmd="${1:-help}"
shift || true

die() {
  echo "wl: $*" >&2
  exit 1
}

exists() {
  [[ -x "$1" ]]
}

run() {
  local target="$1"
  shift
  exists "$target" || die "missing executable: $target"
  exec "$target" "$@"
}

try() {
  local target="$1"
  shift
  exists "$target" && exec "$target" "$@"
  return 1
}

service_up() {
  local name="$1"
  nerdctl ps --format '{{.Names}}' 2>/dev/null | grep -qx "$name"
}

start_or_up() {
  local name="$1"
  local script="$2"

  if service_up "$name"; then
    echo "PASS $name already up"
    return 0
  fi

  if nerdctl ps -a --format '{{.Names}}' 2>/dev/null | grep -qx "$name"; then
    nerdctl start "$name"
    echo "PASS $name started"
    return 0
  fi

  "$script" up
}

help() {
  cat <<'HELP'
Wonderland command surface

Usage:
  wl help
  wl status
  wl doctor
  wl rootless status|start|stop|doctor
  wl runtime status|start|doctor|logs <container>|inspect <container>|compose ...
  wl storage status|attach|attach-light|attach-full|eject|force-eject|verify|doctor|authority
  wl universe status|doctor|dashboard
  wl snapshot create|doctor|list|restore-drill
  wl governance doctor|verify|status

Direct service passthrough:
  wl dns ...
  wl nats ...
  wl observability ...
  wl torrent ...
  wl portainer ...
  wl matrix ...
  wl spin-city ...
  wl obsidian ...

Diagnostics:
  wl path
  wl repair doctor
  wl containers
HELP
}

case "$cmd" in
  help|-h|--help)
    help
    ;;

  path)
    echo "WL_HOME=$WL_HOME"
    echo
    echo "which -a wl:"
    which -a wl || true
    echo
    echo "type -a wl:"
    type -a wl || true
    ;;

  containers|ps)
    nerdctl ps --format 'table {{.Names}}\t{{.Status}}\t{{.Ports}}'
    ;;

  status)
    run "$WL_HOME/bin/wl-universe" status
    ;;

  doctor)
    "$WL_HOME/bin/wl-storage" doctor || true
    "$WL_HOME/bin/wl-snapshot" doctor || true
    "$WL_HOME/bin/wl-universe" status
    ;;

  rootless)
    run "$WL_HOME/bin/wl-rootless" "$@"
    ;;

  runtime)
    sub="${1:-status}"
    shift || true

    case "$sub" in
      status|ps)
        nerdctl ps --format 'table {{.Names}}\t{{.Status}}\t{{.Ports}}'
        ;;
      start)
        start_or_up wl-dns "$WL_HOME/bin/wl-dns"
        start_or_up wl-nats "$WL_HOME/bin/wl-nats"
        "$WL_HOME/bin/wl-observability" up || true
        "$WL_HOME/bin/wl-universe" status
        ;;
      doctor)
        "$WL_HOME/bin/wl-universe" status
        ;;
      logs|inspect|images|compose)
        run "$WL_HOME/bin/wl-runtime" "$sub" "$@"
        ;;
      *)
        die "unknown runtime command: $sub"
        ;;
    esac
    ;;

  storage)
    sub="${1:-status}"
    shift || true
    case "$sub" in
      attach-light) run "$WL_HOME/bin/wl-storage" attach --light "$@" ;;
      attach-full)  run "$WL_HOME/bin/wl-storage" attach --full "$@" ;;
      *)            run "$WL_HOME/bin/wl-storage" "$sub" "$@" ;;
    esac
    ;;

  universe)
    run "$WL_HOME/bin/wl-universe" "$@"
    ;;

  snapshot)
    run "$WL_HOME/bin/wl-snapshot" "$@"
    ;;

  governance)
    run "$WL_HOME/bin/wl-governance" "$@"
    ;;

  repair)
    sub="${1:-doctor}"
    shift || true
    case "$sub" in
      doctor)
        echo "Wonderland wl doctor"
        echo
        echo "WL_HOME=$WL_HOME"
        echo "canonical=$WL_HOME/bin/wl"
        echo
        ls -l "$WL_HOME/bin/wl"
        echo
        which -a wl || true
        echo
        nerdctl ps --format 'table {{.Names}}\t{{.Status}}' 2>/dev/null || true
        ;;
      *)
        die "unknown repair command: $sub"
        ;;
    esac
    ;;

  dns)
    run "$WL_HOME/bin/wl-dns" "$@"
    ;;

  nats)
    run "$WL_HOME/bin/wl-nats" "$@"
    ;;

  observability)
    run "$WL_HOME/bin/wl-observability" "$@"
    ;;

  *)
    candidate="$WL_HOME/bin/wl-$cmd"
    if exists "$candidate"; then
      exec "$candidate" "$@"
    fi
    die "unknown wl command: $cmd"
    ;;
esac
