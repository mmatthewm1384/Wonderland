#!/usr/bin/env bash
set -euo pipefail

ROOT="$HOME/Wonderland"
REG="$ROOT/vault/09-Governance/registry/the-matrix.registry.json"
APP_REG="$ROOT/vault/09-Governance/registry/the-matrix-apps.json"
PRESENCE="$ROOT/.wl/state/the-matrix/presence.json"

apps=(
  "$ROOT/apps/tauri/wl-spin-city"
  "$ROOT/apps/tauri/wl-agitate"
  "$ROOT/apps/tauri/wl-matrix"
  "$ROOT/apps/matrix/matrix-fluderation"
)

app_doctor() {
  local app="$1"
  local name
  name="$(basename "$app")"

  test -d "$app" || { echo "FAIL $name dir"; return 1; }
  test -f "$app/package.json" || { echo "FAIL $name package.json"; return 1; }
  test -f "$app/src-tauri/Cargo.toml" || { echo "FAIL $name Cargo.toml"; return 1; }
  test -f "$app/src-tauri/tauri.conf.json" || { echo "FAIL $name tauri.conf.json"; return 1; }

  echo "PASS $name"
}

case "${1:-doctor}" in
  doctor)
    test -f "$REG" || { echo "FAIL registry"; exit 1; }
    test -f "$APP_REG" || { echo "FAIL app-registry"; exit 1; }
    test -f "$PRESENCE" || { echo "FAIL presence"; exit 1; }

    jq -e '.id == "THE∅MATRIX"' "$REG" >/dev/null || { echo "FAIL registry-id"; exit 1; }
    jq -e '.suite == "THE∅MATRIX" and .status == "certified"' "$APP_REG" >/dev/null || { echo "FAIL app-registry-status"; exit 1; }

    jq -e '.suite == "THE∅MATRIX" and .active_realm and .modes.focus and .modes.ambient and .modes.energy and .modes.emergence' "$PRESENCE" >/dev/null || { echo "FAIL presence-schema"; exit 1; }

    echo "PASS app-registry"
    echo "PASS presence"

    for app in "${apps[@]}"; do
      app_doctor "$app"
    done

    test -x "$ROOT/bin/wl-spin-city" || { echo "FAIL wl-spin-city launcher"; exit 1; }
    "$ROOT/bin/wl-spin-city" doctor

    echo "PASS THE∅MATRIX"
    echo "RESULT PASS"
    ;;

  status)
    jq . "$REG"
    ;;

  files)
    find "${apps[@]}" -maxdepth 3 -type f | sort
    ;;

  build)
    failed=0

    for app in "${apps[@]}"; do
      name="$(basename "$app")"
      echo "BUILD $name"

      app_doctor "$app" || {
        echo "FAIL doctor $name"
        failed=1
        continue
      }

      cd "$app"

      if [[ ! -x node_modules/.bin/tauri ]]; then
        echo "INSTALL $name dependencies"
        npm install || {
          echo "FAIL npm install $name"
          failed=1
          continue
        }
      fi

      npm run tauri build || {
        echo "FAIL build $name"
        failed=1
        continue
      }

      echo "PASS build $name"
    done

    if [[ "$failed" -eq 0 ]]; then
      echo "RESULT PASS"
    else
      echo "RESULT FAIL"
      exit 1
    fi
    ;;

  spin-city)
    "$ROOT/bin/wl-spin-city" open
    ;;

  spin-city-prod)
    "$ROOT/bin/wl-spin-city" prod
    ;;

  agitate)
    cd "$ROOT/apps/tauri/wl-agitate"
    npm run tauri dev
    ;;

  matrix)
    cd "$ROOT/apps/tauri/wl-matrix"
    npm run tauri dev
    ;;

  fluderation)
    cd "$ROOT/apps/matrix/matrix-fluderation"
    npm run tauri dev
    ;;

  *)
    echo "usage: wl-the-matrix {doctor|status|files|build|spin-city|spin-city-prod|agitate|matrix|fluderation}"
    exit 2
    ;;
esac
