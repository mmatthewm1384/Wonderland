#!/usr/bin/env bash
set -euo pipefail

WL_HOME="${WL_HOME:-$HOME/Wonderland}"

ROOT="$WL_HOME/vault/01-Projects/THEOMATRIX"
CONFIG="$WL_HOME/config/theomatrix/theomatrix.json"

status() {
python3 <<EOF
import json
with open("$CONFIG") as f:
    print(json.dumps(json.load(f), indent=2))
EOF
}

doctor() {

local result=0

for d in \
    canon \
    graph \
    memory \
    reports \
    registries \
    certification \
    runtime
do
    if [ -d "$ROOT/$d" ]; then
        echo "PASS $d"
    else
        echo "FAIL $d"
        result=1
    fi
done

if [ "$result" -eq 0 ]; then
    echo
    echo "RESULT PASS"
else
    echo
    echo "RESULT FAIL"
fi

return "$result"
}

verify() {

doctor

if [ -f "$CONFIG" ]; then
    echo "PASS config"
else
    echo "FAIL config"
    return 1
fi

echo
echo "RESULT PASS"
}

case "${1:-status}" in
    status) status ;;
    doctor) doctor ;;
    verify) verify ;;
    *)
        echo "Usage:"
        echo "  wl-theomatrix status"
        echo "  wl-theomatrix doctor"
        echo "  wl-theomatrix verify"
        exit 1
        ;;
esac
