#!/usr/bin/env bash
set -euo pipefail

WL_HOME="${WL_HOME:-$HOME/Wonderland}"
source "$WL_HOME/bin/wl-runtime-env"

case "${1:-status}" in
  start)
    limactl start wonderland-rootless
    ;;
  stop)
    limactl stop wonderland-rootless
    ;;
  restart)
    limactl stop wonderland-rootless || true
    limactl start wonderland-rootless
    ;;
  status)
    limactl list | grep -E '^wonderland-rootless[[:space:]]' || {
      echo "FAIL wonderland-rootless not found"
      exit 1
    }

    limactl list | grep -E '^wonderland-rootless[[:space:]]+Running' >/dev/null || {
      echo "FAIL wonderland-rootless not running"
      exit 1
    }

    echo "PASS wonderland-rootless running"
    ;;
  shell)
    limactl shell wonderland-rootless
    ;;
  *)
    echo "usage: wl-rootless {start|stop|restart|status|shell}"
    exit 2
    ;;
esac
