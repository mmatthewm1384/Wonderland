#!/usr/bin/env bash
set -euo pipefail

WL_HOME="${WL_HOME:-$HOME/Wonderland}"

case "${1:-status}" in
  status)
    echo "Wonderland Rootless Status"
    echo
    limactl list 2>/dev/null | grep -E 'NAME|wonderland|default' || true
    echo
    nerdctl ps --format '{{.Names}}\t{{.Status}}\t{{.Ports}}' 2>/dev/null || true
    ;;

  start)
    echo "Starting Wonderland rootless runtime..."
    wl storage status || true
    nerdctl start wl-dns 2>/dev/null || wl dns up || true
    nerdctl start wl-nats 2>/dev/null || wl nats up || true
    wl observability up || true
    wl universe status
    ;;

  stop)
    echo "Stopping visible Wonderland runtime services..."
    nerdctl stop wl-grafana wl-prometheus wl-loki wl-nats wl-dns 2>/dev/null || true
    wl universe status || true
    ;;

  doctor)
    wl storage doctor
    wl universe status
    ;;

  *)
    echo "Usage: wl rootless status|start|stop|doctor"
    exit 1
    ;;
esac
