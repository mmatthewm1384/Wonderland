#!/usr/bin/env bash
set -euo pipefail

ROOT="$HOME/Wonderland"
STATE_DIR="$ROOT/.wl/state/the-matrix"
PID_FILE="$STATE_DIR/screensaver.pid"
LOG_FILE="$STATE_DIR/screensaver.log"

usage() {
  echo "usage: wl-matrix-suite {status|doctor|bundle-doctor|report|recertify|mode <realm> <mode>|atmosphere <calm|haunted|storm|oracle|wonderland>|run-atmosphere <calm|haunted|storm|oracle|wonderland>|start-atmosphere <calm|haunted|storm|oracle|wonderland> [seconds]|drift|watchers|orbit-storm|tide|echo|tempest|forge|collapse|reactor|seed|swarm|oracle|wonderland|focus|ambient|energy|emergence|build|open-built <focus|ambient|energy|emergence|all>|screensaver [seconds]|start [seconds]|stop|state|log}"
}

case "${1:-status}" in
  status|doctor)
    "$ROOT/bin/wl-the-matrix" doctor
    ;;

  report)
    REPORT_DIR="$ROOT/vault/08-Operations/reports"
    AUDIT_DIR="$ROOT/vault/09-Governance/wil/audit"
    STAMP="$(date -u +%Y%m%dT%H%M%SZ)"
    REPORT="$REPORT_DIR/the-matrix-suite-report.json"
    AUDIT="$AUDIT_DIR/${STAMP}-the-matrix-suite-report.audit.json"
    mkdir -p "$REPORT_DIR" "$AUDIT_DIR"

    running="false"
    pid="null"
    active_realm="unknown"

    if [[ -f "$PID_FILE" ]] && kill -0 "$(cat "$PID_FILE")" >/dev/null 2>&1; then
      running="true"
      pid="$(cat "$PID_FILE")"
    fi

    if [[ -f "$ROOT/.wl/state/the-matrix/presence.json" ]]; then
      active_realm="$(jq -r .active_realm "$ROOT/.wl/state/the-matrix/presence.json")"
    fi

    cat > "$REPORT" <<JSON
{
  "id": "THE∅MATRIX",
  "status": "active",
  "screensaver": {
    "running": $running,
    "pid": $pid
  },
  "presence": {
    "active_realm": "$active_realm",
    "file": ".wl/state/the-matrix/presence.json"
  },
  "commands": {
    "doctor": "wl-matrix-suite doctor",
    "bundle_doctor": "wl-matrix-suite bundle-doctor",
    "build": "wl-matrix-suite build",
    "start": "wl-matrix-suite start 300",
    "stop": "wl-matrix-suite stop"
  },
  "apps": {
    "focus": "wl-spin-city",
    "ambient": "wl-agitate",
    "energy": "wl-matrix",
    "emergence": "matrix-fluderation"
  },
  "modes": "vault/09-Governance/registry/the-matrix-modes.json"
}
JSON

    cp "$REPORT" "$AUDIT"
    cat "$REPORT"
    echo "audit=$AUDIT" >&2
    ;;

  recertify)
    "$0" doctor
    "$0" bundle-doctor
    "$0" report >/dev/null

    echo "PASS THE∅MATRIX recertified"
    echo "RESULT PASS"
    ;;

  bundle-doctor)
    bundles=(
      "$(find "$ROOT/apps/tauri/wl-spin-city/src-tauri/target/release/bundle/macos" -maxdepth 1 -name "*.app" | head -1)"
      "$(find "$ROOT/apps/tauri/wl-agitate/src-tauri/target/release/bundle/macos" -maxdepth 1 -name "*.app" | head -1)"
      "$(find "$ROOT/apps/tauri/wl-matrix/src-tauri/target/release/bundle/macos" -maxdepth 1 -name "*.app" | head -1)"
      "$(find "$ROOT/apps/matrix/matrix-fluderation/src-tauri/target/release/bundle/macos" -maxdepth 1 -name "*.app" | head -1)"
    )

    for bundle in "${bundles[@]}"; do
      test -d "$bundle" || { echo "FAIL missing bundle: $bundle"; exit 1; }
      echo "PASS $(basename "$bundle")"
    done

    echo "RESULT PASS"
    ;;

  mode)
    realm="${2:?realm required}"
    mode="${3:?mode required}"

    case "$realm:$mode" in
      focus:Drift|focus:Watchers|focus:"Orbit Storm"|focus:Wonderland|\
      ambient:Tide|ambient:Echo|ambient:Tempest|ambient:Wonderland|\
      energy:Forge|energy:Collapse|energy:Reactor|energy:Wonderland|\
      emergence:Seed|emergence:Swarm|emergence:Oracle|emergence:Wonderland)
        "$ROOT/bin/wl-matrix-presence" set-mode "$realm" "$mode"
        ;;
      *)
        echo "FAIL invalid mode: $realm $mode"
        echo "valid:"
        echo "  focus: Drift | Watchers | Orbit Storm | Wonderland"
        echo "  ambient: Tide | Echo | Tempest | Wonderland"
        echo "  energy: Forge | Collapse | Reactor | Wonderland"
        echo "  emergence: Seed | Swarm | Oracle | Wonderland"
        exit 2
        ;;
    esac
    ;;

  calm)
    "$0" atmosphere calm
    ;;

  haunted)
    "$0" atmosphere haunted
    ;;

  storm)
    "$0" atmosphere storm
    ;;

  oracle-atmosphere)
    "$0" atmosphere oracle
    ;;

  watcher-show)
    "$ROOT/bin/wl-matrix-presence" watcher show
    ;;

  watcher-reset)
    "$ROOT/bin/wl-matrix-presence" watcher reset
    ;;

  watcher-attention)
    value="${2:?attention required}"
    "$ROOT/bin/wl-matrix-presence" watcher set attention "$value"
    ;;

  watcher-interest)
    value="${2:?interest required}"
    "$ROOT/bin/wl-matrix-presence" watcher set interest "$value"
    ;;

  watcher-population)
    value="${2:?population required}"
    "$ROOT/bin/wl-matrix-presence" watcher set population "$value"
    ;;

  atmosphere)
    atmosphere="${2:?atmosphere required}"

    case "$atmosphere" in
      calm)
        "$0" mode focus Drift
        "$0" mode ambient Tide
        "$0" mode energy Forge
        "$0" mode emergence Seed
        ;;

      haunted)
        "$0" mode focus Watchers
        "$0" mode ambient Echo
        "$0" mode energy Collapse
        "$0" mode emergence Oracle
        ;;

      storm)
        "$0" mode focus "Orbit Storm"
        "$0" mode ambient Tempest
        "$0" mode energy Reactor
        "$0" mode emergence Swarm
        ;;

      oracle)
        "$0" mode focus Watchers
        "$0" mode ambient Echo
        "$0" mode energy Forge
        "$0" mode emergence Oracle
        ;;

      wonderland)
        "$0" mode focus Wonderland
        "$0" mode ambient Wonderland
        "$0" mode energy Wonderland
        "$0" mode emergence Wonderland
        ;;

      *)
        echo "usage: wl-matrix-suite atmosphere {calm|haunted|storm|oracle|wonderland}"
        exit 2
        ;;
    esac

    "$ROOT/bin/wl-matrix-presence" summary
    ;;

  run-atmosphere)
    atmosphere="${2:?atmosphere required}"
    "$0" atmosphere "$atmosphere"
    "$0" open-built all
    ;;

  start-atmosphere)
    atmosphere="${2:?atmosphere required}"
    interval="${3:-300}"
    "$0" atmosphere "$atmosphere"
    "$0" start "$interval"
    ;;

  drift)
    "$0" mode focus Drift
    ;;

  watchers)
    "$0" mode focus Watchers
    ;;

  orbit-storm)
    "$0" mode focus "Orbit Storm"
    ;;

  tide)
    "$0" mode ambient Tide
    ;;

  echo)
    "$0" mode ambient Echo
    ;;

  tempest)
    "$0" mode ambient Tempest
    ;;

  forge)
    "$0" mode energy Forge
    ;;

  collapse)
    "$0" mode energy Collapse
    ;;

  reactor)
    "$0" mode energy Reactor
    ;;

  seed)
    "$0" mode emergence Seed
    ;;

  swarm)
    "$0" mode emergence Swarm
    ;;

  oracle)
    "$0" mode emergence Oracle
    ;;

  wonderland)
    "$0" mode focus Wonderland
    "$0" mode ambient Wonderland
    "$0" mode energy Wonderland
    "$0" mode emergence Wonderland
    ;;

  focus|spin-city)
    "$ROOT/bin/wl-matrix-presence" set-realm focus >/dev/null 2>&1 || true
    "$ROOT/bin/wl-spin-city" prod
    ;;

  ambient|agitate)
    "$ROOT/bin/wl-matrix-presence" set-realm ambient >/dev/null 2>&1 || true
    cd "$ROOT/apps/tauri/wl-agitate"
    npm run tauri dev
    ;;

  energy|matrix)
    "$ROOT/bin/wl-matrix-presence" set-realm energy >/dev/null 2>&1 || true
    cd "$ROOT/apps/tauri/wl-matrix"
    npm run tauri dev
    ;;

  emergence|fluderation)
    "$ROOT/bin/wl-matrix-presence" set-realm emergence >/dev/null 2>&1 || true
    cd "$ROOT/apps/matrix/matrix-fluderation"
    npm run tauri dev
    ;;

  build)
    "$ROOT/bin/wl-the-matrix" build
    ;;

  open-built)
    target="${2:-all}"

    case "$target" in
      focus)
        "$ROOT/bin/wl-matrix-presence" set-realm focus
        open "$(find "$ROOT/apps/tauri/wl-spin-city/src-tauri/target/release/bundle/macos" -maxdepth 1 -name "*.app" | head -1)"
        ;;

      ambient)
        "$ROOT/bin/wl-matrix-presence" set-realm ambient
        open "$(find "$ROOT/apps/tauri/wl-agitate/src-tauri/target/release/bundle/macos" -maxdepth 1 -name "*.app" | head -1)"
        ;;

      energy)
        "$ROOT/bin/wl-matrix-presence" set-realm energy
        open "$(find "$ROOT/apps/tauri/wl-matrix/src-tauri/target/release/bundle/macos" -maxdepth 1 -name "*.app" | head -1)"
        ;;

      emergence)
        "$ROOT/bin/wl-matrix-presence" set-realm emergence
        open "$(find "$ROOT/apps/matrix/matrix-fluderation/src-tauri/target/release/bundle/macos" -maxdepth 1 -name "*.app" | head -1)"
        ;;

      all)
        "$ROOT/bin/wl-matrix-presence" set-realm all
        open "$(find "$ROOT/apps/tauri/wl-spin-city/src-tauri/target/release/bundle/macos" -maxdepth 1 -name "*.app" | head -1)"
        open "$(find "$ROOT/apps/tauri/wl-agitate/src-tauri/target/release/bundle/macos" -maxdepth 1 -name "*.app" | head -1)"
        open "$(find "$ROOT/apps/tauri/wl-matrix/src-tauri/target/release/bundle/macos" -maxdepth 1 -name "*.app" | head -1)"
        open "$(find "$ROOT/apps/matrix/matrix-fluderation/src-tauri/target/release/bundle/macos" -maxdepth 1 -name "*.app" | head -1)"
        ;;

      *)
        echo "usage: wl-matrix-suite open-built {focus|ambient|energy|emergence|all}"
        exit 2
        ;;
    esac
    ;;

  screensaver)
    mkdir -p "$STATE_DIR"
    INTERVAL="${2:-300}"
    echo "$$" > "$PID_FILE"

    apps=(
      "$(find "$ROOT/apps/tauri/wl-spin-city/src-tauri/target/release/bundle/macos" -maxdepth 1 -name "*.app" | head -1)"
      "$(find "$ROOT/apps/tauri/wl-agitate/src-tauri/target/release/bundle/macos" -maxdepth 1 -name "*.app" | head -1)"
      "$(find "$ROOT/apps/matrix/matrix-fluderation/src-tauri/target/release/bundle/macos" -maxdepth 1 -name "*.app" | head -1)"
      "$(find "$ROOT/apps/tauri/wl-matrix/src-tauri/target/release/bundle/macos" -maxdepth 1 -name "*.app" | head -1)"
    )

    while true; do
      for app in "${apps[@]}"; do
        test -d "$app" || {
          echo "FAIL missing app bundle: $app"
          echo "Run: wl-matrix-suite build"
          exit 1
        }

        app_name="$(basename "$app" .app)"
        case "$app_name" in
          "Spin City Wave") "$ROOT/bin/wl-matrix-presence" set-realm focus >/dev/null 2>&1 || true ;;
          "Agitate Waves") "$ROOT/bin/wl-matrix-presence" set-realm ambient >/dev/null 2>&1 || true ;;
          "Matrix Atom Destroyer") "$ROOT/bin/wl-matrix-presence" set-realm energy >/dev/null 2>&1 || true ;;
          "Matrix Fluderation") "$ROOT/bin/wl-matrix-presence" set-realm emergence >/dev/null 2>&1 || true ;;
        esac

        echo "OPEN $app_name"
        open "$app"

        sleep "$INTERVAL"

        osascript -e "tell application \"$app_name\" to quit" >/dev/null 2>&1 || true
      done
    done
    ;;

  stop)
    pkill -f "wl-matrix-suite screensaver" >/dev/null 2>&1 || true

    for name in \
      "Spin City Wave" \
      "Agitate Waves" \
      "Matrix Fluderation" \
      "Matrix Atom Destroyer"
    do
      osascript -e "tell application \"$name\" to quit" >/dev/null 2>&1 || true
    done

    rm -f "$PID_FILE"
    echo "PASS stopped THE∅MATRIX screensaver"
    ;;

  state)
    mkdir -p "$STATE_DIR"
    echo "state_dir=$STATE_DIR"
    if [[ -f "$PID_FILE" ]] && kill -0 "$(cat "$PID_FILE")" >/dev/null 2>&1; then
      echo "screensaver_pid=$(cat "$PID_FILE")"
      echo "screensaver_status=running"
    else
      echo "screensaver_pid=none"
      echo "screensaver_status=stopped"
    fi
    echo "log_file=$LOG_FILE"

    echo
    "$ROOT/bin/wl-matrix-presence" summary 2>/dev/null || true
    ;;

  log)
    mkdir -p "$STATE_DIR"
    touch "$LOG_FILE"
    tail -80 "$LOG_FILE"
    ;;

  *)
    usage
    exit 2
    ;;
esac
