#!/usr/bin/env bash
set -euo pipefail

ROOT="$HOME/Wonderland"
STATE_DIR="$ROOT/.wl/state/the-matrix"
PID_FILE="$STATE_DIR/screensaver.pid"
LOG_FILE="$STATE_DIR/screensaver.log"

usage() {
  echo "usage: wl-matrix-suite {status|doctor|bundle-doctor|report|focus|ambient|energy|emergence|build|open-built <focus|ambient|energy|emergence|all>|screensaver [seconds]|start [seconds]|stop|state|log}"
}

case "${1:-status}" in
  status|doctor)
    "$ROOT/bin/wl-the-matrix" doctor
    ;;

  report)
    REPORT_DIR="$ROOT/vault/08-Operations/reports"
    REPORT="$REPORT_DIR/the-matrix-suite-report.json"
    mkdir -p "$REPORT_DIR"

    running="false"
    pid="null"
    if [[ -f "$PID_FILE" ]] && kill -0 "$(cat "$PID_FILE")" >/dev/null 2>&1; then
      running="true"
      pid="$(cat "$PID_FILE")"
    fi

    cat > "$REPORT" <<JSON
{
  "id": "THE∅MATRIX",
  "status": "active",
  "screensaver": {
    "running": $running,
    "pid": $pid
  },
  "commands": {
    "doctor": "wl-matrix-suite doctor",
    "bundle_doctor": "wl-matrix-suite bundle-doctor",
    "build": "wl-matrix-suite build",
    "start": "wl-matrix-suite start 300",
    "stop": "wl-matrix-suite stop"
  },
  "apps": {
    "focus": "wl-spin-city",
    "ambient": "wl-agitate",
    "energy": "wl-matrix",
    "emergence": "matrix-fluderation"
  }
}
JSON

    cat "$REPORT"
    ;;

  bundle-doctor)
    bundles=(
      "$ROOT/apps/tauri/wl-spin-city/src-tauri/target/release/bundle/macos/Spin City Wave.app"
      "$ROOT/apps/tauri/wl-agitate/src-tauri/target/release/bundle/macos/Agitate Waves.app"
      "$ROOT/apps/tauri/wl-matrix/src-tauri/target/release/bundle/macos/Matrix Atom Destroyer.app"
      "$ROOT/apps/matrix/matrix-fluderation/src-tauri/target/release/bundle/macos/Matrix Fluderation.app"
    )

    for bundle in "${bundles[@]}"; do
      test -d "$bundle" || { echo "FAIL missing bundle: $bundle"; exit 1; }
      echo "PASS $(basename "$bundle")"
    done

    echo "RESULT PASS"
    ;;

  focus|spin-city)
    "$ROOT/bin/wl-spin-city" prod
    ;;

  ambient|agitate)
    cd "$ROOT/apps/tauri/wl-agitate"
    npm run tauri dev
    ;;

  energy|matrix)
    cd "$ROOT/apps/tauri/wl-matrix"
    npm run tauri dev
    ;;

  emergence|fluderation)
    cd "$ROOT/apps/matrix/matrix-fluderation"
    npm run tauri dev
    ;;

  build)
    "$ROOT/bin/wl-the-matrix" build
    ;;

  open-built)
    target="${2:-all}"

    case "$target" in
      focus)
        open "$ROOT/apps/tauri/wl-spin-city/src-tauri/target/release/bundle/macos/Spin City Wave.app"
        ;;
      ambient)
        open "$ROOT/apps/tauri/wl-agitate/src-tauri/target/release/bundle/macos/Agitate Waves.app"
        ;;
      energy)
        open "$ROOT/apps/tauri/wl-matrix/src-tauri/target/release/bundle/macos/Matrix Atom Destroyer.app"
        ;;
      emergence)
        open "$ROOT/apps/matrix/matrix-fluderation/src-tauri/target/release/bundle/macos/Matrix Fluderation.app"
        ;;
      all)
        open "$ROOT/apps/tauri/wl-spin-city/src-tauri/target/release/bundle/macos/Spin City Wave.app"
        open "$ROOT/apps/tauri/wl-agitate/src-tauri/target/release/bundle/macos/Agitate Waves.app"
        open "$ROOT/apps/matrix/matrix-fluderation/src-tauri/target/release/bundle/macos/Matrix Fluderation.app"
        open "$ROOT/apps/tauri/wl-matrix/src-tauri/target/release/bundle/macos/Matrix Atom Destroyer.app"
        ;;
      *)
        echo "usage: wl-matrix-suite open-built {focus|ambient|energy|emergence|all}"
        exit 2
        ;;
    esac
    ;;

  start)
    mkdir -p "$STATE_DIR"
    INTERVAL="${2:-300}"

    if [[ -f "$PID_FILE" ]] && kill -0 "$(cat "$PID_FILE")" >/dev/null 2>&1; then
      echo "PASS screensaver already running pid=$(cat "$PID_FILE")"
      exit 0
    fi

    nohup "$0" screensaver "$INTERVAL" >> "$LOG_FILE" 2>&1 &
    echo "$!" > "$PID_FILE"
    echo "PASS started THE∅MATRIX screensaver pid=$!"
    ;;

  screensaver)
    mkdir -p "$STATE_DIR"
    INTERVAL="${2:-300}"
    echo "$$" > "$PID_FILE"

    apps=(
      "$ROOT/apps/tauri/wl-spin-city/src-tauri/target/release/bundle/macos/Spin City Wave.app"
      "$ROOT/apps/tauri/wl-agitate/src-tauri/target/release/bundle/macos/Agitate Waves.app"
      "$ROOT/apps/matrix/matrix-fluderation/src-tauri/target/release/bundle/macos/Matrix Fluderation.app"
      "$ROOT/apps/tauri/wl-matrix/src-tauri/target/release/bundle/macos/Matrix Atom Destroyer.app"
    )

    while true; do
      for app in "${apps[@]}"; do
        test -d "$app" || {
          echo "FAIL missing app bundle: $app"
          echo "Run: wl-matrix-suite build"
          exit 1
        }

        app_name="$(basename "$app" .app)"
        echo "OPEN $app_name"
        open "$app"

        sleep "$INTERVAL"

        osascript -e "tell application \"$app_name\" to quit" >/dev/null 2>&1 || true
      done
    done
    ;;

  stop)
    pkill -f "wl-matrix-suite screensaver" >/dev/null 2>&1 || true

    for name in \
      "Spin City Wave" \
      "Agitate Waves" \
      "Matrix Fluderation" \
      "Matrix Atom Destroyer"
    do
      osascript -e "tell application \"$name\" to quit" >/dev/null 2>&1 || true
    done

    rm -f "$PID_FILE"
    echo "PASS stopped THE∅MATRIX screensaver"
    ;;

  state)
    mkdir -p "$STATE_DIR"
    echo "state_dir=$STATE_DIR"
    if [[ -f "$PID_FILE" ]] && kill -0 "$(cat "$PID_FILE")" >/dev/null 2>&1; then
      echo "screensaver_pid=$(cat "$PID_FILE")"
      echo "screensaver_status=running"
    else
      echo "screensaver_pid=none"
      echo "screensaver_status=stopped"
    fi
    echo "log_file=$LOG_FILE"
    ;;

  log)
    mkdir -p "$STATE_DIR"
    touch "$LOG_FILE"
    tail -80 "$LOG_FILE"
    ;;

  *)
    usage
    exit 2
    ;;
esac
