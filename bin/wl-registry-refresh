#!/usr/bin/env bash
set -euo pipefail

ROOT="${WL_AUTHORITY_ROOT:-${WL_HOME:-$HOME/Wonderland}}"

echo "Refreshing Wonderland Registry"
echo

"$ROOT/bin/wl-registry-refresh-documents"

if [[ -x "$ROOT/bin/wl-registry-refresh-commands" ]]; then
  "$ROOT/bin/wl-registry-refresh-commands"
fi

if [[ -x "$ROOT/bin/wl-services-refresh" ]]; then
  "$ROOT/bin/wl-services-refresh"
fi

if [[ -x "$ROOT/bin/wl-registry-refresh-services" ]]; then
  "$ROOT/bin/wl-registry-refresh-services"
fi

if [[ -x "$ROOT/bin/wl-registry-refresh-intents" ]]; then
  "$ROOT/bin/wl-registry-refresh-intents"
fi

if [[ -x "$ROOT/bin/wl-registry-refresh-plans" ]]; then
  "$ROOT/bin/wl-registry-refresh-plans"
fi

if [[ -x "$ROOT/bin/wl-registry-refresh-assets" ]]; then
  "$ROOT/bin/wl-registry-refresh-assets"
fi

echo
echo "Registry refresh complete"
