#!/usr/bin/env bash
set -euo pipefail

WL_ROOT="${WL_ROOT:-$HOME/Wonderland}"
APP_ID="matrix-atom-destroyer"
APP_DIR="$WL_ROOT/assets/visualizations/$APP_ID"
BIN_DIR="$WL_ROOT/bin"
CMD="$BIN_DIR/wl-matrix"

mkdir -p "$APP_DIR"/{screenshots,exports,versions}
mkdir -p "$BIN_DIR"

cat > "$APP_DIR/matrix-atom-destroyer.html" <<'HTML'
<!DOCTYPE html>
<html>
<head>
<title>Matrix Atom Destroyer</title>
<style>
html, body {
  margin: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: #05070A;
  color: #00FF66;
  font-family: monospace;
}
canvas { display: block; }
#label {
  position: absolute;
  top: 10px;
  left: 10px;
  color: #00FF66;
  text-shadow: 0 0 10px #00FF66;
  user-select: none;
}
</style>
</head>
<body>
<canvas id="c"></canvas>
<div id="label">Click / SPACE = slam · R = reset · S = screenshot · Double-click = fullscreen</div>

<script>
const COLORS = {
  bg: "#05070A",
  cyan: "#00E5FF",
  purple: "#7000FF",
  green: "#00FF66",
  red: "#FF0033"
};

const canvas = document.getElementById("c");
const ctx = canvas.getContext("2d");

let w, h;
let angle = 0;
let phase = 0;
let slam = 0;
let shockwave = 0;
let audioCtx = null;

function resize() {
  w = canvas.width = window.innerWidth;
  h = canvas.height = window.innerHeight;
}

function boom() {
  try {
    audioCtx = audioCtx || new AudioContext();
    const osc = audioCtx.createOscillator();
    const gain = audioCtx.createGain();

    osc.type = "sine";
    osc.frequency.value = 42;

    osc.connect(gain);
    gain.connect(audioCtx.destination);

    gain.gain.setValueAtTime(0.45, audioCtx.currentTime);
    gain.gain.exponentialRampToValueAtTime(0.0001, audioCtx.currentTime + 0.45);

    osc.start();
    osc.stop(audioCtx.currentTime + 0.45);
  } catch (_) {}
}

function triggerSlam() {
  phase = 2;
  slam = 1;
  shockwave = 1;
  boom();
}

function reset() {
  phase = 0;
  slam = 0;
  shockwave = 0;
}

function saveScreenshot() {
  const a = document.createElement("a");
  a.download = "matrix-atom-destroyer.png";
  a.href = canvas.toDataURL("image/png");
  a.click();
}

function matrixRain() {
  ctx.fillStyle = COLORS.green;
  ctx.font = "14px monospace";

  for (let i = 0; i < 90; i++) {
    const char = Math.random() > 0.5 ? "1" : "0";
    ctx.fillText(char, Math.random() * w, Math.random() * h);
  }
}

function atom() {
  ctx.save();
  ctx.translate(w / 2, h / 2);

  const scale = 1 + slam * 2.5;
  ctx.scale(scale, scale);
  ctx.rotate(angle);

  ctx.strokeStyle = phase === 2 ? COLORS.red : COLORS.green;
  ctx.shadowColor = ctx.strokeStyle;
  ctx.shadowBlur = 18;
  ctx.lineWidth = 3;

  for (let i = 0; i < 3; i++) {
    ctx.beginPath();
    ctx.ellipse(0, 0, 90, 32, i * Math.PI / 1.5 + angle, 0, Math.PI * 2);
    ctx.stroke();
  }

  ctx.fillStyle = phase === 2 ? COLORS.red : COLORS.cyan;

  for (let i = 0; i < 40; i++) {
    const spread = phase === 2 ? 160 + slam * 500 : 70;
    const x = Math.cos(angle * 2 + i) * spread * Math.random();
    const y = Math.sin(angle * 3 + i) * spread * Math.random();
    ctx.fillRect(x, y, 4, 4);
  }

  ctx.restore();
}

function drawShockwave() {
  if (shockwave <= 0) return;

  ctx.save();
  ctx.translate(w / 2, h / 2);
  ctx.strokeStyle = `rgba(255,0,51,${shockwave})`;
  ctx.lineWidth = 6;
  ctx.shadowColor = COLORS.red;
  ctx.shadowBlur = 30;
  ctx.beginPath();
  ctx.arc(0, 0, (1 - shockwave) * Math.max(w, h), 0, Math.PI * 2);
  ctx.stroke();
  ctx.restore();

  shockwave -= 0.018;
}

function draw() {
  ctx.fillStyle = "rgba(5,7,10,0.12)";
  ctx.fillRect(0, 0, w, h);

  matrixRain();
  atom();
  drawShockwave();

  angle += phase === 2 ? 0.12 : 0.045;

  if (slam > 0) slam -= 0.025;
  if (slam < 0) slam = 0;

  if (phase === 2 && shockwave <= 0 && slam === 0) {
    phase = 0;
  }

  requestAnimationFrame(draw);
}

window.addEventListener("resize", resize);
window.addEventListener("click", triggerSlam);

window.addEventListener("dblclick", () => {
  if (!document.fullscreenElement) {
    document.documentElement.requestFullscreen();
  } else {
    document.exitFullscreen();
  }
});

window.addEventListener("keydown", e => {
  switch (e.key.toLowerCase()) {
    case " ":
      e.preventDefault();
      triggerSlam();
      break;
    case "r":
      reset();
      break;
    case "s":
      saveScreenshot();
      break;
  }
});

resize();
draw();
</script>
</body>
</html>
HTML

cat > "$APP_DIR/README.md" <<'MD'
# Matrix Atom Destroyer

Interactive Matrix-style atom visualization.

## Controls

- Click: slam destroy
- Space: slam destroy
- R: reset
- S: screenshot export
- Double-click: fullscreen

## Runtime

- Browser
- HTML5 Canvas
- No external dependencies

## Wonderland

- Command: `wl-matrix`
- Asset path: `assets/visualizations/matrix-atom-destroyer`
MD

cat > "$APP_DIR/manifest.json" <<JSON
{
  "id": "matrix-atom-destroyer",
  "name": "Matrix Atom Destroyer",
  "version": "1.0.0",
  "status": "experimental",
  "owner": "Wonderland",
  "runtime": "browser",
  "dependencies": [],
  "created": "$(date +%F)",
  "command": "wl-matrix",
  "entrypoint": "matrix-atom-destroyer.html",
  "description": "Matrix-style atom visualization with slam-destroy effect."
}
JSON

cat > "$CMD" <<'SH'
#!/usr/bin/env bash
set -euo pipefail

WL_ROOT="${WL_ROOT:-$HOME/Wonderland}"
APP="$WL_ROOT/assets/visualizations/matrix-atom-destroyer/matrix-atom-destroyer.html"

if [[ ! -f "$APP" ]]; then
  echo "FAIL missing: $APP"
  exit 1
fi

open "$APP"
SH

chmod +x "$CMD"

echo "Matrix Atom Destroyer installed."
echo "Path: $APP_DIR"
echo "Command: wl-matrix"

echo
echo "Verification:"
[[ -f "$APP_DIR/matrix-atom-destroyer.html" ]] && echo "PASS html" || echo "FAIL html"
[[ -f "$APP_DIR/README.md" ]] && echo "PASS readme" || echo "FAIL readme"
[[ -f "$APP_DIR/manifest.json" ]] && echo "PASS manifest" || echo "FAIL manifest"
[[ -x "$CMD" ]] && echo "PASS command" || echo "FAIL command"

echo
echo "Run:"
echo "  wl-matrix"
