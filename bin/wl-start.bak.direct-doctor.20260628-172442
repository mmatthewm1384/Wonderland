#!/usr/bin/env bash
set -uo pipefail

WL_HOME="${WL_HOME:-$HOME/Wonderland}"
WL_ROOT="${WL_ROOT:-$WL_HOME}"
WL_LIB="$WL_HOME/lib/wl-lib.sh"

if [[ -f "$WL_LIB" ]]; then
  . "$WL_LIB"
else
  echo "FAIL wl-lib missing: $WL_LIB"
  echo "RESULT FAIL"
  exit 1
fi

echo "== Wonderland Start =="

wl_section "Preflight"
command -v limactl >/dev/null 2>&1 && wl_pass "limactl" || wl_fail "limactl"
command -v nerdctl >/dev/null 2>&1 && wl_pass "nerdctl" || wl_fail "nerdctl"
wl_required_path "root" "$WL_HOME"
wl_required_path "bin" "$WL_HOME/bin"
wl_required_path "vault" "$WL_HOME/vault"
wl_t7_status

wl_section "Starting wonderland-rootless"
limactl start wonderland-rootless >/dev/null 2>&1 || true

if limactl list 2>/dev/null | grep -q '^wonderland-rootless[[:space:]]\+Running'; then
  wl_pass "wonderland-rootless" "running"
else
  wl_fail "wonderland-rootless" "not running"
fi

wl_section "Starting rootless services"
for svc in wl-vaultwarden wl-vaultwarden-db wl-loki; do
  LIMA_INSTANCE=wonderland-rootless nerdctl start "$svc" >/dev/null 2>&1 || true

  if LIMA_INSTANCE=wonderland-rootless nerdctl ps --format '{{.Names}}' 2>/dev/null | grep -qx "$svc"; then
    wl_pass "$svc" "up"
  else
    wl_warn "$svc" "not up"
  fi
done

wl_section "Ensuring rootless Loki config"
mkdir -p "$WL_HOME/runtime/wl-loki/config"

if [[ ! -f "$WL_HOME/runtime/wl-loki/config/local-config.yaml" ]]; then
  cat > "$WL_HOME/runtime/wl-loki/config/local-config.yaml" <<'YAML'
auth_enabled: false
server:
  http_listen_port: 3100
  grpc_listen_port: 9096
common:
  path_prefix: /loki
  storage:
    filesystem:
      chunks_directory: /loki/chunks
      rules_directory: /loki/rules
  replication_factor: 1
  ring:
    kvstore:
      store: inmemory
schema_config:
  configs:
    - from: 2024-01-01
      store: tsdb
      object_store: filesystem
      schema: v13
      index:
        prefix: index_
        period: 24h
limits_config:
  allow_structured_metadata: false
  retention_period: 168h
compactor:
  working_directory: /loki/compactor
  retention_enabled: true
  delete_request_store: filesystem
YAML
  wl_pass "rootless loki config" "created"
else
  wl_pass "rootless loki config" "exists"
fi

wl_section "Lifecycle report"
"$WL_HOME/bin/wl-lifecycle-report" start || wl_warn "lifecycle report" "non-terminal report failure"

wl_section "Verification"

doctor_rc=0
universe_rc=0

wl doctor || doctor_rc=$?
wl universe status || universe_rc=$?

if (( doctor_rc == 0 && universe_rc == 0 && wl_failures == 0 && wl_corruptions == 0 )); then
  echo "RESULT PASS"
  exit 0
fi

echo "RESULT FAIL"
exit 1
