#!/usr/bin/env bash
set -euo pipefail

ROOT="/Users/wonderland/Wonderland"
FAIL=0

check() {
  local name="$1"
  shift

  printf "%-24s" "$name"

  if "$@" >/tmp/wl-doctor-check.log 2>&1; then
    echo "PASS"
  else
    echo "FAIL"
    cat /tmp/wl-doctor-check.log | sed 's/^/  /'
    FAIL=1
  fi
}

echo
echo "Wonderland Doctor"
echo "root: $ROOT"
echo

check "vault" "$ROOT/bin/wl" verify
check "registry integrity" "$ROOT/bin/wl" registry integrity
check "runtime drift" "$ROOT/bin/wl" runtime drift
check "anon route" "$ROOT/bin/wl" anon doctor
check "operations" "$ROOT/bin/wl" operations verify
check "intelligence" "$ROOT/bin/wl" intelligence verify
check "governance" "$ROOT/bin/wl" governance verify
check "recovery drill" "$ROOT/bin/wl-verify-recovery-drill"

echo

if [[ "$FAIL" -eq 0 ]]; then
  echo "RESULT PASS"
else
  echo "RESULT FAIL"
  exit 1
fi
