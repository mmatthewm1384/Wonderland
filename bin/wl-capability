#!/usr/bin/env bash
set -uo pipefail

WL_HOME="${WL_HOME:-$HOME/Wonderland}"
. "$WL_HOME/lib/wl-bootstrap.sh"

cmd="${1:-status}"

cap_state() {
  local cap="$1"
  if wl_capability_available "$cap"; then
    echo "available"
  else
    echo "unavailable"
  fi
}

case "$cmd" in
  status)
    if [[ "${2:-}" == "--json" || "${1:-}" == "--json" ]]; then
      cat <<JSON
{
  "result": "PASS",
  "profile": "${WL_PROFILE:-internal-light}",
  "capabilities": {
    "internal_storage": "$(cap_state internal_storage)",
    "runtime": "$(cap_state runtime)",
    "external_storage": "$(cap_state external_storage)",
    "media": "$(cap_state media)",
    "torrent": "$(cap_state torrent)"
  }
}
JSON
      exit 0
    fi

    wl_capability_status
    wl_health_exit
    ;;

  --json|json)
    "$0" status --json
    ;;

  has)
    cap="${2:-}"
    if [[ -z "$cap" ]]; then
      echo "Usage: wl capability has <capability>"
      echo "RESULT FAIL"
      exit 1
    fi

    if wl_capability_available "$cap"; then
      echo "PASS $cap"
      exit 0
    else
      echo "WARN $cap unavailable"
      exit 0
    fi
    ;;

  *)
    echo "Usage: wl capability {status|status --json|has <capability>}"
    echo "RESULT FAIL"
    exit 1
    ;;
esac
