#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
SVC="$ROOT/services/wl-time-machine"
CFG="$SVC/config"
STATE="$SVC/state"
SNAP="$SVC/snapshots"
RESTORE="$SVC/restores"
LOGS="$SVC/logs"
RECOVERY="$SVC/recovery"
POLICY="$CFG/time-machine-policy.json"
INDEX="$STATE/snapshot-index.jsonl"

mkdir -p "$CFG" "$STATE" "$SNAP" "$RESTORE" "$LOGS" "$RECOVERY"

timestamp() { date -u +"%Y-%m-%dT%H:%M:%SZ"; }
stamp() { date -u +"%Y%m%dT%H%M%SZ"; }

init() {
  [ -f "$CFG/excludes.txt" ] || cat > "$CFG/excludes.txt" <<'EOF'
.git
.DS_Store
.quarantine
node_modules
.venv
venv
__pycache__
.cache
tmp
logs
backups
downloads
services/wl-time-machine/snapshots
services/wl-time-machine/restores
services/wl-time-machine/recovery
EOF

  [ -f "$POLICY" ] || cat > "$POLICY" <<'EOF'
{
  "id": "wl-time-machine-policy-v2",
  "mode": "append-only-local-snapshots",
  "default_snapshot_scope": "authority",
  "restore_mode": "staged-only",
  "delete_snapshots_by_default": false,
  "allowed_behaviors": [
    "create_authority_snapshot",
    "create_explicit_full_snapshot",
    "write_manifest",
    "verify_snapshot_manifest",
    "stage_restore_copy",
    "create_recovery_bundle",
    "prune_staged_restores"
  ],
  "forbidden_behaviors": [
    "overwrite_live_files_without_operator_action",
    "delete_snapshots_without_explicit_command",
    "restore_without_staging",
    "capture_secret_material_by_default"
  ]
}
EOF

  touch "$INDEX"
  echo "$(timestamp) init" >> "$LOGS/time-machine.log"
  echo "RESULT PASS"
}

exclude_args() {
  while IFS= read -r pattern; do
    [ -n "$pattern" ] || continue
    printf '%s\n' "--exclude=./$pattern"
    printf '%s\n' "--exclude=$pattern"
  done < "$CFG/excludes.txt"
}

snapshot() {
  init >/dev/null

  scope="${1:-authority}"
  label="${2:-manual}"

  case "$scope" in
    authority|full) ;;
    *) label="$scope"; scope="authority" ;;
  esac

  id="$(stamp)-$scope-$label"
  dest="$SNAP/$id"
  mkdir -p "$dest"

  manifest="$dest/manifest.json"
  archive="$dest/root.tar.gz"

  mapfile -t excludes < <(exclude_args)

  if [ "$scope" = "authority" ]; then
    tar "${excludes[@]}" -czf "$archive" \
      bin \
      vault \
      services/*/config \
      services/*/state \
      services/*/README.md \
      2>/dev/null || true
  else
    tar "${excludes[@]}" -czf "$archive" .
  fi

  sha="$(shasum -a 256 "$archive" | awk '{print $1}')"
  bytes="$(wc -c < "$archive" | tr -d ' ')"

  python3 - "$manifest" "$id" "$label" "$scope" "$sha" "$bytes" <<'PY'
import json
import sys
from datetime import datetime, timezone

path, sid, label, scope, sha, bytes_ = sys.argv[1:]
data = {
    "id": sid,
    "created": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
    "label": label,
    "scope": scope,
    "archive": "root.tar.gz",
    "sha256": sha,
    "bytes": int(bytes_),
    "mode": "append-only-local-snapshot",
    "restore_mode": "staged-only"
}
with open(path, "w") as f:
    json.dump(data, f, indent=2)
    f.write("\n")
PY

  cat "$manifest" >> "$INDEX"
  echo "$(timestamp) snapshot $id scope=$scope" >> "$LOGS/time-machine.log"

  echo "Snapshot created: $id"
  echo "Scope: $scope"
  echo "Archive: $archive"
  echo "Size: $bytes bytes"
  echo "RESULT PASS"
}

list_snapshots() {
  find "$SNAP" -mindepth 1 -maxdepth 1 -type d -print 2>/dev/null | sort | sed "s#^$SNAP/##" || true
}

verify_snapshot() {
  init >/dev/null

  id="${1:-latest}"
  [ "$id" = "latest" ] && id="$(list_snapshots | tail -1)"

  [ -n "${id:-}" ] || { echo "No snapshots found"; echo "RESULT FAIL"; exit 1; }

  manifest="$SNAP/$id/manifest.json"
  archive="$SNAP/$id/root.tar.gz"

  [ -f "$manifest" ] || { echo "FAIL manifest"; echo "RESULT FAIL"; exit 1; }
  [ -f "$archive" ] || { echo "FAIL archive"; echo "RESULT FAIL"; exit 1; }

  expected="$(jq -r '.sha256' "$manifest")"
  actual="$(shasum -a 256 "$archive" | awk '{print $1}')"

  if [ "$expected" = "$actual" ]; then
    echo "PASS snapshot $id"
    echo "RESULT PASS"
  else
    echo "FAIL checksum $id"
    echo "RESULT FAIL"
    exit 1
  fi
}

restore_stage() {
  init >/dev/null

  id="${1:-latest}"
  [ "$id" = "latest" ] && id="$(list_snapshots | tail -1)"
  [ -n "${id:-}" ] || { echo "No snapshots found"; echo "RESULT FAIL"; exit 1; }

  verify_snapshot "$id" >/dev/null

  stage="$RESTORE/$id"
  rm -rf "$stage"
  mkdir -p "$stage"
  tar -xzf "$SNAP/$id/root.tar.gz" -C "$stage"

  echo "Restore staged: $stage"
  echo "RESULT PASS"
}

doctor() {
  init >/dev/null
  result="PASS"

  echo "Wonderland Time Machine Doctor"
  echo

  [ -f "$POLICY" ] && echo "PASS policy" || { echo "FAIL policy"; result="FAIL"; }
  [ -f "$CFG/excludes.txt" ] && echo "PASS excludes" || { echo "FAIL excludes"; result="FAIL"; }
  [ -d "$SNAP" ] && echo "PASS snapshots-dir" || { echo "FAIL snapshots-dir"; result="FAIL"; }
  [ -d "$RESTORE" ] && echo "PASS restores-dir" || { echo "FAIL restores-dir"; result="FAIL"; }
  [ -f "$INDEX" ] && echo "PASS index" || { echo "FAIL index"; result="FAIL"; }

  jq -e '.mode=="append-only-local-snapshots" and .default_snapshot_scope=="authority" and .restore_mode=="staged-only"' "$POLICY" >/dev/null \
    && echo "PASS governance-policy" \
    || { echo "FAIL governance-policy"; result="FAIL"; }

  echo
  echo "RESULT $result"
}

recovery_bundle() {
  init >/dev/null

  out="$RECOVERY/wl-time-machine-recovery-$(stamp).tar.gz"
  tar -czf "$out" bin/wl-time-machine services/wl-time-machine/config services/wl-time-machine/state vault/06-Recovery/wl-time-machine.md 2>/dev/null || true

  echo "Recovery bundle: $out"
  echo "RESULT PASS"
}

prune_restores() {
  rm -rf "$RESTORE"/*
  mkdir -p "$RESTORE"
  echo "RESULT PASS"
}

prune_recovery() {
  keep="${1:-3}"
  ls -t "$RECOVERY"/*.tar.gz 2>/dev/null | tail -n +"$((keep + 1))" | xargs rm -f 2>/dev/null || true
  echo "RESULT PASS"
}

status() {
  init >/dev/null

  count="$(find "$SNAP" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l | tr -d ' ')"
  latest="$(list_snapshots | tail -1 || true)"

  echo "Wonderland Time Machine"
  echo
  echo "Snapshots:       $count"
  echo "Latest:          ${latest:-NONE}"
  echo "Default Scope:   authority"
  echo "Restore:         staged-only"
  echo
  echo "RESULT PASS"
}

case "${1:-status}" in
  init) init ;;
  status) status ;;
  snapshot) shift; snapshot "${1:-authority}" "${2:-manual}" ;;
  list) list_snapshots ;;
  verify) shift; [ "${1:-}" ] && verify_snapshot "$1" || doctor ;;
  doctor) doctor ;;
  restore-stage) shift; restore_stage "${1:-latest}" ;;
  recovery-bundle) recovery_bundle ;;
  prune-restores) prune_restores ;;
  prune-recovery) shift; prune_recovery "${1:-3}" ;;
  *) echo "usage: wl-time-machine init|status|snapshot [authority|full] [label]|list|verify [id]|doctor|restore-stage [id]|recovery-bundle|prune-restores|prune-recovery [keep]" ;;
esac
