#!/usr/bin/env bash
set -euo pipefail

WL_HOME="${WL_HOME:-$HOME/Wonderland}"
export WL_HOME

cmd="${1:-help}"
shift || true

die(){ echo "wl: $*" >&2; exit 1; }
has(){ [[ -x "$1" ]]; }
need(){ has "$1" || die "missing executable: $1"; }

run(){
  local target="$1"; shift
  need "$target"
  exec "$target" "$@"
}

container_exists(){
  nerdctl ps -a --format '{{.Names}}' 2>/dev/null | grep -qx "$1"
}

container_up(){
  nerdctl ps --format '{{.Names}}' 2>/dev/null | grep -qx "$1"
}

start_container_or_service(){
  local name="$1"
  local svc="$2"

  if container_up "$name"; then
    echo "PASS $name already up"
    return 0
  fi

  if container_exists "$name"; then
    nerdctl start "$name" >/dev/null
    echo "PASS $name started"
    return 0
  fi

  need "$svc"
  "$svc" up
}

start_observability(){
  local missing=0

  for c in wl-prometheus wl-grafana wl-loki; do
    container_up "$c" || missing=1
  done

  if [[ "$missing" -eq 0 ]]; then
    echo "PASS observability already up"
    return 0
  fi

  "$WL_HOME/bin/wl-observability" up
}

help(){
cat <<'HELP'
Wonderland command surface

Core:
  wl help
  wl status
  wl doctor
  wl path
  wl commands
  wl containers

Lifecycle:
  wl rootless status|start|stop|doctor
  wl runtime status|start|doctor|logs <container>|inspect <container>|compose ...

Authority:
  wl storage status|attach|attach-light|attach-full|eject|force-eject|verify|doctor|authority
  wl universe status|doctor|dashboard
  wl snapshot create|doctor|list|restore-drill
  wl governance doctor|verify|status

Passthrough:
  wl <name> ...
  Example: wl dns up, wl nats up, wl observability up, wl portainer status

Recovery:
  wl repair doctor
  wl repair path
HELP
}

case "$cmd" in
  help|-h|--help)
    help
    ;;

  path)
    echo "WL_HOME=$WL_HOME"
    echo
    which -a wl || true
    echo
    type -a wl || true
    ;;

  commands)
    find "$WL_HOME/bin" -maxdepth 1 -type f -perm -111 -name 'wl-*' \
      | sed "s|$WL_HOME/bin/wl-||" \
      | sort
    ;;

  containers|ps)
    nerdctl ps --format 'table {{.Names}}\t{{.Status}}\t{{.Ports}}'
    ;;

  status)
    run "$WL_HOME/bin/wl-universe" status
    ;;

  doctor)
    "$WL_HOME/bin/wl-storage" doctor || true
    "$WL_HOME/bin/wl-snapshot" doctor || true
    "$WL_HOME/bin/wl-universe" status
    ;;

  rootless)
    run "$WL_HOME/bin/wl-rootless" "$@"
    ;;

  runtime)
    sub="${1:-status}"
    shift || true
    case "$sub" in
      status|ps)
        nerdctl ps --format 'table {{.Names}}\t{{.Status}}\t{{.Ports}}'
        ;;
      start)
        start_container_or_service wl-dns "$WL_HOME/bin/wl-dns"
        start_container_or_service wl-nats "$WL_HOME/bin/wl-nats"
        start_observability
        "$WL_HOME/bin/wl-universe" status
        ;;
      doctor)
        "$WL_HOME/bin/wl-universe" status
        ;;
      logs|inspect|images|compose)
        run "$WL_HOME/bin/wl-runtime" "$sub" "$@"
        ;;
      *)
        die "unknown runtime command: $sub"
        ;;
    esac
    ;;

  storage)
    sub="${1:-status}"
    shift || true
    case "$sub" in
      attach-light) run "$WL_HOME/bin/wl-storage" attach --light "$@" ;;
      attach-full)  run "$WL_HOME/bin/wl-storage" attach --full "$@" ;;
      *)            run "$WL_HOME/bin/wl-storage" "$sub" "$@" ;;
    esac
    ;;

  universe)     run "$WL_HOME/bin/wl-universe" "$@" ;;
  snapshot)     run "$WL_HOME/bin/wl-snapshot" "$@" ;;
  governance)   run "$WL_HOME/bin/wl-governance" "$@" ;;
  dns)          run "$WL_HOME/bin/wl-dns" "$@" ;;
  nats)         run "$WL_HOME/bin/wl-nats" "$@" ;;
  observability) run "$WL_HOME/bin/wl-observability" "$@" ;;

  repair)
    sub="${1:-doctor}"
    shift || true
    case "$sub" in
      doctor|path)
        echo "Wonderland wl repair doctor"
        echo
        echo "WL_HOME=$WL_HOME"
        echo "canonical=$WL_HOME/bin/wl"
        echo
        ls -l "$WL_HOME/bin/wl"
        echo
        which -a wl || true
        echo
        type -a wl || true
        echo
        echo "Runtime:"
        nerdctl ps --format 'table {{.Names}}\t{{.Status}}' 2>/dev/null || true
        ;;
      *)
        die "unknown repair command: $sub"
        ;;
    esac
    ;;

  *)
    candidate="$WL_HOME/bin/wl-$cmd"
    if has "$candidate"; then
      exec "$candidate" "$@"
    fi
    die "unknown wl command: $cmd"
    ;;
esac
