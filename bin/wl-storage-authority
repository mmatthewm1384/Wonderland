#!/usr/bin/env bash
set -euo pipefail

WL_ROOT="${WL_ROOT:-$HOME/Wonderland}"
REGISTRY="$WL_ROOT/vault/07-Operations/platform/storage-authority.json"

echo "== Storage Authority =="

if [ -f "$REGISTRY" ]; then
  echo "PASS registry: $REGISTRY"
  echo "INFO external storage: optional in light mode"
  exit 0
fi

echo "FAIL registry missing"
echo "expected: $REGISTRY"
exit 1
