#!/usr/bin/env bash
set -euo pipefail

ROOT="${WL_AUTHORITY_ROOT:-${WL_HOME:-$HOME/Wonderland}}"
STAMP="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
REG="$ROOT/.wl-registry"
ROOTREG="$ROOT/registries/root-registry.json"

mkdir -p "$ROOT/registries"

{
  echo "{"
  echo "  \"id\": \"wl-registry\","
  echo "  \"generated_at\": \"$STAMP\","
  echo "  \"authority_root\": \"$ROOT\","
  echo "  \"commands\": ["
  first=1
  find "$ROOT/bin" -maxdepth 1 -type f -perm -111 -name 'wl*' | sort | while read -r f; do
    [[ $first -eq 1 ]] && first=0 || echo ","
    printf '    { "name": "%s", "path": "%s" }' "$(basename "$f")" "$f"
  done
  echo
  echo "  ]"
  echo "}"
} > "$REG"

cat > "$ROOTREG" <<JSON
{
  "id": "root-registry",
  "generated_at": "$STAMP",
  "authority": "$ROOT",
  "rootless_runtime": "wonderland-rootless",
  "legacy_runtime": "default",
  "mode": "phase-2-rootless-primary"
}
JSON

echo "PASS registry refreshed"
