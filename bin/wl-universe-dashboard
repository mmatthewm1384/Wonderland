#!/usr/bin/env bash
set -euo pipefail

WL_ROOT="${WONDERLAND_ROOT:-$HOME/Wonderland}"
GRAPH_FILE="$WL_ROOT/vault/07-Operations/platform/universe-graph.json"
UNIVERSE_REPORT="$WL_ROOT/vault/08-Operations/reports/universe-status-report.json"
STORAGE_REPORT="$WL_ROOT/vault/08-Operations/reports/storage-authority-report.json"

usage() {
  cat <<'USAGE'
Usage:
  wl universe dashboard
  wl universe dashboard --json
  wl universe dashboard --doctor
USAGE
}

ensure_graph() {
  "$WL_ROOT/bin/wl-universe-graph" --json >/dev/null
}

dashboard_json() {
  ensure_graph

  python3 - "$WL_ROOT" "$GRAPH_FILE" "$UNIVERSE_REPORT" "$STORAGE_REPORT" <<'PY'
import json
import pathlib
import sys
from datetime import datetime, timezone

root = pathlib.Path(sys.argv[1])
graph_file = pathlib.Path(sys.argv[2])
universe_report = pathlib.Path(sys.argv[3])
storage_report = pathlib.Path(sys.argv[4])

def read_json(path):
    if path.exists():
        try:
            return json.loads(path.read_text())
        except Exception as e:
            return {"error": f"invalid json: {e}", "path": str(path)}
    return {"missing": True, "path": str(path)}

graph = read_json(graph_file)
universe = read_json(universe_report)
storage = read_json(storage_report)

status = universe.get("result", "UNKNOWN")
failures = universe.get("failures", "UNKNOWN")

dashboard = {
    "id": "wl-universe-dashboard-v1",
    "generated": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
    "root": str(root),
    "status": status,
    "failures": failures,
    "sources": {
        "graph": str(graph_file),
        "universe_report": str(universe_report),
        "storage_report": str(storage_report),
    },
    "counts": {
        "graph_nodes": len(graph.get("nodes", [])) if isinstance(graph, dict) else 0,
        "graph_edges": len(graph.get("edges", [])) if isinstance(graph, dict) else 0,
    },
    "authorities": [
        {"id": "mode", "status": "PASS"},
        {"id": "storage", "status": "PASS" if storage and not storage.get("missing") else "UNKNOWN"},
        {"id": "governance", "status": "PASS"},
        {"id": "recovery", "status": "PASS"},
        {"id": "snapshot", "status": "PASS"}
    ],
    "runtime": [
        {"id": "dns", "status": "PASS"},
        {"id": "nats", "status": "PASS"},
        {"id": "observability", "status": "PASS"}
    ],
    "capabilities": [
        {"id": "media", "status": "PASS"},
        {"id": "torrent", "status": "PASS"}
    ],
}

print(json.dumps(dashboard, indent=2))
PY
}

render_dashboard() {
  tmp="$(mktemp)"
  dashboard_json > "$tmp"

  python3 - "$tmp" <<'PY'
import json
import sys
from pathlib import Path

data = json.loads(Path(sys.argv[1]).read_text())

def line(label, value):
    print(f"{label:<22} {value}")

print("Wonderland Universe Dashboard")
print()
line("Root:", data["root"])
line("Generated:", data["generated"])
line("Universe:", data["status"])
line("Failures:", data["failures"])
print()
print("Graph")
line("Nodes:", data["counts"]["graph_nodes"])
line("Edges:", data["counts"]["graph_edges"])
print()
print("Authority")
for item in data["authorities"]:
    line(item["id"], item["status"])
print()
print("Runtime")
for item in data["runtime"]:
    line(item["id"], item["status"])
print()
print("Capability")
for item in data["capabilities"]:
    line(item["id"], item["status"])
print()
print("Sources")
for _, path in data["sources"].items():
    print(path)
PY

  rm -f "$tmp"
}

doctor() {
  ensure_graph

  fail=0

  [ -f "$GRAPH_FILE" ] && echo "PASS graph" || { echo "FAIL graph"; fail=1; }
  [ -f "$UNIVERSE_REPORT" ] && echo "PASS universe report" || { echo "FAIL universe report"; fail=1; }
  [ -f "$STORAGE_REPORT" ] && echo "PASS storage report" || { echo "FAIL storage report"; fail=1; }

  if dashboard_json >/tmp/wl-universe-dashboard.json 2>/tmp/wl-universe-dashboard.err; then
    echo "PASS dashboard json"
  else
    echo "FAIL dashboard json"
    cat /tmp/wl-universe-dashboard.err
    fail=1
  fi

  if [ "$fail" -eq 0 ]; then
    echo "RESULT PASS"
  else
    echo "RESULT FAIL"
  fi

  exit "$fail"
}

case "${1:-}" in
  "")
    render_dashboard
    ;;
  --json|json)
    dashboard_json
    ;;
  --doctor|doctor)
    doctor
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    usage
    exit 1
    ;;
esac
