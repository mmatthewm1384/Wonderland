#!/usr/bin/env bash
set -uo pipefail

WL_HOME="${WL_HOME:-$HOME/Wonderland}"
. "$WL_HOME/lib/wl-bootstrap.sh"

cmd="${1:-show}"

case "$cmd" in
  refresh)
    wl_state_refresh
    echo "RESULT PASS"
    ;;

  show|dump)
    wl_state_dump
    ;;

  capabilities)
    wl_capabilities_dump
    ;;

  get)
    wl_state_get "${2:-}"
    ;;

  *)
    echo "Usage: wl state {refresh|show|get <key>|capabilities}"
    echo "RESULT FAIL"
    exit 1
    ;;
esac
