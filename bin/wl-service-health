#!/usr/bin/env bash
set -euo pipefail

ROOT="${WL_AUTHORITY_ROOT:-${WL_HOME:-$HOME/Wonderland}}"
OUT="$ROOT/vault/06-Services/service-health.json"

python3 - "$OUT" <<'PY'
import json
import subprocess
import pathlib
import datetime

out = pathlib.Path(__import__("sys").argv[1])

services = []

try:
    ps = subprocess.run(
        ["nerdctl","ps","--format","{{.Names}}"],
        capture_output=True,
        text=True
    ).stdout.splitlines()

    for name in sorted(ps):
        services.append({
            "name": name,
            "status": "running"
        })
except Exception:
    pass

payload = {
    "id": "service-health-v4",
    "version": 4,
    "generated": datetime.datetime.now().isoformat(timespec="seconds"),
    "services": services
}

out.write_text(json.dumps(payload, indent=2) + "\n")

print(f"services: {len(services)}")
PY
