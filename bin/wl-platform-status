#!/usr/bin/env python3
"""Deterministic Wonderland Platform convergence status."""

from __future__ import annotations

import json
import os
import subprocess
import sys
from dataclasses import dataclass
from pathlib import Path
from typing import Any


ROOT = Path(
    os.environ.get(
        "WL_ROOT",
        "/Users/wonderland/Wonderland",
    )
).expanduser().resolve()

TIMEOUT_SECONDS = 60


@dataclass(frozen=True)
class Check:
    name: str
    command: tuple[str, ...]
    returncode: int | None
    status: str
    stdout: str
    stderr: str
    error: str | None = None


def run_check(
    name: str,
    command: list[str],
    *,
    timeout: int = TIMEOUT_SECONDS,
) -> Check:
    environment = os.environ.copy()
    environment["WL_ROOT"] = str(ROOT)
    environment["WL_HOME"] = str(ROOT)
    environment["PATH"] = os.pathsep.join(
        [
            str(ROOT / "bin"),
            "/opt/homebrew/bin",
            "/opt/homebrew/sbin",
            "/usr/local/bin",
            "/usr/bin",
            "/bin",
            "/usr/sbin",
            "/sbin",
        ]
    )

    try:
        completed = subprocess.run(
            command,
            cwd=ROOT,
            env=environment,
            stdin=subprocess.DEVNULL,
            text=True,
            capture_output=True,
            timeout=timeout,
            check=False,
        )
    except subprocess.TimeoutExpired as exc:
        return Check(
            name=name,
            command=tuple(command),
            returncode=None,
            status="FAIL",
            stdout=exc.stdout or "",
            stderr=exc.stderr or "",
            error=f"timeout after {timeout} seconds",
        )
    except OSError as exc:
        return Check(
            name=name,
            command=tuple(command),
            returncode=None,
            status="FAIL",
            stdout="",
            stderr="",
            error=f"{type(exc).__name__}: {exc}",
        )

    return Check(
        name=name,
        command=tuple(command),
        returncode=completed.returncode,
        status=(
            "PASS"
            if completed.returncode == 0
            else "FAIL"
        ),
        stdout=completed.stdout,
        stderr=completed.stderr,
        error=(
            None
            if completed.returncode == 0
            else f"exit status {completed.returncode}"
        ),
    )


def find_manifest_index() -> Path | None:
    candidates = [
        ROOT / "01-Platform/registry/manifest-index.json",
        ROOT / "01-Platform/manifests/index.json",
        ROOT / "vault/05-Registry/manifest-index.json",
        ROOT / "vault/05-Registry/manifests/index.json",
        ROOT / "config/wonderland/manifest-index.json",
        ROOT / "config/wonderland/manifests/index.json",
    ]

    for candidate in candidates:
        if candidate.is_file():
            return candidate

    patterns = (
        "*manifest*index*.json",
        "manifest-index.json",
    )

    discovered: list[Path] = []

    for pattern in patterns:
        discovered.extend(
            path
            for path in ROOT.rglob(pattern)
            if (
                path.is_file()
                and ".git" not in path.parts
                and "backups" not in path.parts
                and "certifications" not in path.parts
                and "releases" not in path.parts
            )
        )

    return sorted(set(discovered))[0] if discovered else None


def count_manifest_entries(value: Any) -> int | None:
    if isinstance(value, list):
        return len(value)

    if not isinstance(value, dict):
        return None

    for key in (
        "manifests",
        "entries",
        "items",
        "artifacts",
        "records",
        "files",
    ):
        child = value.get(key)

        if isinstance(child, list):
            return len(child)

        if isinstance(child, dict):
            return len(child)

    # Some indexes are directly keyed by manifest identifier.
    metadata_keys = {
        "schema_version",
        "version",
        "created_at",
        "updated_at",
        "generated_at",
        "metadata",
    }

    content_keys = [
        key
        for key in value
        if key not in metadata_keys
    ]

    return len(content_keys) if content_keys else None


def verify_manifest_index() -> tuple[str, int, str | None]:
    index = find_manifest_index()

    if index is None:
        return (
            "FAIL",
            0,
            "manifest index not found",
        )

    try:
        value = json.loads(
            index.read_text(encoding="utf-8")
        )
    except (OSError, json.JSONDecodeError) as exc:
        return (
            "FAIL",
            0,
            f"{index}: {type(exc).__name__}: {exc}",
        )

    count = count_manifest_entries(value)

    if count is None:
        return (
            "FAIL",
            0,
            f"unrecognized manifest index structure: {index}",
        )

    return (
        "PASS",
        count,
        str(index.relative_to(ROOT)),
    )


def main() -> int:
    registry = run_check(
        "registry",
        [
            str(ROOT / "bin/wl-registry"),
            "verify",
        ],
    )

    architecture = run_check(
        "architecture",
        [
            str(ROOT / "bin/wl-architecture-verify"),
        ],
    )

    builder = run_check(
        "builder",
        [
            str(ROOT / "bin/wl"),
            "builder",
            "verify",
        ],
    )

    manifest_status, manifest_count, manifest_detail = (
        verify_manifest_index()
    )

    engineering_gate = (
        "PASS"
        if (
            registry.status == "PASS"
            and architecture.status == "PASS"
            and builder.status == "PASS"
            and manifest_status == "PASS"
        )
        else "FAIL"
    )

    statuses = {
        "registry": registry.status,
        "architecture": architecture.status,
        "builder": builder.status,
        "manifest_index": manifest_status,
        "engineering_gate": engineering_gate,
    }

    failures = [
        name
        for name, status in statuses.items()
        if status != "PASS"
    ]

    print("Wonderland Platform Status")
    print()

    for name in (
        "registry",
        "architecture",
        "builder",
        "manifest_index",
        "engineering_gate",
    ):
        print(f"{name}: {statuses[name]}")

    print()
    print(f"manifests: {manifest_count}")

    if manifest_detail:
        print(f"manifest_index_path: {manifest_detail}")

    if failures:
        print()

        for check in (
            registry,
            architecture,
            builder,
        ):
            if check.status == "PASS":
                continue

            print(
                f"{check.name}_error: "
                f"{check.error or 'unknown failure'}"
            )

            if check.stderr.strip():
                last_line = check.stderr.strip().splitlines()[-1]
                print(
                    f"{check.name}_stderr: {last_line}"
                )

        print()
        print(
            f"FAIL platform status: "
            f"{len(failures)} failure(s)"
        )
        print("RESULT FAIL")
        return 1

    print()
    print("PASS platform convergence")
    print("RESULT PASS")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
