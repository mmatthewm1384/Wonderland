#!/usr/bin/env bash
set -uo pipefail

WL_HOME="${WL_HOME:-$HOME/Wonderland}"
. "$WL_HOME/lib/wl-bootstrap.sh"

BASELINE_DIR="$WL_HOME/vault/08-Operations/baselines"
cmd="${1:-create}"

latest_baseline() {
  ls -t "$BASELINE_DIR"/wonderland-platform-baseline-*.json 2>/dev/null | head -1
}

create_baseline() {
  STAMP="$(date +%Y%m%d-%H%M%S)"
  BASELINE="$BASELINE_DIR/wonderland-platform-baseline-${STAMP}.json"

  mkdir -p "$BASELINE_DIR"

  verify_rc=0
  "$WL_HOME/bin/wl-verify" >/tmp/wl-baseline-verify.out 2>&1 || verify_rc=$?

  result="PASS"
  [[ "$verify_rc" -eq 0 ]] || result="FAIL"

  cat > "$BASELINE" <<JSON
{
  "schema": "wonderland.platform.baseline.v1",
  "timestamp": "$STAMP",
  "result": "$result",
  "context": $(wl_context_dump),
  "state": $(wl_state_dump),
  "capabilities": $(wl_capabilities_dump),
  "health": $(wl_health_dump),
  "release": "$WL_HOME/releases/stable/current.json",
  "docs": "$WL_HOME/vault/02-Documentation/generated/wonderland-command-reference.md"
}
JSON

  echo "BASELINE $BASELINE"
  echo "RESULT $result"
  exit "$verify_rc"
}

case "$cmd" in
  create|new)
    create_baseline
    ;;

  latest|path)
    latest="$(latest_baseline)"
    if [[ -n "$latest" ]]; then
      echo "$latest"
    else
      echo "FAIL no baseline found"
      echo "RESULT FAIL"
      exit 1
    fi
    ;;

  status)
    latest="$(latest_baseline)"

    if [[ -z "$latest" ]]; then
      echo "WARN no baseline found"
      echo "RESULT PASS"
      exit 0
    fi

    echo "Wonderland Baseline Status"
    echo
    echo "Latest: $latest"
    python3 -m json.tool "$latest"
    echo "RESULT PASS"
    ;;

  show)
    latest="$(latest_baseline)"

    if [[ -z "$latest" ]]; then
      echo "FAIL no baseline found"
      echo "RESULT FAIL"
      exit 1
    fi

    cat "$latest"
    ;;

  *)
    echo "Usage: wl baseline {create|latest|status|show}"
    echo "RESULT FAIL"
    exit 1
    ;;
esac
