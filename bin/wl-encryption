#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
POLICY="$ROOT/vault/security/encryption/policy.json"
REPORT="$ROOT/logs/security/encryption-report.json"

usage() {
  echo "Usage: wl encryption verify|report"
}

audit() {
  if [[ -x "$ROOT/bin/wl-audit" ]]; then
    "$ROOT/bin/wl-audit" log "$1" --status "$2" --message "${3:-}" >/dev/null 2>&1 || true
  fi
}

report() {
  python3 - "$ROOT" "$POLICY" "$REPORT" <<'PY'
import json
import shutil
import sys
from pathlib import Path
from datetime import datetime, timezone

root = Path(sys.argv[1])
policy_path = Path(sys.argv[2])
report_path = Path(sys.argv[3])

errors = []
warnings = []

if not policy_path.exists():
    raise SystemExit("FAIL: missing encryption policy")

policy = json.loads(policy_path.read_text())

if policy.get("component") != "wonderland-encryption":
    errors.append("invalid encryption component")

tools = []
for tool in policy.get("preferred_tools", []):
    found = shutil.which(tool)
    tools.append({
        "name": tool,
        "available": bool(found),
        "path": found
    })

if not any(t["available"] for t in tools):
    warnings.append("no preferred encryption tool found")

protected_paths = []
for rel in policy.get("protected_paths", []):
    path = root / rel
    protected_paths.append({
        "path": rel,
        "exists": path.exists()
    })
    if not path.exists():
        warnings.append(f"protected path missing: {rel}")

overall = "fail" if errors else "warn" if warnings else "pass"

out = {
    "component": "wonderland-encryption",
    "generated_at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
    "overall": overall,
    "mode": policy.get("mode"),
    "tools": tools,
    "protected_paths": protected_paths,
    "future_capabilities": policy.get("required_future_capabilities", []),
    "warnings": warnings,
    "errors": errors
}

report_path.parent.mkdir(parents=True, exist_ok=True)
report_path.write_text(json.dumps(out, indent=2) + "\n")
print(json.dumps(out, indent=2))

raise SystemExit(1 if errors else 0)
PY
}

case "${1:-}" in
  report)
    if report; then
      audit encryption.report pass "Encryption readiness report generated"
    else
      audit encryption.report fail "Encryption readiness report failed"
      exit 1
    fi
    ;;
  verify)
    if report >/dev/null; then
      echo "PASS: encryption readiness verified"
      audit encryption.verify pass "Encryption readiness verified"
    else
      echo "FAIL: encryption readiness verification failed"
      audit encryption.verify fail "Encryption readiness verification failed"
      exit 1
    fi
    ;;
  ""|help|--help|-h)
    usage
    ;;
  *)
    echo "FAIL: unknown encryption command: $1"
    exit 1
    ;;
esac
