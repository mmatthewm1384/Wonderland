#!/usr/bin/env bash
set -euo pipefail

ROOT="/Users/wonderland/Wonderland"
SECRETS="$ROOT/secrets"
OPS="$ROOT/vault/07-Operations/secrets"

case "${1:-inventory}" in

  inventory)

    mkdir -p "$OPS/inventory"

    find "$SECRETS" -type f \
      > "$OPS/inventory/secrets-inventory.txt"

    count="$(wc -l < "$OPS/inventory/secrets-inventory.txt")"

    echo "inventory: $count"
    echo "PASS"
  ;;

  doctor|verify)

    [[ -d "$SECRETS" ]]

    [[ -f "$OPS/inventory/secrets-inventory.txt" ]]

    echo "PASS secrets governance"
  ;;

  *)
    echo "Usage: wl-secrets inventory|doctor"
    exit 1
  ;;
esac
