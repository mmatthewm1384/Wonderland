#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
POLICY="$ROOT/vault/security/secrets-policy.json"
INDEX="$ROOT/vault/security/secrets/index.json"
STORE="$ROOT/vault/security/secrets/store.json"

usage() {
  cat <<'EOF'
Usage:
  wl secrets verify
  wl secrets list
  wl secrets report
EOF
}

audit() {
  local event="$1"
  local status="$2"
  local message="${3:-}"

  if [[ -x "$ROOT/bin/wl-audit" ]]; then
    "$ROOT/bin/wl-audit" log "$event" --status "$status" --message "$message" >/dev/null 2>&1 || true
  fi
}

verify() {
  python3 - "$POLICY" "$INDEX" <<'PY'
import json
import sys
from pathlib import Path

policy = Path(sys.argv[1])
index = Path(sys.argv[2])

errors = []

if not policy.exists():
    errors.append("missing secrets policy")

if not index.exists():
    errors.append("missing secrets index")

if not errors:
    pdata = json.loads(policy.read_text())
    idata = json.loads(index.read_text())

    if pdata.get("component") != "wonderland-secrets":
        errors.append("invalid policy component")

    if pdata.get("rules", {}).get("plaintext_storage") is not False:
        errors.append("plaintext_storage must be false")

    if idata.get("component") != "wonderland-secrets-index":
        errors.append("invalid index component")

    if not isinstance(idata.get("secrets"), list):
        errors.append("secrets index must contain a secrets list")

if errors:
    print("FAIL: secrets verification failed")
    for error in errors:
        print(error)
    raise SystemExit(1)

print("PASS: secrets subsystem valid")
PY
}

list_secrets() {
  python3 - "$INDEX" <<'PY'
import json
import sys
from pathlib import Path

index = Path(sys.argv[1])
data = json.loads(index.read_text())

secrets = data.get("secrets", [])
if not secrets:
    print("No secrets registered.")
else:
    for item in secrets:
        print(item.get("name", "<unnamed>"))
PY
}

report() {
  python3 - "$POLICY" "$INDEX" <<'PY'
import json
import sys
from pathlib import Path

policy = json.loads(Path(sys.argv[1]).read_text())
index = json.loads(Path(sys.argv[2]).read_text())

print(json.dumps({
  "component": "wonderland-secrets",
  "version": policy.get("version"),
  "mode": policy.get("mode"),
  "registered_secrets": len(index.get("secrets", [])),
  "plaintext_storage": policy.get("rules", {}).get("plaintext_storage")
}, indent=2))
PY
}

case "${1:-}" in
  verify)
    verify
    audit secrets.verify pass "Secrets subsystem verified"
    ;;
  list)
    list_secrets
    audit secrets.list info "Secrets index listed"
    ;;
  report)
    report
    audit secrets.report pass "Secrets report generated"
    ;;
  ""|help|--help|-h)
    usage
    ;;
  *)
    echo "FAIL: unknown secrets command: $1"
    usage
    exit 1
    ;;
esac
