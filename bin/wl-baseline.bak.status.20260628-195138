#!/usr/bin/env bash
set -uo pipefail

WL_HOME="${WL_HOME:-$HOME/Wonderland}"
. "$WL_HOME/lib/wl-bootstrap.sh"

BASELINE_DIR="$WL_HOME/vault/08-Operations/baselines"
STAMP="$(date +%Y%m%d-%H%M%S)"
BASELINE="$BASELINE_DIR/wonderland-platform-baseline-${STAMP}.json"

mkdir -p "$BASELINE_DIR"

verify_rc=0
"$WL_HOME/bin/wl-verify" >/tmp/wl-baseline-verify.out 2>&1 || verify_rc=$?

result="PASS"
[[ "$verify_rc" -eq 0 ]] || result="FAIL"

cat > "$BASELINE" <<JSON
{
  "schema": "wonderland.platform.baseline.v1",
  "timestamp": "$STAMP",
  "result": "$result",
  "context": $(wl_context_dump),
  "state": $(wl_state_dump),
  "capabilities": $(wl_capabilities_dump),
  "health": $(wl_health_dump),
  "release": "$WL_HOME/releases/stable/current.json",
  "docs": "$WL_HOME/vault/02-Documentation/generated/wonderland-command-reference.md"
}
JSON

echo "BASELINE $BASELINE"
echo "RESULT $result"
exit "$verify_rc"
