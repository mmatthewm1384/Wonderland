#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
POLICY="$ROOT/vault/security/permissions-policy.json"

usage() {
  cat <<'EOF'
Usage:
  wl-permissions verify
  wl-permissions report
EOF
}

verify() {
  python3 - "$POLICY" <<'PY'
import json
import sys
from pathlib import Path

policy = Path(sys.argv[1])

if not policy.exists():
    raise SystemExit("FAIL: missing permissions policy")

data = json.loads(policy.read_text())

errors = []

if data.get("component") != "wonderland-permissions":
    errors.append("component must be wonderland-permissions")

if data.get("mode") not in {"advisory", "enforcing"}:
    errors.append("mode must be advisory or enforcing")

seen = set()

for i, rule in enumerate(data.get("rules", []), start=1):
    rid = rule.get("id")
    if not rid:
        errors.append(f"rule {i}: missing id")
    elif rid in seen:
        errors.append(f"rule {i}: duplicate id {rid}")
    else:
        seen.add(rid)

    if not rule.get("resource"):
        errors.append(f"rule {i}: missing resource")

    if not isinstance(rule.get("actions"), list) or not rule["actions"]:
        errors.append(f"rule {i}: actions must be non-empty list")

    if not isinstance(rule.get("requires"), list):
        errors.append(f"rule {i}: requires must be list")

if errors:
    print("FAIL: permissions policy invalid")
    for error in errors:
        print(error)
    raise SystemExit(1)

print(f"PASS: permissions policy valid ({len(data.get('rules', []))} rules)")
PY
}

report() {
  python3 - "$POLICY" <<'PY'
import json
import sys
from pathlib import Path

policy = Path(sys.argv[1])
data = json.loads(policy.read_text())

print(json.dumps({
  "component": data.get("component"),
  "version": data.get("version"),
  "mode": data.get("mode"),
  "rules": len(data.get("rules", [])),
  "resources": sorted({r.get("resource") for r in data.get("rules", []) if r.get("resource")})
}, indent=2))
PY
}

case "${1:-}" in
  verify) verify ;;
  report) report ;;
  ""|help|--help|-h) usage ;;
  *)
    echo "FAIL: unknown permissions command: $1"
    usage
    exit 1
    ;;
esac
