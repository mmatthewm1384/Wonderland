#!/usr/bin/env bash
set -euo pipefail

WL_HOME="${WL_HOME:-$HOME/Wonderland}"
PLIST="$HOME/Library/LaunchAgents/com.wonderland.controller-api.plist"
LABEL="com.wonderland.controller-api"

install_agent() {
cat > "$PLIST" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
 "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>$LABEL</string>

  <key>ProgramArguments</key>
  <array>
    <string>$WL_HOME/bin/wl-api</string>
  </array>

  <key>WorkingDirectory</key>
  <string>$WL_HOME</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>WL_HOME</key>
    <string>$WL_HOME</string>
    <key>WL_API_HOST</key>
    <string>127.0.0.1</string>
    <key>WL_API_PORT</key>
    <string>9105</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>$WL_HOME/runtime/controller/api.launchd.out.log</string>

  <key>StandardErrorPath</key>
  <string>$WL_HOME/runtime/controller/api.launchd.err.log</string>
</dict>
</plist>
PLIST

  launchctl bootout "gui/$(id -u)" "$PLIST" >/dev/null 2>&1 || true
  launchctl bootstrap "gui/$(id -u)" "$PLIST"
  launchctl kickstart -k "gui/$(id -u)/$LABEL"

  echo "RESULT PASS installed $LABEL"
}

uninstall_agent() {
  launchctl bootout "gui/$(id -u)" "$PLIST" >/dev/null 2>&1 || true
  rm -f "$PLIST"
  echo "RESULT PASS uninstalled $LABEL"
}

status_agent() {
  echo "== launchd =="
  launchctl print "gui/$(id -u)/$LABEL" 2>/dev/null | grep -E 'state =|pid =|last exit code =' || true

  echo
  echo "== api =="
  curl -fsS http://127.0.0.1:9105/state | jq '.healthy, .runtime.running, .registry.service_count'
}

logs_agent() {
  echo "== stdout =="
  tail -80 "$WL_HOME/runtime/controller/api.launchd.out.log" 2>/dev/null || true
  echo
  echo "== stderr =="
  tail -80 "$WL_HOME/runtime/controller/api.launchd.err.log" 2>/dev/null || true
}

case "${1:-status}" in
  install) install_agent ;;
  uninstall) uninstall_agent ;;
  restart)
    launchctl kickstart -k "gui/$(id -u)/$LABEL"
    status_agent
    ;;
  status) status_agent ;;
  logs) logs_agent ;;
  *)
    echo "Usage: wl-api-agent install|uninstall|restart|status|logs"
    exit 2
    ;;
esac
