#!/usr/bin/env bash
set -euo pipefail

WL_ROOT="${WL_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
export WL_ROOT

usage() {
  cat <<'USAGE'
Usage:
  wl start
  wl stop
  wl restart
  wl verify
  wl doctor [module]
  wl runtime <command> [args...]
  wl services <command> [args...]
  wl rootless <command> [args...]
  wl builder <command> [args...]
  wl browser <command> [args...]
  wl academy <command> [args...]

Academy commands:
  quality
  verify
  certify
  inventory
  report
  review
  chapter verify
  chapter certify
  chapter build
  chapter package
  chapter publish

Examples:
  wl verify
  wl doctor academy
  wl academy quality
  wl academy verify
  wl academy certify
USAGE
}

cmd="${1:-help}"

case "$cmd" in
  knowledge-engine|wke)
    shift
    exec "$(cd "$(dirname "$0")" && pwd)/wlknowledge" "$@"
    ;;

  knowledge|know)
    shift
    exec "$(cd "$(dirname "$0")" && pwd)/wl-knowledge" "$@"
    ;;
  start)
    shift
    exec "$WL_ROOT/bin/wl-start" "$@"
    ;;

  stop)
    shift
    if [[ -x "$WL_ROOT/bin/wl-stop" ]]; then
      exec "$WL_ROOT/bin/wl-stop" "$@"
    fi
    echo "FAIL wl-stop missing" >&2
    exit 127
    ;;

  restart)
    shift
    "$WL_ROOT/bin/wl" stop "$@" || true
    exec "$WL_ROOT/bin/wl" start "$@"
    ;;

  verify)
    shift
    exec "$WL_ROOT/bin/wl-verify" "$@"
    ;;

  doctor)
    shift
    if [[ "${1:-}" == "academy" ]]; then
      shift
      WL_ROOT="$WL_ROOT" exec "$WL_ROOT/bin/wl-academy" verify "$@"
    fi
    exec "$WL_ROOT/bin/wl-doctor" "$@"
    ;;

  operator)
    shift
    exec python3 -m wl.operator "$@"
    ;;

  runtime)
    shift
    exec "$WL_ROOT/bin/wl-runtime" "$@"
    ;;

  services)
    shift
    exec "$WL_ROOT/bin/wl-services" "$@"
    ;;

  rootless)
    shift
    exec "$WL_ROOT/bin/wl-rootless" "$@"
    ;;

  builder)
    shift
    exec "$WL_ROOT/bin/wl-builder" "$@"
    ;;

  browser)
    shift
    exec "$WL_ROOT/bin/wl-browser" "$@"
    ;;

  academy)
    shift
    exec "$WL_ROOT/bin/wl-academy" "$@"
    ;;

  help|-h|--help)
    usage
    ;;

  *)
    echo "wl: unknown command: $cmd" >&2
    usage >&2
    exit 64
    ;;
esac
