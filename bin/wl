#!/usr/bin/env bash
set -euo pipefail
WL_ROOT="${WL_ROOT:-$HOME/Wonderland}"


# Platform Core 2.2 dispatch

# Platform Core 2.3 engineering dispatch

# Platform Core 2.3 maintenance dispatch


# Wonderland engineering dispatch
ROOT="${WL_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}"
if [[ -f "$ROOT/lib/core/dispatch/engineering.sh" ]]; then
  . "$ROOT/lib/core/dispatch/engineering.sh"
  if wl_engineering_dispatch "$@"; then
    exit 0
  elif [[ "$?" -ne 127 ]]; then
    exit $?
  fi
fi

case "${1:-}" in
    vm)
        shift
        exec "$WL_ROOT/bin/wl-vm" "$@"
        ;;
    build)
        shift
        exec "$WL_ROOT/bin/wl-build" "$@"
        ;;
    encryption)
        shift
        exec "$WL_ROOT/bin/wl-encryption" "$@"
        ;;
    certificates)
        shift
        exec "$WL_ROOT/bin/wl-certificates" "$@"
        ;;
    firewall)
        shift
        exec "$WL_ROOT/bin/wl-firewall" "$@"
        ;;
    integrity)
        shift
        exec "$WL_ROOT/bin/wl-integrity" "$@"
        ;;
    security)
        shift
        exec "$WL_ROOT/bin/wl-security" "$@"
        ;;
    identity)
        shift
        exec "$WL_ROOT/bin/wl-identity" "$@"
        ;;
    secrets)
        shift
        exec "$WL_ROOT/bin/wl-secrets" "$@"
        ;;
    permissions)
        shift
        exec "$WL_ROOT/bin/wl-permissions" "$@"
        ;;
    audit)
        shift
        exec "$WL_ROOT/bin/wl-audit" "$@"
        ;;
  root)
    shift || true
    exec "$WL_ROOT/bin/wl-root" "${1:-$PWD}"
    ;;
  cd)
    shift || true
    exec "$WL_ROOT/bin/wl-cd" "${1:-$PWD}"
    ;;

  academy)
    shift || true
    exec "$WL_ROOT/bin/wl-academy" "${@:-help}"
    ;;

    mirror)
        shift
        subcommand="${1:-help}"

        if [[ -x "$WL_ROOT/bin/wl-audit" ]]; then
            "$WL_ROOT/bin/wl-audit" log "mirror.${subcommand}.started" --status info --message "wl mirror ${subcommand} started" >/dev/null 2>&1 || true
        fi

        if "$WL_ROOT/bin/wl-mirror" "$@"; then
            rc=0
            if [[ -x "$WL_ROOT/bin/wl-audit" ]]; then
                "$WL_ROOT/bin/wl-audit" log "mirror.${subcommand}.completed" --status pass --message "wl mirror ${subcommand} completed" >/dev/null 2>&1 || true
            fi
        else
            rc=$?
            if [[ -x "$WL_ROOT/bin/wl-audit" ]]; then
                "$WL_ROOT/bin/wl-audit" log "mirror.${subcommand}.failed" --status fail --message "wl mirror ${subcommand} failed with exit code ${rc}" >/dev/null 2>&1 || true
            fi
        fi

        exit "$rc"
        ;;
  migrate)
    shift
    . "${WL_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}/lib/migrate/cli.sh"
    wl_migrate_main "$@"
    exit $?
    ;;
  refactor)
    shift
    . "${WL_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}/lib/refactor/cli.sh"
    wl_refactor_main "$@"
    exit $?
    ;;
esac

case "${1:-}" in
  mirror)
    shift
    exec "$WL_ROOT/bin/wl-mirror" "$@"
    ;;
  architecture)
    shift
    . "${WL_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}/lib/architecture/cli.sh"
    wl_architecture_main "$@"
    exit $?
    ;;
  inventory)
    shift
    . "${WL_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}/lib/inventory/cli.sh"
    wl_inventory_main "$@"
    exit $?
    ;;
  lint)
    shift
    . "${WL_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}/lib/lint/cli.sh"
    wl_lint_main "$@"
    exit $?
    ;;
esac

case "${1:-}" in
  mirror)
    shift
    exec "$WL_ROOT/bin/wl-mirror" "$@"
    ;;
  doctor)
    shift
    . "${WL_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}/lib/doctor/cli.sh"
    wl_doctor_main "$@"
    exit $?
    ;;
  registry)
    shift
    . "${WL_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}/lib/core/registry/command_registry_cli.sh"
    wl_registry_main "$@"
    exit $?
    ;;
esac

case "${1:-}" in
  mirror)
    shift
    exec "$WL_ROOT/bin/wl-mirror" "$@"
    ;;
  chaos)
    shift
    exec "${WL_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}/bin/wl-chaos" "$@"
    ;;
esac

WL_HOME="${WL_HOME:-$HOME/Wonderland}"
WL_BOOTSTRAP="$WL_HOME/lib/wl-bootstrap.sh"

if [[ ! -f "$WL_BOOTSTRAP" ]]; then
  echo "FAIL bootstrap missing: $WL_BOOTSTRAP"
  echo "RESULT FAIL"
  exit 1
fi

source "$WL_BOOTSTRAP"
wl_dispatch "$@"

# Mirror command: wl mirror status|verify|diff|update
