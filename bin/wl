#!/usr/bin/env bash
set -euo pipefail

ROOT="/Users/wonderland/Wonderland"

case "${1:-help}" in
  verify)
    exec "$ROOT/bin/wl-verify-core"
    ;;

  core)
    case "${2:-help}" in
      verify)
        exec "$ROOT/bin/wl-verify-core"
        ;;
      status)
        cat "$ROOT/vault/00-Core/manifests/vault-state.json"
        ;;
      path)
        echo "$ROOT/vault/00-Core"
        ;;
      *)
        echo "Usage:"
        echo "  wl core verify"
        echo "  wl core status"
        echo "  wl core path"
        ;;
    esac
    ;;

  status)
    echo "Wonderland root: $ROOT"
    echo "Core vault: $ROOT/vault/00-Core"
    "$ROOT/bin/wl-verify-core"
    ;;

  help|*)
    echo "Wonderland CLI"
    echo
    echo "Commands:"
    echo "  wl verify"
    echo "  wl status"
    echo "  wl core verify"
    echo "  wl core status"
    echo "  wl core path"
    ;;
esac
