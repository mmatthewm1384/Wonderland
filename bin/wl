#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

source "$ROOT/lib/core/bootstrap.sh"

usage() {
  cat <<'USAGE'
Usage:
  wl builder <command> [args...]

Examples:
  wl builder status
  wl builder doctor
  wl builder build --profile development
  wl builder verify
USAGE
}

cmd="${1:-}"

case "$cmd" in
  builder)
    shift
    exec "$WL_ROOT/lib/builder/launcher.sh" "$@"
    ;;
  ""|-h|--help|help)
    usage
    ;;
  *)
    echo "wl: unknown command: $cmd" >&2
    usage >&2
    exit 2
    ;;
esac
