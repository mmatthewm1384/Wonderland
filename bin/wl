
wl_builder_python() {
  local root="$WL_ROOT"
  local venv="$root/.venv"
  local python_bin="$venv/bin/python"

  if [ ! -x "$python_bin" ]; then
    echo "wl: creating Python environment: $venv" >&2
    python3 -m venv "$venv"
  fi

  "$python_bin" -m pip install --upgrade pip setuptools wheel >/dev/null
  "$python_bin" -m pip install -e "$root/builder" >/dev/null

  export WONDERLAND_BUILD_ROOT="${WONDERLAND_BUILD_ROOT:-$HOME/Wonderland-Builds}"
  mkdir -p "$WONDERLAND_BUILD_ROOT"

  "$python_bin" -m wlbuilder "$@"
}

#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export PATH="$ROOT/bin:$PATH"

usage() {
  cat <<'EOF'
Wonderland CLI

Usage:
  wl <subsystem> [command] [args...]

Examples:
  wl builder build --profile development
  wl builder doctor
  wl release publish
  wl vm ssh
EOF
}

if [[ $# -eq 0 || "${1:-}" == "help" || "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

if [[ "${1:-}" == "list" ]]; then
  echo "Wonderland subsystems:"
  find "$ROOT/bin" -maxdepth 1 -type f -name 'wl-*' -perm -111     | sed "s#^$ROOT/bin/wl-#  #"     | sort
  exit 0
fi

subsystem="$1"
shift

tool="$ROOT/bin/wl-$subsystem"

if [[ ! -x "$tool" ]]; then
  echo "FAIL: unknown subsystem: $subsystem" >&2
  echo "Expected executable: $tool" >&2
  exit 1
fi

exec "$tool" "$@"


case "${1:-}" in
  builder)
    shift
    wl_builder_python "$@"
    exit $?
    ;;
esac
