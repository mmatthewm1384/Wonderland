#!/usr/bin/env bash
set -euo pipefail

WONDERLAND_ROOT="${WONDERLAND_ROOT:-${WL_HOME:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}}"
export WONDERLAND_ROOT

usage() {
  cat <<USAGE
Usage:
  wl start
  wl runtime verify
  wl runtime status
  wl builder <command> [args...]

Examples:
  wl start
  wl runtime verify
  wl runtime status
  wl builder status
  wl builder doctor
  wl builder build --profile development
  wl builder verify
USAGE
}

cmd="${1:-}"

case "$cmd" in
  start)
    shift
    exec "$WONDERLAND_ROOT/bin/wl-start" "$@"
    ;;

  runtime)
    shift
    case "${1:-}" in
      verify)
        shift
        export PYTHONPATH="$WONDERLAND_ROOT:${PYTHONPATH:-}"
        exec python3 -m wl.runtime.verify "$@"
        ;;
      status)
        shift
        export PYTHONPATH="$WONDERLAND_ROOT:${PYTHONPATH:-}"
        exec python3 -m wl.runtime.show_status "$@"
        ;;
      *)
        echo "wl: unknown runtime command: ${1:-}" >&2
        usage >&2
        exit 64
        ;;
    esac
    ;;

  builder)
    shift
    exec "$WONDERLAND_ROOT/bin/wl-builder" "$@"
    ;;

  ""|help|--help|-h)
    usage
    ;;

  *)
    echo "wl: unknown command: $cmd" >&2
    usage >&2
    exit 64
    ;;
esac
