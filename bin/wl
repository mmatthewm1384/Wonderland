#!/usr/bin/env bash
set -euo pipefail

WONDERLAND_ROOT="${WONDERLAND_ROOT:-${WL_HOME:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}}"
export WONDERLAND_ROOT
export PYTHONPATH="$WONDERLAND_ROOT:${PYTHONPATH:-}"

usage() {
  cat <<USAGE
Usage:
  wl start
  wl verify
  wl doctor
  wl runtime <command> [args...]
  wl builder <command> [args...]

Runtime commands:
  verify
  doctor
  clean
  status
  report
  theme

Examples:
  wl start
  wl verify
  wl doctor
  wl runtime report
  wl builder status
USAGE
}

cmd="${1:-}"

case "$cmd" in
  start)
    shift
    exec "$WONDERLAND_ROOT/bin/wl-start" "$@"
    ;;

  verify)
    shift
    exec python3 -m wl.runtime.verify "$@"
    ;;

  doctor)
    shift
    exec python3 -m wl.runtime.doctor "$@"
    ;;

  runtime)
    shift
    subcmd="${1:-}"
    case "$subcmd" in
      verify|doctor|clean|theme)
        shift
        exec python3 -m "wl.runtime.${subcmd}" "$@"
        ;;
      status)
        shift
        exec python3 -m wl.runtime.show_status "$@"
        ;;
      report)
        shift
        exec python3 -m wl.runtime.report "$@"
        ;;
      ""|help|--help|-h)
        usage
        ;;
      *)
        echo "wl: unknown runtime command: $subcmd" >&2
        usage >&2
        exit 64
        ;;
    esac
    ;;

  builder)
    shift
    exec "$WONDERLAND_ROOT/bin/wl-builder" "$@"
    ;;

  ""|help|--help|-h)
    usage
    ;;

  *)
    echo "wl: unknown command: $cmd" >&2
    usage >&2
    exit 64
    ;;
esac
