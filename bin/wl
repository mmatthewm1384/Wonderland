#!/usr/bin/env bash
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$ROOT"

usage() {
  cat <<'EOF'
Wonderland CLI

Usage:
  wl builder <command> [args...]

Builder commands:
  wl builder verify
  wl builder doctor
  wl builder certify
  wl builder build --profile development
  wl builder status
  wl builder shell
  wl builder start
  wl builder stop
  wl builder restart
  wl builder logs
  wl builder root

General:
  wl help
EOF
}

command="${1:-help}"

case "$command" in
  help|-h|--help)
    usage
    ;;

  builder)
    shift
    exec "$ROOT/bin/wl-builder" "$@"
    ;;

  *)
    echo "FAIL: unknown wl command: $command" >&2
    echo >&2
    usage >&2
    exit 1
    ;;
esac
