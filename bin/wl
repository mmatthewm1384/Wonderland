#!/usr/bin/env bash
set -euo pipefail

ROOT="/Users/wonderland/Wonderland"

usage() {
  cat <<USAGE
Wonderland CLI

Commands:
  wl verify
  wl status

  wl core verify
  wl core status
  wl core path

  wl templates verify
  wl templates path
USAGE
}

case "${1:-help}" in
  verify)
    "$ROOT/bin/wl-verify-core"
    "$ROOT/bin/wl-verify-templates"
    ;;

  status)
    echo "Wonderland root: $ROOT"
    echo "Core vault: $ROOT/vault/00-Core"
    echo "Templates: $ROOT/vault/01-Templates"
    "$ROOT/bin/wl-verify-core"
    "$ROOT/bin/wl-verify-templates"
    ;;

  core)
    case "${2:-help}" in
      verify)
        exec "$ROOT/bin/wl-verify-core"
        ;;
      status)
        cat "$ROOT/vault/00-Core/manifests/vault-state.json"
        ;;
      path)
        echo "$ROOT/vault/00-Core"
        ;;
      *)
        usage
        ;;
    esac
    ;;

  templates)
    case "${2:-help}" in
      verify)
        exec "$ROOT/bin/wl-verify-templates"
        ;;
      path)
        echo "$ROOT/vault/01-Templates"
        ;;
      *)
        usage
        ;;
    esac
    ;;

  help|*)
    usage
    ;;
esac
