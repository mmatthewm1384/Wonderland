#!/usr/bin/env python3
import argparse
import json
from datetime import datetime, timezone
from pathlib import Path

ROOT = Path.home() / "Wonderland"
SCHEDULE = ROOT / "vault/chaos/escalation-schedule.json"

PROFILES = {
    "hourly": [
        {"mode": "nudge", "risk": 1, "after_hours": 0},
        {"mode": "drift", "risk": 2, "after_hours": 1},
        {"mode": "storm", "risk": 3, "after_hours": 2},
        {"mode": "blackout", "risk": 4, "after_hours": 3},
        {"mode": "cataclysm", "risk": 5, "after_hours": 4},
    ],
    "exponential": [
        {"mode": "nudge", "risk": 1, "after_hours": 0},
        {"mode": "drift", "risk": 2, "after_hours": 1},
        {"mode": "storm", "risk": 3, "after_hours": 2},
        {"mode": "blackout", "risk": 4, "after_hours": 4},
        {"mode": "cataclysm", "risk": 5, "after_hours": 8},
    ],
}

def now():
    return datetime.now(timezone.utc).isoformat()

def write_schedule(strategy: str, hold_hours: float):
    if strategy not in PROFILES:
        raise SystemExit(f"FAIL unknown strategy: {strategy}")

    doc = {
        "schema": "wonderland.chaos.escalation.v1",
        "enabled": True,
        "started_at": now(),
        "initial_hold_hours": hold_hours,
        "strategy": strategy,
        "cataclysm_requires_manual_approval": True,
        "levels": PROFILES[strategy],
    }

    SCHEDULE.parent.mkdir(parents=True, exist_ok=True)
    tmp = SCHEDULE.with_suffix(".json.tmp")
    tmp.write_text(json.dumps(doc, indent=2, sort_keys=True) + "\n")
    tmp.replace(SCHEDULE)

    print(f"PASS chaos schedule started")
    print(f"strategy={strategy}")
    print(f"initial_hold_hours={hold_hours}")
    print(f"path={SCHEDULE}")

def status():
    if not SCHEDULE.exists():
        print("FAIL no chaos schedule")
        return 1

    doc = json.loads(SCHEDULE.read_text())
    print(json.dumps(doc, indent=2, sort_keys=True))
    return 0

def stop():
    if not SCHEDULE.exists():
        print("PASS no chaos schedule present")
        return 0

    doc = json.loads(SCHEDULE.read_text())
    doc["enabled"] = False
    doc["stopped_at"] = now()

    tmp = SCHEDULE.with_suffix(".json.tmp")
    tmp.write_text(json.dumps(doc, indent=2, sort_keys=True) + "\n")
    tmp.replace(SCHEDULE)

    print("PASS chaos schedule stopped")
    return 0

def main():
    parser = argparse.ArgumentParser()
    sub = parser.add_subparsers(dest="cmd", required=True)

    start = sub.add_parser("start")
    start.add_argument("--strategy", choices=sorted(PROFILES), default="exponential")
    start.add_argument("--hold-hours", type=float, default=6.0)

    sub.add_parser("status")
    sub.add_parser("stop")
    sub.add_parser("pause")
    sub.add_parser("resume")

    args = parser.parse_args()

    if args.cmd == "start":
        write_schedule(args.strategy, args.hold_hours)
    elif args.cmd == "status":
        return status()
    elif args.cmd == "stop":
        return stop()
    elif args.cmd == "pause":
        return stop()
    elif args.cmd == "resume":
        if not SCHEDULE.exists():
            print("FAIL no chaos schedule present")
            return 1
        doc = json.loads(SCHEDULE.read_text())
        doc["enabled"] = True
        doc["resumed_at"] = now()
        tmp = SCHEDULE.with_suffix(".json.tmp")
        tmp.write_text(json.dumps(doc, indent=2, sort_keys=True) + "\n")
        tmp.replace(SCHEDULE)
        print("PASS chaos schedule resumed")
        return 0

if __name__ == "__main__":
    raise SystemExit(main() or 0)
