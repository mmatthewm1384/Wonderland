#!/usr/bin/env bash
set -euo pipefail

WL_HOME="${WL_HOME:-$HOME/Wonderland}"

model="$(jq -r '.model // "unknown"' "$WL_HOME/vault/chaos/foundation-model.json" 2>/dev/null || echo unknown)"
title="$(python3 - "$model" <<'PY'
import sys
m=sys.argv[1]
print(" ".join(part.capitalize() for part in m.split("-")))
PY
)"

env_status="$(jq -r '.status // "unknown"' "$WL_HOME/vault/chaos/environment-state.json" 2>/dev/null || echo unknown)"
lease_mode="$(jq -r '.mode // "none"' "$WL_HOME/vault/05-Registry/chaos/lease.json" 2>/dev/null || echo none)"
fingerprint="$(jq -r '.authority.fingerprint_verified // false' "$WL_HOME/vault/chaos/foundation-model.json" 2>/dev/null || echo false)"

jq -n \
  --arg current "$title" \
  --arg model "$model" \
  --arg env_status "$env_status" \
  --arg lease_mode "$lease_mode" \
  --arg fingerprint "$fingerprint" \
  '{
    schema: "wonderland.chaos.menubar.status.v1",
    current: $current,
    model: $model,
    environment_status: $env_status,
    lease_mode: $lease_mode,
    fingerprint_verified: ($fingerprint == "true")
  }'
