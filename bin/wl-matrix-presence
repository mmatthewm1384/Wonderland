#!/usr/bin/env bash
set -euo pipefail

ROOT="$HOME/Wonderland"
PRESENCE="$ROOT/.wl/state/the-matrix/presence.json"

case "${1:-show}" in
  show|status)
    test -f "$PRESENCE" || { echo "FAIL missing presence"; exit 1; }
    jq . "$PRESENCE"
    ;;

  reset)
    mkdir -p "$(dirname "$PRESENCE")"
    cat > "$PRESENCE" <<JSON
{
  "suite": "THE∅MATRIX",
  "updated_at": "$(date -u +%Y%m%dT%H%M%SZ)",
  "active_realm": "unknown",
  "entities": {
    "watchers": 4,
    "ghost_fragments": 28,
    "swarm_density": 76,
    "matrix_energy": 90,
    "wave_tension": 1.3
  },
  "modes": {
    "focus": "Wonderland",
    "ambient": "Wonderland",
    "energy": "Wonderland",
    "emergence": "Wonderland"
  }
}
JSON
    echo "PASS reset THE∅MATRIX presence"
    ;;

  set-realm)
    realm="${2:?realm required}"
    tmp="$(mktemp)"
    jq --arg realm "$realm" --arg ts "$(date -u +%Y%m%dT%H%M%SZ)" \
      '.active_realm=$realm | .updated_at=$ts' "$PRESENCE" > "$tmp"
    mv "$tmp" "$PRESENCE"
    echo "PASS active_realm=$realm"
    ;;

  set-mode)
    realm="${2:?realm required}"
    mode="${3:?mode required}"
    tmp="$(mktemp)"
    jq --arg realm "$realm" --arg mode "$mode" --arg ts "$(date -u +%Y%m%dT%H%M%SZ)" \
      '.modes[$realm]=$mode | .updated_at=$ts' "$PRESENCE" > "$tmp"
    mv "$tmp" "$PRESENCE"
    echo "PASS mode $realm=$mode"
    ;;

  mode)
    realm="${2:?realm required}"
    jq -r --arg realm "$realm" '.modes[$realm]' "$PRESENCE"
    ;;

  *)
    echo "usage: wl-matrix-presence {show|status|reset|set-realm <name>|set-mode <realm> <mode>|mode <realm>}"
    exit 2
    ;;
esac
