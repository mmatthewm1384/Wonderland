#!/usr/bin/env bash
set -euo pipefail

ROOT="$HOME/Wonderland"
PRESENCE="$ROOT/.wl/state/the-matrix/presence.json"

case "${1:-show}" in
  show|status)
    test -f "$PRESENCE" || { echo "FAIL missing presence"; exit 1; }
    jq . "$PRESENCE"
    ;;

  summary)
    test -f "$PRESENCE" || { echo "FAIL missing presence"; exit 1; }

    echo "THE∅MATRIX Presence"
    echo "active_realm=$(jq -r .active_realm "$PRESENCE")"
    echo "focus=$(jq -r .modes.focus "$PRESENCE")"
    echo "ambient=$(jq -r .modes.ambient "$PRESENCE")"
    echo "energy=$(jq -r .modes.energy "$PRESENCE")"
    echo "emergence=$(jq -r .modes.emergence "$PRESENCE")"
    ;;

  reset)
    mkdir -p "$(dirname "$PRESENCE")"
    cat > "$PRESENCE" <<JSON
{
  "suite": "THE∅MATRIX",
  "updated_at": "$(date -u +%Y%m%dT%H%M%SZ)",
  "active_realm": "unknown",
  "entities": {
    "watchers": 4,
    "ghost_fragments": 28,
    "swarm_density": 76,
    "matrix_energy": 90,
    "wave_tension": 1.3
  },
  "modes": {
    "focus": "Wonderland",
    "ambient": "Wonderland",
    "energy": "Wonderland",
    "emergence": "Wonderland"
  }
}
JSON
    echo "PASS reset THE∅MATRIX presence"
    ;;

  watcher)
    action="${2:-show}"

    case "$action" in
      show)
        jq .watcher_state "$PRESENCE"
        ;;

      reset)
        tmp="$(mktemp)"
        jq --arg ts "$(date -u +%Y%m%dT%H%M%SZ)" '
          .watcher_state = {
            "population": 12,
            "attention": 0.0,
            "interest": 0.0,
            "false_positive_rate": 0.006
          }
          | .updated_at=$ts
        ' "$PRESENCE" > "$tmp"
        mv "$tmp" "$PRESENCE"
        echo "PASS watcher reset"
        ;;

      set)
        key="${3:?key required}"
        value="${4:?value required}"

        case "$key" in
          population|attention|interest|false_positive_rate)
            tmp="$(mktemp)"
            jq --arg key "$key" --argjson value "$value" --arg ts "$(date -u +%Y%m%dT%H%M%SZ)" '
              .watcher_state[$key]=$value
              | .updated_at=$ts
            ' "$PRESENCE" > "$tmp"
            mv "$tmp" "$PRESENCE"
            echo "PASS watcher $key=$value"
            ;;
          *)
            echo "FAIL invalid watcher key: $key"
            echo "valid: population attention interest false_positive_rate"
            exit 2
            ;;
        esac
        ;;

      *)
        echo "usage: wl-matrix-presence watcher {show|reset|set <population|attention|interest|false_positive_rate> <number>}"
        exit 2
        ;;
    esac
    ;;

  set-realm)
    realm="${2:?realm required}"
    tmp="$(mktemp)"
    jq --arg realm "$realm" --arg ts "$(date -u +%Y%m%dT%H%M%SZ)" \
      '.active_realm=$realm | .updated_at=$ts' "$PRESENCE" > "$tmp"
    mv "$tmp" "$PRESENCE"
    echo "PASS active_realm=$realm"
    ;;

  set-mode)
    realm="${2:?realm required}"
    mode="${3:?mode required}"
    tmp="$(mktemp)"
    jq --arg realm "$realm" --arg mode "$mode" --arg ts "$(date -u +%Y%m%dT%H%M%SZ)" \
      '.modes[$realm]=$mode | .updated_at=$ts' "$PRESENCE" > "$tmp"
    mv "$tmp" "$PRESENCE"
    echo "PASS mode $realm=$mode"
    ;;

  mode)
    realm="${2:?realm required}"
    jq -r --arg realm "$realm" '.modes[$realm]' "$PRESENCE"
    ;;

  *)
    echo "usage: wl-matrix-presence {show|status|summary|reset|watcher {show|reset|set}|set-realm <name>|set-mode <realm> <mode>|mode <realm>}"
    exit 2
    ;;
esac
