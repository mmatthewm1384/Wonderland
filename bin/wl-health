#!/usr/bin/env bash
set -euo pipefail

ROOT="/Users/wonderland/Wonderland"
FAIL=0

check() {
  local label="$1"
  shift

  if "$@" >/dev/null 2>&1; then
    printf "%-22s PASS\n" "$label"
  else
    printf "%-22s FAIL\n" "$label"
    FAIL=1
  fi
}

echo
echo "Wonderland Health"
echo

check "Vault Verify" "$ROOT/bin/wl" verify
check "Registry Integrity" "$ROOT/bin/wl" registry integrity
check "Runtime Drift" "$ROOT/bin/wl" runtime drift
check "Runtime Inventory" "$ROOT/bin/wl" runtime inventory
check "Recovery Drill" "$ROOT/bin/wl-verify-recovery-drill"
check "Anon Route" "$ROOT/bin/wl" anon doctor

echo

if [[ "$FAIL" -eq 0 ]]; then
  echo "RESULT PASS"
else
  echo "RESULT FAIL"
  exit 1
fi
