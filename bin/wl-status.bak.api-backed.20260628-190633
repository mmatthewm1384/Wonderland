#!/usr/bin/env bash
set -uo pipefail

WL_HOME="${WL_HOME:-$HOME/Wonderland}"
. "$WL_HOME/lib/wl-bootstrap.sh"

json=0
case "${1:-}" in
  --json|json)
    json=1
    ;;
esac

runtime_state="down"
t7_state="detached"
media_state="unavailable"
torrent_state="unavailable"
result="PASS"
rc=0

wl_runtime_running && runtime_state="running" || { result="FAIL"; rc=1; }
wl_storage_t7_attached && t7_state="attached"
wl_capability_available media && media_state="available"
wl_capability_available torrent && torrent_state="available"

if (( json == 1 )); then
  cat <<JSON
{
  "result": "$result",
  "root": "$WL_HOME",
  "mode": "${WL_MODE:-light}",
  "profile": "${WL_PROFILE:-internal-light}",
  "version": "${WL_VERSION:-0.0.0}",
  "build": "${WL_BUILD:-unknown}",
  "runtime": {
    "instance": "$WL_RUNTIME_INSTANCE",
    "state": "$runtime_state"
  },
  "storage": {
    "t7_path": "$WL_T7_PATH",
    "t7_state": "$t7_state"
  },
  "capabilities": {
    "media": "$media_state",
    "torrent": "$torrent_state"
  }
}
JSON
  exit "$rc"
fi

echo "Wonderland Status"
echo
echo "Root:    $WL_HOME"
echo "Mode:    ${WL_MODE:-light}"
echo "Profile: ${WL_PROFILE:-internal-light}"
echo "Version: ${WL_VERSION:-0.0.0}"
echo "Build:   ${WL_BUILD:-unknown}"

wl_section "Runtime"
[[ "$runtime_state" == "running" ]] && wl_pass "$WL_RUNTIME_INSTANCE" "running" || wl_fail "$WL_RUNTIME_INSTANCE" "not running"

wl_section "Storage"
[[ "$t7_state" == "attached" ]] && wl_pass "t7" "$WL_T7_PATH" || wl_warn "t7" "detached"

wl_section "Capabilities"
[[ "$media_state" == "available" ]] && wl_pass "media" "available" || wl_warn "media" "unavailable"
[[ "$torrent_state" == "available" ]] && wl_pass "torrent" "available" || wl_warn "torrent" "unavailable"

wl_exit
