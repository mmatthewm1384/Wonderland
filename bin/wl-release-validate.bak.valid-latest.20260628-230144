#!/usr/bin/env bash
set -uo pipefail

WL_HOME="${WL_HOME:-$HOME/Wonderland}"
. "$WL_HOME/lib/wl-bootstrap.sh"

target="${1:-latest}"

case "$target" in
  latest)
    file="$(ls -t "$WL_HOME"/releases/builds/release-*.json 2>/dev/null | head -1)"
    ;;
  stable)
    file="$WL_HOME/releases/stable/current.json"
    ;;
  *)
    file="$target"
    ;;
esac

if [[ -z "${file:-}" || ! -f "$file" ]]; then
  echo "FAIL release missing: ${file:-$target}"
  echo "RESULT FAIL"
  exit 1
fi

if python3 -m json.tool "$file" >/dev/null 2>&1; then
  echo "PASS release json $file"
  echo "RESULT PASS"
  exit 0
else
  echo "FAIL release json $file"
  echo "RESULT FAIL"
  exit 1
fi
