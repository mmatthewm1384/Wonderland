#!/usr/bin/env bash
set -euo pipefail

ROOT="/Users/wonderland/Wonderland"
INTENTS="$ROOT/vault/05-Registry/intents"

echo
echo "Wonderland Intent Verification"
echo "root: $INTENTS"
echo

mkdir -p "$INTENTS"

python3 - "$INTENTS" <<'PY'
import json
import pathlib
import sys

root = pathlib.Path(sys.argv[1])
failures = []

required = {"id", "intent", "status", "created", "operator", "rollback"}
allowed = {"draft", "approved", "rejected", "executed", "archived"}

files = sorted(root.glob("*.intent.json"))

for path in files:
    print(f"OK      {path.name}")

    try:
        data = json.loads(path.read_text())
    except Exception as exc:
        failures.append(f"invalid json {path.name}: {exc}")
        continue

    missing = required - set(data.keys())
    if missing:
        failures.append(f"missing fields in {path.name}: {sorted(missing)}")

    if data.get("status") not in allowed:
        failures.append(f"invalid status in {path.name}: {data.get('status')}")

if failures:
    print()
    for failure in failures:
        print(f"FAIL    {failure}")
    print()
    print("RESULT  FAIL")
    sys.exit(1)

print()
print("RESULT  PASS")
PY
