#!/usr/bin/env bash
set -euo pipefail
WORKSPACE_ROOT="/Users/wonderland/Wonderland"
SESSION_ID="disposable_$(date +%s)"
TARGET_DIR="$WORKSPACE_ROOT/data/$SESSION_ID"
echo "[PRE-FLIGHT] Forcing Obsidian governance sync..."
if [ -x "$WORKSPACE_ROOT/bin/wl-governance" ]; then "$WORKSPACE_ROOT/bin/wl-governance"; fi
echo "[INIT] Carving isolated session folder: $SESSION_ID"
mkdir -p "$TARGET_DIR"
nerdctl run -it --rm -v "$TARGET_DIR:/workspace" -w /workspace alpine:latest sh -c "echo '=== Ephemeral Space Active ==='; sh"
rm -rf "$TARGET_DIR"
echo "[SUCCESS] Session destroyed."
