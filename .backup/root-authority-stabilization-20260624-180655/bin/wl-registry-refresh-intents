#!/usr/bin/env bash
set -euo pipefail

ROOT="/Users/wonderland/Wonderland"
INTENTS="$ROOT/vault/05-Registry/intents"
OUT="$ROOT/vault/05-Registry/intents.json"

mkdir -p "$INTENTS"

python3 - "$INTENTS" "$OUT" <<'PY'
import json
import pathlib
import sys

intents_dir = pathlib.Path(sys.argv[1])
out = pathlib.Path(sys.argv[2])

items = []

for path in sorted(intents_dir.glob("*.intent.json")):
    try:
        data = json.loads(path.read_text())
    except Exception:
        continue

    items.append({
        "id": data.get("id", path.stem),
        "path": str(path.relative_to(out.parent)),
        "status": data.get("status", "unknown"),
        "intent": data.get("intent", ""),
        "created": data.get("created", "")
    })

payload = {
    "id": "intents-registry-v4",
    "version": 4,
    "intents": items
}

out.write_text(json.dumps(payload, indent=2) + "\n")

print(f"intents refreshed: {len(items)}")
PY
