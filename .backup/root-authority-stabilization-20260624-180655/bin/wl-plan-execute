#!/usr/bin/env bash
set -euo pipefail

ROOT="/Users/wonderland/Wonderland"
PLANS="$ROOT/vault/05-Registry/plans"
EXEC_DIR="$ROOT/vault/05-Registry/executions"
ID="${1:-}"

if [[ -z "$ID" ]]; then
  echo "Usage: wl-plan-execute <plan-id-or-file>"
  exit 1
fi

mkdir -p "$EXEC_DIR"

python3 - "$ROOT" "$PLANS" "$EXEC_DIR" "$ID" <<'PY'
import json, pathlib, sys, datetime

root = pathlib.Path(sys.argv[1])
plans = pathlib.Path(sys.argv[2])
exec_dir = pathlib.Path(sys.argv[3])
target = sys.argv[4]

matches = []
p = pathlib.Path(target)

if p.exists():
    matches = [p]
else:
    for f in plans.glob("*.plan.json"):
        data = json.loads(f.read_text())
        if data.get("id") == target or f.name == target:
            matches.append(f)

if not matches:
    print(f"FAIL plan not found: {target}")
    sys.exit(1)

if len(matches) > 1:
    print(f"FAIL multiple plans matched: {target}")
    sys.exit(1)

plan_path = matches[0]
plan = json.loads(plan_path.read_text())

if plan.get("status") != "approved":
    print(f"FAIL plan must be approved before execution: {plan.get('status')}")
    sys.exit(1)

execution = {
    "id": f"execution-{plan['id']}",
    "version": 4,
    "created": datetime.datetime.now().isoformat(timespec="seconds"),
    "plan_id": plan["id"],
    "status": "executed",
    "actions": [
        "verified approved plan",
        "created execution record",
        "no runtime mutation performed"
    ],
    "rollback": plan.get("rollback", "")
}

out = exec_dir / f"{execution['id']}.execution.json"
out.write_text(json.dumps(execution, indent=2) + "\n")

plan["status"] = "executed"
plan_path.write_text(json.dumps(plan, indent=2) + "\n")

print(f"execution: {out}")
print(f"plan updated: {plan_path}")
PY

"$ROOT/bin/wl-verify-plans"
