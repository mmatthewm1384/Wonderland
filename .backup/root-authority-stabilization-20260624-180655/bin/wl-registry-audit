#!/usr/bin/env bash
set -euo pipefail

ROOT="/Users/wonderland/Wonderland"

"$ROOT/bin/wl-registry-refresh"

"$ROOT/bin/wl-verify-registry"

echo
echo "Registry Summary"
echo

python3 - <<'PY'
import json
from pathlib import Path

root = Path("/Users/wonderland/Wonderland/vault/05-Registry")

for name in [
    "documents",
    "commands",
    "services",
    "operators",
    "assets",
    "intents"
]:
    p = root / f"{name}.json"

    if not p.exists():
        continue

    data = json.loads(p.read_text())

    items = data.get(name, [])

    print(f"{name:12} {len(items)}")
PY
