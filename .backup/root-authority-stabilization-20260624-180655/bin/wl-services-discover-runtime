#!/usr/bin/env bash
set -euo pipefail

ROOT="/Users/wonderland/Wonderland"
OUT_DIR="$ROOT/vault/06-Services/definitions"
REGISTRY="$ROOT/vault/06-Services/service-registry.json"
RUNTIME_REPORT="$ROOT/vault/06-Services/runtime/runtime-containers.json"

mkdir -p "$OUT_DIR" "$(dirname "$RUNTIME_REPORT")"

python3 - "$ROOT" "$OUT_DIR" "$REGISTRY" "$RUNTIME_REPORT" <<'PY'
import json
import pathlib
import subprocess
import sys

root = pathlib.Path(sys.argv[1])
out_dir = pathlib.Path(sys.argv[2])
registry_path = pathlib.Path(sys.argv[3])
runtime_report = pathlib.Path(sys.argv[4])

result = subprocess.run(
    ["nerdctl", "ps", "-a", "--format", "{{.Names}}"],
    stdout=subprocess.PIPE,
    stderr=subprocess.STDOUT,
    text=True
)

if result.returncode != 0:
    print(result.stdout)
    sys.exit(result.returncode)

names = [x.strip() for x in result.stdout.splitlines() if x.strip()]
managed = [x for x in names if x.startswith("wl-")]
unmanaged = [x for x in names if not x.startswith("wl-")]

services = []

dependency_defaults = {
    "wl-grafana": ["wl-prometheus", "wl-loki"],
    "wl-prometheus": [],
    "wl-loki": [],
    "wl-nats": [],
    "wl-dns": []
}

for name in sorted(managed):
    definition = {
        "id": f"{name}-service-v4",
        "name": name,
        "status": "active",
        "version": 4,
        "runtime": "containerd",
        "engine": "nerdctl",
        "container": name,
        "compose": None,
        "verify": f"wl runtime inspect {name}",
        "recover": f"wl services recover {name}",
        "rollback": f"wl services rollback {name}",
        "dependencies": dependency_defaults.get(name, []),
        "ports": [],
        "volumes": []
    }

    path = out_dir / f"{name}.service.json"
    path.write_text(json.dumps(definition, indent=2) + "\n")

    services.append({
        "id": definition["id"],
        "name": name,
        "path": str(path.relative_to(root / "vault" / "06-Services")),
        "runtime": "containerd",
        "engine": "nerdctl",
        "container": name,
        "status": "active"
    })

registry_path.write_text(json.dumps({
    "id": "service-registry-v4",
    "version": 4,
    "services": services
}, indent=2) + "\n")

runtime_report.write_text(json.dumps({
    "id": "runtime-containers-v4",
    "version": 4,
    "engine": "nerdctl",
    "managed": managed,
    "unmanaged": unmanaged
}, indent=2) + "\n")

print(f"managed: {len(managed)}")
print(f"unmanaged: {len(unmanaged)}")
for x in managed:
    print(f"OK managed {x}")
for x in unmanaged:
    print(f"NOTE unmanaged {x}")
PY
