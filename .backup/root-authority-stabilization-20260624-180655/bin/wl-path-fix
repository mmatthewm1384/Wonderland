#!/usr/bin/env bash
set -euo pipefail

ZSHRC="$HOME/.zshrc"
ZPROFILE="$HOME/.zprofile"

echo "=== 🧽 Permanent Path Structural De-duplication ==="

# 1. Create fallback snapshots before executing filesystem updates
mkdir -p "$HOME/Wonderland/backups"
[[ -f "$ZSHRC" ]] && cp "$ZSHRC" "$HOME/Wonderland/backups/.zshrc.bak.$(date +%s)"
[[ -f "$ZPROFILE" ]] && cp "$ZPROFILE" "$HOME/Wonderland/backups/.zprofile.bak.$(date +%s)"
echo "[BACKUP] Created shell configuration snapshots in ~/Wonderland/backups/"

# 2. Programmatically purge the hardcoded text patterns causing loop bloating
if [[ -f "$ZSHRC" ]]; then
    # Create a temporary clean file variant
    CLEAN_TMP=$(mktemp)
    
    # Strip any lines matching legacy paths or repetitive manual appends
    grep -v "Wonderland-v3" "$ZSHRC" | grep -v "Wonderland/bin" | grep -v "tools/bin" > "$CLEAN_TMP" || true
    
    # Append the single definitive path injection anchor to the base configuration file
    cat << 'EOF' >> "$CLEAN_TMP"

# --- Wonderland Structural Path Strategy ---
typeset -U path cdpath fpath manpath # Native Zsh feature to automatically prevent duplicate array values
path=(
  /Users/wonderland/Wonderland/bin
  /Users/wonderland/Wonderland/tools/bin
  /Users/wonderland/.grok/bin
  /Users/wonderland/.local/bin
  /opt/homebrew/bin
  /opt/homebrew/sbin
  /usr/local/bin
  /usr/bin
  /bin
  /usr/sbin
  /sbin
  /Users/wonderland/.orbstack/bin
  $path
)
export PATH
EOF

    mv "$CLEAN_TMP" "$ZSHRC"
    echo "[REPAIR] Successfully scrubbed and optimized configurations inside ~/.zshrc"
fi

echo "=== Processing Complete: Reloading Shell Active Context ==="
