#!/usr/bin/env python3


resolve_wl_root()
{
    if [[ -n "${WL_ROOT:-}" ]]; then
        echo "$WL_ROOT"
        return
    fi

    if command -v git >/dev/null 2>&1; then
        local ROOT
        ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
        if [[ -n "$ROOT" ]]; then
            echo "$ROOT"
            return
        fi
    fi

    local SCRIPT_PATH
    SCRIPT_PATH="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    echo "$(cd "$SCRIPT_PATH/../../.." && pwd)"
}

WL_ROOT="$(resolve_wl_root)"
export WL_ROOT

import json
import sys
from pathlib import Path
from datetime import datetime, timezone


ROOT = Path(__file__).resolve().parents[1]
GENERATED = ROOT / "generated"
REGISTRY = ROOT / "registry.json"


def fail(msg):
    print(f"[FAIL] {msg}")
    sys.exit(1)


def load_json(path):
    with open(path) as f:
        return json.load(f)


def main():

    if len(sys.argv) < 2:
        fail(
            "usage: spark-register <spark-id>"
        )

    spark_id = sys.argv[1]

    spark_dir = GENERATED / spark_id

    if not spark_dir.exists():
        fail(
            f"missing spark directory: {spark_dir}"
        )

    manifest = spark_dir / "manifest.yaml"
    certificate = spark_dir / "certification.json"

    if not manifest.exists():
        fail("missing manifest.yaml")

    if not certificate.exists():
        fail("missing certification.json")

    cert = load_json(certificate)

    if cert.get("status") != "CERTIFIED":
        fail(
            "Spark is not certified"
        )

    if not REGISTRY.exists():
        registry = {
            "apiVersion": "spark.wonderland/v1",
            "kind": "SparkRegistry",
            "schemaVersion": 1,
            "sparks": []
        }
    else:
        registry = load_json(REGISTRY)

        # migrate older registry formats
        if "sparks" not in registry:
            registry = {
                "apiVersion": "spark.wonderland/v1",
                "kind": "SparkRegistry",
                "schemaVersion": 1,
                "previousRegistry": registry,
                "sparks": []
            }


    registry["sparks"] = [
        s for s in registry.get("sparks", [])
        if s.get("id") != spark_id
    ]


    registry["sparks"].append(
        {
            "id": spark_id,
            "version": cert["spark"]["version"],
            "certificateId": cert["certificateId"],
            "status": "CERTIFIED",
            "path": str(
                spark_dir.relative_to(ROOT.parent)
            ),
            "registered": datetime.now(
                timezone.utc
            ).isoformat()
        }
    )


    with open(REGISTRY, "w") as f:
        json.dump(
            registry,
            f,
            indent=2
        )


    print("[PASS] Spark registered")
    print(REGISTRY)


if __name__ == "__main__":
    main()
