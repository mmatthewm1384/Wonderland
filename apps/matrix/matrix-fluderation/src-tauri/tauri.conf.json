{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Matrix Fluderation",
  "version": "0.1.0",
  "identifier": "com.wonderland.matrix.fluderation",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "Matrix Fluderation",
        "width": 1180,
        "height": 780,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ]
  }
}
