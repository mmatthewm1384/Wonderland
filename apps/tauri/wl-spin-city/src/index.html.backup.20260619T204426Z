<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<title>Matrix Spin City</title>
<style>
:root {
  --wl-background:#05070A;
  --wl-cyan:#00E5FF;
  --wl-purple:#7000FF;
  --wl-green:#00FF66;
  --text:#E9FBFF;
  --muted:#7D8799;
  --panel:#0B1018;
}
* { box-sizing:border-box; }
body {
  margin:0;
  min-height:100vh;
  font-family:Inter,system-ui,-apple-system,sans-serif;
  color:var(--text);
  background:
    radial-gradient(circle at 18% 8%, rgba(112,0,255,.30), transparent 34rem),
    radial-gradient(circle at 82% 82%, rgba(0,229,255,.16), transparent 32rem),
    var(--wl-background);
}
.shell { width:min(1240px, calc(100vw - 44px)); margin:0 auto; padding:24px 0; }
.topbar,.panel,.stage,.card {
  border:1px solid rgba(0,229,255,.24);
  background:rgba(11,16,24,.88);
  border-radius:24px;
  box-shadow:0 0 34px rgba(0,229,255,.08);
}
.topbar { display:flex; justify-content:space-between; align-items:center; padding:20px 24px; }
.eyebrow { color:var(--wl-green); letter-spacing:.16em; text-transform:uppercase; font-size:12px; margin:0 0 6px; }
h1 { margin:0; color:var(--wl-cyan); font-size:44px; }
.status { color:var(--wl-green); border:1px solid rgba(0,255,102,.55); border-radius:999px; padding:10px 16px; font-weight:800; }

.panel {
  margin-top:16px;
  padding:18px;
  display:grid;
  grid-template-columns:repeat(6, minmax(130px,1fr));
  gap:14px;
  align-items:end;
}
.control {
  border-left:1px solid rgba(0,229,255,.16);
  padding:8px 14px;
}
label { display:flex; justify-content:space-between; color:var(--muted); margin-bottom:8px; font-size:12px; }
label span { color:var(--wl-cyan); font-family:"JetBrains Mono",monospace; }
input[type=range], select { width:100%; accent-color:var(--wl-cyan); }
select {
  background:#05070A;
  color:var(--text);
  border:1px solid rgba(0,229,255,.25);
  border-radius:12px;
  padding:9px;
}
button {
  border:0;
  border-radius:16px;
  padding:14px 20px;
  color:white;
  font-weight:900;
  cursor:pointer;
  background:linear-gradient(135deg,var(--wl-purple),var(--wl-cyan));
}
.stage {
  position:relative;
  margin-top:16px;
  height:920px;
  overflow:hidden;
}
.stage-grid {
  position:absolute;
  inset:0;
  background:
    radial-gradient(circle at 50% 50%, rgba(0,229,255,.08), transparent 18rem),
    repeating-linear-gradient(90deg, rgba(0,229,255,.045) 0 1px, transparent 1px 72px),
    repeating-linear-gradient(0deg, rgba(112,0,255,.032) 0 1px, transparent 1px 72px);
}
.field-wrap {
  position:absolute;
  inset:0;
  display:grid;
  place-items:center;
}
svg {
  width:min(1400px, 96vw);
  height:820px;
  overflow:visible;
  filter:drop-shadow(0 0 16px rgba(0,229,255,.10));
}
.orbit {
  fill:none;
  stroke-width:3;
  stroke-linecap:round;
  opacity:.95;
}
.inner { stroke:var(--wl-cyan); filter:drop-shadow(0 0 12px var(--wl-cyan)); }
.mid { stroke:var(--wl-purple); filter:drop-shadow(0 0 12px var(--wl-purple)); }
.outer { stroke:var(--wl-green); filter:drop-shadow(0 0 14px var(--wl-green)); }

.ghost {
  fill:none;
  stroke:rgba(0,229,255,.12);
  stroke-width:1;
  stroke-dasharray:3 11;
}

.core {
  fill:rgba(0,229,255,.18);
  stroke:var(--wl-cyan);
  stroke-width:3;
  filter:drop-shadow(0 0 22px var(--wl-cyan));
  transform-origin:500px 300px;
  animation:coreCW var(--inner-duration,18s) linear infinite;
}
.core-line {
  stroke:var(--wl-cyan);
  stroke-width:2;
  stroke-linecap:round;
  transform-origin:500px 300px;
  animation:coreCW var(--inner-duration,18s) linear infinite;
}

.inner-group {
  transform-origin:500px 300px;
  animation:spinCW var(--inner-duration,18s) linear infinite;
}
.mid-group {
  transform-origin:500px 300px;
  animation:spinCCW var(--mid-duration,24s) linear infinite;
}
.outer-group {
  transform-origin:500px 300px;
  animation:spinCCW var(--outer-duration,32s) linear infinite;
}

.hook { filter:drop-shadow(0 0 12px currentColor); }
.hook-cyan { color:var(--wl-cyan); fill:rgba(0,229,255,.12); stroke:var(--wl-cyan); }
.hook-purple { color:var(--wl-purple); fill:rgba(112,0,255,.12); stroke:var(--wl-purple); }
.hook-green { color:var(--wl-green); fill:rgba(0,255,102,.12); stroke:var(--wl-green); }

.nebula {
  position:absolute;
  inset:90px 160px;
  border-radius:50%;
  background:
    radial-gradient(ellipse at 50% 50%, rgba(0,229,255,.10), transparent 32%),
    radial-gradient(ellipse at 40% 60%, rgba(112,0,255,.16), transparent 36%),
    radial-gradient(ellipse at 60% 45%, rgba(0,255,102,.10), transparent 38%);
  filter:blur(18px);
  opacity:.75;
  animation:breathe 8s ease-in-out infinite alternate;
}
@keyframes breathe { from { transform:scale(.96); opacity:.5; } to { transform:scale(1.04); opacity:.85; } }
@keyframes spinCW { from { transform:rotate(0deg); } to { transform:rotate(360deg); } }
@keyframes spinCCW { from { transform:rotate(0deg); } to { transform:rotate(-360deg); } }
@keyframes coreCW { from { transform:rotate(0deg); } to { transform:rotate(360deg); } }

.hud {
  position:absolute;
  left:24px;
  top:24px;
  width:270px;
  padding:16px;
  z-index:30;
}
.hud h2,.side h2 { color:var(--wl-cyan); font-size:13px; margin:0 0 12px; letter-spacing:.08em; }
.hud-line {
  display:flex;
  justify-content:space-between;
  gap:16px;
  color:var(--muted);
  font-family:"JetBrains Mono",monospace;
  font-size:13px;
  margin:8px 0;
}
.hud-line strong { color:var(--wl-green); font-weight:800; }

.side {
  position:absolute;
  right:24px;
  top:24px;
  width:260px;
  padding:16px;
  z-index:30;
}
.pattern-title { color:var(--wl-purple); font-size:26px; font-weight:900; margin-bottom:14px; }
.side p { color:#b9d7df; line-height:1.6; margin:0; }

.target {
  position:absolute;
  right:24px;
  bottom:24px;
  width:280px;
  padding:16px;
  z-index:30;
}
.target-name { color:var(--wl-green); font-size:18px; font-weight:900; }

.energy {
  position:absolute;
  left:24px;
  bottom:24px;
  width:270px;
  padding:16px;
  z-index:30;
}
.energy-value { color:var(--wl-green); font-size:32px; font-weight:900; }
.energy-bars { display:flex; gap:4px; height:42px; align-items:end; margin-top:12px; }
.energy-bars span {
  flex:1;
  min-width:4px;
  height:10px;
  border-radius:999px 999px 0 0;
  background:linear-gradient(to top,var(--wl-green),var(--wl-cyan),var(--wl-purple));
}
</style>
</head>
<body>
<section class="shell">
  <header class="topbar">
    <div>
      <p class="eyebrow">Wonderland Matrix</p>
      <h1>Spin City</h1>
    </div>
    <div id="status" class="status">ROTATION STABLE</div>
  </header>

  <section class="panel">
    <div class="control"><label>Inner Speed <span id="vInner"></span></label><input id="innerSpeed" type="range" min="1" max="100" value="94"></div>
    <div class="control"><label>Middle Speed <span id="vMiddle"></span></label><input id="middleSpeed" type="range" min="1" max="100" value="47"></div>
    <div class="control"><label>Outer Speed <span id="vOuter"></span></label><input id="outerSpeed" type="range" min="1" max="100" value="18"></div>
    <div class="control"><label>Waviness <span id="vWaviness"></span></label><input id="waviness" type="range" min="0" max="100" value="94"></div>
    <div class="control"><label>Hook Intensity <span id="vHook"></span></label><input id="hookIntensity" type="range" min="10" max="100" value="86"></div>
    <div class="control"><label>Pattern <span id="vPattern"></span></label>
      <select id="pattern">
        <option value="spectral" selected>Spectral Drift</option>
        
        <option value="vortex">Vortex</option>
        <option value="omen">Omen Ring</option>
      </select>
    </div>
    <button id="emit">Emit Rotation Event</button>
  </section>

  <section class="stage">
    <div class="stage-grid"></div>
    <div class="nebula"></div>

    <div class="card hud">
      <h2>FIELD STATUS</h2>
      <div class="hud-line"><span>Center</span><strong>clockwise</strong></div>
      <div class="hud-line"><span>Outer</span><strong>counter</strong></div>
      <div class="hud-line"><span>Inner speed</span><strong id="hInner"></strong></div>
      <div class="hud-line"><span>Middle speed</span><strong id="hMiddle"></strong></div>
      <div class="hud-line"><span>Outer speed</span><strong id="hOuter"></strong></div>
      <div class="hud-line"><span>Energy</span><strong id="hEnergy"></strong></div>
    </div>

    <div class="card side">
      <h2>ACTIVE PATTERN</h2>
      <div class="pattern-title" id="patternTitle">Balanced</div>
      <p>Uneven hooked rings move at different speeds. Inner field pulls clockwise; outer fields drag counter-clockwise. Something old is awake.</p>
    </div>

    <div class="card target">
      <h2>EVENT TARGET</h2>
      <div class="target-name">matrix-fluderation</div>
      <p>Ready to receive rotational field event.</p>
    </div>

    <div class="card energy">
      <h2>FIELD ENERGY</h2>
      <div id="energyValue" class="energy-value">0%</div>
      <div id="energyBars" class="energy-bars"></div>
    </div>

    <div class="field-wrap">
      <svg viewBox="0 0 1000 600" aria-label="Spin City rotational field">
        <defs>
          <path id="innerPath" class="orbit inner" />
          <path id="midPath" class="orbit mid" />
          <path id="outerPath" class="orbit outer" />
        </defs>

        <path id="innerGhost" class="ghost" />
        <path id="midGhost" class="ghost" />
        <path id="outerGhost" class="ghost" />

        <g class="outer-group" id="outerHooks"></g>
        <g class="mid-group" id="midHooks"></g>
        <g class="inner-group" id="innerHooks"></g>

        <path id="innerOrbit" class="orbit inner" />
        <path id="midOrbit" class="orbit mid" />
        <path id="outerOrbit" class="orbit outer" />

        <circle class="core" cx="500" cy="300" r="36" />
        <line class="core-line" x1="500" y1="260" x2="500" y2="340" />
        <line class="core-line" x1="460" y1="300" x2="540" y2="300" />
      </svg>
    </div>
  </section>
</section>

<script>
const $ = id => document.querySelector(id);

const innerSpeed = $("#innerSpeed");
const middleSpeed = $("#middleSpeed");
const outerSpeed = $("#outerSpeed");
const waviness = $("#waviness");
const hookIntensity = $("#hookIntensity");
const pattern = $("#pattern");

function energy() {
  return Math.min(100, Math.round(
    Number(innerSpeed.value) * .34 +
    Number(middleSpeed.value) * .28 +
    Number(outerSpeed.value) * .28 +
    Number(waviness.value) * .10
  ));
}

function orbitPath(rx, ry, wave, phase) {
  const cx = 500, cy = 300;
  const points = [];
  const steps = 180;

  for (let i = 0; i <= steps; i++) {
    const a = Math.PI * 2 * i / steps;
    const supernatural = Math.sin(a * 7 + phase) * wave + Math.sin(a * 11 - phase * .7) * wave * .42;
    const x = cx + Math.cos(a) * (rx + supernatural);
    const y = cy + Math.sin(a) * (ry + supernatural * .42);
    points.push(`${i === 0 ? "M" : "L"} ${x.toFixed(2)} ${y.toFixed(2)}`);
  }

  return points.join(" ") + " Z";
}

function hookShape(x, y, size, cls, rot, kind = "predator") {
  const shapes = {
    predator: `
      <path d="M -22 0 C -8 -26, 28 -20, 20 2 C 10 24, -12 16, -22 0"
            fill="none" stroke-width="3.4"/>
      <path d="M 12 -7 L 31 -18" fill="none" stroke-width="2.4"/>
    `,
    tendril: `
      <path d="M -32 0 C -12 -24, 10 24, 32 0"
            fill="none" stroke-width="2.8"/>
      <path d="M 17 0 C 33 -13, 35 18, 18 10"
            fill="none" stroke-width="2.4"/>
    `,
    fracture: `
      <path d="M -25 19 L -4 -23 L 8 3 L 27 -18"
            fill="none" stroke-width="3.3"/>
      <path d="M -4 -23 L 18 24" fill="none" stroke-width="2.5"/>
    `,
    scar: `
      <path d="M -21 -15 C -36 4, -18 25, 4 13"
            fill="none" stroke-width="2.9"/>
      <path d="M 8 -12 C 23 -28, 36 15, 16 24"
            fill="none" stroke-width="2.4"/>
    `
  };

  return `
    <g class="hook ${cls}"
       transform="translate(${x} ${y}) rotate(${rot}) scale(${size / 44})">
      ${shapes[kind] || shapes.predator}
    </g>
  `;
}

function point(rx, ry, wave, phase, a) {
  const supernatural = Math.sin(a * 7 + phase) * wave + Math.sin(a * 11 - phase * .7) * wave * .42;
  return {
    x: 500 + Math.cos(a) * (rx + supernatural),
    y: 300 + Math.sin(a) * (ry + supernatural * .42)
  };
}

function drawHooks(target, rx, ry, wave, phase, count, cls, clockwise, anchors) {
  const kinds = ["predator", "tendril", "fracture", "scar"];
  const html = anchors.slice(0, count).map((a, i) => {
    const angle = a * Math.PI * 2 + phase * (clockwise ? 1 : -1);
    const turbulence =
      Math.sin(angle * 3.0 + phase) * wave * 0.28 +
      Math.sin(angle * 7.0 - phase * 0.7) * wave * 0.18 +
      Math.sin(angle * 13.0 + phase * 0.31) * wave * 0.10;

    const attachBulge = 20 + Math.sin(phase + i * 1.7) * 10;
    const x = 500 + Math.cos(angle) * (rx + turbulence + attachBulge);
    const y = 300 + Math.sin(angle) * (ry + turbulence + attachBulge);
    const tangent = angle * 180 / Math.PI + (clockwise ? 92 : -92);
    const size = Math.max(30, Number(hookIntensity.value) * (0.62 + (i % 3) * 0.14));
    return hookShape(x, y, size, cls, tangent, kinds[i % kinds.length]);
  }).join("");

  $(target).innerHTML = html;
}

function sync() {
  $("#vInner").textContent = innerSpeed.value;
  $("#vMiddle").textContent = middleSpeed.value;
  $("#vOuter").textContent = outerSpeed.value;
  $("#vWaviness").textContent = waviness.value;
  $("#vHook").textContent = hookIntensity.value;
  $("#vPattern").textContent = pattern.value;

  $("#hInner").textContent = innerSpeed.value;
  $("#hMiddle").textContent = middleSpeed.value;
  $("#hOuter").textContent = outerSpeed.value;

  const e = energy();
  $("#hEnergy").textContent = `${e}%`;
  $("#energyValue").textContent = `${e}%`;
  $("#status").textContent = e > 70 ? "SUPERNATURAL DRIFT" : "ROTATION STABLE";
  $("#patternTitle").textContent = pattern.options[pattern.selectedIndex].text;

  document.documentElement.style.setProperty("--inner-duration", `${Math.max(5, 22 - Number(innerSpeed.value) / 5)}s`);
  document.documentElement.style.setProperty("--mid-duration", `${Math.max(7, 28 - Number(middleSpeed.value) / 5)}s`);
  document.documentElement.style.setProperty("--outer-duration", `${Math.max(9, 34 - Number(outerSpeed.value) / 5)}s`);

  const bars = Array.from({length: 26}, (_, i) => {
    const h = Math.max(10, Math.round((Math.sin(i * .7) * .25 + .75) * e));
    return `<span style="height:${h}px"></span>`;
  }).join("");
  $("#energyBars").innerHTML = bars;

  const wave = Number(waviness.value) / 2.15;
  const phase = performance.now() / 1800;

  let profile = {
    balanced: [210, 76, 330, 122, 450, 168],
    spectral: [220, 78, 345, 128, 470, 174],
    vortex: [190, 70, 330, 118, 485, 178],
    omen: [225, 66, 350, 116, 465, 152]
  }[pattern.value];

  const [irx, iry, mrx, mry, orx, ory] = profile;

  $("#innerOrbit").setAttribute("d", orbitPath(irx, iry, wave, phase));
  $("#midOrbit").setAttribute("d", orbitPath(mrx, mry, wave * 1.15, phase + 1.2));
  $("#outerOrbit").setAttribute("d", orbitPath(orx, ory, wave * 1.35, phase + 2.2));

  $("#innerGhost").setAttribute("d", orbitPath(irx + 38, iry + 16, wave * .55, phase));
  $("#midGhost").setAttribute("d", orbitPath(mrx + 45, mry + 20, wave * .55, phase + 1.2));
  $("#outerGhost").setAttribute("d", orbitPath(orx + 42, ory + 18, wave * .55, phase + 2.2));

  drawHooks("#innerHooks", irx, iry, wave, phase, 3, "hook-cyan", true, [0.06,0.36,0.73]);
  drawHooks("#midHooks", mrx, mry, wave * 1.1, phase + 1.2, 4, "hook-purple", false, [0.03,0.31,0.61,0.93]);
  drawHooks("#outerHooks", orx, ory, wave * 1.3, phase + 2.2, 5, "hook-green", false, [0.01,0.24,0.51,0.78,0.97]);
}

function makeEvent() {
  const stamp = new Date().toISOString().replaceAll("-", "").replaceAll(":", "").replace(/\.\d{3}Z$/, "Z");
  return {
    id:`evt-matrix-spin-city-${stamp}`,
    source:"matrix-spin-city",
    type:"rotation",
    strength:energy(),
    timestamp:new Date().toISOString(),
    payload:{
      target:"matrix-fluderation",
      center_rotation:"clockwise",
      outer_rotation:"counter-clockwise",
      inner_speed:Number(innerSpeed.value),
      middle_speed:Number(middleSpeed.value),
      outer_speed:Number(outerSpeed.value),
      waviness:Number(waviness.value),
      hook_intensity:Number(hookIntensity.value),
      pattern:pattern.value,
      palette:{
        wlBackground:"#05070A",
        wlCyan:"#00E5FF",
        wlPurple:"#7000FF",
        wlGreen:"#00FF66"
      }
    }
  };
}

function emitEvent() {
  const event = makeEvent();
  const blob = new Blob([JSON.stringify(event, null, 2)], { type:"application/json" });
  const url = URL.createObjectURL(blob);
  const a = document.createElement("a");
  a.href = url;
  a.download = `${event.id}.json`;
  a.click();
  URL.revokeObjectURL(url);
  $("#status").textContent = "ROTATION EVENT EXPORTED";
}

[innerSpeed,middleSpeed,outerSpeed,waviness,hookIntensity,pattern].forEach(el => el.addEventListener("input", sync));
$("#emit").onclick = emitEvent;

function loop() {
  sync();
  requestAnimationFrame(loop);
}
loop();
</script>
</body>
</html>
