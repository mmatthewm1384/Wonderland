<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<title>Matrix Spin City</title>
<style>
:root {
  --wl-background:#05070A;
  --wl-cyan:#00E5FF;
  --wl-purple:#7000FF;
  --wl-green:#00FF66;
  --text:#E9FBFF;
  --muted:#7D8799;
  --panel:#0B1018;
}
* { box-sizing:border-box; }
body {
  margin:0;
  min-height:100vh;
  font-family:Inter,system-ui,-apple-system,sans-serif;
  color:var(--text);
  background:
    radial-gradient(circle at 20% 10%, rgba(112,0,255,.28), transparent 34rem),
    radial-gradient(circle at 80% 80%, rgba(0,229,255,.18), transparent 32rem),
    var(--wl-background);
}
.shell { width:min(1240px, calc(100vw - 44px)); margin:0 auto; padding:24px 0; }
.topbar,.panel,.stage {
  border:1px solid rgba(0,229,255,.26);
  background:rgba(11,16,24,.90);
  border-radius:24px;
  box-shadow:0 0 34px rgba(0,229,255,.09);
}
.topbar { display:flex; justify-content:space-between; align-items:center; padding:20px 24px; }
.eyebrow { color:var(--wl-green); letter-spacing:.16em; text-transform:uppercase; font-size:12px; margin:0 0 6px; }
h1 { margin:0; color:var(--wl-cyan); font-size:44px; }
.status { color:var(--wl-green); border:1px solid rgba(0,255,102,.6); border-radius:999px; padding:10px 16px; font-weight:800; }
.panel {
  margin-top:16px;
  padding:18px;
  display:grid;
  grid-template-columns:repeat(5, minmax(145px,1fr));
  gap:14px;
  align-items:end;
}
.control {
  border:1px solid rgba(0,229,255,.12);
  background:rgba(5,7,10,.44);
  border-radius:16px;
  padding:12px;
}
label { display:flex; justify-content:space-between; color:var(--muted); margin-bottom:8px; font-size:12px; }
label span { color:var(--wl-cyan); font-family:"JetBrains Mono",monospace; }
input[type=range], select { width:100%; accent-color:var(--wl-cyan); }
select {
  background:#05070A;
  color:var(--text);
  border:1px solid rgba(0,229,255,.25);
  border-radius:12px;
  padding:9px;
}
button {
  border:0;
  border-radius:16px;
  padding:14px 20px;
  color:white;
  font-weight:900;
  cursor:pointer;
  background:linear-gradient(135deg,var(--wl-purple),var(--wl-cyan));
}
.stage {
  position:relative;
  margin-top:16px;
  height:650px;
  overflow:hidden;
}
.grid {
  position:absolute;
  inset:0;
  background:
    radial-gradient(circle at 50% 50%, rgba(0,229,255,.08), transparent 18rem),
    repeating-linear-gradient(90deg, rgba(0,229,255,.055) 0 1px, transparent 1px 64px),
    repeating-linear-gradient(0deg, rgba(112,0,255,.04) 0 1px, transparent 1px 64px);
}
.hud,.payload,.pattern-card,.target-card {
  position:absolute;
  border:1px solid rgba(0,229,255,.24);
  border-radius:16px;
  background:rgba(5,7,10,.72);
  color:var(--wl-cyan);
  font-family:"JetBrains Mono",monospace;
  line-height:1.65;
  z-index:30;
}
.hud { left:24px; top:24px; width:315px; padding:14px 16px; }
.payload { left:24px; bottom:24px; width:340px; padding:14px; font-size:11px; color:var(--wl-green); white-space:pre-wrap; }
.pattern-card { right:24px; top:24px; width:270px; padding:18px; }
.target-card { right:24px; bottom:24px; width:300px; padding:18px; }
.pattern-card h2,.target-card h2 { color:var(--wl-cyan); font-size:14px; margin:0 0 12px; }
.pattern-title { color:var(--wl-purple); font-size:28px; font-weight:900; }
.target { color:var(--wl-green); font-size:18px; font-weight:900; }

.history {
  position:absolute;
  right:24px;
  top:225px;
  width:270px;
  height:120px;
  display:flex;
  align-items:end;
  gap:5px;
  padding:12px;
  border:1px solid rgba(0,229,255,.22);
  border-radius:16px;
  background:rgba(5,7,10,.62);
  z-index:30;
}
.bar {
  flex:1;
  min-width:7px;
  height:8px;
  background:linear-gradient(to top,var(--wl-green),var(--wl-cyan),var(--wl-purple));
  border-radius:999px 999px 0 0;
}

.field {
  position:absolute;
  inset:0;
  display:grid;
  place-items:center;
}
.orbit {
  position:absolute;
  left:50%;
  top:50%;
  border-radius:50%;
  transform:translate(-50%,-50%);
  pointer-events:none;
}
.inner-orbit {
  width:310px;
  height:138px;
  border:3px solid rgba(0,229,255,.86);
  box-shadow:0 0 24px rgba(0,229,255,.25);
}
.outer-orbit {
  width:590px;
  height:250px;
  border:3px solid rgba(0,255,102,.88);
  box-shadow:0 0 30px rgba(0,255,102,.25);
}
.mid-orbit {
  width:450px;
  height:190px;
  border:2px solid rgba(112,0,255,.68);
  box-shadow:0 0 24px rgba(112,0,255,.22);
}

.core {
  position:absolute;
  left:50%;
  top:50%;
  width:82px;
  height:82px;
  transform:translate(-50%,-50%);
  border-radius:50%;
  border:3px solid var(--wl-cyan);
  background:radial-gradient(circle, rgba(0,229,255,.42), rgba(5,7,10,.6) 58%);
  box-shadow:0 0 44px rgba(0,229,255,.42), inset 0 0 22px rgba(0,229,255,.28);
  animation:coreCW var(--inner-speed,9s) linear infinite;
  z-index:12;
}
.core:before,.core:after {
  content:"";
  position:absolute;
  left:50%;
  top:50%;
  width:110px;
  height:3px;
  background:linear-gradient(90deg, transparent, var(--wl-cyan), transparent);
  transform:translate(-50%,-50%);
}
.core:after { transform:translate(-50%,-50%) rotate(90deg); }

.marker {
  position:absolute;
  left:50%;
  top:50%;
  width:34px;
  height:34px;
  transform-origin:0 0;
  z-index:14;
}
.marker .diamond {
  width:100%;
  height:100%;
  transform:rotate(45deg);
  border:3px solid currentColor;
  background:rgba(5,7,10,.52);
  box-shadow:0 0 18px currentColor, inset 0 0 12px currentColor;
}
.marker .diamond:before,
.marker .diamond:after {
  content:"";
  position:absolute;
  left:50%;
  top:50%;
  background:currentColor;
  transform:translate(-50%,-50%);
}
.marker .diamond:before { width:22px; height:2px; }
.marker .diamond:after { width:2px; height:22px; }

.inner-marker { color:var(--wl-cyan); }
.mid-marker { color:var(--wl-purple); }
.outer-marker { color:var(--wl-green); width:40px; height:40px; }

.direction-arrow {
  position:absolute;
  left:50%;
  top:50%;
  width:42px;
  height:10px;
  transform-origin:0 0;
  z-index:13;
}
.direction-arrow:after {
  content:"";
  display:block;
  width:100%;
  height:3px;
  background:currentColor;
  box-shadow:0 0 12px currentColor;
}
.direction-arrow:before {
  content:"";
  position:absolute;
  right:-2px;
  top:-4px;
  border-left:10px solid currentColor;
  border-top:6px solid transparent;
  border-bottom:6px solid transparent;
}
.inner-arrow { color:var(--wl-cyan); }
.outer-arrow { color:var(--wl-green); }
.mid-arrow { color:var(--wl-purple); }

@keyframes coreCW {
  from { transform:translate(-50%,-50%) rotate(0deg); }
  to { transform:translate(-50%,-50%) rotate(360deg); }
}
</style>
</head>

<body>
<section class="shell">
  <header class="topbar">
    <div>
      <p class="eyebrow">Wonderland Matrix</p>
      <h1>Spin City</h1>
    </div>
    <div id="status" class="status">ROTATION STABLE</div>
  </header>

  <section class="panel">
    <div class="control"><label>Inner Speed <span id="vInner"></span></label><input id="innerSpeed" type="range" min="1" max="100" value="28"></div>
    <div class="control"><label>Outer Speed <span id="vOuter"></span></label><input id="outerSpeed" type="range" min="1" max="100" value="18"></div>
    <div class="control"><label>Flatness <span id="vFlatness"></span></label><input id="flatness" type="range" min="20" max="90" value="42"></div>
    <div class="control"><label>Hook Size <span id="vHook"></span></label><input id="hookSize" type="range" min="20" max="60" value="40"></div>
    <div class="control">
      <label>Pattern <span id="vPattern"></span></label>
      <select id="pattern">
        <option value="balanced">Balanced</option>
        <option value="vortex">Vortex</option>
        <option value="gyroscopic">Gyroscopic</option>
        <option value="wide">Wide Orbit</option>
      </select>
    </div>
    <button id="emit">Emit Rotation Event</button>
  </section>

  <section class="stage">
    <div class="grid"></div>

    <div id="hud" class="hud"></div>
    <pre id="payload" class="payload"></pre>
    <div class="history" id="history"></div>

    <div class="pattern-card">
      <h2>ACTIVE PATTERN</h2>
      <div class="pattern-title" id="patternTitle">BALANCED</div>
      <p>Inner field rotates clockwise. Outer field rotates counter-clockwise.</p>
    </div>

    <div class="target-card">
      <h2>EVENT TARGET</h2>
      <div class="target">matrix-fluderation</div>
      <p>Ready to receive rotational field event.</p>
    </div>

    <div class="field" id="field">
      <div class="orbit outer-orbit" id="outerOrbit"></div>
      <div class="orbit mid-orbit" id="midOrbit"></div>
      <div class="orbit inner-orbit" id="innerOrbit"></div>
      <div id="markers"></div>
      <div id="arrows"></div>
      <div class="core" id="core"></div>
    </div>
  </section>
</section>

<script>
const $ = s => document.querySelector(s);
const markers = $("#markers");
const arrows = $("#arrows");
const hud = $("#hud");
const payload = $("#payload");
const history = $("#history");

const innerSpeed = $("#innerSpeed");
const outerSpeed = $("#outerSpeed");
const flatness = $("#flatness");
const hookSize = $("#hookSize");
const pattern = $("#pattern");

let t = 0;
let energyHistory = [];

function energy() {
  return Math.round(Number(innerSpeed.value) * .42 + Number(outerSpeed.value) * .44 + Number(hookSize.value) * .14);
}

function ellipsePoint(radiusX, radiusY, angle) {
  return {
    x: Math.cos(angle) * radiusX,
    y: Math.sin(angle) * radiusY
  };
}

function marker(cls, x, y, size) {
  const m = document.createElement("div");
  m.className = `marker ${cls}`;
  m.style.width = `${size}px`;
  m.style.height = `${size}px`;
  m.style.transform = `translate(${x - size / 2}px, ${y - size / 2}px)`;
  m.innerHTML = `<div class="diamond"></div>`;
  markers.appendChild(m);
}

function arrow(cls, x, y, angle) {
  const a = document.createElement("div");
  a.className = `direction-arrow ${cls}`;
  a.style.transform = `translate(${x}px, ${y}px) rotate(${angle}rad)`;
  arrows.appendChild(a);
}

function sync() {
  $("#vInner").textContent = innerSpeed.value;
  $("#vOuter").textContent = outerSpeed.value;
  $("#vFlatness").textContent = flatness.value;
  $("#vHook").textContent = hookSize.value;
  $("#vPattern").textContent = pattern.value;

  const innerDuration = Math.max(8, 22 - Number(innerSpeed.value) / 5);
  document.documentElement.style.setProperty("--inner-speed", `${innerDuration}s`);

  const e = energy();
  $("#status").textContent = e > 70 ? "ROTATION INTENSE" : "ROTATION STABLE";
  $("#patternTitle").textContent = pattern.value.toUpperCase();

  hud.innerHTML =
    `ROLE=rotational-field-generator<br>` +
    `CENTER_ROTATION=clockwise<br>` +
    `OUTER_ROTATION=counter-clockwise<br>` +
    `INNER_SPEED=${innerSpeed.value}<br>` +
    `OUTER_SPEED=${outerSpeed.value}<br>` +
    `FLATNESS=${flatness.value}<br>` +
    `FIELD_ENERGY=${e}`;

  const event = makeEvent(false);
  payload.textContent = JSON.stringify(event, null, 2);

  energyHistory.push(e);
  energyHistory = energyHistory.slice(-28);
  const max = Math.max(1, ...energyHistory);
  history.innerHTML = energyHistory.map(v => `<div class="bar" style="height:${Math.max(8, Math.round(v / max * 96))}px"></div>`).join("");
}

function draw() {
  markers.innerHTML = "";
  arrows.innerHTML = "";

  const flat = Number(flatness.value) / 100;
  const size = Number(hookSize.value);

  let innerRX = 155;
  let outerRX = 300;
  let midRX = 225;

  if (pattern.value === "wide") {
    outerRX = 340; midRX = 245;
  }
  if (pattern.value === "vortex") {
    innerRX = 135; outerRX = 320;
  }

  const innerRY = innerRX * flat;
  const midRY = midRX * flat;
  const outerRY = outerRX * flat;

  $("#innerOrbit").style.width = `${innerRX * 2}px`;
  $("#innerOrbit").style.height = `${innerRY * 2}px`;
  $("#midOrbit").style.width = `${midRX * 2}px`;
  $("#midOrbit").style.height = `${midRY * 2}px`;
  $("#outerOrbit").style.width = `${outerRX * 2}px`;
  $("#outerOrbit").style.height = `${outerRY * 2}px`;

  const cw = t * Number(innerSpeed.value) / 38;
  const ccw = -t * Number(outerSpeed.value) / 44;

  for (let i = 0; i < 6; i++) {
    const a = cw + Math.PI * 2 * i / 6;
    const p = ellipsePoint(innerRX, innerRY, a);
    marker("inner-marker", p.x, p.y, Math.max(22, size * .72));
    if (i % 3 === 0) arrow("inner-arrow", p.x, p.y, a + Math.PI / 2);
  }

  for (let i = 0; i < 8; i++) {
    const a = ccw + Math.PI * 2 * i / 8;
    const p = ellipsePoint(midRX, midRY, a);
    marker("mid-marker", p.x, p.y, Math.max(24, size * .82));
    if (i % 4 === 0) arrow("mid-arrow", p.x, p.y, a - Math.PI / 2);
  }

  for (let i = 0; i < 10; i++) {
    const a = ccw + Math.PI * 2 * i / 10;
    const p = ellipsePoint(outerRX, outerRY, a);
    marker("outer-marker", p.x, p.y, size);
    if (i % 2 === 0) arrow("outer-arrow", p.x, p.y, a - Math.PI / 2);
  }

  t += .022;
  requestAnimationFrame(draw);
}

function makeEvent(finalize = true) {
  const stamp = new Date().toISOString().replaceAll("-", "").replaceAll(":", "").replace(/\.\d{3}Z$/, "Z");
  return {
    id: `evt-matrix-spin-city-${stamp}`,
    source: "matrix-spin-city",
    type: "rotation",
    strength: energy(),
    timestamp: new Date().toISOString(),
    payload: {
      target: "matrix-fluderation",
      inner_rotation: "clockwise",
      outer_rotation: "counter-clockwise",
      inner_speed: Number(innerSpeed.value),
      outer_speed: Number(outerSpeed.value),
      flatness: Number(flatness.value),
      hook_size: Number(hookSize.value),
      pattern: pattern.value,
      palette: {
        wlBackground: "#05070A",
        wlCyan: "#00E5FF",
        wlPurple: "#7000FF",
        wlGreen: "#00FF66"
      },
      preview: !finalize
    }
  };
}

function emitEvent() {
  const event = makeEvent(true);
  const blob = new Blob([JSON.stringify(event, null, 2)], { type:"application/json" });
  const url = URL.createObjectURL(blob);
  const a = document.createElement("a");
  a.href = url;
  a.download = `${event.id}.json`;
  a.click();
  URL.revokeObjectURL(url);
  $("#status").textContent = "ROTATION EVENT EXPORTED";
}

[innerSpeed, outerSpeed, flatness, hookSize, pattern].forEach(el => el.addEventListener("input", sync));
$("#emit").onclick = emitEvent;

setInterval(sync, 700);
sync();
draw();
</script>
</body>
</html>
