<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<title>Matrix Spin City</title>
<style>
:root {
  --wl-background:#05070A;
  --wl-cyan:#00E5FF;
  --wl-purple:#7000FF;
  --wl-green:#00FF66;
  --text:#E9FBFF;
  --muted:#7D8799;
  --panel:#0B1018;
}
* { box-sizing:border-box; }
body {
  margin:0;
  min-height:100vh;
  font-family:Inter,system-ui,-apple-system,sans-serif;
  color:var(--text);
  background:
    radial-gradient(circle at 18% 8%, rgba(112,0,255,.28), transparent 34rem),
    radial-gradient(circle at 82% 82%, rgba(0,229,255,.14), transparent 32rem),
    var(--wl-background);
}
.shell { width:min(1240px, calc(100vw - 44px)); margin:0 auto; padding:24px 0; }
.topbar,.panel,.stage {
  border:1px solid rgba(0,229,255,.24);
  background:rgba(11,16,24,.88);
  border-radius:24px;
  box-shadow:0 0 34px rgba(0,229,255,.08);
}
.topbar { display:flex; justify-content:space-between; align-items:center; padding:20px 24px; }
.eyebrow { color:var(--wl-green); letter-spacing:.16em; text-transform:uppercase; font-size:12px; margin:0 0 6px; }
h1 { margin:0; color:var(--wl-cyan); font-size:44px; }
.status { color:var(--wl-green); border:1px solid rgba(0,255,102,.55); border-radius:999px; padding:10px 16px; font-weight:800; }
.panel {
  margin-top:16px;
  padding:18px;
  display:grid;
  grid-template-columns:repeat(6, minmax(130px,1fr));
  gap:14px;
  align-items:end;
}
.control { border-left:1px solid rgba(0,229,255,.16); padding:8px 14px; }
label { display:flex; justify-content:space-between; color:var(--muted); margin-bottom:8px; font-size:12px; }
label span { color:var(--wl-cyan); font-family:"JetBrains Mono",monospace; }
input[type=range], select { width:100%; accent-color:var(--wl-cyan); }
select {
  background:#05070A;
  color:var(--text);
  border:1px solid rgba(0,229,255,.25);
  border-radius:12px;
  padding:9px;
}
button {
  border:0;
  border-radius:16px;
  padding:14px 20px;
  color:white;
  font-weight:900;
  cursor:pointer;
  background:linear-gradient(135deg,var(--wl-purple),var(--wl-cyan));
}
.stage {
  position:relative;
  margin-top:16px;
  height:660px;
  overflow:hidden;
}
.stage-grid {
  position:absolute;
  inset:0;
  background:
    radial-gradient(circle at 50% 50%, rgba(0,229,255,.08), transparent 18rem),
    repeating-linear-gradient(90deg, rgba(0,229,255,.045) 0 1px, transparent 1px 72px),
    repeating-linear-gradient(0deg, rgba(112,0,255,.032) 0 1px, transparent 1px 72px);
}
.field-wrap {
  position:absolute;
  inset:0;
  display:grid;
  place-items:center;
}
svg {
  width:min(1060px, 86vw);
  height:600px;
  overflow:visible;
}
.ring {
  fill:none;
  stroke-width:3.2;
  stroke-linecap:round;
}
.inner-ring {
  stroke:var(--wl-cyan);
  filter:drop-shadow(0 0 12px var(--wl-cyan));
}
.mid-ring {
  stroke:var(--wl-purple);
  filter:drop-shadow(0 0 12px var(--wl-purple));
}
.outer-ring {
  stroke:var(--wl-green);
  filter:drop-shadow(0 0 14px var(--wl-green));
}
.ghost {
  fill:none;
  stroke:rgba(0,229,255,.10);
  stroke-width:1;
  stroke-dasharray:3 12;
}
.inner-group {
  transform-origin:500px 300px;
  animation:spinCW var(--inner-duration,8s) linear infinite;
}
.mid-group {
  transform-origin:500px 300px;
  animation:spinCCW var(--mid-duration,14s) linear infinite;
}
.outer-group {
  transform-origin:500px 300px;
  animation:spinCCW var(--outer-duration,22s) linear infinite;
}
.core {
  fill:rgba(0,229,255,.18);
  stroke:var(--wl-cyan);
  stroke-width:3;
  filter:drop-shadow(0 0 22px var(--wl-cyan));
  transform-origin:500px 300px;
  animation:spinCW var(--inner-duration,8s) linear infinite;
}
.core-line {
  stroke:var(--wl-cyan);
  stroke-width:2;
  stroke-linecap:round;
  transform-origin:500px 300px;
  animation:spinCW var(--inner-duration,8s) linear infinite;
}
.hook {
  stroke-linecap:round;
  stroke-linejoin:round;
  filter:drop-shadow(0 0 13px currentColor);
}
.hook-cyan { color:var(--wl-cyan); stroke:var(--wl-cyan); fill:rgba(0,229,255,.10); }
.hook-purple { color:var(--wl-purple); stroke:var(--wl-purple); fill:rgba(112,0,255,.10); }
.hook-green { color:var(--wl-green); stroke:var(--wl-green); fill:rgba(0,255,102,.10); }
.hook-anchor {
  fill:var(--wl-background);
  stroke-width:3;
}
.hook-blade {
  fill:none;
  stroke-width:5;
}
.hook-tether {
  stroke-width:3;
  opacity:.85;
}
@keyframes spinCW { from { transform:rotate(0deg); } to { transform:rotate(360deg); } }
@keyframes spinCCW { from { transform:rotate(0deg); } to { transform:rotate(-360deg); } }
</style>
</head>
<body>
<section class="shell">
  <header class="topbar">
    <div>
      <p class="eyebrow">Wonderland Matrix</p>
      <h1>Spin City</h1>
    </div>
    <div id="status" class="status">ROTATION STABLE</div>
  </header>

  <section class="panel">
    <div class="control"><label>Inner Speed <span id="vInner"></span></label><input id="innerSpeed" type="range" min="1" max="100" value="72"></div>
    <div class="control"><label>Middle Speed <span id="vMiddle"></span></label><input id="middleSpeed" type="range" min="1" max="100" value="42"></div>
    <div class="control"><label>Outer Speed <span id="vOuter"></span></label><input id="outerSpeed" type="range" min="1" max="100" value="24"></div>
    <div class="control"><label>Waviness <span id="vWaviness"></span></label><input id="waviness" type="range" min="0" max="100" value="36"></div>
    <div class="control"><label>Hook Size <span id="vHook"></span></label><input id="hookSize" type="range" min="20" max="70" value="48"></div>
    <div class="control"><label>Pattern <span id="vPattern"></span></label>
      <select id="pattern">
        <option value="spectral" selected>Spectral Drift</option>
        <option value="balanced">Balanced</option>
        <option value="vortex">Vortex</option>
        <option value="omen">Omen Ring</option>
      </select>
    </div>
    <button id="emit">Emit Rotation Event</button>
  </section>

  <section class="stage">
    <div class="stage-grid"></div>
    <div class="field-wrap">
      <svg viewBox="0 0 1000 600">
        <path id="outerGhost" class="ghost" />
        <path id="midGhost" class="ghost" />
        <path id="innerGhost" class="ghost" />

        <g class="outer-group">
          <path id="outerRing" class="ring outer-ring" />
          <g id="outerHooks"></g>
        </g>

        <g class="mid-group">
          <path id="midRing" class="ring mid-ring" />
          <g id="midHooks"></g>
        </g>

        <g class="inner-group">
          <path id="innerRing" class="ring inner-ring" />
          <g id="innerHooks"></g>
        </g>

        <circle class="core" cx="500" cy="300" r="22" />
        <line class="core-line" x1="500" y1="270" x2="500" y2="330" />
        <line class="core-line" x1="470" y1="300" x2="530" y2="300" />
      </svg>
    </div>
  </section>
</section>

<script>
const $ = id => document.querySelector(id);

const innerSpeed = $("#innerSpeed");
const middleSpeed = $("#middleSpeed");
const outerSpeed = $("#outerSpeed");
const waviness = $("#waviness");
const hookSize = $("#hookSize");
const pattern = $("#pattern");

function syncLabels() {
  $("#vInner").textContent = innerSpeed.value;
  $("#vMiddle").textContent = middleSpeed.value;
  $("#vOuter").textContent = outerSpeed.value;
  $("#vWaviness").textContent = waviness.value;
  $("#vHook").textContent = hookSize.value;
  $("#vPattern").textContent = pattern.options[pattern.selectedIndex].text;

  document.documentElement.style.setProperty("--inner-duration", `${Math.max(5, 18 - Number(innerSpeed.value) / 7)}s`);
  document.documentElement.style.setProperty("--mid-duration", `${Math.max(9, 28 - Number(middleSpeed.value) / 4)}s`);
  document.documentElement.style.setProperty("--outer-duration", `${Math.max(16, 42 - Number(outerSpeed.value) / 3)}s`);
}

function profile() {
  return {
    spectral: [215, 82, 345, 132, 485, 184],
    balanced: [205, 78, 330, 124, 460, 174],
    vortex: [190, 72, 330, 116, 500, 188],
    omen: [220, 70, 355, 112, 480, 162]
  }[pattern.value];
}

function pathFor(rx, ry, wave, phase) {
  const cx = 500, cy = 300;
  const points = [];
  const steps = 240;

  for (let i = 0; i <= steps; i++) {
    const a = Math.PI * 2 * i / steps;
    const wobble =
      Math.sin(a * 3 + phase) * wave +
      Math.sin(a * 5 - phase * .7) * wave * .38;
    const x = cx + Math.cos(a) * (rx + wobble);
    const y = cy + Math.sin(a) * (ry + wobble * .38);
    points.push(`${i === 0 ? "M" : "L"} ${x.toFixed(2)} ${y.toFixed(2)}`);
  }

  return points.join(" ") + " Z";
}

function pointOn(rx, ry, wave, phase, t) {
  const a = Math.PI * 2 * t;
  const wobble =
    Math.sin(a * 3 + phase) * wave +
    Math.sin(a * 5 - phase * .7) * wave * .38;
  return {
    x: 500 + Math.cos(a) * (rx + wobble),
    y: 300 + Math.sin(a) * (ry + wobble * .38),
    angle: a
  };
}

function hookGlyph(x, y, size, cls, angle, clockwise) {
  const dir = clockwise ? 1 : -1;
  const rot = angle * 180 / Math.PI + (clockwise ? 90 : -90);

  return `
    <g class="hook ${cls}" transform="translate(${x} ${y}) rotate(${rot}) scale(${size / 48})">
      <circle class="hook-anchor" cx="0" cy="0" r="7"/>
      <path class="hook-tether" d="M 0 0 L ${dir * 18} 0"/>
      <path class="hook-blade" d="M ${dir * 12} -24 C ${dir * 42} -12 ${dir * 38} 20 ${dir * 10} 26"/>
      <path class="hook-blade" d="M ${dir * 16} -12 C ${dir * 30} -6 ${dir * 28} 10 ${dir * 14} 16" opacity=".55"/>
    </g>`;
}

function drawHooks(group, rx, ry, wave, phase, cls, clockwise, placements) {
  const size = Number(hookSize.value);
  $(group).innerHTML = placements.map((t, i) => {
    const p = pointOn(rx, ry, wave, phase, t);
    const s = Math.max(26, size * (0.85 + (i % 3) * .12));
    return hookGlyph(p.x, p.y, s, cls, p.angle, clockwise);
  }).join("");
}

function draw() {
  syncLabels();

  const [irx, iry, mrx, mry, orx, ory] = profile();
  const wave = Number(waviness.value) / 5.2;
  const phase = performance.now() / 2400;

  $("#innerRing").setAttribute("d", pathFor(irx, iry, wave, phase));
  $("#midRing").setAttribute("d", pathFor(mrx, mry, wave * 1.15, phase + 1.1));
  $("#outerRing").setAttribute("d", pathFor(orx, ory, wave * 1.3, phase + 2.0));

  $("#innerGhost").setAttribute("d", pathFor(irx + 34, iry + 14, wave * .5, phase));
  $("#midGhost").setAttribute("d", pathFor(mrx + 42, mry + 18, wave * .5, phase + 1.1));
  $("#outerGhost").setAttribute("d", pathFor(orx + 46, ory + 20, wave * .5, phase + 2.0));

  drawHooks("#innerHooks", irx, iry, wave, phase, "hook-cyan", true, [0.06,0.18,0.41,0.57,0.82]);
  drawHooks("#midHooks", mrx, mry, wave * 1.15, phase + 1.1, "hook-purple", false, [0.04,0.15,0.32,0.49,0.73,0.91]);
  drawHooks("#outerHooks", orx, ory, wave * 1.3, phase + 2.0, "hook-green", false, [0.02,0.09,0.24,0.43,0.58,0.76,0.88,0.97]);

  requestAnimationFrame(draw);
}

function energy() {
  return Math.round(Number(innerSpeed.value) * .36 + Number(middleSpeed.value) * .28 + Number(outerSpeed.value) * .22 + Number(waviness.value) * .14);
}

function emitEvent() {
  const stamp = new Date().toISOString().replaceAll("-", "").replaceAll(":", "").replace(/\.\d{3}Z$/, "Z");
  const event = {
    id:`evt-matrix-spin-city-${stamp}`,
    source:"matrix-spin-city",
    type:"rotation",
    strength:energy(),
    timestamp:new Date().toISOString(),
    payload:{
      target:"matrix-fluderation",
      inner_rotation:"clockwise",
      middle_rotation:"counter-clockwise",
      outer_rotation:"counter-clockwise",
      inner_speed:Number(innerSpeed.value),
      middle_speed:Number(middleSpeed.value),
      outer_speed:Number(outerSpeed.value),
      waviness:Number(waviness.value),
      hook_size:Number(hookSize.value),
      palette:{
        wlBackground:"#05070A",
        wlCyan:"#00E5FF",
        wlPurple:"#7000FF",
        wlGreen:"#00FF66"
      }
    }
  };

  const blob = new Blob([JSON.stringify(event, null, 2)], { type:"application/json" });
  const url = URL.createObjectURL(blob);
  const a = document.createElement("a");
  a.href = url;
  a.download = `${event.id}.json`;
  a.click();
  URL.revokeObjectURL(url);
  $("#status").textContent = "ROTATION EVENT EXPORTED";
}

[innerSpeed,middleSpeed,outerSpeed,waviness,hookSize,pattern].forEach(el => el.addEventListener("input", syncLabels));
$("#emit").onclick = emitEvent;

draw();
</script>
</body>
</html>
