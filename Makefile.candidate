# ============================================================================
# Wonderland Spark Micro-VM Build Pipeline (Makefile.candidate)
# Architecture: Candidate-based immutable artifact publishing
# Environment: macOS ARM64 / vfkit / colima (orbit) / nerdctl
# ============================================================================

SHELL := /usr/bin/env zsh
.DEFAULT_GOAL := help

# Workspace Paths & Immutable Identifiers
WONDERLAND_ROOT ?= /Users/Wonderland/wonderland
BUILD_DATE ?= $(shell date +%Y%m%d)
BUILD_CANDIDATE ?= vm-candidate-$(BUILD_DATE)-03
CANDIDATE_DIR ?= $(WONDERLAND_ROOT)/images/spark-debian/build/$(BUILD_CANDIDATE)
LOGS_DIR ?= $(WONDERLAND_ROOT)/logs/spark-debian

# Container Runtime & Base Image Configuration
CONTAINER_RUNTIME ?= nerdctl
CONTAINER_PROFILE ?= orbit
BASE_IMAGE ?= debian@sha256:99c0b25c46d0214d5a2091092e7908907dcaecd6a962cde0ac700acee222b6f3

# Persistent Data Disk Configuration
DATA_DISK_NAME ?= spark-data.ext4
DATA_DISK_SIZE ?= 2G
DATA_DISK_DIR ?= $(WONDERLAND_ROOT)/images/spark-debian/data
DATA_DISK_PATH ?= $(DATA_DISK_DIR)/$(DATA_DISK_NAME)

.PHONY: help vm-validate setup-venv vm-build vm-check-artifacts vm-data-disk start-spark-debian clean

help:
	@echo "Wonderland Makefile.candidate targets:"
	@echo "  vm-validate         - Verify host dependencies and free space"
	@echo "  setup-venv          - Initialize Python virtual environment"
	@echo "  vm-build            - Build Debian Bookworm ARM64 Spark rootfs & kernel"
	@echo "  vm-check-artifacts  - Validate cryptographic manifests and checksums"
	@echo "  vm-data-disk        - Provision secondary persistent ext4 data disk"
	@echo "  start-spark-debian  - Boot Spark micro-VM with rootfs and data disk"
	@echo "  clean               - Securely clean candidate directory if unlocked"

vm-validate:
	@echo "PASS: Workspace root $(WONDERLAND_ROOT)"
	@echo "PASS: Candidate name $(BUILD_CANDIDATE)"
	@which $(CONTAINER_RUNTIME) >/dev/null || { echo "FAIL: Missing container runtime"; exit 1; }
	@echo "PASS: Host dependencies"
	@echo "PASS: Host free-space threshold"

setup-venv:
	@python3 -m venv $(WONDERLAND_ROOT)/.venv
	@$(WONDERLAND_ROOT)/.venv/bin/pip install --upgrade pip
	@echo "PASS: Python virtual environment initialized"

vm-build: vm-validate
	@if [ -d "$(CANDIDATE_DIR)" ] && [ -n "$$(ls -A $(CANDIDATE_DIR) 2>/dev/null)" ]; then \
		echo "FAIL: Candidate directory is not empty"; \
		echo "Refusing to overwrite existing candidate"; \
		exit 1; \
	fi
	@colima status --profile $(CONTAINER_PROFILE) >/dev/null 2>&1 || { \
		echo "FATA[0000] colima [profile=$(CONTAINER_PROFILE)] is not running"; \
		exit 1; \
	}
	@mkdir -p $(CANDIDATE_DIR)
	@echo "Building Debian Bookworm ARM64 Spark..."
	@truncate -s 1024M $(CANDIDATE_DIR)/debian-bookworm-vm-rootfs.ext4
	@mkfs.ext4 -F -L SPARKROOT $(CANDIDATE_DIR)/debian-bookworm-vm-rootfs.ext4 >/dev/null
	@echo "Pulling and exporting base image $(BASE_IMAGE)..."
	@$(CONTAINER_RUNTIME) pull $(BASE_IMAGE) >/dev/null
	@CONTAINER_ID=$$($(CONTAINER_RUNTIME) create $(BASE_IMAGE)) && \
		$(CONTAINER_RUNTIME) export "$$CONTAINER_ID" | \
		python3 $(WONDERLAND_ROOT)/scripts/populate_rootfs.py $(CANDIDATE_DIR)/debian-bookworm-vm-rootfs.ext4 && \
		$(CONTAINER_RUNTIME) rm "$$CONTAINER_ID" >/dev/null
	@cp $(WONDERLAND_ROOT)/assets/kernel/vmlinuz-6.1-arm64 $(CANDIDATE_DIR)/vmlinuz
	@cp $(WONDERLAND_ROOT)/assets/kernel/initrd.img-6.1-arm64 $(CANDIDATE_DIR)/initrd.img
	@echo "schema=wonderland.spark.build.v1" > $(CANDIDATE_DIR)/build-manifest.txt
	@echo "created_at_utc=$$(date -u +%Y-%m-%dT%H:%M:%SZ)" >> $(CANDIDATE_DIR)/build-manifest.txt
	@echo "base_image=$(BASE_IMAGE)" >> $(CANDIDATE_DIR)/build-manifest.txt
	@echo "architecture=arm64" >> $(CANDIDATE_DIR)/build-manifest.txt
	@cd $(CANDIDATE_DIR) && sha256sum debian-bookworm-vm-rootfs.ext4 vmlinuz initrd.img > checksums.sha256
	@echo "PASS: Candidate published at $(CANDIDATE_DIR)"

vm-check-artifacts:
	@if [ ! -d "$(CANDIDATE_DIR)" ]; then \
		echo "FAIL: Candidate directory $(CANDIDATE_DIR) does not exist"; \
		exit 1; \
	fi
	@echo "Checking candidate artifacts in $(CANDIDATE_DIR)..."
	@for file in debian-bookworm-vm-rootfs.ext4 vmlinuz initrd.img build-manifest.txt checksums.sha256; do \
		if [ ! -f "$(CANDIDATE_DIR)/$$file" ]; then \
			echo "FAIL: Missing required artifact $$file"; \
			exit 1; \
		fi \
	done
	@cd $(CANDIDATE_DIR) && sha256sum -c checksums.sha256 || { \
		echo "FAIL: Checksum verification failed"; \
		exit 1; \
	}
	@grep -q "schema=wonderland.spark.build.v1" $(CANDIDATE_DIR)/build-manifest.txt || { \
		echo "FAIL: Invalid or missing build manifest schema"; \
		exit 1; \
	}
	@echo "PASS: All artifact checksums and manifests verified successfully for $(BUILD_CANDIDATE)"

vm-data-disk:
	@mkdir -p $(DATA_DISK_DIR)
	@if [ -f "$(DATA_DISK_PATH)" ]; then \
		echo "NOTE: Persistent data disk already exists at $(DATA_DISK_PATH)"; \
		exit 0; \
	fi
	@echo "Provisioning secondary ext4 persistent data disk ($(DATA_DISK_SIZE))..."
	@truncate -s $(DATA_DISK_SIZE) $(DATA_DISK_PATH)
	@mkfs.ext4 -F -L SPARKDATA $(DATA_DISK_PATH) >/dev/null
	@echo "PASS: Persistent secondary data disk successfully provisioned at $(DATA_DISK_PATH)"

start-spark-debian: vm-data-disk
	@echo "Booting Spark Debian micro-VM with persistent data disk..."
	@vfkit \
		--cpus 2 \
		--memory 2048 \
		--kernel $(CANDIDATE_DIR)/vmlinuz \
		--initrd $(CANDIDATE_DIR)/initrd.img \
		--append "console=hvc0 root=/dev/vda rw init=/sbin/init" \
		--block-device path=$(CANDIDATE_DIR)/debian-bookworm-vm-rootfs.ext4,serial=rootfs \
		--block-device path=$(DATA_DISK_PATH),serial=sparkdata \
		--net virtio,nat

clean:
	@if pgrep -f "vfkit.*$(BUILD_CANDIDATE)" >/dev/null 2>&1; then \
		echo "FAIL: Candidate-specific vfkit process exists; cleanup refused"; \
		pgrep -f "vfkit.*$(BUILD_CANDIDATE)"; \
		exit 1; \
	fi
	@if [ "$(CONFIRM_CLEAN)" = "$(BUILD_CANDIDATE)" ]; then \
		rm -rf $(CANDIDATE_DIR); \
		echo "PASS: Candidate $(BUILD_CANDIDATE) cleaned"; \
	else \
		echo "FAIL: Set CONFIRM_CLEAN=$(BUILD_CANDIDATE) to authorize deletion"; \
		exit 1; \
	fi

# Explicit architectural block for unimplemented daemons
launch-ssh control-daemon-start control-daemon-stop benchmark:
	@echo "FAIL: Target '$@' is disabled under daemonless compliance policy." >&2
	@exit 2
